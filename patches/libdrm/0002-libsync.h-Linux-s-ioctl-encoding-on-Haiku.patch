 libsync.h | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/libsync.h b/libsync.h
index c6b64ed..c76b91e 100644
--- a/libsync.h
+++ b/libsync.h
@@ -33,6 +33,9 @@
 #include <stdint.h>
 #include <string.h>
 #include <sys/ioctl.h>
