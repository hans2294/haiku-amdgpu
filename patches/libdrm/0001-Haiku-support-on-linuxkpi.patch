 #else
 #warning "Missing implementation of drmParsePciBusInfo"
     return -EINVAL;
@@ -3984,6 +4019,22 @@ static int drmParsePciDeviceInfo(int maj, int min,
     device->subdevice_id = results[0].pc_subdevice;
     device->revision_id = results[0].pc_revid;
 
+    return 0;
+#elif defined(__HAIKU__)
+    struct linuxkpi_device_info info;
+    int ret = drm_haiku_node_info(maj, min, &info);
+
+    if (ret)
+        return ret;
+    if (info.bus != LINUXKPI_BUS_PCI)
