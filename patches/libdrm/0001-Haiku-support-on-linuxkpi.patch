diff --git a/haiku/libdrm_haiku.c b/haiku/libdrm_haiku.c
new file mode 100644
index 0000000..0ebdd96
--- /dev/null
+++ b/haiku/libdrm_haiku.c
@@ -0,0 +1,234 @@
+/*
+ * Copyright 2026, hans2294.
+ * Distributed under the terms of the MIT License.
+ */
+
+
+/*	libdrm's Haiku support; see libdrm_haiku.h. */
+
+
+#include "libdrm_haiku.h"
+
+#include <dirent.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <sys/mman.h>
+#include <unistd.h>
+
+#define DRM_DIR "/dev/dri"
+
+
+static int
+info_ioctl(int fd, struct linuxkpi_device_info *info)
+{
+	memset(info, 0, sizeof(*info));
+	return ioctl(fd, LINUXKPI_IOCTL_DEVICE_INFO, info, sizeof(*info));
+}
+
+
+int
+drm_haiku_fd_info(int fd, struct linuxkpi_device_info *info)
+{
+	return info_ioctl(fd, info);
+}
+
+
+static int
+path_info(const char *path, struct linuxkpi_device_info *info)
+{
+	// Opening a node is cheap: linuxkpi opens the Linux file on first use,
+	// and this ioctl is not one.
+	int fd = open(path, O_RDWR | O_CLOEXEC);
+	if (fd < 0)
+		return -1;
+	int result = info_ioctl(fd, info);
+	int error = errno;
+	close(fd);
+	errno = error;
+	return result;
+}
+
+
+int
+drm_haiku_node_info(int maj, int min, struct linuxkpi_device_info *info)
+{
+	char path[64];
+	snprintf(path, sizeof(path), min >= 128 ? DRM_DIR "/renderD%d"
+		: DRM_DIR "/card%d", min);
+	if (path_info(path, info) != 0)
+		return -errno;
+	if ((int)info->major != maj || (int)info->minor != min)
+		return -ENODEV;
+	return 0;
+}
+
+
+static void
+apply_info(struct stat *st, const struct linuxkpi_device_info *info)
+{
+	st->st_rdev = makedev(info->major, info->minor);
+	st->st_mode = (st->st_mode & ~S_IFMT) | S_IFCHR;
+}
+
+
+int
+drm_haiku_fstat(int fd, struct stat *st)
+{
+	if (fstat(fd, st) != 0)
+		return -1;
+	struct linuxkpi_device_info info;
+	if (info_ioctl(fd, &info) == 0)
+		apply_info(st, &info);
+	return 0;
+}
+
+
+int
+drm_haiku_stat(const char *path, struct stat *st)
+{
+	if (stat(path, st) != 0)
+		return -1;
+	struct linuxkpi_device_info info;
+	if (strncmp(path, DRM_DIR "/", sizeof(DRM_DIR)) == 0
+		&& path_info(path, &info) == 0)
+		apply_info(st, &info);
+	return 0;
+}
+
+
+static int
+same_device(const struct linuxkpi_device_info *a,
+	const struct linuxkpi_device_info *b)
+{
+	return a->bus == b->bus && a->pci_domain == b->pci_domain
+		&& a->pci_bus == b->pci_bus && a->pci_device == b->pci_device
+		&& a->pci_function == b->pci_function;
+}
+
+
+char *
+drm_haiku_node_name_for_fd(int fd, const char *prefix)
+{
+	struct linuxkpi_device_info own;
+	if (info_ioctl(fd, &own) != 0)
+		return NULL;
+
+	DIR *dir = opendir(DRM_DIR);
+	if (dir == NULL)
+		return NULL;
+	char *result = NULL;
+	struct dirent *entry;
+	while (result == NULL && (entry = readdir(dir)) != NULL) {
+		if (strncmp(entry->d_name, prefix, strlen(prefix)) != 0)
+			continue;
+		char path[PATH_MAX];
+		snprintf(path, sizeof(path), DRM_DIR "/%s", entry->d_name);
+		struct linuxkpi_device_info info;
+		if (path_info(path, &info) == 0 && same_device(&own, &info))
+			result = strdup(path);
+	}
+	closedir(dir);
+	return result;
+}
+
+
+//	#pragma mark - mappings
+
+
+/*	A mapping is undone through a linuxkpi node, but munmap() gets no file
+	descriptor: remember the one each mapping was made through. If that one
+	is closed by then, any DRM node will do.
+*/
+struct mapping {
+	struct mapping *next;
+	void *address;
+	int fd;
+};
+
+static pthread_mutex_t sMappingLock = PTHREAD_MUTEX_INITIALIZER;
+static struct mapping *sMappings;
+
+
+void *
+drm_haiku_mmap(void *addr, size_t length, int prot, int flags, int fd,
+	off_t offset)
+{
+	struct linuxkpi_mmap request;
+	memset(&request, 0, sizeof(request));
+	request.offset = offset;
+	request.size = length;
+	if (prot & PROT_READ)
+		request.flags |= LINUXKPI_MMAP_READ;
+	if (prot & PROT_WRITE)
+		request.flags |= LINUXKPI_MMAP_WRITE;
+	if (ioctl(fd, LINUXKPI_IOCTL_MMAP, &request, sizeof(request)) != 0)
+		return MAP_FAILED;
+
+	struct mapping *mapping = malloc(sizeof(*mapping));
+	if (mapping != NULL) {
+		mapping->address = (void *)(uintptr_t)request.address;
+		mapping->fd = fd;
+		pthread_mutex_lock(&sMappingLock);
+		mapping->next = sMappings;
+		sMappings = mapping;
+		pthread_mutex_unlock(&sMappingLock);
+	}
+	return (void *)(uintptr_t)request.address;
+}
+
+
+static int
+unmap_through(int fd, void *address)
+{
+	struct linuxkpi_munmap request;
+	request.address = (uintptr_t)address;
+	return ioctl(fd, LINUXKPI_IOCTL_MUNMAP, &request, sizeof(request));
+}
+
+
+int
+drm_haiku_munmap(void *addr, size_t length)
+{
+	int fd = -1;
+	pthread_mutex_lock(&sMappingLock);
+	for (struct mapping **link = &sMappings; *link != NULL;
+			link = &(*link)->next) {
+		if ((*link)->address == addr) {
+			struct mapping *mapping = *link;
+			*link = mapping->next;
+			fd = mapping->fd;
+			free(mapping);
+			break;
+		}
+	}
+	pthread_mutex_unlock(&sMappingLock);
+
+	if (fd >= 0 && unmap_through(fd, addr) == 0)
+		return 0;
+	if (fd >= 0 && errno != EBADF)
+		return -1;
+
+	DIR *dir = opendir(DRM_DIR);
+	if (dir == NULL)
+		return -1;
+	int result = -1;
+	struct dirent *entry;
+	while (result != 0 && (entry = readdir(dir)) != NULL) {
+		if (entry->d_name[0] == '.')
+			continue;
+		char path[PATH_MAX];
+		snprintf(path, sizeof(path), DRM_DIR "/%s", entry->d_name);
+		int nodeFD = open(path, O_RDWR | O_CLOEXEC);
+		if (nodeFD < 0)
+			continue;
+		result = unmap_through(nodeFD, addr);
+		close(nodeFD);
+	}
+	closedir(dir);
+	return result;
+}
diff --git a/haiku/libdrm_haiku.h b/haiku/libdrm_haiku.h
new file mode 100644
index 0000000..b20eabc
--- /dev/null
+++ b/haiku/libdrm_haiku.h
@@ -0,0 +1,47 @@
+/*
+ * Copyright 2026, hans2294.
+ * Distributed under the terms of the MIT License.
+ */
+#ifndef LIBDRM_HAIKU_H
+#define LIBDRM_HAIKU_H
+
+/*
+ * Private to libdrm and libdrm_amdgpu (each links its own copy).
+ *
+ * libdrm on Haiku, where DRM nodes are linuxkpi devices: a node tells its
+ * Linux dev_t and PCI device through LINUXKPI_IOCTL_DEVICE_INFO, and
+ * buffers are mapped with LINUXKPI_IOCTL_MMAP instead of mmap().
+ */
+
+#include <stddef.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+
+#include <linuxkpi/uapi.h>
+
+/* Haiku's dev_t has no major/minor; these carry the node's Linux dev_t. */
+#define makedev(major, minor)	((dev_t)(((major) << 20) | (minor)))
+#define major(dev)				((unsigned int)((dev) >> 20) & 0xfff)
+#define minor(dev)				((unsigned int)(dev) & 0xfffff)
+
+#pragma GCC visibility push(hidden)
+
+/* stat()/fstat() that fill in st_rdev for DRM nodes */
+int drm_haiku_fstat(int fd, struct stat *st);
+int drm_haiku_stat(const char *path, struct stat *st);
+
+/* The device behind an open node, or behind the node for maj:min */
+int drm_haiku_fd_info(int fd, struct linuxkpi_device_info *info);
+int drm_haiku_node_info(int maj, int min, struct linuxkpi_device_info *info);
+
+/* The /dev/dri path of the node of \p prefix ("card", "renderD") on the
+ * same device as \p fd; malloc()ed, or NULL. */
+char *drm_haiku_node_name_for_fd(int fd, const char *prefix);
+
+void *drm_haiku_mmap(void *addr, size_t length, int prot, int flags, int fd,
+	off_t offset);
+int drm_haiku_munmap(void *addr, size_t length);
+
+#pragma GCC visibility pop
+
+#endif
diff --git a/haiku/sys/ioccom.h b/haiku/sys/ioccom.h
new file mode 100644
index 0000000..f42ea35
--- /dev/null
+++ b/haiku/sys/ioccom.h
@@ -0,0 +1,38 @@
+/*
+ * Copyright 2026, hans2294.
+ * Distributed under the terms of the MIT License.
+ */
+#ifndef _LIBDRM_HAIKU_SYS_IOCCOM_H
+#define _LIBDRM_HAIKU_SYS_IOCCOM_H
+
+/* Linux's ioctl encoding, which Linux's DRM in linuxkpi decodes: number,
+ * type, size and direction in one 32 bit command. Linux's uapi drm.h
+ * includes this on systems that are not Linux. */
+#define _IOC_NRBITS		8
+#define _IOC_TYPEBITS	8
+#define _IOC_SIZEBITS	14
+#define _IOC_NRSHIFT	0
+#define _IOC_TYPESHIFT	(_IOC_NRSHIFT + _IOC_NRBITS)
+#define _IOC_SIZESHIFT	(_IOC_TYPESHIFT + _IOC_TYPEBITS)
+#define _IOC_DIRSHIFT	(_IOC_SIZESHIFT + _IOC_SIZEBITS)
+#define _IOC_NONE		0U
+#define _IOC_WRITE		1U
+#define _IOC_READ		2U
+
+/* BSD's names, which libdrm's xf86drm.h uses off Linux, unshifted to
+ * match _IOC() below */
+#define IOC_VOID		_IOC_NONE
+#define IOC_OUT			_IOC_READ
+#define IOC_IN			_IOC_WRITE
+#define IOC_INOUT		(_IOC_READ | _IOC_WRITE)
+
+#define _IOC(dir, type, nr, size) \
+	(((dir) << _IOC_DIRSHIFT) | ((type) << _IOC_TYPESHIFT) \
+		| ((nr) << _IOC_NRSHIFT) | ((size) << _IOC_SIZESHIFT))
+#define _IO(type, nr)			_IOC(_IOC_NONE, (type), (nr), 0)
+#define _IOR(type, nr, t)		_IOC(_IOC_READ, (type), (nr), sizeof(t))
+#define _IOW(type, nr, t)		_IOC(_IOC_WRITE, (type), (nr), sizeof(t))
+#define _IOWR(type, nr, t)		_IOC(_IOC_READ | _IOC_WRITE, (type), (nr), \
+	sizeof(t))
+
+#endif
