+++ b/libdrm_macros.h
@@ -64,6 +64,15 @@ static inline void *drm_mmap(void *addr, size_t length, int prot, int flags,
               munmap(addr, length)
 
 
+#elif defined(__HAIKU__)
+
+/* Device memory is mapped through linuxkpi's ioctls */
+#include "haiku/libdrm_haiku.h"
+#  define drm_mmap(addr, length, prot, flags, fd, offset) \
+              drm_haiku_mmap(addr, length, prot, flags, fd, offset)
+#  define drm_munmap(addr, length) \
+              drm_haiku_munmap(addr, length)
+
 #else
 
 /* assume large file support exists */
