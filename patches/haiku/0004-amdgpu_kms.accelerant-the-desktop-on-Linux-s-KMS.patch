+extern "C" void*
+get_accelerant_hook(uint32 feature, void* data)
+{
+	switch (feature) {
+		case B_INIT_ACCELERANT:
+			return (void*)amdgpu_kms_init_accelerant;
+		case B_UNINIT_ACCELERANT:
+			return (void*)amdgpu_kms_uninit_accelerant;
+		case B_CLONE_ACCELERANT:
+			return (void*)amdgpu_kms_clone_accelerant;
+		case B_ACCELERANT_CLONE_INFO_SIZE:
+			return (void*)amdgpu_kms_clone_info_size;
+		case B_GET_ACCELERANT_CLONE_INFO:
+			return (void*)amdgpu_kms_get_clone_info;
+		case B_GET_ACCELERANT_DEVICE_INFO:
+			return (void*)amdgpu_kms_get_device_info;
+		case B_ACCELERANT_RETRACE_SEMAPHORE:
+			return (void*)amdgpu_kms_retrace_semaphore;
+
+		case B_ACCELERANT_MODE_COUNT:
+			return (void*)amdgpu_kms_mode_count;
+		case B_GET_MODE_LIST:
+			return (void*)amdgpu_kms_get_mode_list;
+		case B_PROPOSE_DISPLAY_MODE:
+			return (void*)amdgpu_kms_propose_display_mode;
+		case B_SET_DISPLAY_MODE:
+			return (void*)amdgpu_kms_set_display_mode;
+		case B_GET_DISPLAY_MODE:
+			return (void*)amdgpu_kms_get_display_mode;
+		case B_GET_PREFERRED_DISPLAY_MODE:
+			return (void*)amdgpu_kms_get_preferred_display_mode;
+		case B_GET_EDID_INFO:
+			return (void*)amdgpu_kms_get_edid_info;
+		case B_GET_FRAME_BUFFER_CONFIG:
+			return (void*)amdgpu_kms_get_frame_buffer_config;
+		case B_GET_PIXEL_CLOCK_LIMITS:
+			return (void*)amdgpu_kms_get_pixel_clock_limits;
+
+		case B_MOVE_DISPLAY:
+			return (void*)amdgpu_kms_move_display;
+		case B_ACCELERANT_PAGE_FLIP_FEATURE:
+			return (void*)amdgpu_kms_move_display;
+
+		case B_SET_CURSOR_SHAPE:
+			return (void*)amdgpu_kms_set_cursor_shape;
+		case B_SET_CURSOR_BITMAP:
+			return (void*)amdgpu_kms_set_cursor_bitmap;
+		case B_MOVE_CURSOR:
+			return (void*)amdgpu_kms_move_cursor;
+		case B_SHOW_CURSOR:
+			return (void*)amdgpu_kms_show_cursor;
+	}
+	return NULL;
+}
