+#ifndef _PAGE_FLIP_H
+#define _PAGE_FLIP_H
+
+
+/*!	An accelerant that answers this feature with a non-NULL hook says that
+	it takes modes twice as high as the display (virtual_height), and that
+	its B_MOVE_DISPLAY to the top of either half is a page flip that lands
+	at a vertical blank and returns once it did. app_server then draws into
+	the hidden half and flips, for a tear-free screen.
+*/
+#define B_ACCELERANT_PAGE_FLIP_FEATURE	0x50464c50	/* 'PFLP' */
+
+
+#endif	// _PAGE_FLIP_H
