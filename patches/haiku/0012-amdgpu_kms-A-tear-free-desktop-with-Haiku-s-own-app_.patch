 		free_buffer(newBuffer);
+		if (sShadow != NULL)
+			start_shadow();
 		return B_ERROR;
 	}
 
+	free_shadow();
 	free_buffer(sBuffer);
 	sBuffer = newBuffer;
 	sShownHalf = 0;
@@ -559,9 +794,15 @@ amdgpu_kms_set_display_mode(display_mode* displayMode)
 	if (doubled)
 		sCurrentMode.virtual_height *= 2;
 	sModeSet = true;
+	sShadow = newShadow;
+	sShadowArea = newShadowArea;
+	if (sShadow != NULL) {
+		set_screen_shadow(true);
+		start_shadow();
