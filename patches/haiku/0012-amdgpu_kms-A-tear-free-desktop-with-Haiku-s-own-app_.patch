+extern "C" long
+lkpi_haiku_dirty_pages(const void* address, unsigned long pages,
+	unsigned char* bitmap)
+{
+	if (!IS_USER_ADDRESS(address) || (addr_t)address % B_PAGE_SIZE != 0)
+		return -kLinuxEINVAL;
+	VMAddressSpace* addressSpace = VMAddressSpace::GetCurrent();
+	if (addressSpace == NULL)
+		return -kLinuxEINVAL;
+
+	long count = 0;
+	addressSpace->ReadLock();
+	VMArea* source = addressSpace->LookupArea((addr_t)address);
+	if (source != NULL && (addr_t)address + pages * B_PAGE_SIZE
+			<= source->Base() + source->Size()) {
+		off_t offset = (addr_t)address - source->Base() + source->cache_offset;
+		VMCache* cache = vm_area_get_locked_cache(source);
+		for (VMArea* area = cache->areas.First(); area != NULL;
+				area = cache->areas.GetNext(area)) {
+			if (offset < area->cache_offset
+				|| offset + (off_t)(pages * B_PAGE_SIZE)
+					> area->cache_offset + (off_t)area->Size()) {
+				continue;
+			}
+			addr_t base = area->Base() + (offset - area->cache_offset);
+			VMTranslationMap* map = area->address_space->TranslationMap();
+			map->Lock();
+			for (unsigned long i = 0; i < pages; i++) {
+				addr_t page = base + i * B_PAGE_SIZE;
+				phys_addr_t physical;
+				uint32 flags;
+				if (map->Query(page, &physical, &flags) != B_OK
+					|| (flags & PAGE_MODIFIED) == 0) {
+					continue;
+				}
+				map->ClearFlags(page, PAGE_MODIFIED);
+				if ((bitmap[i / 8] & (1 << (i % 8))) == 0) {
+					bitmap[i / 8] |= 1 << (i % 8);
+					count++;
+				}
+			}
+			map->Unlock();
+		}
+		vm_area_put_locked_cache(cache);
+	} else
+		count = -kLinuxEINVAL;
+	addressSpace->ReadUnlock();
+	addressSpace->Put();
+	return count;
+}
