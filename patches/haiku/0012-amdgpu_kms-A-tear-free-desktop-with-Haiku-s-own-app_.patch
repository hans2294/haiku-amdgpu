+static status_t
+dirty_pages(void* buffer)
+{
+	linuxkpi_dirty_pages request;
+	if (!IS_USER_ADDRESS(buffer)
+		|| user_memcpy(&request, buffer, sizeof(request)) != B_OK)
+		return B_BAD_ADDRESS;
+	if (request.pages == 0 || request.pages > 16 * 1024 * 1024 / 4
+		|| !IS_USER_ADDRESS((void*)(addr_t)request.bitmap))
+		return B_BAD_VALUE;
+
+	size_t bytes = (request.pages + 7) / 8;
+	uint8* bitmap = (uint8*)malloc(bytes);
+	if (bitmap == NULL)
+		return B_NO_MEMORY;
+	// Bits get added to what is there: the caller may ask several times.
+	if (user_memcpy(bitmap, (const void*)(addr_t)request.bitmap, bytes) != B_OK) {
+		free(bitmap);
+		return B_BAD_ADDRESS;
+	}
+	long count = lkpi_haiku_dirty_pages((const void*)(addr_t)request.address,
+		request.pages, bitmap);
+	status_t status = B_OK;
+	if (count < 0)
+		status = lkpi_haiku_error(count);
+	else {
+		request.any = count > 0 ? 1 : 0;
+		if (user_memcpy((void*)(addr_t)request.bitmap, bitmap, bytes) != B_OK
+			|| user_memcpy(buffer, &request, sizeof(request)) != B_OK)
+			status = B_BAD_ADDRESS;
+	}
+	free(bitmap);
+	return status;
+}
