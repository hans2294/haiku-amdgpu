 }
 
 
+static status_t
+flip_to_half(uint32 half)
+{
+	if (half == sShownHalf)
+		return B_OK;
+
+	uint32 framebuffer = half == 0 ? sBuffer.framebuffer : sBuffer.framebuffer2;
+	bool done = false;
+	if (drmModePageFlip(sFD, sCrtc, framebuffer, DRM_MODE_PAGE_FLIP_EVENT,
+			&done) != 0) {
+		// no flip (the CRTC is off, say): show it right away instead
+		static bool sTold;
+		if (!sTold) {
+			LOG("page flip failed (%s), setting the framebuffer\n",
+				strerror(errno));
+			sTold = true;
+		}
+		if (drmModeSetCrtc(sFD, sCrtc, framebuffer, 0, 0, &sConnector, 1,
+				&sKMSMode) != 0)
+			return B_ERROR;
+		sShownHalf = half;
+		return B_OK;
+	}
+
+	// The flip's event comes through read() on the DRM file
+	drmEventContext context = {};
+	context.version = 2;
+	context.page_flip_handler = page_flip_done;
+	while (!done) {
+		if (drmHandleEvent(sFD, &context) != 0 && errno != EINTR) {
+			LOG("waiting for the page flip failed: %s\n", strerror(errno));
+			break;
+		}
+	}
+	sShownHalf = half;
+	return B_OK;
+}
+
+
+//	#pragma mark - shadow
+
+
+/*!	Puts the pages in \a bitmap from the shadow into a half of the buffer. */
+static void
+copy_shadow_pages(const uint8* bitmap, size_t pages, uint32 half)
+{
+	uint8* source = (uint8*)sShadow;
+	uint8* target = (uint8*)sBuffer.pixels
+		+ half * sBuffer.pitch * sCurrentMode.timing.v_display;
+	size_t index = 0;
+	while (index < pages) {
+		if ((bitmap[index / 8] & (1 << (index % 8))) == 0) {
+			index++;
+			continue;
+		}
+		size_t start = index;
+		while (index < pages && (bitmap[index / 8] & (1 << (index % 8))) != 0)
+			index++;
+		memcpy(target + start * B_PAGE_SIZE, source + start * B_PAGE_SIZE,
+			(index - start) * B_PAGE_SIZE);
+	}
+}
+
+
+/*!	Adds the pages written to since the last call to \a bitmap, and tells whether
+	there were any.
+*/
+static bool
+add_written_pages(uint8* bitmap, size_t pages)
+{
+	linuxkpi_dirty_pages request = {};
+	request.address = (addr_t)sShadow;
+	request.pages = pages;
+	request.bitmap = (addr_t)bitmap;
+	if (ioctl(sFD, LINUXKPI_IOCTL_DIRTY_PAGES, &request, sizeof(request)) != 0) {
+		LOG("no dirty pages: %s\n", strerror(errno));
+		memset(bitmap, 0xff, (pages + 7) / 8);
+		return true;
+	}
+	return request.any != 0;
+}
+
+
+/*!	A frame: what was written since the last one, and what the hidden half missed
+	while it was shown, goes into the hidden half, which a flip then shows. At most
+	one per vblank, as the flip waits for it. With nothing to do it just looks now
+	and then: looking at all the pages costs something, too.
+
+	app_server doesn't say when it is done drawing, but it does stop writing, as
+	drawing comes in short bursts. So that is what a frame waits for, for up to half
+	a refresh, as what is copied in the middle of a burst shows half drawn. A program
+	that draws without pause is never done, and that is where this gives up.
+*/
+static status_t
+shadow_thread(void* cookie)
+{
+	size_t pages = (size_t)cookie;
+	size_t bytes = (pages + 7) / 8;
+	uint8* written = (uint8*)malloc(bytes);
+	uint8* missed = (uint8*)malloc(bytes);
+	if (written == NULL || missed == NULL) {
+		free(written);
+		free(missed);
+		return B_NO_MEMORY;
+	}
+	memset(missed, 0xff, bytes);
+
+	const display_timing& timing = sCurrentMode.timing;
+	bigtime_t refresh = (bigtime_t)timing.h_total * timing.v_total * 1000
+		/ timing.pixel_clock;
+
+	while (!sShadowQuit) {
+		memset(written, 0, bytes);
+		bool any = add_written_pages(written, pages);
+		for (size_t i = 0; !any && i < bytes; i++)
+			any = missed[i] != 0;
+		if (!any) {
+			// Not more often than about 60 times a second: the first frame after
+			// a quiet moment may come that late, and 7200 pages take a while.
+			snooze(16000);
+			continue;
+		}
+
+		bigtime_t deadline = system_time() + refresh / 2;
+		while (system_time() < deadline) {
+			snooze(200);
+			if (!add_written_pages(written, pages))
+				break;
+		}
+
+		for (size_t i = 0; i < bytes; i++)
+			missed[i] |= written[i];
+		uint32 hidden = 1 - sShownHalf;
+		copy_shadow_pages(missed, pages, hidden);
+		flip_to_half(hidden);
+		memcpy(missed, written, bytes);
+	}
+
+	free(written);
+	free(missed);
+	return B_OK;
+}
+
+
+static void
+set_screen_shadow(bool active)
+{
+	linuxkpi_screen_shadow shadow = {};
+	shadow.active = active ? 1 : 0;
+	ioctl(sFD, LINUXKPI_IOCTL_SET_SCREEN_SHADOW, &shadow, sizeof(shadow));
+}
+
+
+static void
+stop_shadow()
+{
+	if (sShadowThread >= 0) {
+		sShadowQuit = true;
+		status_t result;
+		wait_for_thread(sShadowThread, &result);
+		sShadowThread = -1;
+	}
+}
+
+
+static void
+free_shadow()
+{
+	stop_shadow();
+	if (sShadowArea >= 0)
+		delete_area(sShadowArea);
+	sShadowArea = -1;
+	sShadow = NULL;
+	set_screen_shadow(false);
+}
+
+
+static void
+start_shadow()
+{
+	size_t size = sBuffer.pitch * sCurrentMode.timing.v_display;
+	sShadowQuit = false;
+	sShadowThread = spawn_thread(shadow_thread, "amdgpu_kms shadow",
+		B_DISPLAY_PRIORITY, (void*)(addr_t)(size / B_PAGE_SIZE));
+	if (sShadowThread >= 0)
+		resume_thread(sShadowThread);
+}
+
