+/* The pages of an area of the calling team (and its clones in other teams)
+ * written to since the last call: one bit per page, added to the bitmap. "any"
+ * says whether this call found one that wasn't set yet. */
+struct linuxkpi_dirty_pages {
+	uint64_t address;		/* in: page aligned, in the area */
+	uint64_t pages;			/* in */
+	uint64_t bitmap;		/* in: where the bits go, (pages + 7) / 8 bytes */
+	uint32_t any;			/* out: whether any is set */
+	uint32_t _reserved;
+};
