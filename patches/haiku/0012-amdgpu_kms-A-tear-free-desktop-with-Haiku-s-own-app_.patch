 	LOG("mode %s, %u Hz, frame buffer at %p, %" B_PRIu32 " bytes per row%s\n",
 		mode->name, mode->vrefresh, sBuffer.pixels, sBuffer.pitch,
-		doubled ? ", two screens high" : "");
+		doubled ? ", two screens high" : sShadow != NULL ? ", with a shadow" : "");
 	return B_OK;
 }
 
