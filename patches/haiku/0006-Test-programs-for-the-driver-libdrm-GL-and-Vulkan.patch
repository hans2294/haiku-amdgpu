diff --git a/src/bin/gltest/gltest.c b/src/bin/gltest/gltest.c
new file mode 100644
index 0000000000..53d051fdfd
--- /dev/null
+++ b/src/bin/gltest/gltest.c
@@ -0,0 +1,257 @@
+/*
+ * Copyright 2026, hans2294.
+ * Distributed under the terms of the MIT License.
+ */
+
+
+/*	OpenGL without a window: EGL on the surfaceless platform (the DRM render
+	node, through libdrm), an OpenGL 4.6 core context with no surface, a
+	triangle drawn into a framebuffer object and read back, and a fill rate
+	measurement. With radeonsi underneath, all of it runs on the GPU.
+
+	gltest
+*/
+
+
+#include <dlfcn.h>
+#include <inttypes.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <OS.h>
+
+#include <EGL/egl.h>
+#include <EGL/eglext.h>
+#include <GL/glcorearb.h>
+
+
+static int sFailures;
+
+
+static int
+check(const char *what, int ok)
+{
+	printf("%s  %s\n", ok ? "ok  " : "FAIL", what);
+	if (!ok)
+		sFailures++;
+	return ok;
+}
+
+
+#define GL_FUNCTIONS(F) \
+	F(PFNGLGETSTRINGPROC, glGetString) \
+	F(PFNGLGETINTEGERVPROC, glGetIntegerv) \
+	F(PFNGLGETERRORPROC, glGetError) \
+	F(PFNGLGENTEXTURESPROC, glGenTextures) \
+	F(PFNGLBINDTEXTUREPROC, glBindTexture) \
+	F(PFNGLTEXSTORAGE2DPROC, glTexStorage2D) \
+	F(PFNGLGENFRAMEBUFFERSPROC, glGenFramebuffers) \
+	F(PFNGLBINDFRAMEBUFFERPROC, glBindFramebuffer) \
+	F(PFNGLFRAMEBUFFERTEXTURE2DPROC, glFramebufferTexture2D) \
+	F(PFNGLCHECKFRAMEBUFFERSTATUSPROC, glCheckFramebufferStatus) \
+	F(PFNGLCREATESHADERPROC, glCreateShader) \
+	F(PFNGLSHADERSOURCEPROC, glShaderSource) \
+	F(PFNGLCOMPILESHADERPROC, glCompileShader) \
+	F(PFNGLGETSHADERIVPROC, glGetShaderiv) \
+	F(PFNGLGETSHADERINFOLOGPROC, glGetShaderInfoLog) \
+	F(PFNGLCREATEPROGRAMPROC, glCreateProgram) \
+	F(PFNGLATTACHSHADERPROC, glAttachShader) \
+	F(PFNGLLINKPROGRAMPROC, glLinkProgram) \
+	F(PFNGLGETPROGRAMIVPROC, glGetProgramiv) \
+	F(PFNGLUSEPROGRAMPROC, glUseProgram) \
+	F(PFNGLGETUNIFORMLOCATIONPROC, glGetUniformLocation) \
+	F(PFNGLUNIFORM1FPROC, glUniform1f) \
+	F(PFNGLGENVERTEXARRAYSPROC, glGenVertexArrays) \
+	F(PFNGLBINDVERTEXARRAYPROC, glBindVertexArray) \
+	F(PFNGLVIEWPORTPROC, glViewport) \
+	F(PFNGLCLEARCOLORPROC, glClearColor) \
+	F(PFNGLCLEARPROC, glClear) \
+	F(PFNGLDRAWARRAYSPROC, glDrawArrays) \
+	F(PFNGLREADPIXELSPROC, glReadPixels) \
+	F(PFNGLFINISHPROC, glFinish)
+
+#define DECLARE(type, name) static type name;
+GL_FUNCTIONS(DECLARE)
+
+
+static const char *kVertexShader =
+	"#version 460 core\n"
+	"uniform float scale;\n"
+	"out vec3 color;\n"
+	"const vec2 corners[3] = vec2[](vec2(0.0, 0.8), vec2(-0.8, -0.8),\n"
+	"	vec2(0.8, -0.8));\n"
+	"const vec3 colors[3] = vec3[](vec3(1, 0, 0), vec3(0, 1, 0),\n"
+	"	vec3(0, 0, 1));\n"
+	"void main() {\n"
+	"	gl_Position = vec4(corners[gl_VertexID] * scale, 0.0, 1.0);\n"
+	"	color = colors[gl_VertexID];\n"
+	"}\n";
+
+static const char *kFragmentShader =
+	"#version 460 core\n"
+	"in vec3 color;\n"
+	"out vec4 fragColor;\n"
+	"void main() { fragColor = vec4(color, 1.0); }\n";
+
+
+static GLuint
+compile(GLenum type, const char *source)
+{
+	GLuint shader = glCreateShader(type);
+	glShaderSource(shader, 1, &source, NULL);
+	glCompileShader(shader);
+	GLint ok = 0;
+	glGetShaderiv(shader, GL_COMPILE_STATUS, &ok);
+	if (!ok) {
+		char log[1024];
+		glGetShaderInfoLog(shader, sizeof(log), NULL, log);
+		printf("      %s\n", log);
+		return 0;
+	}
+	return shader;
+}
+
+
+int
+main(void)
+{
+	setvbuf(stdout, NULL, _IOLBF, 0);
+
+	void *library = dlopen("libEGL.so.1", RTLD_NOW | RTLD_LOCAL);
+	if (!check("dlopen libEGL.so.1", library != NULL)) {
+		printf("      %s\n", dlerror());
+		return 1;
+	}
+#define EGL_FUNCTION(type, name) type name = (type)dlsym(library, #name);
+	EGL_FUNCTION(PFNEGLGETPROCADDRESSPROC, eglGetProcAddress)
+	EGL_FUNCTION(PFNEGLGETPLATFORMDISPLAYPROC, eglGetPlatformDisplay)
+	EGL_FUNCTION(PFNEGLINITIALIZEPROC, eglInitialize)
+	EGL_FUNCTION(PFNEGLQUERYSTRINGPROC, eglQueryString)
+	EGL_FUNCTION(PFNEGLBINDAPIPROC, eglBindAPI)
+	EGL_FUNCTION(PFNEGLCREATECONTEXTPROC, eglCreateContext)
+	EGL_FUNCTION(PFNEGLMAKECURRENTPROC, eglMakeCurrent)
+	EGL_FUNCTION(PFNEGLDESTROYCONTEXTPROC, eglDestroyContext)
+	EGL_FUNCTION(PFNEGLTERMINATEPROC, eglTerminate)
+	EGL_FUNCTION(PFNEGLGETERRORPROC, eglGetError)
+
+	EGLDisplay display = eglGetPlatformDisplay(EGL_PLATFORM_SURFACELESS_MESA,
+		EGL_DEFAULT_DISPLAY, NULL);
+	EGLint major, minor;
+	if (!check("eglInitialize (surfaceless)", display != EGL_NO_DISPLAY
+			&& eglInitialize(display, &major, &minor))) {
+		printf("      EGL error %#x\n", eglGetError());
+		return 1;
+	}
+	printf("      EGL %d.%d, %s, APIs: %s\n", major, minor,
+		eglQueryString(display, EGL_VENDOR),
+		eglQueryString(display, EGL_CLIENT_APIS));
+
+	eglBindAPI(EGL_OPENGL_API);
+	const EGLint contextAttributes[] = {
+		EGL_CONTEXT_MAJOR_VERSION, 4,
+		EGL_CONTEXT_MINOR_VERSION, 6,
+		EGL_CONTEXT_OPENGL_PROFILE_MASK, EGL_CONTEXT_OPENGL_CORE_PROFILE_BIT,
+		EGL_NONE
+	};
+	EGLContext context = eglCreateContext(display, EGL_NO_CONFIG_KHR,
+		EGL_NO_CONTEXT, contextAttributes);
+	if (!check("eglCreateContext (OpenGL 4.6 core, no config)",
+			context != EGL_NO_CONTEXT)
+		|| !check("eglMakeCurrent (no surface)", eglMakeCurrent(display,
+			EGL_NO_SURFACE, EGL_NO_SURFACE, context))) {
+		printf("      EGL error %#x\n", eglGetError());
+		return 1;
+	}
+
+#define LOAD(type, name) name = (type)eglGetProcAddress(#name);
+	GL_FUNCTIONS(LOAD)
+	printf("      GL_VENDOR    %s\n", (const char *)glGetString(GL_VENDOR));
+	printf("      GL_RENDERER  %s\n", (const char *)glGetString(GL_RENDERER));
+	printf("      GL_VERSION   %s\n", (const char *)glGetString(GL_VERSION));
+	printf("      GLSL         %s\n",
+		(const char *)glGetString(GL_SHADING_LANGUAGE_VERSION));
+
+	const int size = 512;
+	GLuint texture, framebuffer, vertexArray;
+	glGenTextures(1, &texture);
+	glBindTexture(GL_TEXTURE_2D, texture);
+	glTexStorage2D(GL_TEXTURE_2D, 1, GL_RGBA8, size, size);
+	glGenFramebuffers(1, &framebuffer);
+	glBindFramebuffer(GL_FRAMEBUFFER, framebuffer);
+	glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D,
+		texture, 0);
+	check("framebuffer object complete",
+		glCheckFramebufferStatus(GL_FRAMEBUFFER) == GL_FRAMEBUFFER_COMPLETE);
+
+	GLuint vertex = compile(GL_VERTEX_SHADER, kVertexShader);
+	GLuint fragment = compile(GL_FRAGMENT_SHADER, kFragmentShader);
+	GLuint program = glCreateProgram();
+	glAttachShader(program, vertex);
+	glAttachShader(program, fragment);
+	glLinkProgram(program);
+	GLint linked = 0;
+	glGetProgramiv(program, GL_LINK_STATUS, &linked);
+	if (!check("GLSL 4.60 shaders compiled and linked", vertex && fragment
+			&& linked))
+		return 1;
+	glUseProgram(program);
+	glUniform1f(glGetUniformLocation(program, "scale"), 1.0f);
+	glGenVertexArrays(1, &vertexArray);
+	glBindVertexArray(vertexArray);
+
+	glViewport(0, 0, size, size);
+	glClearColor(0.1f, 0.1f, 0.1f, 1.0f);
+	glClear(GL_COLOR_BUFFER_BIT);
+	glDrawArrays(GL_TRIANGLES, 0, 3);
+
+	uint8_t *pixels = malloc(size * size * 4);
+	glReadPixels(0, 0, size, size, GL_RGBA, GL_UNSIGNED_BYTE, pixels);
+	// below the top corner: red; near the lower corners: green, blue;
+	// a corner of the image: the clear colour
+	const uint8_t *top = pixels + ((size * 85 / 100) * size + size / 2) * 4;
+	const uint8_t *left = pixels + ((size * 12 / 100) * size + size * 14 / 100) * 4;
+	const uint8_t *right = pixels + ((size * 12 / 100) * size + size * 86 / 100) * 4;
+	const uint8_t *corner = pixels + ((size - 4) * size + 4) * 4;
+	printf("      top %02x%02x%02x, left %02x%02x%02x, right %02x%02x%02x, "
+		"corner %02x%02x%02x\n", top[0], top[1], top[2], left[0], left[1],
+		left[2], right[0], right[1], right[2], corner[0], corner[1], corner[2]);
+	check("triangle read back with its colours", top[0] > 200 && top[1] < 60
+		&& left[1] > 200 && left[0] < 60 && right[2] > 200 && right[0] < 60
+		// 0.1 * 255 is 25.5: either rounding is right
+		&& (corner[0] == 0x19 || corner[0] == 0x1a) && corner[0] == corner[1]
+		&& glGetError() == GL_NO_ERROR);
+
+	// Fill rate: big triangles into a 4K framebuffer
+	const int big = 4096;
+	GLuint bigTexture, bigFramebuffer;
+	glGenTextures(1, &bigTexture);
+	glBindTexture(GL_TEXTURE_2D, bigTexture);
+	glTexStorage2D(GL_TEXTURE_2D, 1, GL_RGBA8, big, big);
+	glGenFramebuffers(1, &bigFramebuffer);
+	glBindFramebuffer(GL_FRAMEBUFFER, bigFramebuffer);
+	glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D,
+		bigTexture, 0);
+	glViewport(0, 0, big, big);
+	glUniform1f(glGetUniformLocation(program, "scale"), 1.25f);
+	glFinish();
+	const int draws = 2000;
+	bigtime_t start = system_time();
+	for (int i = 0; i < draws; i++)
+		glDrawArrays(GL_TRIANGLES, 0, 3);
+	glFinish();
+	double seconds = (system_time() - start) / 1000000.0;
+	// the triangle covers about 0.64 * 1.25^2 / 2 of the target... roughly
+	double pixelsPerDraw = big * (double)big * 0.5;
+	printf("      %d draws of ~%.0f Mpixels in %.3f s: ~%.0f Gpixels/s\n",
+		draws, pixelsPerDraw / 1e6, seconds,
+		draws * pixelsPerDraw / seconds / 1e9);
+	check("fill rate measured", glGetError() == GL_NO_ERROR);
+
+	free(pixels);
+	eglMakeCurrent(display, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
+	eglDestroyContext(display, context);
+	eglTerminate(display);
+	printf("%s: %d failure(s)\n", sFailures == 0 ? "PASS" : "DONE", sFailures);
+	return sFailures == 0 ? 0 : 1;
+}
