index 0000000000..a4928bc5b3
--- /dev/null
+++ b/src/bin/vsynctest/vsynctest.cpp
@@ -0,0 +1,248 @@
+/*
+ * Copyright 2026, hans2294.
+ * Distributed under the terms of the MIT License.
+ */
+
+
+/*	Checks the retrace semaphore: how often BScreen::WaitForRetrace()
+	returns, and how fast a BGLView swaps with SwapBuffers(true). Both
+	should follow the display's refresh rate. Then BGLView's direct mode in
+	a BDirectWindow: frames per second without vsync through the bitmap and
+	straight to the frame buffer, and whether the last frame is on screen.
+
+	vsynctest
+*/
+
+
+#include <Application.h>
+#include <Bitmap.h>
+#include <DirectWindow.h>
+#include <GLView.h>
+#include <Screen.h>
+#include <Window.h>
+
+#include <GL/gl.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+
+static int sFailures;
+
+
+static bool
+near_refresh(double hz, double refresh)
+{
+	return hz > refresh * 0.9 && hz < refresh * 1.1;
+}
+
+
+static double
+refresh_rate(BScreen& screen)
+{
+	display_mode mode;
+	if (screen.GetMode(&mode) != B_OK)
+		return 0;
+	return mode.timing.pixel_clock * 1000.0
+		/ (mode.timing.h_total * mode.timing.v_total);
+}
+
+
+static void
+check_pixel(BScreen& screen, BRect frame, int red, int green, int blue,
+	const char* what)
+{
+	BBitmap* shot = NULL;
+	BRect center(frame.left + 100, frame.top + 100, frame.left + 101,
+		frame.top + 101);
+	uint32 pixel = 0;
+	if (screen.GetBitmap(&shot, false, &center) == B_OK && shot != NULL)
+		pixel = *(uint32*)shot->Bits() & 0xffffff;
+	delete shot;
+	if (abs((int)(pixel >> 16) - red) <= 1
+		&& abs((int)((pixel >> 8) & 0xff) - green) <= 1
+		&& abs((int)(pixel & 0xff) - blue) <= 1)
+		printf("ok    %s (%06" B_PRIx32 ")\n", what, pixel);
+	else {
+		printf("FAIL  %s: %06" B_PRIx32 "\n", what, pixel);
+		sFailures++;
+	}
+}
+
+
+class DirectWindow : public BDirectWindow {
+public:
+	DirectWindow(BRect frame)
+		:
+		BDirectWindow(frame, "vsynctest direct", B_TITLED_WINDOW,
+			B_NOT_RESIZABLE | B_NOT_ZOOMABLE),
+		fView(NULL),
+		fStall(false)
+	{
+	}
+
+	void SetView(BGLView* view)
+	{
+		fView = view;
+	}
+
+	void StallNextConnected()
+	{
+		fStall = true;
+	}
+
+	virtual void DirectConnected(direct_buffer_info* info)
+	{
+		// Longer than app_server waits; it gives up on the window then.
+		if (fStall) {
+			fStall = false;
+			snooze(1000000);
+			return;
+		}
+		if (fView != NULL) {
+			fView->DirectConnected(info);
+			fView->EnableDirectMode(true);
+		}
+		BDirectWindow::DirectConnected(info);
+	}
+
+private:
+	BGLView* fView;
+	bool fStall;
+};
+
+
+static double
+swap_rate(BGLView* view, int frames)
+{
+	view->LockGL();
+	bigtime_t start = system_time();
+	for (int i = 0; i < frames; i++) {
+		float level = (i % 60) / 60.0f;
+		glClearColor(level, 0.2f, 1.0f - level, 1.0f);
+		glClear(GL_COLOR_BUFFER_BIT);
+		view->SwapBuffers();
+	}
+	double rate = frames * 1000000.0 / (system_time() - start);
+	view->UnlockGL();
+	return rate;
+}
+
+
+class TestApp : public BApplication {
+public:
+	TestApp()
+		:
+		BApplication("application/x-vnd.Haiku-vsynctest")
+	{
+	}
+
+	virtual void ReadyToRun()
+	{
+		BScreen screen;
+		double refresh = refresh_rate(screen);
+		printf("      display refresh %.2f Hz\n", refresh);
+
+		const int kFrames = 120;
+		status_t status = screen.WaitForRetrace(1000000);
+		bigtime_t start = system_time();
+		for (int i = 0; i < kFrames && status == B_OK; i++)
+			status = screen.WaitForRetrace(1000000);
+		double hz = kFrames * 1000000.0 / (system_time() - start);
+		if (status == B_OK && near_refresh(hz, refresh))
+			printf("ok    WaitForRetrace: %.2f Hz\n", hz);
+		else {
+			printf("FAIL  WaitForRetrace: %s, %.2f Hz\n", strerror(status), hz);
+			sFailures++;
+		}
+
+		BWindow* window = new BWindow(BRect(100, 100, 355, 355), "vsynctest",
+			B_TITLED_WINDOW, B_NOT_RESIZABLE | B_QUIT_ON_WINDOW_CLOSE);
+		BGLView* view = new BGLView(window->Bounds(), "gl", B_FOLLOW_ALL, 0,
+			BGL_RGB | BGL_DOUBLE);
+		window->AddChild(view);
+		window->Show();
+
+		view->LockGL();
+		start = system_time();
+		for (int i = 0; i < kFrames; i++) {
+			float level = (i % 60) / 60.0f;
+			glClearColor(level, 0.2f, 1.0f - level, 1.0f);
+			glClear(GL_COLOR_BUFFER_BIT);
+			view->SwapBuffers(true);
+		}
+		hz = kFrames * 1000000.0 / (system_time() - start);
+		view->UnlockGL();
+		if (near_refresh(hz, refresh))
+			printf("ok    SwapBuffers(true): %.2f fps\n", hz);
+		else {
+			printf("FAIL  SwapBuffers(true): %.2f fps\n", hz);
+			sFailures++;
+		}
+
+		const int kFastFrames = 600;
+		double bitmapRate = swap_rate(view, kFastFrames);
+		printf("      bitmap path: %.0f fps\n", bitmapRate);
+		window->Lock();
+		window->Quit();
+
+		DirectWindow* direct = new DirectWindow(BRect(400, 100, 655, 355));
+		BGLView* directView = new BGLView(direct->Bounds(), "gl", B_FOLLOW_ALL,
+			0, BGL_RGB | BGL_DOUBLE);
+		direct->SetView(directView);
+		direct->AddChild(directView);
+		direct->Show();
+		snooze(500000);
+		double directRate = swap_rate(directView, kFastFrames);
+		printf("      direct mode: %.0f fps\n", directRate);
+
+		// a known colour, then read the screen where the view is
+		directView->LockGL();
+		glClearColor(0.25f, 0.5f, 0.75f, 1.0f);
+		glClear(GL_COLOR_BUFFER_BIT);
+		directView->SwapBuffers();
+		directView->UnlockGL();
+		direct->Lock();
+		BRect frame = directView->ConvertToScreen(directView->Bounds());
+		direct->Unlock();
+		check_pixel(screen, frame, 64, 128, 191, "last frame on screen");
+
+		// app_server gives up on the window during a move: frames have to
+		// show at the new place all the same
+		direct->StallNextConnected();
+		direct->Lock();
+		direct->MoveBy(300, 200);
+		frame = directView->ConvertToScreen(directView->Bounds());
+		direct->Unlock();
+		snooze(1500000);
+		// A few frames, as a running program draws: with page flipping, the
+		// screen read looks at one of the two screens, and a frame only
+		// reaches the other with the next flip.
+		for (int i = 0; i < 5; i++) {
+			directView->LockGL();
+			glClearColor(0.75f, 0.25f, 0.5f, 1.0f);
+			glClear(GL_COLOR_BUFFER_BIT);
+			directView->SwapBuffers();
+			directView->UnlockGL();
+			snooze(50000);
+		}
+		check_pixel(screen, frame, 191, 64, 128,
+			"frame on screen after app_server gave up");
+		direct->Lock();
+		direct->Quit();
+
+		printf("%s: %d failure(s)\n", sFailures == 0 ? "PASS" : "DONE",
+			sFailures);
+		Quit();
+	}
+};
+
+
+int
+main()
+{
+	setvbuf(stdout, NULL, _IOLBF, 0);
+	TestApp app;
+	app.Run();
+	return sFailures == 0 ? 0 : 1;
+}
