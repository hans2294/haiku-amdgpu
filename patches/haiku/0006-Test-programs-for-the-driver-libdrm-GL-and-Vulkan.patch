--- /dev/null
+++ b/src/bin/vkwindow/triangle.vert
@@ -0,0 +1,15 @@
+#version 450
+// vkwindow's triangle: corners from the vertex index, turned by the push
+// constant angle, each corner its own colour
+layout(push_constant) uniform Push { float angle; float aspect; };
+layout(location = 0) out vec3 color;
+const vec2 corners[3] = vec2[](vec2(0.0, -0.8), vec2(0.7, 0.45), vec2(-0.7, 0.45));
+const vec3 colors[3] = vec3[](vec3(1.0, 0.2, 0.2), vec3(0.2, 1.0, 0.3), vec3(0.3, 0.4, 1.0));
+void main()
+{
+	vec2 p = corners[gl_VertexIndex];
+	float c = cos(angle), s = sin(angle);
+	p = vec2(c * p.x - s * p.y, s * p.x + c * p.y);
+	gl_Position = vec4(p.x / aspect, p.y, 0.0, 1.0);
+	color = colors[gl_VertexIndex];
+}
