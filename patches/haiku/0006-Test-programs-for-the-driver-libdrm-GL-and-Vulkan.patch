+SubDir HAIKU_TOP src bin amdgputest ;
+
+# Linux's DRM and amdgpu UAPI headers, unchanged, with Linux's ioctl
+# encoding from compat/sys/ioccom.h.
+SubDirSysHdrs [ FDirName $(SUBDIR) compat ] ;
+SubDirSysHdrs [ FDirName $(HAIKU_TOP) .. linux-6.12 include uapi drm ] ;
+
+Application amdgputest :
+	amdgputest.cpp
+	;
diff --git a/src/bin/amdgputest/amdgputest.cpp b/src/bin/amdgputest/amdgputest.cpp
new file mode 100644
index 0000000000..68ab8f6ffb
--- /dev/null
+++ b/src/bin/amdgputest/amdgputest.cpp
@@ -0,0 +1,426 @@
+/*
+ * Copyright 2026, hans2294.
+ * Distributed under the terms of the MIT License.
+ */
+
+
+/*!	Talks to Linux's amdgpu through /dev/dri the way libdrm does, with the
+	unchanged Linux UAPI: version, device and memory info, sensors, a
+	context, a buffer object's life (create, mapping, GPU VA map, close),
+	and a copy on the GPU: SDMA copies a VRAM buffer the CPU filled into a
+	GTT buffer, submitted with the CS ioctl and waited for with WAIT_CS.
+
+	amdgputest [/dev/dri/renderD128]
+*/
+
+
+#include <OS.h>
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <unistd.h>
+
+// The kernel tree's UAPI headers, before headers_install strips this
+#define __user
+#include <drm.h>
+#include <amdgpu_drm.h>
+
+#include "../../libs/compat/linuxkpi/include/linuxkpi/uapi.h"
+
+
+static int sFailures;
+
+
+static bool
+check(const char* what, int result)
+{
+	if (result == 0) {
+		printf("ok    %s\n", what);
+		return true;
+	}
+	printf("FAIL  %s: %s\n", what, strerror(errno));
+	sFailures++;
+	return false;
+}
+
+
+static int
+drm_ioctl(int fd, unsigned long command, void* argument)
+{
+	int result;
+	do {
+		result = ioctl(fd, command, argument);
+	} while (result == -1 && (errno == EINTR || errno == EAGAIN));
+	return result;
+}
+
+
+static int
+query_info(int fd, uint32_t query, void* buffer, uint32_t size,
+	uint32_t extra = 0)
+{
+	drm_amdgpu_info request = {};
+	request.return_pointer = (uintptr_t)buffer;
+	request.return_size = size;
+	request.query = query;
+	if (query == AMDGPU_INFO_SENSOR)
+		request.sensor_info.type = extra;
+	return drm_ioctl(fd, DRM_IOCTL_AMDGPU_INFO, &request);
+}
+
+
+static void
+test_version(int fd)
+{
+	char name[64] = {}, date[64] = {}, description[128] = {};
+	drm_version version = {};
+	version.name = name;
+	version.name_len = sizeof(name) - 1;
+	version.date = date;
+	version.date_len = sizeof(date) - 1;
+	version.desc = description;
+	version.desc_len = sizeof(description) - 1;
+	if (check("DRM_IOCTL_VERSION", drm_ioctl(fd, DRM_IOCTL_VERSION, &version)))
+		printf("      %s %d.%d.%d: %s\n", name, version.version_major,
+			version.version_minor, version.version_patchlevel, description);
+}
+
+
+static void
+test_info(int fd)
+{
+	drm_amdgpu_info_device device = {};
+	if (check("AMDGPU_INFO_DEV_INFO", query_info(fd, AMDGPU_INFO_DEV_INFO,
+			&device, sizeof(device)))) {
+		printf("      device %#x rev %#x family %u, %u SE x %u SA, %u CUs, "
+			"%u RBs\n", device.device_id, device.pci_rev, device.family,
+			device.num_shader_engines, device.num_shader_arrays_per_engine,
+			device.cu_active_number, device.num_rb_pipes);
+		printf("      engine clock %llu MHz, memory clock %llu MHz, "
+			"VRAM type %u, %u bit, wave size %u, PCIe gen %u\n",
+			(unsigned long long)device.max_engine_clock / 1000,
+			(unsigned long long)device.max_memory_clock / 1000,
+			device.vram_type, device.vram_bit_width, device.wave_front_size,
+			device.pcie_gen);
+		printf("      GPU VA %#llx - %#llx\n",
+			(unsigned long long)device.virtual_address_offset,
+			(unsigned long long)device.virtual_address_max);
+	}
+
+	drm_amdgpu_memory_info memory = {};
+	if (check("AMDGPU_INFO_MEMORY", query_info(fd, AMDGPU_INFO_MEMORY, &memory,
+			sizeof(memory)))) {
+		printf("      VRAM %llu MiB (%llu usable), CPU visible %llu MiB, "
+			"GTT %llu MiB\n",
+			(unsigned long long)memory.vram.total_heap_size >> 20,
+			(unsigned long long)memory.vram.usable_heap_size >> 20,
+			(unsigned long long)memory.cpu_accessible_vram.total_heap_size >> 20,
+			(unsigned long long)memory.gtt.total_heap_size >> 20);
+	}
+
+	drm_amdgpu_info_firmware firmware = {};
+	drm_amdgpu_info request = {};
+	request.return_pointer = (uintptr_t)&firmware;
+	request.return_size = sizeof(firmware);
+	request.query = AMDGPU_INFO_FW_VERSION;
+	request.query_fw.fw_type = AMDGPU_INFO_FW_GFX_ME;
+	if (check("AMDGPU_INFO_FW_VERSION (gfx me)",
+			drm_ioctl(fd, DRM_IOCTL_AMDGPU_INFO, &request)))
+		printf("      version %#x, feature %u\n", firmware.ver,
+			firmware.feature);
+
+	uint32_t value = 0;
+	if (check("AMDGPU_INFO_SENSOR (GPU temperature)", query_info(fd,
+			AMDGPU_INFO_SENSOR, &value, sizeof(value),
+			AMDGPU_INFO_SENSOR_GPU_TEMP)))
+		printf("      %.1f C\n", value / 1000.0);
+	if (check("AMDGPU_INFO_SENSOR (shader clock)", query_info(fd,
+			AMDGPU_INFO_SENSOR, &value, sizeof(value),
+			AMDGPU_INFO_SENSOR_GFX_SCLK)))
+		printf("      %u MHz\n", value);
+}
+
+
+static void
+test_context(int fd)
+{
+	drm_amdgpu_ctx context = {};
+	context.in.op = AMDGPU_CTX_OP_ALLOC_CTX;
+	if (!check("AMDGPU_CTX alloc", drm_ioctl(fd, DRM_IOCTL_AMDGPU_CTX,
+			&context)))
+		return;
+	uint32_t id = context.out.alloc.ctx_id;
+	printf("      context %u\n", id);
+
+	memset(&context, 0, sizeof(context));
+	context.in.op = AMDGPU_CTX_OP_FREE_CTX;
+	context.in.ctx_id = id;
+	check("AMDGPU_CTX free", drm_ioctl(fd, DRM_IOCTL_AMDGPU_CTX, &context));
+}
+
+
+static uint32_t
+create_buffer(int fd, uint64_t size, uint32_t domain, uint64_t flags,
+	const char* what)
+{
+	drm_amdgpu_gem_create create = {};
+	create.in.bo_size = size;
+	create.in.alignment = 4096;
+	create.in.domains = domain;
+	create.in.domain_flags = flags;
+	if (!check(what, drm_ioctl(fd, DRM_IOCTL_AMDGPU_GEM_CREATE, &create)))
+		return 0;
+	return create.out.handle;
+}
+
+
+static void
+close_buffer(int fd, uint32_t handle)
+{
+	drm_gem_close close = {};
+	close.handle = handle;
+	check("DRM_IOCTL_GEM_CLOSE", drm_ioctl(fd, DRM_IOCTL_GEM_CLOSE, &close));
+}
+
+
+/*!	What libdrm's amdgpu_bo_cpu_map() will do on Haiku: the buffer's fake
+	offset from GEM_MMAP, then linuxkpi's mmap stand-in.
+*/
+static void*
+map_buffer(int fd, uint32_t handle, uint64_t size, const char* what)
+{
+	drm_amdgpu_gem_mmap mmap = {};
+	mmap.in.handle = handle;
+	if (drm_ioctl(fd, DRM_IOCTL_AMDGPU_GEM_MMAP, &mmap) != 0) {
+		check(what, -1);
+		return NULL;
+	}
+
+	linuxkpi_mmap request = {};
+	request.offset = mmap.out.addr_ptr;
+	request.size = size;
+	request.flags = LINUXKPI_MMAP_READ | LINUXKPI_MMAP_WRITE;
+	if (!check(what, drm_ioctl(fd, LINUXKPI_IOCTL_MMAP, &request)))
+		return NULL;
+	area_info info;
+	if (get_area_info(request.area, &info) == B_OK)
+		printf("      area %d at %p, %zu bytes\n", (int)request.area,
+			info.address, info.size);
+	return (void*)(uintptr_t)request.address;
+}
+
+
+static void
+unmap_buffer(int fd, void* address)
+{
+	linuxkpi_munmap request = {};
+	request.address = (uintptr_t)address;
+	check("LINUXKPI_IOCTL_MUNMAP", drm_ioctl(fd, LINUXKPI_IOCTL_MUNMAP,
+		&request));
+}
+
+
+static bool
+map_gpu(int fd, uint32_t handle, uint64_t address, uint64_t size,
+	uint32_t operation)
+{
+	drm_amdgpu_gem_va va = {};
+	va.handle = handle;
+	va.operation = operation;
+	va.flags = AMDGPU_VM_PAGE_READABLE | AMDGPU_VM_PAGE_WRITEABLE
+		| AMDGPU_VM_PAGE_EXECUTABLE;
+	va.va_address = address;
+	va.map_size = size;
+	return check(operation == AMDGPU_VA_OP_MAP ? "AMDGPU_GEM_VA map"
+		: "AMDGPU_GEM_VA unmap", drm_ioctl(fd, DRM_IOCTL_AMDGPU_GEM_VA, &va));
+}
+
+
+static void
+test_mapping(int fd)
+{
+	const uint64_t size = 1 << 20;
+	uint32_t handle = create_buffer(fd, size, AMDGPU_GEM_DOMAIN_VRAM,
+		AMDGPU_GEM_CREATE_CPU_ACCESS_REQUIRED, "AMDGPU_GEM_CREATE (1 MiB VRAM)");
+	if (handle == 0)
+		return;
+
+	uint32_t* data = (uint32_t*)map_buffer(fd, handle, size,
+		"map VRAM buffer");
+	if (data != NULL) {
+		for (uint32_t i = 0; i < size / 4; i++)
+			data[i] = i * 0x9e3779b9;
+		uint32_t errors = 0;
+		for (uint32_t i = 0; i < size / 4; i++) {
+			if (data[i] != i * 0x9e3779b9)
+				errors++;
+		}
+		check("CPU write/read through the VRAM mapping",
+			errors == 0 ? 0 : (errno = EIO, -1));
+		unmap_buffer(fd, data);
+	}
+
+	if (map_gpu(fd, handle, 1ULL << 32, size, AMDGPU_VA_OP_MAP))
+		map_gpu(fd, handle, 1ULL << 32, size, AMDGPU_VA_OP_UNMAP);
+	close_buffer(fd, handle);
+}
+
+
+/*!	SDMA (v6) copies \a size bytes from VRAM to GTT. The IB is built by the
+	CPU in a third buffer, padded with NOPs to 8 dwords.
+*/
+static void
+test_sdma_copy(int fd)
+{
+	const uint64_t size = 1 << 20;
+	const uint64_t sourceVA = 0x100000000ULL, destinationVA = 0x200000000ULL,
+		ibVA = 0x300000000ULL;
+
+	drm_amdgpu_ctx context = {};
+	context.in.op = AMDGPU_CTX_OP_ALLOC_CTX;
+	if (!check("AMDGPU_CTX alloc", drm_ioctl(fd, DRM_IOCTL_AMDGPU_CTX,
+			&context)))
+		return;
+	uint32_t contextID = context.out.alloc.ctx_id;
+
+	uint32_t source = create_buffer(fd, size, AMDGPU_GEM_DOMAIN_VRAM,
+		AMDGPU_GEM_CREATE_CPU_ACCESS_REQUIRED, "create source (VRAM)");
+	uint32_t destination = create_buffer(fd, size, AMDGPU_GEM_DOMAIN_GTT, 0,
+		"create destination (GTT)");
+	uint32_t ib = create_buffer(fd, 4096, AMDGPU_GEM_DOMAIN_GTT, 0,
+		"create IB (GTT)");
+	uint32_t* sourceData = source != 0
+		? (uint32_t*)map_buffer(fd, source, size, "map source") : NULL;
+	uint32_t* destinationData = destination != 0
+		? (uint32_t*)map_buffer(fd, destination, size, "map destination")
+		: NULL;
+	uint32_t* ibData = ib != 0
+		? (uint32_t*)map_buffer(fd, ib, 4096, "map IB") : NULL;
+
+	if (sourceData != NULL && destinationData != NULL && ibData != NULL
+		&& map_gpu(fd, source, sourceVA, size, AMDGPU_VA_OP_MAP)
+		&& map_gpu(fd, destination, destinationVA, size, AMDGPU_VA_OP_MAP)
+		&& map_gpu(fd, ib, ibVA, 4096, AMDGPU_VA_OP_MAP)) {
+		for (uint32_t i = 0; i < size / 4; i++) {
+			sourceData[i] = 0xc0ffee00 ^ (i * 2654435761u);
+			destinationData[i] = 0xdeadbeef;
+		}
+
+		uint32_t count = 0;
+		ibData[count++] = 0x00000001;	// SDMA_OP_COPY, COPY_LINEAR
+		ibData[count++] = size - 1;
+		ibData[count++] = 0;
+		ibData[count++] = (uint32_t)sourceVA;
+		ibData[count++] = sourceVA >> 32;
+		ibData[count++] = (uint32_t)destinationVA;
+		ibData[count++] = destinationVA >> 32;
+		while (count % 8 != 0)
+			ibData[count++] = 0;		// SDMA_OP_NOP
+
+		drm_amdgpu_bo_list_entry buffers[3] = {
+			{ source, 0 }, { destination, 0 }, { ib, 0 } };
+		drm_amdgpu_bo_list_in bufferList = {};
+		bufferList.operation = ~0U;
+		bufferList.list_handle = ~0U;
+		bufferList.bo_number = 3;
+		bufferList.bo_info_size = sizeof(drm_amdgpu_bo_list_entry);
+		bufferList.bo_info_ptr = (uintptr_t)buffers;
+
+		drm_amdgpu_cs_chunk_ib ibChunk = {};
+		ibChunk.va_start = ibVA;
+		ibChunk.ib_bytes = count * 4;
+		ibChunk.ip_type = AMDGPU_HW_IP_DMA;
+
+		drm_amdgpu_cs_chunk chunks[2] = {};
+		chunks[0].chunk_id = AMDGPU_CHUNK_ID_BO_HANDLES;
+		chunks[0].length_dw = sizeof(bufferList) / 4;
+		chunks[0].chunk_data = (uintptr_t)&bufferList;
+		chunks[1].chunk_id = AMDGPU_CHUNK_ID_IB;
+		chunks[1].length_dw = sizeof(ibChunk) / 4;
+		chunks[1].chunk_data = (uintptr_t)&ibChunk;
+		uint64_t chunkPointers[2] = { (uintptr_t)&chunks[0],
+			(uintptr_t)&chunks[1] };
+
+		drm_amdgpu_cs submission = {};
+		submission.in.ctx_id = contextID;
+		submission.in.num_chunks = 2;
+		submission.in.chunks = (uintptr_t)chunkPointers;
+		bigtime_t start = system_time();
+		if (check("AMDGPU_CS (SDMA copy, 1 MiB)", drm_ioctl(fd,
+				DRM_IOCTL_AMDGPU_CS, &submission))) {
+			printf("      sequence %llu\n",
+				(unsigned long long)submission.out.handle);
+
+			drm_amdgpu_wait_cs wait = {};
+			wait.in.handle = submission.out.handle;
+			wait.in.timeout = (system_time() + 5000000) * 1000;
+				// absolute, on the same clock as system_time()
+			wait.in.ip_type = AMDGPU_HW_IP_DMA;
+			wait.in.ctx_id = contextID;
+			if (check("AMDGPU_WAIT_CS", drm_ioctl(fd, DRM_IOCTL_AMDGPU_WAIT_CS,
+					&wait))) {
+				printf("      status %llu after %lld us\n",
+					(unsigned long long)wait.out.status,
+					(long long)(system_time() - start));
+				uint32_t errors = 0;
+				for (uint32_t i = 0; i < size / 4; i++) {
+					if (destinationData[i] != (0xc0ffee00 ^ (i * 2654435761u)))
+						errors++;
+				}
+				if (errors != 0)
+					printf("      %u of %u words differ, first %#x\n", errors,
+						(uint32_t)(size / 4), destinationData[0]);
+				check("GPU copy arrived in system memory",
+					errors == 0 && wait.out.status == 0 ? 0 : (errno = EIO, -1));
+			}
+		}
+
+		map_gpu(fd, ib, ibVA, 4096, AMDGPU_VA_OP_UNMAP);
+		map_gpu(fd, destination, destinationVA, size, AMDGPU_VA_OP_UNMAP);
+		map_gpu(fd, source, sourceVA, size, AMDGPU_VA_OP_UNMAP);
+	}
+
+	if (ibData != NULL)
+		unmap_buffer(fd, ibData);
+	if (destinationData != NULL)
+		unmap_buffer(fd, destinationData);
+	if (sourceData != NULL)
+		unmap_buffer(fd, sourceData);
+	if (ib != 0)
+		close_buffer(fd, ib);
+	if (destination != 0)
+		close_buffer(fd, destination);
+	if (source != 0)
+		close_buffer(fd, source);
+
+	memset(&context, 0, sizeof(context));
+	context.in.op = AMDGPU_CTX_OP_FREE_CTX;
+	context.in.ctx_id = contextID;
+	check("AMDGPU_CTX free", drm_ioctl(fd, DRM_IOCTL_AMDGPU_CTX, &context));
+}
+
+
+int
+main(int argc, char** argv)
+{
+	const char* path = argc > 1 ? argv[1] : "/dev/dri/renderD128";
+	int fd = open(path, O_RDWR | O_CLOEXEC);
+	if (fd < 0) {
+		printf("FAIL  open %s: %s\n", path, strerror(errno));
+		return 1;
+	}
+	printf("ok    open %s\n", path);
+
+	test_version(fd);
+	test_info(fd);
+	test_context(fd);
+	test_mapping(fd);
+	test_sdma_copy(fd);
+
+	close(fd);
+	printf("%s: %d failure(s)\n", sFailures == 0 ? "PASS" : "DONE", sFailures);
+	return sFailures == 0 ? 0 : 1;
+}
diff --git a/src/bin/amdgputest/compat/sys/ioccom.h b/src/bin/amdgputest/compat/sys/ioccom.h
new file mode 100644
index 0000000000..d21529dd01
--- /dev/null
+++ b/src/bin/amdgputest/compat/sys/ioccom.h
@@ -0,0 +1,31 @@
+/*
+ * Copyright 2026, hans2294.
+ * Distributed under the terms of the MIT License.
+ */
+#ifndef _AMDGPUTEST_SYS_IOCCOM_H
+#define _AMDGPUTEST_SYS_IOCCOM_H
+
+/* Linux's ioctl encoding, which Linux's DRM in linuxkpi decodes: number,
+ * type, size and direction in one 32 bit command. Linux's uapi drm.h
+ * includes this on systems that are not Linux. */
+#define _IOC_NRBITS		8
+#define _IOC_TYPEBITS	8
+#define _IOC_SIZEBITS	14
+#define _IOC_NRSHIFT	0
+#define _IOC_TYPESHIFT	(_IOC_NRSHIFT + _IOC_NRBITS)
+#define _IOC_SIZESHIFT	(_IOC_TYPESHIFT + _IOC_TYPEBITS)
+#define _IOC_DIRSHIFT	(_IOC_SIZESHIFT + _IOC_SIZEBITS)
+#define _IOC_NONE		0U
+#define _IOC_WRITE		1U
+#define _IOC_READ		2U
+
+#define _IOC(dir, type, nr, size) \
+	(((dir) << _IOC_DIRSHIFT) | ((type) << _IOC_TYPESHIFT) \
+		| ((nr) << _IOC_NRSHIFT) | ((size) << _IOC_SIZESHIFT))
+#define _IO(type, nr)			_IOC(_IOC_NONE, (type), (nr), 0)
+#define _IOR(type, nr, t)		_IOC(_IOC_READ, (type), (nr), sizeof(t))
+#define _IOW(type, nr, t)		_IOC(_IOC_WRITE, (type), (nr), sizeof(t))
+#define _IOWR(type, nr, t)		_IOC(_IOC_READ | _IOC_WRITE, (type), (nr), \
+	sizeof(t))
+
+#endif
