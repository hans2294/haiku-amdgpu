diff --git a/src/bin/tearingtest/tearingtest.cpp b/src/bin/tearingtest/tearingtest.cpp
new file mode 100644
index 0000000000..2778c72a87
--- /dev/null
+++ b/src/bin/tearingtest/tearingtest.cpp
@@ -0,0 +1,91 @@
+/*
+ * Copyright 2026, hans2294.
+ * Distributed under the terms of the MIT License.
+ */
+
+
+/*	Material for spotting tearing: a window at (100, 100) whose 800x600
+	view turns black and white as fast as app_server draws it. On a screen
+	that tears, single frames show both; captured from the card's output,
+	tear-free frames are one or the other all over.
+
+	tearingtest [seconds]    (default 10)
+*/
+
+
+#include <Application.h>
+#include <View.h>
+#include <Window.h>
+
+#include <OS.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+
+class FlashWindow : public BWindow {
+public:
+	FlashWindow()
+		: BWindow(BRect(100, 100, 899, 699), "tearingtest", B_TITLED_WINDOW,
+			B_NOT_RESIZABLE | B_NOT_ZOOMABLE)
+	{
+		fView = new BView(Bounds(), "flash", B_FOLLOW_ALL, 0);
+		fView->SetViewColor(B_TRANSPARENT_COLOR);
+		AddChild(fView);
+	}
+
+	BView* fView;
+};
+
+
+class FlashApp : public BApplication {
+public:
+	FlashApp(bigtime_t duration)
+		: BApplication("application/x-vnd.linuxkpi-tearingtest"),
+		  fDuration(duration) {}
+
+	void ReadyToRun()
+	{
+		fWindow = new FlashWindow();
+		fWindow->Show();
+		thread_id thread = spawn_thread(_Flash, "flash", B_NORMAL_PRIORITY,
+			this);
+		resume_thread(thread);
+	}
+
+private:
+	static int32 _Flash(void* self)
+	{
+		FlashApp* app = (FlashApp*)self;
+		snooze(500000);
+		bigtime_t start = system_time();
+		uint32 fills = 0;
+		while (system_time() - start < app->fDuration) {
+			if (!app->fWindow->Lock())
+				break;
+			BView* view = app->fWindow->fView;
+			view->SetHighColor(fills % 2 == 0 ? 0 : 255, fills % 2 == 0 ? 0
+				: 255, fills % 2 == 0 ? 0 : 255);
+			view->FillRect(view->Bounds());
+			view->Sync();
+			app->fWindow->Unlock();
+			fills++;
+		}
+		printf("%" B_PRIu32 " fills in %.1f s\n", fills,
+			(system_time() - start) / 1000000.0);
+		app->PostMessage(B_QUIT_REQUESTED);
+		return 0;
+	}
+
+	bigtime_t fDuration;
+	FlashWindow* fWindow;
+};
+
+
+int
+main(int argc, char** argv)
+{
+	setvbuf(stdout, NULL, _IOLBF, 0);
+	FlashApp app((argc > 1 ? atof(argv[1]) : 10) * 1000000);
+	app.Run();
+	return 0;
+}
