+
+/*!	Hands what BDirectWindow::DirectConnected() says on to Vulkan once the
+	device and surface exist, the last word first; until then it keeps it.
+*/
+class DirectForwarder {
+public:
+	DirectForwarder() : fLock("direct forwarder") {}
+	~DirectForwarder() { free(fLast); }
+
+	void Connected(direct_buffer_info* info)
+	{
+		BAutolock _(fLock);
+		size_t size = sizeof(direct_buffer_info)
+			+ (info->clip_list_count > 0 ? info->clip_list_count - 1 : 0)
+				* sizeof(clipping_rect);
+		direct_buffer_info* copy = (direct_buffer_info*)realloc(fLast, size);
+		if (copy != NULL) {
+			memcpy(copy, info, size);
+			fLast = copy;
+		}
+		if (fForward != NULL)
+			fForward(fDevice, fView, info);
+	}
+
+	void Attach(PFN_vkDirectConnectedHAIKU forward, VkDevice device,
+		BView* view)
+	{
+		BAutolock _(fLock);
+		fForward = forward;
+		fDevice = device;
+		fView = view;
+		if (fForward != NULL && fLast != NULL)
+			fForward(fDevice, fView, fLast);
+	}
+
+	void Detach()
+	{
+		BAutolock _(fLock);
+		fForward = NULL;
+	}
+
+private:
+	BLocker fLock;
+	direct_buffer_info* fLast = NULL;
+	PFN_vkDirectConnectedHAIKU fForward = NULL;
+	VkDevice fDevice = VK_NULL_HANDLE;
+	BView* fView = NULL;
+};
+
+
+/*!	All the Vulkan, on a thread of its own: Haiku's window thread must stay
+	free to draw what presenting hands it.
+*/
+class Renderer {
+public:
+	Renderer(BView* view, bigtime_t duration, VkPresentModeKHR presentMode,
+		DirectForwarder* forwarder)
+		: fView(view), fDuration(duration), fPresentMode(presentMode),
+		  fForwarder(forwarder), fQuit(false), fResult(1) {}
+
+	thread_id Start()
+	{
+		fThread = spawn_thread(_Run, "vulkan renderer", B_DISPLAY_PRIORITY,
+			this);
+		resume_thread(fThread);
+		return fThread;
+	}
+
+	void Stop()
+	{
+		fQuit = true;
+		status_t result;
+		wait_for_thread(fThread, &result);
+	}
+
+	int Result() const { return fResult; }
+
+private:
+	static int32 _Run(void* self)
+	{
+		Renderer* renderer = (Renderer*)self;
+		renderer->fResult = renderer->Run();
+		if (renderer->fDuration > 0)
+			be_app->PostMessage(B_QUIT_REQUESTED);
+		return 0;
+	}
+
+	int Run();
+	bool CreateInstance();
+	bool CreateDevice();
+	bool CreatePipeline();
+	void Destroy();
+
+	BView* fView;
+	bigtime_t fDuration;
+	VkPresentModeKHR fPresentMode;
+	DirectForwarder* fForwarder;
+	volatile bool fQuit;
+	int fResult;
+	thread_id fThread;
+
+	VkInstance fInstance = VK_NULL_HANDLE;
+	VkSurfaceKHR fSurface = VK_NULL_HANDLE;
+	VkPhysicalDevice fPhysicalDevice = VK_NULL_HANDLE;
+	VkDevice fDevice = VK_NULL_HANDLE;
+	VkQueue fQueue = VK_NULL_HANDLE;
+	uint32_t fFamily = 0;
+	VkSwapchainKHR fSwapchain = VK_NULL_HANDLE;
+	VkFormat fFormat = VK_FORMAT_UNDEFINED;
+	VkExtent2D fExtent = {};
+	uint32_t fImageCount = 0;
+	VkImage fImages[kMaxImages] = {};
+	VkImageView fViews[kMaxImages] = {};
+	VkFramebuffer fFramebuffers[kMaxImages] = {};
+	VkRenderPass fRenderPass = VK_NULL_HANDLE;
+	VkPipelineLayout fLayout = VK_NULL_HANDLE;
+	VkPipeline fPipeline = VK_NULL_HANDLE;
+	VkCommandPool fCommandPool = VK_NULL_HANDLE;
+	VkCommandBuffer fCommands = VK_NULL_HANDLE;
+	VkSemaphore fAcquired = VK_NULL_HANDLE;
+	VkSemaphore fRendered[kMaxImages] = {};
+	VkFence fFrameDone = VK_NULL_HANDLE;
+};
+
+
+bool
+Renderer::CreateInstance()
+{
+	void* loader = dlopen("libvulkan.so.1", RTLD_NOW | RTLD_LOCAL);
+	if (loader == NULL) {
+		printf("FAIL  dlopen libvulkan.so.1: %s\n", dlerror());
+		return false;
+	}
+	vkGetInstanceProcAddr = (PFN_vkGetInstanceProcAddr)dlsym(loader,
+		"vkGetInstanceProcAddr");
+	PFN_vkCreateInstance vkCreateInstance = (PFN_vkCreateInstance)
+		vkGetInstanceProcAddr(NULL, "vkCreateInstance");
+
+	const char* extensions[] = {
+		VK_KHR_SURFACE_EXTENSION_NAME,
+		VK_EXT_HEADLESS_SURFACE_EXTENSION_NAME,
+	};
+	VkApplicationInfo application = {};
+	application.sType = VK_STRUCTURE_TYPE_APPLICATION_INFO;
+	application.pApplicationName = "vkwindow";
+	application.apiVersion = VK_API_VERSION_1_3;
+	VkInstanceCreateInfo instanceInfo = {};
+	instanceInfo.sType = VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO;
+	instanceInfo.pApplicationInfo = &application;
+	instanceInfo.enabledExtensionCount = 2;
+	instanceInfo.ppEnabledExtensionNames = extensions;
+	if (!check("vkCreateInstance", vkCreateInstance(&instanceInfo, NULL,
+			&fInstance)))
+		return false;
+
+#define LOAD_INSTANCE(name) \
+	name = (PFN_##name)vkGetInstanceProcAddr(fInstance, #name);
+	INSTANCE_FUNCTIONS(LOAD_INSTANCE)
+
+	// The view rides along with a headless surface
+	VkHaikuViewSurfaceCreateInfoHAIKU haikuInfo = {};
+	haikuInfo.sType = VK_STRUCTURE_TYPE_HAIKU_VIEW_SURFACE_CREATE_INFO_HAIKU;
+	haikuInfo.view = fView;
+	VkHeadlessSurfaceCreateInfoEXT surfaceInfo = {};
+	surfaceInfo.sType = VK_STRUCTURE_TYPE_HEADLESS_SURFACE_CREATE_INFO_EXT;
+	surfaceInfo.pNext = &haikuInfo;
+	return check("vkCreateHeadlessSurfaceEXT (Haiku view)",
+		vkCreateHeadlessSurfaceEXT(fInstance, &surfaceInfo, NULL, &fSurface));
+}
+
+
+bool
+Renderer::CreateDevice()
+{
+	uint32_t count = 1;
+	VkResult result = vkEnumeratePhysicalDevices(fInstance, &count,
+		&fPhysicalDevice);
+	if (count == 0 || (result != VK_SUCCESS && result != VK_INCOMPLETE)) {
+		printf("FAIL  no Vulkan device\n");
+		return false;
+	}
+	VkPhysicalDeviceProperties properties;
+	vkGetPhysicalDeviceProperties(fPhysicalDevice, &properties);
+	printf("ok    device: %s\n", properties.deviceName);
+
+	uint32_t familyCount = 8;
+	VkQueueFamilyProperties families[8];
+	vkGetPhysicalDeviceQueueFamilyProperties(fPhysicalDevice, &familyCount,
+		families);
+	fFamily = UINT32_MAX;
+	for (uint32_t i = 0; i < familyCount && fFamily == UINT32_MAX; i++) {
+		VkBool32 present = VK_FALSE;
+		vkGetPhysicalDeviceSurfaceSupportKHR(fPhysicalDevice, i, fSurface,
+			&present);
+		if ((families[i].queueFlags & VK_QUEUE_GRAPHICS_BIT) && present)
+			fFamily = i;
+	}
+	if (fFamily == UINT32_MAX) {
+		printf("FAIL  no graphics queue that can present\n");
+		return false;
+	}
+
+	float priority = 1.0f;
+	VkDeviceQueueCreateInfo queueInfo = {};
+	queueInfo.sType = VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO;
+	queueInfo.queueFamilyIndex = fFamily;
+	queueInfo.queueCount = 1;
+	queueInfo.pQueuePriorities = &priority;
+	const char* extensions[] = { VK_KHR_SWAPCHAIN_EXTENSION_NAME };
+	VkDeviceCreateInfo deviceInfo = {};
+	deviceInfo.sType = VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO;
+	deviceInfo.queueCreateInfoCount = 1;
+	deviceInfo.pQueueCreateInfos = &queueInfo;
+	deviceInfo.enabledExtensionCount = 1;
+	deviceInfo.ppEnabledExtensionNames = extensions;
+	if (!check("vkCreateDevice", vkCreateDevice(fPhysicalDevice, &deviceInfo,
+			NULL, &fDevice)))
+		return false;
+
+#define LOAD_DEVICE(name) name = (PFN_##name)vkGetDeviceProcAddr(fDevice, #name);
+	DEVICE_FUNCTIONS(LOAD_DEVICE)
+	vkGetDeviceQueue(fDevice, fFamily, 0, &fQueue);
+
+	VkSurfaceCapabilitiesKHR caps;
+	if (!check("vkGetPhysicalDeviceSurfaceCapabilitiesKHR",
+			vkGetPhysicalDeviceSurfaceCapabilitiesKHR(fPhysicalDevice, fSurface,
+				&caps)))
+		return false;
+	fExtent = caps.currentExtent;
+	uint32_t formatCount = 4;
+	VkSurfaceFormatKHR formats[4];
+	vkGetPhysicalDeviceSurfaceFormatsKHR(fPhysicalDevice, fSurface,
+		&formatCount, formats);
+	fFormat = formats[0].format;
+	printf("ok    surface: %ux%u, format %d, at least %u images\n",
+		fExtent.width, fExtent.height, fFormat, caps.minImageCount);
+
+	VkSwapchainCreateInfoKHR swapchainInfo = {};
+	swapchainInfo.sType = VK_STRUCTURE_TYPE_SWAPCHAIN_CREATE_INFO_KHR;
+	swapchainInfo.surface = fSurface;
+	swapchainInfo.minImageCount = caps.minImageCount;
+	swapchainInfo.imageFormat = fFormat;
+	swapchainInfo.imageColorSpace = formats[0].colorSpace;
+	swapchainInfo.imageExtent = fExtent;
+	swapchainInfo.imageArrayLayers = 1;
+	swapchainInfo.imageUsage = VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT;
+	swapchainInfo.preTransform = VK_SURFACE_TRANSFORM_IDENTITY_BIT_KHR;
+	swapchainInfo.compositeAlpha = VK_COMPOSITE_ALPHA_OPAQUE_BIT_KHR;
+	swapchainInfo.presentMode = fPresentMode;
+	swapchainInfo.clipped = VK_TRUE;
+	if (!check("vkCreateSwapchainKHR", vkCreateSwapchainKHR(fDevice,
+			&swapchainInfo, NULL, &fSwapchain)))
+		return false;
+	fImageCount = kMaxImages;
+	vkGetSwapchainImagesKHR(fDevice, fSwapchain, &fImageCount, fImages);
+	printf("ok    swapchain with %u images, %s\n", fImageCount,
+		fPresentMode == VK_PRESENT_MODE_FIFO_KHR ? "FIFO" : "IMMEDIATE");
+
+	if (fForwarder != NULL) {
+		PFN_vkDirectConnectedHAIKU directConnected
+			= (PFN_vkDirectConnectedHAIKU)vkGetDeviceProcAddr(fDevice,
+				"vkDirectConnectedHAIKU");
+		if (!check("vkGetDeviceProcAddr(vkDirectConnectedHAIKU)",
+				directConnected != NULL ? VK_SUCCESS
+					: VK_ERROR_EXTENSION_NOT_PRESENT))
+			return false;
+		fForwarder->Attach(directConnected, fDevice, fView);
+	}
+	return true;
+}
+
+
+bool
+Renderer::CreatePipeline()
+{
+	VkAttachmentDescription attachment = {};
+	attachment.format = fFormat;
+	attachment.samples = VK_SAMPLE_COUNT_1_BIT;
+	attachment.loadOp = VK_ATTACHMENT_LOAD_OP_CLEAR;
+	attachment.storeOp = VK_ATTACHMENT_STORE_OP_STORE;
+	attachment.stencilLoadOp = VK_ATTACHMENT_LOAD_OP_DONT_CARE;
+	attachment.stencilStoreOp = VK_ATTACHMENT_STORE_OP_DONT_CARE;
+	attachment.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+	attachment.finalLayout = VK_IMAGE_LAYOUT_PRESENT_SRC_KHR;
+	VkAttachmentReference colorReference = {
+		0, VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL };
+	VkSubpassDescription subpass = {};
+	subpass.pipelineBindPoint = VK_PIPELINE_BIND_POINT_GRAPHICS;
+	subpass.colorAttachmentCount = 1;
+	subpass.pColorAttachments = &colorReference;
+	VkSubpassDependency dependency = {};
+	dependency.srcSubpass = VK_SUBPASS_EXTERNAL;
+	dependency.dstSubpass = 0;
+	dependency.srcStageMask = VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT;
+	dependency.dstStageMask = VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT;
+	dependency.dstAccessMask = VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT;
+	VkRenderPassCreateInfo renderPassInfo = {};
+	renderPassInfo.sType = VK_STRUCTURE_TYPE_RENDER_PASS_CREATE_INFO;
+	renderPassInfo.attachmentCount = 1;
+	renderPassInfo.pAttachments = &attachment;
+	renderPassInfo.subpassCount = 1;
+	renderPassInfo.pSubpasses = &subpass;
+	renderPassInfo.dependencyCount = 1;
+	renderPassInfo.pDependencies = &dependency;
+	if (!check("vkCreateRenderPass", vkCreateRenderPass(fDevice,
+			&renderPassInfo, NULL, &fRenderPass)))
+		return false;
+
+	for (uint32_t i = 0; i < fImageCount; i++) {
+		VkImageViewCreateInfo viewInfo = {};
+		viewInfo.sType = VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO;
+		viewInfo.image = fImages[i];
+		viewInfo.viewType = VK_IMAGE_VIEW_TYPE_2D;
+		viewInfo.format = fFormat;
+		viewInfo.subresourceRange.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+		viewInfo.subresourceRange.levelCount = 1;
+		viewInfo.subresourceRange.layerCount = 1;
+		if (!check("vkCreateImageView", vkCreateImageView(fDevice, &viewInfo,
+				NULL, &fViews[i])))
+			return false;
+		VkFramebufferCreateInfo framebufferInfo = {};
+		framebufferInfo.sType = VK_STRUCTURE_TYPE_FRAMEBUFFER_CREATE_INFO;
+		framebufferInfo.renderPass = fRenderPass;
+		framebufferInfo.attachmentCount = 1;
+		framebufferInfo.pAttachments = &fViews[i];
+		framebufferInfo.width = fExtent.width;
+		framebufferInfo.height = fExtent.height;
+		framebufferInfo.layers = 1;
+		if (!check("vkCreateFramebuffer", vkCreateFramebuffer(fDevice,
+				&framebufferInfo, NULL, &fFramebuffers[i])))
+			return false;
+	}
+
+	VkShaderModule vertex, fragment;
+	VkShaderModuleCreateInfo moduleInfo = {};
+	moduleInfo.sType = VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO;
+	moduleInfo.codeSize = sizeof(kTriangle_vert);
+	moduleInfo.pCode = kTriangle_vert;
+	vkCreateShaderModule(fDevice, &moduleInfo, NULL, &vertex);
+	moduleInfo.codeSize = sizeof(kTriangle_frag);
+	moduleInfo.pCode = kTriangle_frag;
+	vkCreateShaderModule(fDevice, &moduleInfo, NULL, &fragment);
+
+	VkPushConstantRange push = { VK_SHADER_STAGE_VERTEX_BIT, 0,
+		2 * sizeof(float) };
+	VkPipelineLayoutCreateInfo layoutInfo = {};
+	layoutInfo.sType = VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO;
+	layoutInfo.pushConstantRangeCount = 1;
+	layoutInfo.pPushConstantRanges = &push;
+	vkCreatePipelineLayout(fDevice, &layoutInfo, NULL, &fLayout);
+
+	VkPipelineShaderStageCreateInfo stages[2] = {};
+	stages[0].sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO;
+	stages[0].stage = VK_SHADER_STAGE_VERTEX_BIT;
+	stages[0].module = vertex;
+	stages[0].pName = "main";
+	stages[1].sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO;
+	stages[1].stage = VK_SHADER_STAGE_FRAGMENT_BIT;
+	stages[1].module = fragment;
+	stages[1].pName = "main";
+	VkPipelineVertexInputStateCreateInfo vertexInput = {};
+	vertexInput.sType = VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO;
+	VkPipelineInputAssemblyStateCreateInfo assembly = {};
+	assembly.sType = VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO;
+	assembly.topology = VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST;
+	VkPipelineViewportStateCreateInfo viewport = {};
+	viewport.sType = VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO;
+	viewport.viewportCount = 1;
+	viewport.scissorCount = 1;
+	VkPipelineRasterizationStateCreateInfo raster = {};
+	raster.sType = VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO;
+	raster.polygonMode = VK_POLYGON_MODE_FILL;
+	raster.cullMode = VK_CULL_MODE_NONE;
+	raster.lineWidth = 1.0f;
+	VkPipelineMultisampleStateCreateInfo multisample = {};
+	multisample.sType = VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO;
+	multisample.rasterizationSamples = VK_SAMPLE_COUNT_1_BIT;
+	VkPipelineColorBlendAttachmentState blendAttachment = {};
+	blendAttachment.colorWriteMask = 0xf;
+	VkPipelineColorBlendStateCreateInfo blend = {};
+	blend.sType = VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO;
+	blend.attachmentCount = 1;
+	blend.pAttachments = &blendAttachment;
+	VkDynamicState dynamicStates[] = { VK_DYNAMIC_STATE_VIEWPORT,
+		VK_DYNAMIC_STATE_SCISSOR };
+	VkPipelineDynamicStateCreateInfo dynamic = {};
+	dynamic.sType = VK_STRUCTURE_TYPE_PIPELINE_DYNAMIC_STATE_CREATE_INFO;
+	dynamic.dynamicStateCount = 2;
+	dynamic.pDynamicStates = dynamicStates;
+	VkGraphicsPipelineCreateInfo pipelineInfo = {};
+	pipelineInfo.sType = VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO;
+	pipelineInfo.stageCount = 2;
+	pipelineInfo.pStages = stages;
+	pipelineInfo.pVertexInputState = &vertexInput;
+	pipelineInfo.pInputAssemblyState = &assembly;
+	pipelineInfo.pViewportState = &viewport;
+	pipelineInfo.pRasterizationState = &raster;
+	pipelineInfo.pMultisampleState = &multisample;
+	pipelineInfo.pColorBlendState = &blend;
+	pipelineInfo.pDynamicState = &dynamic;
+	pipelineInfo.layout = fLayout;
+	pipelineInfo.renderPass = fRenderPass;
+	bool ok = check("vkCreateGraphicsPipelines", vkCreateGraphicsPipelines(
+		fDevice, VK_NULL_HANDLE, 1, &pipelineInfo, NULL, &fPipeline));
+	vkDestroyShaderModule(fDevice, vertex, NULL);
+	vkDestroyShaderModule(fDevice, fragment, NULL);
+	if (!ok)
+		return false;
+
+	VkCommandPoolCreateInfo poolInfo = {};
+	poolInfo.sType = VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO;
+	poolInfo.flags = VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT;
+	poolInfo.queueFamilyIndex = fFamily;
+	vkCreateCommandPool(fDevice, &poolInfo, NULL, &fCommandPool);
+	VkCommandBufferAllocateInfo commandsInfo = {};
+	commandsInfo.sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO;
+	commandsInfo.commandPool = fCommandPool;
+	commandsInfo.level = VK_COMMAND_BUFFER_LEVEL_PRIMARY;
+	commandsInfo.commandBufferCount = 1;
+	vkAllocateCommandBuffers(fDevice, &commandsInfo, &fCommands);
+
+	VkSemaphoreCreateInfo semaphoreInfo = {};
+	semaphoreInfo.sType = VK_STRUCTURE_TYPE_SEMAPHORE_CREATE_INFO;
+	vkCreateSemaphore(fDevice, &semaphoreInfo, NULL, &fAcquired);
+	for (uint32_t i = 0; i < fImageCount; i++)
+		vkCreateSemaphore(fDevice, &semaphoreInfo, NULL, &fRendered[i]);
+	VkFenceCreateInfo fenceInfo = {};
+	fenceInfo.sType = VK_STRUCTURE_TYPE_FENCE_CREATE_INFO;
+	fenceInfo.flags = VK_FENCE_CREATE_SIGNALED_BIT;
+	vkCreateFence(fDevice, &fenceInfo, NULL, &fFrameDone);
+	printf("ok    render pass, pipeline, command buffer\n");
+	return true;
+}
+
+
+int
+Renderer::Run()
+{
+	if (!CreateInstance() || !CreateDevice() || !CreatePipeline()) {
+		Destroy();
+		return 1;
+	}
+
+	bigtime_t start = system_time();
+	bigtime_t lastReport = start;
+	uint32_t frames = 0, framesSinceReport = 0;
+	int result = 0;
+	while (!fQuit && (fDuration <= 0 || system_time() - start < fDuration)) {
+		vkWaitForFences(fDevice, 1, &fFrameDone, VK_TRUE, UINT64_MAX);
+		vkResetFences(fDevice, 1, &fFrameDone);
+
+		uint32_t index;
+		VkResult acquired = vkAcquireNextImageKHR(fDevice, fSwapchain,
+			UINT64_MAX, fAcquired, VK_NULL_HANDLE, &index);
+		if (acquired != VK_SUCCESS && acquired != VK_SUBOPTIMAL_KHR) {
+			check("vkAcquireNextImageKHR", acquired);
+			result = 1;
+			break;
+		}
+
+		float seconds = (system_time() - start) / 1000000.0f;
+		VkClearValue clear;
+		clear.color.float32[0] = 0.10f + 0.08f * sinf(seconds * 0.7f);
+		clear.color.float32[1] = 0.12f;
+		clear.color.float32[2] = 0.20f + 0.10f * sinf(seconds * 0.5f + 1.0f);
+		clear.color.float32[3] = 1.0f;
+		float push[2] = { seconds * 1.2f,
+			(float)fExtent.width / (float)fExtent.height };
+
+		vkResetCommandBuffer(fCommands, 0);
+		VkCommandBufferBeginInfo beginInfo = {};
+		beginInfo.sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO;
+		beginInfo.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+		vkBeginCommandBuffer(fCommands, &beginInfo);
+		VkRenderPassBeginInfo passInfo = {};
+		passInfo.sType = VK_STRUCTURE_TYPE_RENDER_PASS_BEGIN_INFO;
+		passInfo.renderPass = fRenderPass;
+		passInfo.framebuffer = fFramebuffers[index];
+		passInfo.renderArea.extent = fExtent;
+		passInfo.clearValueCount = 1;
+		passInfo.pClearValues = &clear;
+		vkCmdBeginRenderPass(fCommands, &passInfo, VK_SUBPASS_CONTENTS_INLINE);
+		vkCmdBindPipeline(fCommands, VK_PIPELINE_BIND_POINT_GRAPHICS, fPipeline);
+		VkViewport viewport = { 0, 0, (float)fExtent.width,
+			(float)fExtent.height, 0, 1 };
+		VkRect2D scissor = { { 0, 0 }, fExtent };
+		vkCmdSetViewport(fCommands, 0, 1, &viewport);
+		vkCmdSetScissor(fCommands, 0, 1, &scissor);
+		vkCmdPushConstants(fCommands, fLayout, VK_SHADER_STAGE_VERTEX_BIT, 0,
+			sizeof(push), push);
+		vkCmdDraw(fCommands, 3, 1, 0, 0);
+		vkCmdEndRenderPass(fCommands);
+		vkEndCommandBuffer(fCommands);
+
+		VkPipelineStageFlags waitStage
+			= VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT;
+		VkSubmitInfo submit = {};
+		submit.sType = VK_STRUCTURE_TYPE_SUBMIT_INFO;
+		submit.waitSemaphoreCount = 1;
+		submit.pWaitSemaphores = &fAcquired;
+		submit.pWaitDstStageMask = &waitStage;
+		submit.commandBufferCount = 1;
+		submit.pCommandBuffers = &fCommands;
+		submit.signalSemaphoreCount = 1;
+		submit.pSignalSemaphores = &fRendered[index];
+		if (!check("vkQueueSubmit", vkQueueSubmit(fQueue, 1, &submit,
+				fFrameDone))) {
+			result = 1;
+			break;
+		}
+
+		VkPresentInfoKHR presentInfo = {};
+		presentInfo.sType = VK_STRUCTURE_TYPE_PRESENT_INFO_KHR;
+		presentInfo.waitSemaphoreCount = 1;
+		presentInfo.pWaitSemaphores = &fRendered[index];
+		presentInfo.swapchainCount = 1;
+		presentInfo.pSwapchains = &fSwapchain;
+		presentInfo.pImageIndices = &index;
+		VkResult presented = vkQueuePresentKHR(fQueue, &presentInfo);
+		if (presented != VK_SUCCESS && presented != VK_SUBOPTIMAL_KHR) {
+			// a closed window ends it
+			if (presented != VK_ERROR_SURFACE_LOST_KHR || !fQuit) {
+				check("vkQueuePresentKHR", presented);
+				result = presented == VK_ERROR_SURFACE_LOST_KHR ? 0 : 1;
+			}
+			break;
+		}
+
+		frames++;
+		framesSinceReport++;
+		bigtime_t now = system_time();
+		if (now - lastReport >= 2000000) {
+			printf("      %.1f frames/s\n",
+				framesSinceReport * 1000000.0 / (now - lastReport));
+			lastReport = now;
+			framesSinceReport = 0;
+		}
+	}
+
+	double elapsed = (system_time() - start) / 1000000.0;
+	printf("%s    %" PRIu32 " frames in %.1f s (%.1f frames/s)\n",
+		result == 0 ? "ok" : "FAIL", frames, elapsed, frames / elapsed);
+	Destroy();
+	return result;
+}
+
+
+void
+Renderer::Destroy()
+{
+	if (fForwarder != NULL)
+		fForwarder->Detach();
+	if (fDevice != VK_NULL_HANDLE) {
+		vkDeviceWaitIdle(fDevice);
+		if (fFrameDone != VK_NULL_HANDLE)
+			vkDestroyFence(fDevice, fFrameDone, NULL);
+		for (uint32_t i = 0; i < kMaxImages; i++) {
+			if (fRendered[i] != VK_NULL_HANDLE)
+				vkDestroySemaphore(fDevice, fRendered[i], NULL);
+			if (fFramebuffers[i] != VK_NULL_HANDLE)
+				vkDestroyFramebuffer(fDevice, fFramebuffers[i], NULL);
+			if (fViews[i] != VK_NULL_HANDLE)
+				vkDestroyImageView(fDevice, fViews[i], NULL);
+		}
+		if (fAcquired != VK_NULL_HANDLE)
+			vkDestroySemaphore(fDevice, fAcquired, NULL);
+		if (fCommandPool != VK_NULL_HANDLE)
+			vkDestroyCommandPool(fDevice, fCommandPool, NULL);
+		if (fPipeline != VK_NULL_HANDLE)
+			vkDestroyPipeline(fDevice, fPipeline, NULL);
+		if (fLayout != VK_NULL_HANDLE)
+			vkDestroyPipelineLayout(fDevice, fLayout, NULL);
+		if (fRenderPass != VK_NULL_HANDLE)
+			vkDestroyRenderPass(fDevice, fRenderPass, NULL);
+		if (fSwapchain != VK_NULL_HANDLE)
+			vkDestroySwapchainKHR(fDevice, fSwapchain, NULL);
+		vkDestroyDevice(fDevice, NULL);
+		fDevice = VK_NULL_HANDLE;
+	}
+	if (fInstance != VK_NULL_HANDLE) {
+		if (fSurface != VK_NULL_HANDLE)
+			vkDestroySurfaceKHR(fInstance, fSurface, NULL);
+		vkDestroyInstance(fInstance, NULL);
+		fInstance = VK_NULL_HANDLE;
+	}
+}
+
+
+/* The renderer draws into the window's view until it is stopped; only then
+ * may the window go. */
+static bool sRendererStopped;
+
+
+static const BRect kWindowFrame(80, 80, 80 + 639, 80 + 479);
+static const char* kWindowTitle = "Vulkan on Haiku (RADV)";
+
+
+static BView*
+create_view(BWindow* window)
+{
+	BView* view = new BView(window->Bounds(), "vulkan", B_FOLLOW_ALL,
+		B_WILL_DRAW);
+	// Vulkan draws everything; app_server should not paint over it
+	view->SetViewColor(B_TRANSPARENT_COLOR);
+	window->AddChild(view);
+	return view;
+}
+
+
+static bool
+quit_requested()
+{
+	if (sRendererStopped)
+		return true;
+	be_app->PostMessage(B_QUIT_REQUESTED);
+	return false;
+}
+
+
+class VulkanWindow : public BWindow {
+public:
+	VulkanWindow(Renderer** renderer, bigtime_t duration,
+		VkPresentModeKHR presentMode)
+		: BWindow(kWindowFrame, kWindowTitle, B_TITLED_WINDOW,
+			B_NOT_RESIZABLE | B_NOT_ZOOMABLE)
+	{
+		*renderer = new Renderer(create_view(this), duration, presentMode,
+			NULL);
+	}
+
+	bool QuitRequested() { return quit_requested(); }
+};
+
+
+class VulkanDirectWindow : public BDirectWindow {
+public:
+	VulkanDirectWindow(Renderer** renderer, bigtime_t duration,
+		VkPresentModeKHR presentMode)
+		: BDirectWindow(kWindowFrame, kWindowTitle, B_TITLED_WINDOW,
+			B_NOT_RESIZABLE | B_NOT_ZOOMABLE)
+	{
+		*renderer = new Renderer(create_view(this), duration, presentMode,
+			&fForwarder);
+	}
+
+	void DirectConnected(direct_buffer_info* info)
+	{
+		fForwarder.Connected(info);
+		BDirectWindow::DirectConnected(info);
+	}
+
+	bool QuitRequested() { return quit_requested(); }
+
+private:
+	DirectForwarder fForwarder;
+};
+
+
+class VulkanApplication : public BApplication {
+public:
+	VulkanApplication(bigtime_t duration, VkPresentModeKHR presentMode,
+		bool direct)
+		: BApplication("application/x-vnd.linuxkpi-vkwindow"),
+		  fDuration(duration), fPresentMode(presentMode), fDirect(direct),
+		  fRenderer(NULL) {}
+
+	void ReadyToRun()
+	{
+		BWindow* window;
+		if (fDirect)
+			window = new VulkanDirectWindow(&fRenderer, fDuration, fPresentMode);
+		else
+			window = new VulkanWindow(&fRenderer, fDuration, fPresentMode);
+		window->Show();
+		fRenderer->Start();
+	}
+
+	bool QuitRequested()
+	{
+		if (fRenderer != NULL)
+			fRenderer->Stop();
+		sRendererStopped = true;
+		return BApplication::QuitRequested();
+	}
+
+	int Result() const { return fRenderer != NULL ? fRenderer->Result() : 1; }
+
+private:
+	bigtime_t fDuration;
+	VkPresentModeKHR fPresentMode;
+	bool fDirect;
+	Renderer* fRenderer;
+};
+
+
+int
+main(int argc, char** argv)
+{
+	setvbuf(stdout, NULL, _IOLBF, 0);
+	bigtime_t duration = argc > 1 ? (bigtime_t)(atof(argv[1]) * 1000000) : 0;
+	VkPresentModeKHR presentMode = VK_PRESENT_MODE_FIFO_KHR;
+	bool direct = true;
+	for (int i = 2; i < argc; i++) {
+		if (strcmp(argv[i], "immediate") == 0)
+			presentMode = VK_PRESENT_MODE_IMMEDIATE_KHR;
+		else if (strcmp(argv[i], "plain") == 0)
+			direct = false;
+	}
+	VulkanApplication application(duration, presentMode, direct);
+	application.Run();
+	int result = application.Result();
+	printf("%s\n", result == 0 ? "PASS" : "DONE (failed)");
+	return result;
+}
