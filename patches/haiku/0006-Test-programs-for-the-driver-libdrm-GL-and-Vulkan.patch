diff --git a/src/bin/kmstest/kmstest.c b/src/bin/kmstest/kmstest.c
new file mode 100644
index 0000000000..9626f6da05
--- /dev/null
+++ b/src/bin/kmstest/kmstest.c
@@ -0,0 +1,271 @@
+/*
+ * Copyright 2026, hans2294.
+ * Distributed under the terms of the MIT License.
+ */
+
+
+/*	A picture on the card's own outputs through Linux's KMS with libdrm:
+	finds a connected connector and its preferred mode, draws into a dumb
+	buffer, sets the mode, and animates for a while. The picture goes when
+	it exits (the framebuffer goes with the file).
+
+	kmstest [seconds]    (default 30)
+*/
+
+
+#include <errno.h>
+#include <fcntl.h>
+#include <inttypes.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#include <OS.h>
+
+#include <xf86drm.h>
+#include <xf86drmMode.h>
+
+
+static int sFailures;
+
+
+static int
+check(const char *what, int result)
+{
+	if (result == 0) {
+		printf("ok    %s\n", what);
+		return 1;
+	}
+	printf("FAIL  %s: %d (%s)\n", what, result,
+		strerror(result < 0 ? -result : errno));
+	sFailures++;
+	return 0;
+}
+
+
+static const char *
+connector_type(uint32_t type)
+{
+	switch (type) {
+		case DRM_MODE_CONNECTOR_HDMIA: return "HDMI-A";
+		case DRM_MODE_CONNECTOR_DisplayPort: return "DP";
+		case DRM_MODE_CONNECTOR_DVID: return "DVI-D";
+		case DRM_MODE_CONNECTOR_VGA: return "VGA";
+		case DRM_MODE_CONNECTOR_eDP: return "eDP";
+		case DRM_MODE_CONNECTOR_USB: return "USB";
+		default: return "other";
+	}
+}
+
+
+//	#pragma mark - drawing
+
+
+/* 5x7 glyphs for the few letters the banner needs */
+static const struct { char c; uint8_t rows[7]; } kFont[] = {
+	{ 'A', { 0x0e, 0x11, 0x11, 0x1f, 0x11, 0x11, 0x11 } },
+	{ 'D', { 0x1e, 0x11, 0x11, 0x11, 0x11, 0x11, 0x1e } },
+	{ 'E', { 0x1f, 0x10, 0x10, 0x1e, 0x10, 0x10, 0x1f } },
+	{ 'G', { 0x0e, 0x11, 0x10, 0x17, 0x11, 0x11, 0x0f } },
+	{ 'H', { 0x11, 0x11, 0x11, 0x1f, 0x11, 0x11, 0x11 } },
+	{ 'I', { 0x0e, 0x04, 0x04, 0x04, 0x04, 0x04, 0x0e } },
+	{ 'K', { 0x11, 0x12, 0x14, 0x18, 0x14, 0x12, 0x11 } },
+	{ 'M', { 0x11, 0x1b, 0x15, 0x15, 0x11, 0x11, 0x11 } },
+	{ 'N', { 0x11, 0x19, 0x15, 0x13, 0x11, 0x11, 0x11 } },
+	{ 'O', { 0x0e, 0x11, 0x11, 0x11, 0x11, 0x11, 0x0e } },
+	{ 'P', { 0x1e, 0x11, 0x11, 0x1e, 0x10, 0x10, 0x10 } },
+	{ 'R', { 0x1e, 0x11, 0x11, 0x1e, 0x14, 0x12, 0x11 } },
+	{ 'S', { 0x0f, 0x10, 0x10, 0x0e, 0x01, 0x01, 0x1e } },
+	{ 'U', { 0x11, 0x11, 0x11, 0x11, 0x11, 0x11, 0x0e } },
+	{ 'X', { 0x11, 0x11, 0x0a, 0x04, 0x0a, 0x11, 0x11 } },
+	{ '0', { 0x0e, 0x11, 0x13, 0x15, 0x19, 0x11, 0x0e } },
+	{ '7', { 0x1f, 0x01, 0x02, 0x04, 0x08, 0x08, 0x08 } },
+	{ '9', { 0x0e, 0x11, 0x11, 0x0f, 0x01, 0x02, 0x0c } },
+	{ ' ', { 0, 0, 0, 0, 0, 0, 0 } },
+};
+
+
+static void
+fill(uint32_t *pixels, uint32_t pitch, int x, int y, int w, int h,
+	uint32_t color)
+{
+	for (int row = y; row < y + h; row++) {
+		uint32_t *line = pixels + row * (pitch / 4);
+		for (int column = x; column < x + w; column++)
+			line[column] = color;
+	}
+}
+
+
+static void
+text(uint32_t *pixels, uint32_t pitch, int x, int y, int scale,
+	const char *string, uint32_t color)
+{
+	for (; *string != '\0'; string++, x += 6 * scale) {
+		for (size_t g = 0; g < sizeof(kFont) / sizeof(kFont[0]); g++) {
+			if (kFont[g].c != *string)
+				continue;
+			for (int row = 0; row < 7; row++) {
+				for (int bit = 0; bit < 5; bit++) {
+					if (kFont[g].rows[row] & (0x10 >> bit))
+						fill(pixels, pitch, x + bit * scale, y + row * scale,
+							scale, scale, color);
+				}
+			}
+		}
+	}
+}
+
+
+/*	Colour bars, a grey ramp, the banner, and a square that travels along
+	the bottom: frame \a frame of the animation.
+*/
+static void
+draw(uint32_t *pixels, uint32_t pitch, int width, int height, uint32_t frame)
+{
+	static const uint32_t kBars[] = { 0xffffff, 0xffff00, 0x00ffff, 0x00ff00,
+		0xff00ff, 0xff0000, 0x0000ff, 0x000000 };
+	int barHeight = height / 2;
+	for (int i = 0; i < 8; i++)
+		fill(pixels, pitch, i * width / 8, 0, width / 8 + 1, barHeight,
+			kBars[i]);
+
+	for (int x = 0; x < width; x++) {
+		uint32_t level = x * 255 / (width - 1);
+		uint32_t grey = level << 16 | level << 8 | level;
+		for (int y = barHeight; y < barHeight + height / 8; y++)
+			pixels[y * (pitch / 4) + x] = grey;
+	}
+
+	int bannerTop = barHeight + height / 8;
+	fill(pixels, pitch, 0, bannerTop, width, height - bannerTop, 0x202838);
+	// Haiku's tab yellow
+	int scale = height / 90;
+	text(pixels, pitch, width / 16, bannerTop + height / 24, scale,
+		"HAIKU", 0xffcb00);
+	text(pixels, pitch, width / 16, bannerTop + height / 24 + 10 * scale,
+		scale * 2 / 3, "RX 7900 GRE  AMDGPU KMS", 0xe0e0e0);
+
+	int size = height / 12;
+	int span = width - size;
+	int position = (frame * 8) % (2 * span);
+	if (position > span)
+		position = 2 * span - position;
+	fill(pixels, pitch, position, height - size - height / 40, size, size,
+		0xffcb00);
+}
+
+
+//	#pragma mark -
+
+
+int
+main(int argc, char **argv)
+{
+	setvbuf(stdout, NULL, _IOLBF, 0);
+	int seconds = argc > 1 ? atoi(argv[1]) : 30;
+
+	int fd = open("/dev/dri/card0", O_RDWR | O_CLOEXEC);
+	if (!check("open /dev/dri/card0", fd >= 0 ? 0 : -errno))
+		return 1;
+
+	drmModeResPtr resources = drmModeGetResources(fd);
+	if (!check("drmModeGetResources", resources != NULL ? 0 : -errno))
+		return 1;
+	printf("      %d connectors, %d encoders, %d CRTCs, %d framebuffers max\n",
+		resources->count_connectors, resources->count_encoders,
+		resources->count_crtcs, resources->max_width);
+
+	drmModeConnectorPtr connector = NULL;
+	for (int i = 0; i < resources->count_connectors; i++) {
+		drmModeConnectorPtr candidate = drmModeGetConnector(fd,
+			resources->connectors[i]);
+		if (candidate == NULL)
+			continue;
+		printf("      connector %u: %s-%u, %s, %d modes\n",
+			candidate->connector_id, connector_type(candidate->connector_type),
+			candidate->connector_type_id,
+			candidate->connection == DRM_MODE_CONNECTED ? "connected"
+				: "disconnected", candidate->count_modes);
+		if (connector == NULL && candidate->connection == DRM_MODE_CONNECTED
+			&& candidate->count_modes > 0)
+			connector = candidate;
+		else
+			drmModeFreeConnector(candidate);
+	}
+	if (!check("connected connector", connector != NULL ? 0 : -ENODEV))
+		return 1;
+
+	drmModeModeInfo *mode = &connector->modes[0];
+	for (int i = 0; i < connector->count_modes; i++) {
+		if (connector->modes[i].type & DRM_MODE_TYPE_PREFERRED) {
+			mode = &connector->modes[i];
+			break;
+		}
+	}
+	printf("      mode %s, %u Hz\n", mode->name, mode->vrefresh);
+
+	// a CRTC the connector's encoders can drive
+	uint32_t crtc = 0;
+	for (int e = 0; e < connector->count_encoders && crtc == 0; e++) {
+		drmModeEncoderPtr encoder = drmModeGetEncoder(fd,
+			connector->encoders[e]);
+		if (encoder == NULL)
+			continue;
+		for (int c = 0; c < resources->count_crtcs; c++) {
+			if (encoder->possible_crtcs & (1u << c)) {
+				crtc = resources->crtcs[c];
+				break;
+			}
+		}
+		drmModeFreeEncoder(encoder);
+	}
+	if (!check("CRTC for the connector", crtc != 0 ? 0 : -ENODEV))
+		return 1;
+
+	struct drm_mode_create_dumb create = {
+		.width = mode->hdisplay,
+		.height = mode->vdisplay,
+		.bpp = 32,
+	};
+	if (!check("DRM_IOCTL_MODE_CREATE_DUMB", drmIoctl(fd,
+			DRM_IOCTL_MODE_CREATE_DUMB, &create)))
+		return 1;
+	struct drm_mode_map_dumb map = { .handle = create.handle };
+	void *pixels;
+	if (!check("DRM_IOCTL_MODE_MAP_DUMB", drmIoctl(fd, DRM_IOCTL_MODE_MAP_DUMB,
+			&map))
+		|| !check("drmMap", drmMap(fd, map.offset, create.size, &pixels)))
+		return 1;
+
+	uint32_t framebuffer;
+	if (!check("drmModeAddFB", drmModeAddFB(fd, mode->hdisplay,
+			mode->vdisplay, 24, 32, create.pitch, create.handle, &framebuffer)))
+		return 1;
+
+	draw(pixels, create.pitch, mode->hdisplay, mode->vdisplay, 0);
+	bigtime_t start = system_time();
+	if (!check("drmModeSetCrtc", drmModeSetCrtc(fd, crtc, framebuffer, 0, 0,
+			&connector->connector_id, 1, mode)))
+		return 1;
+	printf("      mode set in %" PRId64 " ms; showing it for %d s\n",
+		(system_time() - start) / 1000, seconds);
+
+	uint32_t frame = 0;
+	while (system_time() - start < (bigtime_t)seconds * 1000000) {
+		draw(pixels, create.pitch, mode->hdisplay, mode->vdisplay, ++frame);
+		snooze(1000000 / 30);
+	}
+	printf("      %u frames drawn\n", frame);
+
+	drmUnmap(pixels, create.size);
+	drmModeRmFB(fd, framebuffer);
+	struct drm_mode_destroy_dumb destroy = { .handle = create.handle };
+	drmIoctl(fd, DRM_IOCTL_MODE_DESTROY_DUMB, &destroy);
+	drmModeFreeConnector(connector);
+	drmModeFreeResources(resources);
+	close(fd);
+	printf("%s: %d failure(s)\n", sFailures == 0 ? "PASS" : "DONE", sFailures);
+	return sFailures == 0 ? 0 : 1;
+}
