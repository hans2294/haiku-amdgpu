diff --git a/src/bin/vkheadless/fill.comp b/src/bin/vkheadless/fill.comp
new file mode 100644
index 0000000000..589fb5c205
--- /dev/null
+++ b/src/bin/vkheadless/fill.comp
@@ -0,0 +1,10 @@
+#version 450
+// vkheadless' compute shader: data[i] = i * 3 + 7 + push constant
+layout(local_size_x = 64) in;
+layout(std430, binding = 0) buffer Data { uint data[]; };
+layout(push_constant) uniform Push { uint bias; };
+void main()
+{
+	uint i = gl_GlobalInvocationID.x;
+	data[i] = i * 3u + 7u + bias;
+}
