diff --git a/src/bin/libdrmtest/libdrmtest.c b/src/bin/libdrmtest/libdrmtest.c
new file mode 100644
index 0000000000..f97d5f51b4
--- /dev/null
+++ b/src/bin/libdrmtest/libdrmtest.c
@@ -0,0 +1,439 @@
+/*
+ * Copyright 2026, hans2294.
+ * Distributed under the terms of the MIT License.
+ */
+
+
+/*	Uses Linux's amdgpu through libdrm and libdrm_amdgpu the way Mesa does:
+	device enumeration with PCI ids, node names, amdgpu_device_initialize(),
+	GPU and heap info, buffers with CPU mappings and GPU addresses, and an
+	SDMA copy from VRAM to GTT submitted with amdgpu_cs_submit() and waited
+	for with amdgpu_cs_query_fence_status(), and PRIME: a buffer shared
+	through a dma-buf fd with another DRM file, the scanout buffer of the
+	primary node's CRTC exported the way a client would get at it, and
+	mappings that survive a fork().
+
+	libdrmtest
+*/
+
+
+#include <errno.h>
+#include <fcntl.h>
+#include <inttypes.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <sys/wait.h>
+
+#include <xf86drm.h>
+#include <xf86drmMode.h>
+#include <amdgpu.h>
+#include <amdgpu_drm.h>
+
+
+static int sFailures;
+
+
+static int
+check(const char *what, int result)
+{
+	if (result == 0) {
+		printf("ok    %s\n", what);
+		return 1;
+	}
+	printf("FAIL  %s: %d (%s)\n", what, result,
+		strerror(result < 0 ? -result : result));
+	sFailures++;
+	return 0;
+}
+
+
+static char *
+test_enumeration(void)
+{
+	drmDevicePtr devices[8];
+	int count = drmGetDevices2(DRM_DEVICE_GET_PCI_REVISION, devices, 8);
+	if (!check("drmGetDevices2", count > 0 ? 0 : (count < 0 ? count : -ENODEV)))
+		return NULL;
+
+	char *renderNode = NULL;
+	for (int i = 0; i < count; i++) {
+		drmDevicePtr device = devices[i];
+		printf("      device %d: bus type %d", i, device->bustype);
+		if (device->bustype == DRM_BUS_PCI) {
+			printf(", PCI %04x:%02x:%02x.%u, %04x:%04x (%04x:%04x) rev %#x",
+				device->businfo.pci->domain, device->businfo.pci->bus,
+				device->businfo.pci->dev, device->businfo.pci->func,
+				device->deviceinfo.pci->vendor_id,
+				device->deviceinfo.pci->device_id,
+				device->deviceinfo.pci->subvendor_id,
+				device->deviceinfo.pci->subdevice_id,
+				device->deviceinfo.pci->revision_id);
+		}
+		printf("\n");
+		for (int node = 0; node < DRM_NODE_MAX; node++) {
+			if (device->available_nodes & (1 << node))
+				printf("        node %d: %s\n", node, device->nodes[node]);
+		}
+		if (renderNode == NULL
+			&& (device->available_nodes & (1 << DRM_NODE_RENDER)))
+			renderNode = strdup(device->nodes[DRM_NODE_RENDER]);
+	}
+	drmFreeDevices(devices, count);
+	return renderNode;
+}
+
+
+static void
+test_node_names(int fd)
+{
+	int type = drmGetNodeTypeFromFd(fd);
+	check("drmGetNodeTypeFromFd", type == DRM_NODE_RENDER ? 0 : -EINVAL);
+
+	char *primary = drmGetPrimaryDeviceNameFromFd(fd);
+	char *render = drmGetRenderDeviceNameFromFd(fd);
+	if (check("drmGetPrimaryDeviceNameFromFd", primary != NULL ? 0 : -ENOENT))
+		printf("      %s\n", primary);
+	if (check("drmGetRenderDeviceNameFromFd", render != NULL ? 0 : -ENOENT))
+		printf("      %s\n", render);
+	free(primary);
+	free(render);
+
+	drmDevicePtr device;
+	if (check("drmGetDevice2", drmGetDevice2(fd, 0, &device))) {
+		if (device->bustype == DRM_BUS_PCI)
+			printf("      %04x:%04x\n", device->deviceinfo.pci->vendor_id,
+				device->deviceinfo.pci->device_id);
+		drmFreeDevice(&device);
+	}
+}
+
+
+static int
+allocate(amdgpu_device_handle device, uint64_t size, uint32_t heap,
+	uint64_t flags, uint64_t *address, amdgpu_bo_handle *bo,
+	amdgpu_va_handle *va, void **cpu, const char *what)
+{
+	struct amdgpu_bo_alloc_request request = {
+		.alloc_size = size,
+		.phys_alignment = 4096,
+		.preferred_heap = heap,
+		.flags = flags,
+	};
+	if (!check(what, amdgpu_bo_alloc(device, &request, bo)))
+		return 0;
+	if (!check("  amdgpu_va_range_alloc", amdgpu_va_range_alloc(device,
+			amdgpu_gpu_va_range_general, size, 4096, 0, address, va, 0)))
+		return 0;
+	if (!check("  amdgpu_bo_va_op map", amdgpu_bo_va_op(*bo, 0, size, *address,
+			0, AMDGPU_VA_OP_MAP)))
+		return 0;
+	return check("  amdgpu_bo_cpu_map", amdgpu_bo_cpu_map(*bo, cpu));
+}
+
+
+static void
+release(uint64_t size, uint64_t address, amdgpu_bo_handle bo,
+	amdgpu_va_handle va)
+{
+	if (bo == NULL)
+		return;
+	amdgpu_bo_cpu_unmap(bo);
+	amdgpu_bo_va_op(bo, 0, size, address, 0, AMDGPU_VA_OP_UNMAP);
+	if (va != NULL)
+		amdgpu_va_range_free(va);
+	amdgpu_bo_free(bo);
+}
+
+
+static void
+test_sdma_copy(amdgpu_device_handle device)
+{
+	const uint64_t size = 4 << 20;
+	amdgpu_bo_handle source = NULL, destination = NULL, ib = NULL;
+	amdgpu_va_handle sourceVA = NULL, destinationVA = NULL, ibVA = NULL;
+	uint64_t sourceAddress = 0, destinationAddress = 0, ibAddress = 0;
+	uint32_t *sourceData = NULL, *destinationData = NULL, *ibData = NULL;
+	amdgpu_context_handle context;
+
+	if (!check("amdgpu_cs_ctx_create", amdgpu_cs_ctx_create(device, &context)))
+		return;
+
+	if (allocate(device, size, AMDGPU_GEM_DOMAIN_VRAM,
+			AMDGPU_GEM_CREATE_CPU_ACCESS_REQUIRED, &sourceAddress, &source,
+			&sourceVA, (void **)&sourceData, "amdgpu_bo_alloc source (VRAM)")
+		&& allocate(device, size, AMDGPU_GEM_DOMAIN_GTT, 0, &destinationAddress,
+			&destination, &destinationVA, (void **)&destinationData,
+			"amdgpu_bo_alloc destination (GTT)")
+		&& allocate(device, 4096, AMDGPU_GEM_DOMAIN_GTT, 0, &ibAddress, &ib,
+			&ibVA, (void **)&ibData, "amdgpu_bo_alloc IB (GTT)")) {
+		for (uint32_t i = 0; i < size / 4; i++) {
+			sourceData[i] = i ^ 0x5a5a5a5a;
+			destinationData[i] = 0;
+		}
+
+		// SDMA v6 linear copies are at most 4 MiB - 1 byte; two halves
+		uint32_t count = 0;
+		for (uint64_t offset = 0; offset < size; offset += size / 2) {
+			ibData[count++] = 0x00000001;	// SDMA_OP_COPY, COPY_LINEAR
+			ibData[count++] = size / 2 - 1;
+			ibData[count++] = 0;
+			ibData[count++] = (uint32_t)(sourceAddress + offset);
+			ibData[count++] = (sourceAddress + offset) >> 32;
+			ibData[count++] = (uint32_t)(destinationAddress + offset);
+			ibData[count++] = (destinationAddress + offset) >> 32;
+		}
+		while (count % 8 != 0)
+			ibData[count++] = 0;			// SDMA_OP_NOP
+
+		amdgpu_bo_handle buffers[3] = { source, destination, ib };
+		amdgpu_bo_list_handle list;
+		if (check("amdgpu_bo_list_create", amdgpu_bo_list_create(device, 3,
+				buffers, NULL, &list))) {
+			struct amdgpu_cs_ib_info ibInfo = {
+				.ib_mc_address = ibAddress,
+				.size = count,
+			};
+			struct amdgpu_cs_request request = {
+				.ip_type = AMDGPU_HW_IP_DMA,
+				.resources = list,
+				.number_of_ibs = 1,
+				.ibs = &ibInfo,
+			};
+			if (check("amdgpu_cs_submit (SDMA copy, 4 MiB)",
+					amdgpu_cs_submit(context, 0, &request, 1))) {
+				struct amdgpu_cs_fence fence = {
+					.context = context,
+					.ip_type = AMDGPU_HW_IP_DMA,
+					.fence = request.seq_no,
+				};
+				uint32_t expired = 0;
+				if (check("amdgpu_cs_query_fence_status",
+						amdgpu_cs_query_fence_status(&fence,
+							AMDGPU_TIMEOUT_INFINITE, 0, &expired))) {
+					uint32_t errors = 0;
+					for (uint32_t i = 0; i < size / 4; i++) {
+						if (destinationData[i] != (i ^ 0x5a5a5a5a))
+							errors++;
+					}
+					printf("      fence %" PRIu64 " expired %u, %u wrong words\n",
+						request.seq_no, expired, errors);
+					check("GPU copy arrived", expired && errors == 0 ? 0 : -EIO);
+				}
+			}
+			amdgpu_bo_list_destroy(list);
+		}
+	}
+
+	release(4096, ibAddress, ib, ibVA);
+	release(size, destinationAddress, destination, destinationVA);
+	release(size, sourceAddress, source, sourceVA);
+	amdgpu_cs_ctx_free(context);
+}
+
+
+/*	A GTT buffer goes out as a dma-buf fd and comes back in through a second
+	render node file, whose mapping must show what the first one wrote.
+*/
+static void
+test_prime(amdgpu_device_handle device, const char *path)
+{
+	const uint64_t size = 64 * 1024;
+	struct amdgpu_bo_alloc_request request = {
+		.alloc_size = size,
+		.phys_alignment = 4096,
+		.preferred_heap = AMDGPU_GEM_DOMAIN_GTT,
+	};
+	amdgpu_bo_handle bo;
+	uint32_t *cpu;
+	if (!check("PRIME: amdgpu_bo_alloc", amdgpu_bo_alloc(device, &request, &bo)))
+		return;
+	if (check("PRIME: amdgpu_bo_cpu_map", amdgpu_bo_cpu_map(bo,
+			(void **)&cpu))) {
+		for (uint32_t i = 0; i < size / 4; i++)
+			cpu[i] = 0x5a000000 | i;
+	}
+
+	uint32_t dmaBuf;
+	if (check("PRIME: amdgpu_bo_export (dma-buf fd)", amdgpu_bo_export(bo,
+			amdgpu_bo_handle_type_dma_buf_fd, &dmaBuf))) {
+		printf("      dma-buf fd %u\n", dmaBuf);
+
+		struct amdgpu_bo_import_result result;
+		if (check("PRIME: amdgpu_bo_import (same device)", amdgpu_bo_import(
+				device, amdgpu_bo_handle_type_dma_buf_fd, dmaBuf, &result))) {
+			check("PRIME: import gives the same buffer and size",
+				result.buf_handle == bo && result.alloc_size == size
+					? 0 : -EINVAL);
+			amdgpu_bo_free(result.buf_handle);
+		}
+
+		int other = open(path, O_RDWR | O_CLOEXEC);
+		uint32_t handle;
+		if (check("PRIME: drmPrimeFDToHandle (second file)",
+				drmPrimeFDToHandle(other, dmaBuf, &handle))) {
+			union drm_amdgpu_gem_mmap mmap = { .in.handle = handle };
+			void *view;
+			if (check("PRIME: map in the second file", drmIoctl(other,
+					DRM_IOCTL_AMDGPU_GEM_MMAP, &mmap))
+				&& check("PRIME: drmMap", drmMap(other, mmap.out.addr_ptr,
+					size, &view))) {
+				int same = memcmp(view, cpu, size) == 0;
+				check("PRIME: both files see the same pages",
+					same ? 0 : -EIO);
+				drmUnmap(view, size);
+			}
+			drmCloseBufferHandle(other, handle);
+		}
+		close(other);
+		close(dmaBuf);
+	}
+	amdgpu_bo_free(bo);
+}
+
+
+/*	Mappings are shared, as on Linux: a fork() in the process must leave them
+	as they are. A write after the fork has to reach the buffer, which a new
+	mapping of it shows, and not a private copy of the page or a panic.
+*/
+static void
+test_fork(amdgpu_device_handle device, const char *what, uint32_t heap,
+	uint64_t flags)
+{
+	const uint64_t size = 64 * 1024;
+	struct amdgpu_bo_alloc_request request = {
+		.alloc_size = size,
+		.phys_alignment = 4096,
+		.preferred_heap = heap,
+		.flags = flags,
+	};
+	amdgpu_bo_handle bo;
+	uint32_t *cpu;
+	char name[64];
+	snprintf(name, sizeof(name), "fork: amdgpu_bo_alloc %s", what);
+	if (!check(name, amdgpu_bo_alloc(device, &request, &bo)))
+		return;
+	if (check("fork: amdgpu_bo_cpu_map", amdgpu_bo_cpu_map(bo, (void **)&cpu))) {
+		for (uint32_t i = 0; i < size / 4; i++)
+			cpu[i] = 0x11000000 | i;
+
+		pid_t child = fork();
+		if (child == 0)
+			_exit(0);
+		int status = 0;
+		check("fork: fork and wait",
+			child > 0 && waitpid(child, &status, 0) == child ? 0 : -ECHILD);
+
+		for (uint32_t i = 0; i < size / 4; i++)
+			cpu[i] = 0x22000000 | i;
+
+		amdgpu_bo_cpu_unmap(bo);
+		if (check("fork: map again", amdgpu_bo_cpu_map(bo, (void **)&cpu))) {
+			uint32_t errors = 0;
+			for (uint32_t i = 0; i < size / 4; i++) {
+				if (cpu[i] != (0x22000000 | i))
+					errors++;
+			}
+			snprintf(name, sizeof(name), "fork: writes reach the buffer (%s)",
+				what);
+			check(name, errors == 0 ? 0 : -EIO);
+			amdgpu_bo_cpu_unmap(bo);
+		}
+	}
+	amdgpu_bo_free(bo);
+}
+
+
+/*	What a client needs for drawing straight into the screen: the CRTC's
+	frame buffer from the primary node (not being master), as a dma-buf fd
+	that imports on the render node.
+*/
+static void
+test_scanout_export(int renderFD)
+{
+	int fd = open("/dev/dri/card0", O_RDWR | O_CLOEXEC);
+	if (!check("scanout: open primary node", fd >= 0 ? 0 : -errno))
+		return;
+	drmModeResPtr resources = drmModeGetResources(fd);
+	uint32_t framebuffer = 0;
+	for (int i = 0; resources != NULL && i < resources->count_crtcs; i++) {
+		drmModeCrtcPtr crtc = drmModeGetCrtc(fd, resources->crtcs[i]);
+		if (crtc != NULL && crtc->buffer_id != 0 && framebuffer == 0)
+			framebuffer = crtc->buffer_id;
+		drmModeFreeCrtc(crtc);
+	}
+	drmModeFreeResources(resources);
+	if (framebuffer == 0) {
+		printf("skip  scanout: no CRTC shows a frame buffer yet\n");
+		close(fd);
+		return;
+	}
+
+	drmModeFBPtr info = drmModeGetFB(fd, framebuffer);
+	if (check("scanout: drmModeGetFB with a handle",
+			info != NULL && info->handle != 0 ? 0 : -EPERM)) {
+		printf("      frame buffer %u: %ux%u, pitch %u\n", framebuffer,
+			info->width, info->height, info->pitch);
+		int dmaBuf;
+		uint32_t handle;
+		if (check("scanout: drmPrimeHandleToFD", drmPrimeHandleToFD(fd,
+				info->handle, DRM_CLOEXEC | DRM_RDWR, &dmaBuf))) {
+			if (check("scanout: drmPrimeFDToHandle on the render node",
+					drmPrimeFDToHandle(renderFD, dmaBuf, &handle)))
+				drmCloseBufferHandle(renderFD, handle);
+			close(dmaBuf);
+		}
+		drmCloseBufferHandle(fd, info->handle);
+	}
+	drmModeFreeFB(info);
+	close(fd);
+}
+
+
+int
+main(void)
+{
+	char *path = test_enumeration();
+	if (path == NULL)
+		return 1;
+
+	int fd = open(path, O_RDWR | O_CLOEXEC);
+	if (!check("open render node", fd >= 0 ? 0 : -errno))
+		return 1;
+	test_node_names(fd);
+
+	uint32_t major, minor;
+	amdgpu_device_handle device;
+	if (check("amdgpu_device_initialize", amdgpu_device_initialize(fd, &major,
+			&minor, &device))) {
+		printf("      DRM %u.%u, %s\n", major, minor,
+			amdgpu_get_marketing_name(device));
+
+		struct amdgpu_gpu_info info;
+		if (check("amdgpu_query_gpu_info", amdgpu_query_gpu_info(device,
+				&info)))
+			printf("      asic %#x rev %#x family %u, %u SEs, %" PRIu64
+				" MHz\n", info.asic_id, info.chip_rev, info.family_id,
+				info.num_shader_engines, info.max_engine_clk / 1000);
+
+		struct amdgpu_heap_info heap;
+		if (check("amdgpu_query_heap_info (VRAM)", amdgpu_query_heap_info(
+				device, AMDGPU_GEM_DOMAIN_VRAM, 0, &heap)))
+			printf("      %" PRIu64 " MiB, %" PRIu64 " MiB used\n",
+				heap.heap_size >> 20, heap.heap_usage >> 20);
+
+		test_sdma_copy(device);
+		test_prime(device, path);
+		test_scanout_export(fd);
+		test_fork(device, "GTT", AMDGPU_GEM_DOMAIN_GTT, 0);
+		test_fork(device, "VRAM", AMDGPU_GEM_DOMAIN_VRAM,
+			AMDGPU_GEM_CREATE_CPU_ACCESS_REQUIRED);
+		check("amdgpu_device_deinitialize", amdgpu_device_deinitialize(device));
+	}
+
+	close(fd);
+	free(path);
+	printf("%s: %d failure(s)\n", sFailures == 0 ? "PASS" : "DONE", sFailures);
+	return sFailures == 0 ? 0 : 1;
+}
