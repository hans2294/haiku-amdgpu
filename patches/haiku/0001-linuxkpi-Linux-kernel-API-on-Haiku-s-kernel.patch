+};
+struct vm_area_struct {
+	unsigned long vm_start;
+	unsigned long vm_end;
+	struct mm_struct *vm_mm;
+	pgprot_t vm_page_prot;
+	union { const vm_flags_t vm_flags; vm_flags_t __vm_flags; };
+	unsigned long vm_pgoff;
+	struct file *vm_file;
+	void *vm_private_data;
+	const struct vm_operations_struct *vm_ops;
+	void *linuxkpi_area;	/* Haiku area backing the mapping */
+	/* Filled by vmf_insert_*() while linuxkpi faults the mapping in */
+	unsigned long long *linuxkpi_physical;
+	unsigned long linuxkpi_pages;
+	unsigned long linuxkpi_cache;	/* _PAGE_CACHE_* of the last insert */
+};
+struct mm_struct {
+	struct rw_semaphore mmap_lock;
+	atomic_t mm_users;
+	atomic_t mm_count;
+	unsigned long task_size;
+	s32 linuxkpi_team;
+};
+struct vm_fault {
+	struct vm_area_struct *vma;
+	pgoff_t pgoff;
+	unsigned long address;
+	unsigned int flags;
+	struct page *page;
+};
+#define VM_FAULT_OOM		((vm_fault_t)0x000001)
+#define VM_FAULT_SIGBUS		((vm_fault_t)0x000002)
+#define VM_FAULT_MAJOR		((vm_fault_t)0x000004)
+#define VM_FAULT_NOPAGE		((vm_fault_t)0x000100)
+#define VM_FAULT_LOCKED		((vm_fault_t)0x000200)
+#define VM_FAULT_RETRY		((vm_fault_t)0x000400)
+#define VM_FAULT_FALLBACK	((vm_fault_t)0x000800)
+#define VM_FAULT_ERROR		(VM_FAULT_OOM | VM_FAULT_SIGBUS)
+#define FAULT_FLAG_WRITE	0x01
+#define FAULT_FLAG_ALLOW_RETRY	0x04
+#define FAULT_FLAG_RETRY_NOWAIT	0x08
+#define FAULT_FLAG_KILLABLE	0x10
+#define FAULT_FLAG_TRIED	0x20
+
+#endif
