+static inline void clear_highpage(struct page *page) { void *kaddr = kmap_local_page(page); clear_page(kaddr); kunmap_local(kaddr); }
+static inline void copy_highpage(struct page *to, struct page *from)
+{ void *f = kmap_local_page(from), *t = kmap_local_page(to); __builtin_memcpy(t, f, PAGE_SIZE); kunmap_local(t); kunmap_local(f); }
+
+#endif
