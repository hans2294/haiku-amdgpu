+/* SRCU on top of the plain RCU emulation: readers never block writers long. */
+struct srcu_struct { struct mutex lock; };
+#define DEFINE_SRCU(name)			struct srcu_struct name = { .lock = __MUTEX_INITIALIZER(name.lock) }
