+
+void
+guid_gen(guid_t *u)
+{
+	get_random_bytes(u, sizeof(*u));
+	// version 4, variant 1
+	u->b[7] = (u->b[7] & 0x0f) | 0x40;
+	u->b[8] = (u->b[8] & 0x3f) | 0x80;
+}
