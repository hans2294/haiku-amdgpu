+
+
+struct inode *
+alloc_anon_inode(struct super_block *s)
+{
+	struct inode *inode = kzalloc(sizeof(*inode), GFP_KERNEL);
+	if (inode == NULL)
+		return ERR_PTR(-ENOMEM);
+	atomic_set(&inode->i_count, 1);
+	inode->i_sb = s;
+	inode->i_mapping = &inode->i_data;
+	inode->i_data.host = inode;
+	inode->i_data.gfp_mask = GFP_HIGHUSER_MOVABLE;
+	xa_init(&inode->i_data.i_pages);
+	init_rwsem(&inode->i_data.i_mmap_rwsem);
+	return inode;
+}
+
+
+void
+iput(struct inode *inode)
+{
+	if (inode != NULL && atomic_dec_and_test(&inode->i_count))
+		kfree(inode);
+}
