diff --git a/src/libs/compat/linuxkpi/include/linux/mutex.h b/src/libs/compat/linuxkpi/include/linux/mutex.h
new file mode 100644
index 0000000000..4cbdce5139
--- /dev/null
+++ b/src/libs/compat/linuxkpi/include/linux/mutex.h
@@ -0,0 +1,46 @@
+/*
+ * Copyright 2026, hans2294.
+ * Distributed under the terms of the MIT License.
+ */
+#ifndef _LINUXKPI_LINUX_MUTEX_H
+#define _LINUXKPI_LINUX_MUTEX_H
+
+#include <linux/types.h>
+#include <linux/kernel.h>
+#include <linux/bug.h>
+#include <linux/lockdep.h>
+#include <linux/list.h>
+#include <linux/cleanup.h>
+#include <linux/atomic.h>
+
+/* Room for a Haiku mutex; linuxkpi checks the size. */
+struct mutex {
+	unsigned long opaque[6];
+	const char *name;
+};
+#define __MUTEX_INITIALIZER(lockname)	{ .opaque = { 0 }, .name = #lockname }
+#define DEFINE_MUTEX(mutexname)	struct mutex mutexname = __MUTEX_INITIALIZER(mutexname)
+
+/* Haiku's kernel exports mutex_lock() and friends itself; rename ours. */
+#define mutex_destroy	linuxkpi_mutex_destroy
+#define mutex_lock		linuxkpi_mutex_lock
+#define mutex_trylock	linuxkpi_mutex_trylock
+#define mutex_unlock	linuxkpi_mutex_unlock
+void linuxkpi_mutex_init(struct mutex *lock, const char *name);
+void mutex_destroy(struct mutex *lock);
+void mutex_lock(struct mutex *lock);
+int __must_check mutex_lock_interruptible(struct mutex *lock);
+int __must_check mutex_lock_killable(struct mutex *lock);
+int mutex_trylock(struct mutex *lock);
+void mutex_unlock(struct mutex *lock);
+bool mutex_is_locked(struct mutex *lock);
+int atomic_dec_and_mutex_lock(atomic_t *cnt, struct mutex *lock);
+#define mutex_init(m)	linuxkpi_mutex_init(m, #m)
+#define mutex_lock_nested(l, s)	mutex_lock(l)
+#define mutex_lock_interruptible_nested(l, s)	mutex_lock_interruptible(l)
+#define mutex_lock_nest_lock(l, n)	mutex_lock(l)
+#define mutex_lock_io(l)	mutex_lock(l)
+#define devm_mutex_init(dev, m)	({ mutex_init(m); 0; })
+DEFINE_GUARD(mutex, struct mutex *, mutex_lock(_T), mutex_unlock(_T))
+
+#endif
