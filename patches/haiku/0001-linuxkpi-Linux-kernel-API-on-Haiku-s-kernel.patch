new file mode 100644
index 0000000000..7f9ea73800
--- /dev/null
+++ b/src/libs/compat/linuxkpi/linux/chrdev.c
@@ -0,0 +1,439 @@
+/*
+ * Copyright 2026, hans2294.
+ * Distributed under the terms of the MIT License.
+ */
+
+
+/*!	Character devices: the majors Linux code registers with their file
+	operations, and the devices with a dev_t, which the Haiku driver
+	publishes and opens through here.
+
+	Opening goes like Linux's chrdev_open(): a fresh inode carrying the
+	dev_t and a file with the major's file operations, whose open() may
+	swap in others (DRM's stub does).
+*/
+
+
+#include <linux/fs.h>
+#include <linux/device.h>
+#include <linux/device/class.h>
+#include <linux/kdev_t.h>
+#include <linux/slab.h>
+#include <linux/mutex.h>
+#include <linux/list.h>
+#include <linux/fcntl.h>
+#include <linux/mm.h>
+#include <linux/printk.h>
+
+#include <linuxkpi/chrdev.h>
+#include <linuxkpi/haiku.h>
+#include <linuxkpi/uapi.h>
+
+
+struct chrdev_major {
+	struct list_head link;
+	unsigned int major;
+	const char *name;
+	const struct file_operations *fops;
+};
+
+struct chrdev_node {
+	struct list_head link;
+	struct device *dev;
+	dev_t devt;
+	char *path;
+};
+
+/* A mapping into a team; it holds the file like a Linux vma does. */
+struct chrdev_mapping {
+	struct list_head link;
+	int area;
+	struct vm_area_struct *vma;
+};
+
+static DEFINE_MUTEX(sChrdevLock);
+static LIST_HEAD(sMajors);
+static LIST_HEAD(sNodes);
+static LIST_HEAD(sMappings);
+
+
+static struct chrdev_major *
+find_major(unsigned int major)
+{
+	struct chrdev_major *entry;
+	list_for_each_entry(entry, &sMajors, link) {
+		if (entry->major == major)
+			return entry;
+	}
+	return NULL;
+}
+
+
+int
+register_chrdev(unsigned int major, const char *name,
+	const struct file_operations *fops)
+{
+	mutex_lock(&sChrdevLock);
+	if (major == 0) {
+		// dynamic majors, from the top of Linux's experimental range down
+		for (major = 254; major > 233 && find_major(major) != NULL; major--)
+			;
+	}
+	if (find_major(major) != NULL) {
+		mutex_unlock(&sChrdevLock);
+		return -EBUSY;
+	}
+
+	struct chrdev_major *entry = kzalloc(sizeof(*entry), GFP_KERNEL);
+	if (entry == NULL) {
+		mutex_unlock(&sChrdevLock);
+		return -ENOMEM;
+	}
+	entry->major = major;
+	entry->name = name;
+	entry->fops = fops;
+	list_add_tail(&entry->link, &sMajors);
+	mutex_unlock(&sChrdevLock);
+	return major;
+}
+
+
+void
+unregister_chrdev(unsigned int major, const char *name)
+{
+	mutex_lock(&sChrdevLock);
+	struct chrdev_major *entry = find_major(major);
+	if (entry != NULL)
+		list_del(&entry->link);
+	mutex_unlock(&sChrdevLock);
+	kfree(entry);
+}
+
+
+void
+linuxkpi_chrdev_device_added(struct device *dev)
+{
+	if (dev->devt == 0)
+		return;
+
+	char *path = NULL;
+	if (dev->class != NULL && dev->class->devnode != NULL)
+		path = dev->class->devnode(dev, NULL);
+	if (path == NULL)
+		path = kstrdup(dev_name(dev), GFP_KERNEL);
+	struct chrdev_node *node = kzalloc(sizeof(*node), GFP_KERNEL);
+	if (path == NULL || node == NULL) {
+		kfree(path);
+		kfree(node);
+		return;
+	}
+	node->dev = dev;
+	node->devt = dev->devt;
+	node->path = path;
+
+	mutex_lock(&sChrdevLock);
+	list_add_tail(&node->link, &sNodes);
+	mutex_unlock(&sChrdevLock);
+	pr_info("linuxkpi: /dev/%s (%u:%u)\n", path, MAJOR(dev->devt),
+		MINOR(dev->devt));
+}
+
+
+void
+linuxkpi_chrdev_device_removed(struct device *dev)
+{
+	struct chrdev_node *node, *next;
+	mutex_lock(&sChrdevLock);
+	list_for_each_entry_safe(node, next, &sNodes, link) {
+		if (node->dev != dev)
+			continue;
+		list_del(&node->link);
+		// Haiku may still hand out the path it got; it stays allocated.
+		kfree(node);
+	}
+	mutex_unlock(&sChrdevLock);
+}
+
+
+const char *
+linuxkpi_chrdev_path(int index)
+{
+	const char *path = NULL;
+	struct chrdev_node *node;
+	mutex_lock(&sChrdevLock);
+	list_for_each_entry(node, &sNodes, link) {
+		if (index-- == 0) {
+			path = node->path;
+			break;
+		}
+	}
+	mutex_unlock(&sChrdevLock);
+	return path;
+}
+
+
+bool linuxkpi_pci_device_info(struct device *dev,
+	struct linuxkpi_device_info *info);
+
+
+int
+linuxkpi_chrdev_device_info(const char *path,
+	struct linuxkpi_device_info *info)
+{
+	struct device *dev = NULL;
+	struct chrdev_node *node;
+
+	memset(info, 0, sizeof(*info));
+	mutex_lock(&sChrdevLock);
+	list_for_each_entry(node, &sNodes, link) {
+		if (strcmp(node->path, path) == 0) {
+			dev = node->dev;
+			info->major = MAJOR(node->devt);
+			info->minor = MINOR(node->devt);
+			break;
+		}
+	}
+	if (dev != NULL)
+		get_device(dev);
+	mutex_unlock(&sChrdevLock);
+	if (dev == NULL)
+		return -ENODEV;
+
+	// DRM's minors hang off the PCI device
+	for (struct device *parent = dev; parent != NULL; parent = parent->parent) {
+		if (linuxkpi_pci_device_info(parent, info))
+			break;
+	}
+	put_device(dev);
+	return 0;
+}
+
+
+//	#pragma mark - file operations
+
+
+int
+linuxkpi_chrdev_open(const char *path, int linuxFlags, void **_cookie)
+{
+	dev_t devt = 0;
+	const struct file_operations *fops = NULL;
+	struct chrdev_node *node;
+
+	mutex_lock(&sChrdevLock);
+	list_for_each_entry(node, &sNodes, link) {
+		if (strcmp(node->path, path) == 0) {
+			devt = node->devt;
+			break;
+		}
+	}
+	struct chrdev_major *major = devt != 0 ? find_major(MAJOR(devt)) : NULL;
+	if (major != NULL)
+		fops = major->fops;
+	mutex_unlock(&sChrdevLock);
+	if (fops == NULL)
+		return -ENODEV;
+
+	struct inode *inode = alloc_anon_inode(NULL);
+	if (IS_ERR(inode))
+		return PTR_ERR(inode);
+	inode->i_rdev = devt;
+	inode->i_fop = fops;
+
+	struct file *file = kzalloc(sizeof(*file), GFP_KERNEL);
+	if (file == NULL) {
+		iput(inode);
+		return -ENOMEM;
+	}
+	atomic_long_set(&file->f_count, 1);
+	spin_lock_init(&file->f_lock);
+	mutex_init(&file->f_pos_lock);
+	file->f_inode = inode;
+	file->f_mapping = inode->i_mapping;
+	file->f_flags = linuxFlags;
+	switch (linuxFlags & O_ACCMODE) {
+		case O_RDONLY: file->f_mode = FMODE_READ; break;
+		case O_WRONLY: file->f_mode = FMODE_WRITE; break;
+		default: file->f_mode = FMODE_READ | FMODE_WRITE; break;
+	}
+	file->f_op = fops;
+
+	int error = file->f_op->open != NULL ? file->f_op->open(inode, file) : 0;
+	if (error != 0) {
+		kfree(file);
+		iput(inode);
+		return error;
+	}
+	*_cookie = file;
+	return 0;
+}
+
+
+void
+linuxkpi_chrdev_close(void *cookie)
+{
+	struct file *file = cookie;
+	if (file->f_op->flush != NULL)
+		file->f_op->flush(file, NULL);
+}
+
+
+void
+linuxkpi_chrdev_free(void *cookie)
+{
+	struct file *file = cookie;
+	struct inode *inode = file->f_inode;
+	fput(file);
+	iput(inode);
+}
+
+
+long
+linuxkpi_chrdev_ioctl(void *cookie, unsigned int command, void *argument)
+{
+	struct file *file = cookie;
+	if (file->f_op->unlocked_ioctl == NULL)
+		return -ENOTTY;
+	return file->f_op->unlocked_ioctl(file, command, (unsigned long)argument);
+}
+
+
+long
+linuxkpi_chrdev_read(void *cookie, void *buffer, unsigned long length,
+	long long *position)
+{
+	struct file *file = cookie;
+	if (file->f_op->read == NULL)
+		return -EINVAL;
+	loff_t pos = *position;
+	long result = file->f_op->read(file, (char __user *)buffer, length, &pos);
+	*position = pos;
+	return result;
+}
+
+
+//	#pragma mark - mappings
+
+
+/*!	Haiku cannot fault pages in through a driver, so the mapping is made
+	complete up front: the file's mmap() sets the vma up, then its fault
+	handler runs for every page and the inserted pages (see
+	vmf_insert_pfn_prot()) become one area.
+	TODO: buffers that move afterwards (eviction) keep their old pages;
+	unmap_mapping_range() should redo the mapping.
+*/
+int
+linuxkpi_chrdev_mmap(void *cookie, unsigned long long offset,
+	unsigned long long size, int writable, void **_address)
+{
+	struct file *file = cookie;
+	if (file->f_op->mmap == NULL)
+		return -ENODEV;
+	if (size == 0 || !PAGE_ALIGNED(size) || !PAGE_ALIGNED(offset))
+		return -EINVAL;
+
+	struct vm_area_struct *vma = kzalloc(sizeof(*vma), GFP_KERNEL);
+	struct chrdev_mapping *mapping = kzalloc(sizeof(*mapping), GFP_KERNEL);
+	unsigned long pages = size >> PAGE_SHIFT;
+	unsigned long long *physical = kvcalloc(pages, sizeof(*physical),
+		GFP_KERNEL);
+	int error = -ENOMEM;
+	if (vma == NULL || mapping == NULL || physical == NULL)
+		goto err_free;
+
+	// The vma lives at 0; the real address is Haiku's choice, later.
+	vma->vm_start = 0;
+	vma->vm_end = size;
+	vma->vm_pgoff = offset >> PAGE_SHIFT;
+	vma->vm_file = file;
+	vma->__vm_flags = VM_READ | VM_SHARED | VM_MAYREAD | VM_MAYSHARE
+		| (writable ? VM_WRITE | VM_MAYWRITE : 0);
+	vma->vm_page_prot = vm_get_page_prot(vma->vm_flags);
+	vma->linuxkpi_physical = physical;
+	vma->linuxkpi_pages = pages;
+
+	error = file->f_op->mmap(file, vma);
+	if (error != 0)
+		goto err_free;
+
+	for (unsigned long i = 0; i < pages; i++) {
+		if (physical[i] != 0)
+			continue;
+		if (vma->vm_ops == NULL || vma->vm_ops->fault == NULL) {
+			error = -ENXIO;
+			goto err_close;
+		}
+		struct vm_fault vmf = {
+			.vma = vma,
+			.pgoff = vma->vm_pgoff + i,
+			.address = vma->vm_start + i * PAGE_SIZE,
+			.flags = writable ? FAULT_FLAG_WRITE : 0,
+		};
+		vm_fault_t result = vma->vm_ops->fault(&vmf);
+		if ((result & VM_FAULT_ERROR) != 0 || physical[i] == 0) {
+			error = (result & VM_FAULT_OOM) != 0 ? -ENOMEM : -EFAULT;
+			goto err_close;
+		}
+	}
+
+	int cacheMode = LKPI_HAIKU_CACHE_CACHED;
+	if (vma->linuxkpi_cache == _PAGE_CACHE_WC)
+		cacheMode = LKPI_HAIKU_CACHE_WRITE_COMBINING;
+	else if (vma->linuxkpi_cache == _PAGE_CACHE_UC)
+		cacheMode = LKPI_HAIKU_CACHE_UNCACHED;
+	int area = lkpi_haiku_map_user(physical, pages, cacheMode, writable,
+		_address);
+	if (area < 0) {
+		error = area;
+		goto err_close;
+	}
+
+	vma->linuxkpi_physical = NULL;
+	kvfree(physical);
+	get_file(file);
+	mapping->area = area;
+	mapping->vma = vma;
+	mutex_lock(&sChrdevLock);
+	list_add_tail(&mapping->link, &sMappings);
+	mutex_unlock(&sChrdevLock);
+	return area;
+
+err_close:
+	if (vma->vm_ops != NULL && vma->vm_ops->close != NULL)
+		vma->vm_ops->close(vma);
+err_free:
+	kvfree(physical);
+	kfree(mapping);
+	kfree(vma);
+	return error;
+}
+
+
+int
+linuxkpi_chrdev_munmap(void *address)
+{
+	int area = lkpi_haiku_user_area_for(address);
+	if (area < 0)
+		return area;
+
+	struct chrdev_mapping *mapping, *found = NULL;
+	mutex_lock(&sChrdevLock);
+	list_for_each_entry(mapping, &sMappings, link) {
+		if (mapping->area == area) {
+			found = mapping;
+			list_del(&found->link);
+			break;
+		}
+	}
+	mutex_unlock(&sChrdevLock);
+	if (found == NULL)
+		return -EINVAL;
+
+	lkpi_haiku_unmap_user(area);
+	struct vm_area_struct *vma = found->vma;
+	if (vma->vm_ops != NULL && vma->vm_ops->close != NULL)
+		vma->vm_ops->close(vma);
+	fput(vma->vm_file);
+	kfree(vma);
+	kfree(found);
+	return 0;
+}
diff --git a/src/libs/compat/linuxkpi/linux/device.c b/src/libs/compat/linuxkpi/linux/device.c
new file mode 100644
index 0000000000..8e2d0e93e0
--- /dev/null
+++ b/src/libs/compat/linuxkpi/linux/device.c
@@ -0,0 +1,865 @@
+/*
+ * Copyright 2026, hans2294.
+ * Distributed under the terms of the MIT License.
+ */
+
+
+/*!	The device model as far as drivers see it: devices and kobjects with
+	their reference counts, managed resources, device printing, classes,
+	platform devices, firmware loading and I2C adapters.
+
+	There is no sysfs, no uevents and no driver core matching: devices are
+	bookkeeping, and only PCI probes drivers.
+*/
+
+
+#include <linux/device.h>
+#include <linux/device/class.h>
+#include <linux/device/devres.h>
+#include <linux/kobject.h>
+#include <linux/sysfs.h>
+#include <linux/slab.h>
+#include <linux/firmware.h>
+#include <linux/platform_device.h>
+#include <linux/i2c.h>
+#include <linux/printk.h>
+
+#include <linuxkpi/chrdev.h>
+#include <linuxkpi/haiku.h>
+
+
+//	#pragma mark - kobjects
+
+
+void
+kobject_init(struct kobject *kobj, const struct kobj_type *ktype)
+{
+	kref_init(&kobj->kref);
+	INIT_LIST_HEAD(&kobj->entry);
+	kobj->ktype = ktype;
+	kobj->state_initialized = 1;
+}
+
+
+static int
+kobject_set_name_vargs(struct kobject *kobj, const char *fmt, va_list args)
+{
+	char *name = kvasprintf(GFP_KERNEL, fmt, args);
+	if (name == NULL)
+		return -ENOMEM;
+	kfree(kobj->name);
+	kobj->name = name;
+	return 0;
+}
+
+
+int
+kobject_set_name(struct kobject *kobj, const char *fmt, ...)
+{
+	va_list args;
+	va_start(args, fmt);
+	int error = kobject_set_name_vargs(kobj, fmt, args);
+	va_end(args);
+	return error;
+}
+
+
+int
+kobject_add(struct kobject *kobj, struct kobject *parent, const char *fmt, ...)
+{
+	va_list args;
+	va_start(args, fmt);
+	int error = kobject_set_name_vargs(kobj, fmt, args);
+	va_end(args);
+	kobj->parent = parent;
+	return error;
+}
+
+
+int
+kobject_init_and_add(struct kobject *kobj, const struct kobj_type *ktype,
+	struct kobject *parent, const char *fmt, ...)
+{
+	kobject_init(kobj, ktype);
+	va_list args;
+	va_start(args, fmt);
+	int error = kobject_set_name_vargs(kobj, fmt, args);
+	va_end(args);
+	kobj->parent = parent;
+	return error;
+}
+
+
+struct kobject *
+kobject_get(struct kobject *kobj)
+{
+	if (kobj != NULL)
+		kref_get(&kobj->kref);
+	return kobj;
+}
+
+
+static void
+kobject_release(struct kref *kref)
+{
+	struct kobject *kobj = container_of(kref, struct kobject, kref);
+	const char *name = kobj->name;
+	kobj->name = NULL;
+	if (kobj->ktype != NULL && kobj->ktype->release != NULL)
+		kobj->ktype->release(kobj);
+	kfree(name);
+}
+
+
+void
+kobject_put(struct kobject *kobj)
+{
+	if (kobj != NULL)
+		kref_put(&kobj->kref, kobject_release);
+}
+
+
+int
+kobject_uevent_env(struct kobject *kobj, enum kobject_action action,
+	char *envp[])
+{
+	return 0;
+}
+
+
+int
+kset_register(struct kset *kset)
+{
+	INIT_LIST_HEAD(&kset->list);
+	spin_lock_init(&kset->list_lock);
+	return 0;
+}
+
+
+const struct sysfs_ops kobj_sysfs_ops = {};
+
+
+//	#pragma mark - devices
+
+
+static void
+device_release(struct kobject *kobj)
+{
+	struct device *dev = container_of(kobj, struct device, kobj);
+	devres_release_all(dev);
+	if (dev->release != NULL)
+		dev->release(dev);
+	else if (dev->type != NULL && dev->type->release != NULL)
+		dev->type->release(dev);
+	else if (dev->class != NULL && dev->class->dev_release != NULL)
+		dev->class->dev_release(dev);
+}
+
+
+static const struct kobj_type sDeviceKtype = {
+	.release = device_release,
+};
+
+
+void
+device_initialize(struct device *dev)
+{
+	kobject_init(&dev->kobj, &sDeviceKtype);
+	linuxkpi_mutex_init(&dev->mutex, "device");
+	INIT_LIST_HEAD(&dev->devres_head);
+	spin_lock_init(&dev->devres_lock);
+	INIT_LIST_HEAD(&dev->dma_pools);
+	dev->numa_node = NUMA_NO_NODE;
+}
+
+
+int
+device_add(struct device *dev)
+{
+	if (dev->kobj.name == NULL && dev->init_name != NULL)
+		dev_set_name(dev, "%s", dev->init_name);
+	linuxkpi_chrdev_device_added(dev);
+	return 0;
+}
+
+
+int
+device_register(struct device *dev)
+{
+	device_initialize(dev);
+	return device_add(dev);
+}
+
+
+void
+device_del(struct device *dev)
+{
+	linuxkpi_chrdev_device_removed(dev);
+}
+
+
+void
+device_unregister(struct device *dev)
+{
+	device_del(dev);
+	put_device(dev);
+}
+
+
+struct device *
+get_device(struct device *dev)
+{
+	if (dev != NULL)
+		kobject_get(&dev->kobj);
+	return dev;
+}
+
+
+void
+put_device(struct device *dev)
+{
+	if (dev != NULL)
+		kobject_put(&dev->kobj);
+}
+
+
+int
+dev_set_name(struct device *dev, const char *fmt, ...)
+{
+	va_list args;
+	va_start(args, fmt);
+	int error = kobject_set_name_vargs(&dev->kobj, fmt, args);
+	va_end(args);
+	return error;
+}
+
+
+const char *
+dev_name(const struct device *dev)
+{
+	if (dev->kobj.name != NULL)
+		return dev->kobj.name;
+	return dev->init_name != NULL ? dev->init_name : "";
+}
+
+
+const char *
+dev_driver_string(const struct device *dev)
+{
+	if (dev->driver != NULL && dev->driver->name != NULL)
+		return dev->driver->name;
+	if (dev->bus != NULL && dev->bus->name != NULL)
+		return dev->bus->name;
+	if (dev->class != NULL && dev->class->name != NULL)
+		return dev->class->name;
+	return "";
+}
+
+
+/* Linux keeps these between consumer and supplier for runtime power
+ * management; nothing here looks at them. */
+struct device_link {
+	struct device *consumer;
+	struct device *supplier;
+};
+
+
+struct device_link *
+device_link_add(struct device *consumer, struct device *supplier, u32 flags)
+{
+	struct device_link *link = kzalloc(sizeof(*link), GFP_KERNEL);
+	if (link != NULL) {
+		link->consumer = consumer;
+		link->supplier = supplier;
+	}
+	return link;
+}
+
+
+void
+device_link_del(struct device_link *link)
+{
+	kfree(link);
+}
+
+
+//	#pragma mark - printing
+
+
+void
+_dev_printk(const char *level, const struct device *dev, const char *fmt, ...)
+{
+	struct va_format vaf;
+	va_list args;
+	va_start(args, fmt);
+	vaf.fmt = fmt;
+	vaf.va = &args;
+	if (dev != NULL)
+		printk("%s%s %s: %pV", level, dev_driver_string(dev), dev_name(dev),
+			&vaf);
+	else
+		printk("%s(NULL device): %pV", level, &vaf);
+	va_end(args);
+}
+
+
+int
+dev_err_probe(const struct device *dev, int err, const char *fmt, ...)
+{
+	struct va_format vaf;
+	va_list args;
+	va_start(args, fmt);
+	vaf.fmt = fmt;
+	vaf.va = &args;
+	if (err != -EPROBE_DEFER)
+		_dev_printk(KERN_ERR, dev, "error %pe: %pV", ERR_PTR(err), &vaf);
+	va_end(args);
+	return err;
+}
+
+
+//	#pragma mark - managed resources
+
+
+/*!	Managed resources sit on the device's list, newest last; groups are
+	marker nodes. Releasing goes from the end back.
+*/
+struct devres_node {
+	struct list_head entry;
+	dr_release_t release;
+	const char *name;
+	void *group;		/* group marker: the group's id */
+	unsigned long long data[];
+};
+
+struct devres_action {
+	void (*action)(void *);
+	void *data;
+};
+
+
+static struct devres_node *
+node_of(void *res)
+{
+	return container_of(res, struct devres_node, data);
+}
+
+
+void *
+__devres_alloc(dr_release_t release, size_t size, gfp_t gfp, const char *name)
+{
+	struct devres_node *node = kmalloc(sizeof(*node) + size, gfp | __GFP_ZERO);
+	if (node == NULL)
+		return NULL;
+	INIT_LIST_HEAD(&node->entry);
+	node->release = release;
+	node->name = name;
+	return node->data;
+}
+
+
+void
+devres_free(void *res)
+{
+	if (res != NULL)
+		kfree(node_of(res));
+}
+
+
+void
+devres_add(struct device *dev, void *res)
+{
+	struct devres_node *node = node_of(res);
+	spin_lock(&dev->devres_lock);
+	list_add_tail(&node->entry, &dev->devres_head);
+	spin_unlock(&dev->devres_lock);
+}
+
+
+static struct devres_node *
+find_node(struct device *dev, dr_release_t release, dr_match_t match,
+	void *match_data)
+{
+	struct devres_node *node;
+	list_for_each_entry_reverse(node, &dev->devres_head, entry) {
+		if (node->group != NULL || node->release != release)
+			continue;
+		if (match != NULL && !match(dev, node->data, match_data))
+			continue;
+		return node;
+	}
+	return NULL;
+}
+
+
+void *
+devres_find(struct device *dev, dr_release_t release, dr_match_t match,
+	void *match_data)
+{
+	spin_lock(&dev->devres_lock);
+	struct devres_node *node = find_node(dev, release, match, match_data);
+	spin_unlock(&dev->devres_lock);
+	return node != NULL ? node->data : NULL;
+}
+
+
+int
+devres_destroy(struct device *dev, dr_release_t release, dr_match_t match,
+	void *match_data)
+{
+	spin_lock(&dev->devres_lock);
+	struct devres_node *node = find_node(dev, release, match, match_data);
+	if (node != NULL)
+		list_del(&node->entry);
+	spin_unlock(&dev->devres_lock);
+	if (node == NULL)
+		return -ENOENT;
+	kfree(node);
+	return 0;
+}
+
+
+int
+devres_release(struct device *dev, dr_release_t release, dr_match_t match,
+	void *match_data)
+{
+	spin_lock(&dev->devres_lock);
+	struct devres_node *node = find_node(dev, release, match, match_data);
+	if (node != NULL)
+		list_del(&node->entry);
+	spin_unlock(&dev->devres_lock);
+	if (node == NULL)
+		return -ENOENT;
+	node->release(dev, node->data);
+	kfree(node);
+	return 0;
+}
+
+
+/*!	Releases the nodes after \a first (or all) from the newest back. */
+static void
+release_nodes(struct device *dev, struct devres_node *first)
+{
+	for (;;) {
+		spin_lock(&dev->devres_lock);
+		if (list_empty(&dev->devres_head)) {
+			spin_unlock(&dev->devres_lock);
+			return;
+		}
+		struct devres_node *node = list_last_entry(&dev->devres_head,
+			struct devres_node, entry);
+		if (node == first) {
+			spin_unlock(&dev->devres_lock);
+			return;
+		}
+		list_del(&node->entry);
+		spin_unlock(&dev->devres_lock);
+
+		if (node->group == NULL && node->release != NULL)
+			node->release(dev, node->data);
+		kfree(node);
+	}
+}
+
+
+void
+devres_release_all(struct device *dev)
+{
+	if (dev->devres_head.next == NULL)
+		return;
+	release_nodes(dev, NULL);
+}
+
+
+void *
+devres_open_group(struct device *dev, void *id, gfp_t gfp)
+{
+	struct devres_node *node = kzalloc(sizeof(*node), gfp);
+	if (node == NULL)
+		return NULL;
+	node->group = id != NULL ? id : node;
+	spin_lock(&dev->devres_lock);
+	list_add_tail(&node->entry, &dev->devres_head);
+	spin_unlock(&dev->devres_lock);
+	return node->group;
+}
+
+
+static struct devres_node *
+find_group(struct device *dev, void *id)
+{
+	struct devres_node *node;
+	list_for_each_entry_reverse(node, &dev->devres_head, entry) {
+		if (node->group != NULL && (id == NULL || node->group == id))
+			return node;
+	}
+	return NULL;
+}
+
+
+void
+devres_close_group(struct device *dev, void *id)
+{
+	// Groups are not nested in a way that needs a closing marker here.
+}
+
+
+void
+devres_remove_group(struct device *dev, void *id)
+{
+	spin_lock(&dev->devres_lock);
+	struct devres_node *group = find_group(dev, id);
+	if (group != NULL)
+		list_del(&group->entry);
+	spin_unlock(&dev->devres_lock);
+	kfree(group);
+}
+
+
+int
+devres_release_group(struct device *dev, void *id)
+{
+	spin_lock(&dev->devres_lock);
+	struct devres_node *group = find_group(dev, id);
+	spin_unlock(&dev->devres_lock);
+	if (group == NULL)
+		return -ENOENT;
+	release_nodes(dev, group);
+	spin_lock(&dev->devres_lock);
+	list_del(&group->entry);
+	spin_unlock(&dev->devres_lock);
+	kfree(group);
+	return 1;
+}
+
+
+static void
+devm_action_release(struct device *dev, void *res)
+{
+	struct devres_action *action = res;
+	action->action(action->data);
+}
+
+
+static int
+devm_action_match(struct device *dev, void *res, void *match_data)
+{
+	struct devres_action *action = res, *wanted = match_data;
+	return action->action == wanted->action && action->data == wanted->data;
+}
+
+
+int
+__devm_add_action(struct device *dev, void (*action)(void *), void *data,
+	const char *name)
+{
+	struct devres_action *res = __devres_alloc(devm_action_release,
+		sizeof(*res), GFP_KERNEL, name);
+	if (res == NULL)
+		return -ENOMEM;
+	res->action = action;
+	res->data = data;
+	devres_add(dev, res);
+	return 0;
+}
+
+
+void
+devm_remove_action(struct device *dev, void (*action)(void *), void *data)
+{
+	struct devres_action wanted = { action, data };
+	devres_destroy(dev, devm_action_release, devm_action_match, &wanted);
+}
+
+
+void
+devm_release_action(struct device *dev, void (*action)(void *), void *data)
+{
+	struct devres_action wanted = { action, data };
+	devres_release(dev, devm_action_release, devm_action_match, &wanted);
+}
+
+
+static void
+devm_kmalloc_release(struct device *dev, void *res)
+{
+}
+
+
+void *
+devm_kmalloc(struct device *dev, size_t size, gfp_t gfp)
+{
+	void *res = __devres_alloc(devm_kmalloc_release, size, gfp, "kmalloc");
+	if (res != NULL)
+		devres_add(dev, res);
+	return res;
+}
+
+
+static int
+devm_kmalloc_match(struct device *dev, void *res, void *match_data)
+{
+	return res == match_data;
+}
+
+
+void
+devm_kfree(struct device *dev, const void *p)
+{
+	devres_destroy(dev, devm_kmalloc_release, devm_kmalloc_match, (void *)p);
+}
+
+
+char *
+devm_kstrdup(struct device *dev, const char *s, gfp_t gfp)
+{
+	size_t length = strlen(s) + 1;
+	char *copy = devm_kmalloc(dev, length, gfp);
+	if (copy != NULL)
+		memcpy(copy, s, length);
+	return copy;
+}
+
+
+char *
+devm_kasprintf(struct device *dev, gfp_t gfp, const char *fmt, ...)
+{
+	va_list args;
+	va_start(args, fmt);
+	char *string = kvasprintf(gfp, fmt, args);
+	va_end(args);
+	if (string == NULL)
+		return NULL;
+	char *copy = devm_kstrdup(dev, string, gfp);
+	kfree(string);
+	return copy;
+}
+
+
+//	#pragma mark - classes
+
+
+struct class *
+class_create(const char *name)
+{
+	struct class *cls = kzalloc(sizeof(*cls), GFP_KERNEL);
+	if (cls == NULL)
+		return ERR_PTR(-ENOMEM);
+	cls->name = name;
+	return cls;
+}
+
+
+void
+class_destroy(const struct class *cls)
+{
+	if (!IS_ERR_OR_NULL(cls))
+		kfree(cls);
+}
+
+
+int
+class_create_file(const struct class *class, const struct class_attribute *attr)
+{
+	return 0;
+}
+
+
+void
+class_remove_file(const struct class *class,
+	const struct class_attribute *attr)
+{
+}
+
+
+//	#pragma mark - platform devices
+
+
+static void
+platform_device_release(struct device *dev)
+{
+	struct platform_device *pdev = container_of(dev, struct platform_device,
+		dev);
+	kfree(pdev->resource);
+	kfree(pdev);
+}
+
+
+struct platform_device *
+platform_device_register_simple(const char *name, int id,
+	const struct resource *res, unsigned int num)
+{
+	struct platform_device *pdev = kzalloc(sizeof(*pdev), GFP_KERNEL);
+	if (pdev == NULL)
+		return ERR_PTR(-ENOMEM);
+	pdev->name = name;
+	pdev->id = id;
+	device_initialize(&pdev->dev);
+	pdev->dev.release = platform_device_release;
+	if (id >= 0)
+		dev_set_name(&pdev->dev, "%s.%d", name, id);
+	else
+		dev_set_name(&pdev->dev, "%s", name);
+	if (num > 0) {
+		pdev->resource = kmemdup(res, num * sizeof(*res), GFP_KERNEL);
+		pdev->num_resources = pdev->resource != NULL ? num : 0;
+	}
+	return pdev;
+}
+
+
+void
+platform_device_unregister(struct platform_device *pdev)
+{
+	if (!IS_ERR_OR_NULL(pdev))
+		device_unregister(&pdev->dev);
+}
+
+
+//	#pragma mark - firmware
+
+
+static int
+load_firmware(const struct firmware **_fw, const char *name,
+	struct device *device, bool warn)
+{
+	*_fw = NULL;
+	struct firmware *fw = kzalloc(sizeof(*fw), GFP_KERNEL);
+	if (fw == NULL)
+		return -ENOMEM;
+
+	void *data;
+	unsigned long size;
+	int error = lkpi_haiku_read_firmware(name, &data, &size);
+	if (error != 0) {
+		if (warn) {
+			if (device != NULL)
+				dev_err(device, "firmware %s could not be loaded: %d\n",
+					name, error);
+			else
+				pr_err("linuxkpi: firmware %s could not be loaded: %d\n",
+					name, error);
+		}
+		kfree(fw);
+		return error;
+	}
+
+	fw->data = data;
+	fw->size = size;
+	fw->priv = data;
+	*_fw = fw;
+	return 0;
+}
+
+
+int
+request_firmware(const struct firmware **fw, const char *name,
+	struct device *device)
+{
+	return load_firmware(fw, name, device, true);
+}
+
+
+int
+request_firmware_direct(const struct firmware **fw, const char *name,
+	struct device *device)
+{
+	return load_firmware(fw, name, device, false);
+}
+
+
+int
+firmware_request_nowarn(const struct firmware **fw, const char *name,
+	struct device *device)
+{
+	return load_firmware(fw, name, device, false);
+}
+
+
+void
+release_firmware(const struct firmware *fw)
+{
+	if (fw == NULL)
+		return;
+	lkpi_haiku_free(fw->priv);
+	kfree(fw);
+}
+
+
+//	#pragma mark - I2C
+
+
+static atomic_t sNextAdapter = ATOMIC_INIT(0);
+
+
+int
+i2c_add_adapter(struct i2c_adapter *adap)
+{
+	adap->nr = atomic_inc_return(&sNextAdapter) - 1;
+	if (adap->timeout == 0)
+		adap->timeout = HZ;
+	return 0;
+}
+
+
+int
+i2c_add_numbered_adapter(struct i2c_adapter *adap)
+{
+	if (adap->nr < 0)
+		return i2c_add_adapter(adap);
+	if (adap->timeout == 0)
+		adap->timeout = HZ;
+	return 0;
+}
+
+
+void
+i2c_del_adapter(struct i2c_adapter *adap)
+{
+}
+
+
+int
+i2c_transfer(struct i2c_adapter *adap, struct i2c_msg *msgs, int num)
+{
+	const struct i2c_algorithm *algo = adap->algo;
+	int (*xfer)(struct i2c_adapter *, struct i2c_msg *, int)
+		= algo->master_xfer != NULL ? algo->master_xfer : algo->xfer;
+	if (xfer == NULL)
+		return -EOPNOTSUPP;
+
+	int result = -EAGAIN;
+	for (int attempt = 0; attempt <= adap->retries; attempt++) {
+		result = xfer(adap, msgs, num);
+		if (result != -EAGAIN)
+			break;
+	}
+	return result;
+}
+
+
+struct i2c_client *
+i2c_new_client_device(struct i2c_adapter *adap, struct i2c_board_info const *info)
+{
+	struct i2c_client *client = kzalloc(sizeof(*client), GFP_KERNEL);
+	if (client == NULL)
+		return ERR_PTR(-ENOMEM);
+	client->adapter = adap;
+	client->addr = info->addr;
+	client->flags = info->flags;
+	strscpy(client->name, info->type, sizeof(client->name));
+	device_initialize(&client->dev);
+	client->dev.parent = &adap->dev;
+	client->dev.platform_data = info->platform_data;
+	return client;
+}
+
+
+void
+i2c_unregister_device(struct i2c_client *client)
+{
+	if (IS_ERR_OR_NULL(client))
+		return;
+	put_device(&client->dev);
+	kfree(client);
+}
