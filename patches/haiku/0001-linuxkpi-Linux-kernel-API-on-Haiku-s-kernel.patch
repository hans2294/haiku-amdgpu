new file mode 100644
index 0000000000..ae6f231688
--- /dev/null
+++ b/src/libs/compat/linuxkpi/include/linux/tracepoint.h
@@ -0,0 +1,36 @@
+/*
+ * Copyright 2026, hans2294.
+ * Distributed under the terms of the MIT License.
+ */
+#ifndef _LINUXKPI_LINUX_TRACEPOINT_H
+#define _LINUXKPI_LINUX_TRACEPOINT_H
+
+#include <linux/types.h>
+#include <linux/compiler.h>
+/* Tracepoints compile to nothing: every trace_foo() is an empty inline. */
+#define PARAMS(args...)	args
+#define TP_PROTO(args...)	args
+#define TP_ARGS(args...)	args
+#define TP_CONDITION(args...)	args
+#define DECLARE_EVENT_CLASS(name, proto, args, tstruct, assign, print)
+#define DEFINE_EVENT(template, name, proto, args) \
+	static inline void trace_##name(proto) {} \
+	static inline bool trace_##name##_enabled(void) { return false; }
+#define DEFINE_EVENT_PRINT(template, name, proto, args, print) \
+	DEFINE_EVENT(template, name, PARAMS(proto), PARAMS(args))
+#define DEFINE_EVENT_CONDITION(template, name, proto, args, cond) \
+	DEFINE_EVENT(template, name, PARAMS(proto), PARAMS(args))
+#define TRACE_EVENT(name, proto, args, struct, assign, print) \
+	DEFINE_EVENT(, name, PARAMS(proto), PARAMS(args))
+#define TRACE_EVENT_CONDITION(name, proto, args, cond, struct, assign, print) \
+	DEFINE_EVENT(, name, PARAMS(proto), PARAMS(args))
+#define TRACE_EVENT_FN(name, proto, args, struct, assign, print, reg, unreg) \
+	DEFINE_EVENT(, name, PARAMS(proto), PARAMS(args))
+#define DECLARE_TRACE(name, proto, args) DEFINE_EVENT(, name, PARAMS(proto), PARAMS(args))
+#define TRACE_DEFINE_ENUM(x)
+#define TRACE_DEFINE_SIZEOF(x)
+#define tracepoint_string(str)	str
+#define EXPORT_TRACEPOINT_SYMBOL(name)
+#define EXPORT_TRACEPOINT_SYMBOL_GPL(name)
+
+#endif
