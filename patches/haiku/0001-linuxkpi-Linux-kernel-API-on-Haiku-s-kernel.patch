+/*
+ * Copyright 2026, hans2294.
+ * Distributed under the terms of the MIT License.
+ */
+#ifndef _LINUXKPI_LINUX_LOCAL_LOCK_H
+#define _LINUXKPI_LINUX_LOCAL_LOCK_H
+
+#include <linux/percpu.h>
+#include <linux/spinlock.h>
+/* With one shared instance per "per-CPU" variable, the local lock is a real lock. */
+typedef struct { spinlock_t lock; } local_lock_t;
+#define INIT_LOCAL_LOCK(lockname)	{ .lock = __SPIN_LOCK_UNLOCKED(lockname) }
+#define local_lock_init(l)		spin_lock_init(&(l)->lock)
+#define local_lock(l)			spin_lock(&(l)->lock)
+#define local_unlock(l)			spin_unlock(&(l)->lock)
+#define local_lock_irqsave(l, flags)	spin_lock_irqsave(&(l)->lock, flags)
+#define local_unlock_irqrestore(l, flags)	spin_unlock_irqrestore(&(l)->lock, flags)
+#define local_lock_irq(l)		spin_lock_irq(&(l)->lock)
+#define local_unlock_irq(l)		spin_unlock_irq(&(l)->lock)
+
+#endif
