+ */
+#ifndef _LINUXKPI_LINUX_DMA_MAPPING_H
+#define _LINUXKPI_LINUX_DMA_MAPPING_H
+
+#include <linux/device.h>
+#include <linux/err.h>
+#include <linux/scatterlist.h>
