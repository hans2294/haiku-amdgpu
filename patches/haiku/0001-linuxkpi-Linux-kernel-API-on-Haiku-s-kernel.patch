+
+#include <linux/compiler_types.h>
+
+#define likely(x)				__builtin_expect(!!(x), 1)
+#define unlikely(x)				__builtin_expect(!!(x), 0)
+#define likely_notrace(x)		likely(x)
+#define unlikely_notrace(x)		unlikely(x)
