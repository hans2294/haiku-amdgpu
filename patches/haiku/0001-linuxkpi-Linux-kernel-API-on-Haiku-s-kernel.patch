+int init_srcu_struct(struct srcu_struct *ssp);
+void cleanup_srcu_struct(struct srcu_struct *ssp);
+static inline int srcu_read_lock(struct srcu_struct *ssp) { rcu_read_lock(); return 0; }
+static inline void srcu_read_unlock(struct srcu_struct *ssp, int idx) { rcu_read_unlock(); }
+#define srcu_dereference(p, ssp)	READ_ONCE(p)
+void synchronize_srcu(struct srcu_struct *ssp);
+
+#endif
