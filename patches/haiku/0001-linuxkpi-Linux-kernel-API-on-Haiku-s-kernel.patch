diff --git a/src/libs/compat/linuxkpi/include/linux/bitfield.h b/src/libs/compat/linuxkpi/include/linux/bitfield.h
new file mode 100644
index 0000000000..2fb1d67dfe
--- /dev/null
+++ b/src/libs/compat/linuxkpi/include/linux/bitfield.h
@@ -0,0 +1,24 @@
+/*
