+
+/*!	A small sscanf: %d %i %u %x %llx %lu %ld %s %c and literal text, which is
+	what the DRM and amdgpu callers use.
+*/
+int
+vsscanf(const char *input, const char *fmt, va_list args)
+{
+	int matched = 0;
+	while (*fmt) {
+		if (isspace(*fmt)) {
+			input = skip_spaces(input);
+			fmt++;
+			continue;
+		}
+		if (*fmt != '%') {
+			if (*input++ != *fmt++)
+				break;
+			continue;
+		}
+		fmt++;
+		int longness = 0;
+		while (*fmt == 'l' || *fmt == 'h' || *fmt == 'z') {
+			if (*fmt == 'l')
+				longness++;
+			fmt++;
+		}
+		char conversion = *fmt++;
+		if (conversion == 'c') {
+			if (!*input)
+				break;
+			*va_arg(args, char *) = *input++;
+			matched++;
+			continue;
+		}
+		input = skip_spaces(input);
+		if (conversion == 's') {
+			char *out = va_arg(args, char *);
+			while (*input && !isspace(*input))
+				*out++ = *input++;
+			*out = '\0';
+			matched++;
+			continue;
+		}
+		unsigned base = conversion == 'x' || conversion == 'X' ? 16
+			: conversion == 'i' ? 0 : 10;
+		bool negative = false;
+		if ((conversion == 'd' || conversion == 'i') && *input == '-') {
+			negative = true;
+			input++;
+		}
+		char *end;
+		unsigned long long value = simple_strtoull(input, &end, base);
+		if (end == input)
+			break;
+		input = end;
+		if (negative)
+			value = -value;
+		if (longness >= 2)
+			*va_arg(args, unsigned long long *) = value;
+		else if (longness == 1)
+			*va_arg(args, unsigned long *) = value;
+		else
+			*va_arg(args, unsigned int *) = value;
+		matched++;
+	}
+	return matched;
+}
+
+
+int
+sscanf(const char *input, const char *fmt, ...)
+{
+	va_list args;
+	va_start(args, fmt);
+	int matched = vsscanf(input, fmt, args);
+	va_end(args);
+	return matched;
+}
