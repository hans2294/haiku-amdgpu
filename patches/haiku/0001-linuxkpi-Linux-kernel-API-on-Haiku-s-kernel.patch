new file mode 100644
index 0000000000..53ee6859f9
--- /dev/null
+++ b/src/libs/compat/linuxkpi/include/asm/page.h
@@ -0,0 +1,37 @@
+/*
+ * Copyright 2026, hans2294.
+ * Distributed under the terms of the MIT License.
+ */
+#ifndef _LINUXKPI_ASM_PAGE_H
+#define _LINUXKPI_ASM_PAGE_H
+
+#include <linux/types.h>
+#include <linux/const.h>
+#include <linux/bitops.h>
+#include <linux/align.h>
+#define PAGE_SHIFT	12
+#define PAGE_SIZE	(_AC(1, UL) << PAGE_SHIFT)
+#define PAGE_MASK	(~(PAGE_SIZE - 1))
+#define PFN_PHYS(x)	((phys_addr_t)(x) << PAGE_SHIFT)
+#define PHYS_PFN(x)	((unsigned long)((x) >> PAGE_SHIFT))
+#define PFN_UP(x)	(((x) + PAGE_SIZE - 1) >> PAGE_SHIFT)
+#define PFN_DOWN(x)	((x) >> PAGE_SHIFT)
+#define PAGE_ALIGN(addr)	ALIGN(addr, PAGE_SIZE)
+#define PAGE_ALIGN_DOWN(addr)	ALIGN_DOWN(addr, PAGE_SIZE)
+#define PAGE_ALIGNED(addr)	IS_ALIGNED((unsigned long)(addr), PAGE_SIZE)
+#define offset_in_page(p)	((unsigned long)(p) & ~PAGE_MASK)
+#define HPAGE_SHIFT		21
+#define HPAGE_PMD_ORDER	(HPAGE_SHIFT - PAGE_SHIFT)
+#define HPAGE_PMD_NR	(1 << HPAGE_PMD_ORDER)
+#define HPAGE_PMD_SIZE	(1UL << HPAGE_SHIFT)
+#define PMD_SHIFT		21
+#define PMD_SIZE		(1UL << PMD_SHIFT)
+#define PMD_MASK		(~(PMD_SIZE - 1))
+#define PUD_SHIFT		30
+#define PUD_SIZE		(1UL << PUD_SHIFT)
+#define PUD_MASK		(~(PUD_SIZE - 1))
+static inline __attribute_const__ int get_order(unsigned long size)
+{ if (size <= PAGE_SIZE) return 0; return fls64(size - 1) - PAGE_SHIFT; }
+#define clear_page(p)	__builtin_memset((p), 0, PAGE_SIZE)
+
+#endif
