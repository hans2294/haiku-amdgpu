+#define memset_startat(obj, v, member) \
+	memset((u8 *)(obj) + offsetof(typeof(*(obj)), member), v, \
+		sizeof(*(obj)) - offsetof(typeof(*(obj)), member))
+static inline void memcpy_and_pad(void *dest, size_t dest_len, const void *src, size_t count, int pad)
+{ if (dest_len > count) { memcpy(dest, src, count); memset((char *)dest + count, pad, dest_len - count); } else memcpy(dest, src, dest_len); }
+#define strtomem_pad(dest, src, pad)	memcpy_and_pad(dest, sizeof(dest), src, strnlen(src, sizeof(dest)), pad)
