+size_t kmalloc_size_roundup(size_t size);
+DEFINE_FREE(kfree, void *, if (!IS_ERR_OR_NULL(_T)) kfree(_T))
+static inline void *kzalloc(size_t size, gfp_t flags) { return kmalloc(size, flags | __GFP_ZERO); }
+static inline void *kmalloc_array(size_t n, size_t size, gfp_t flags) { return kmalloc(array_size(n, size), flags); }
+static inline void *kcalloc(size_t n, size_t size, gfp_t flags) { return kmalloc_array(n, size, flags | __GFP_ZERO); }
+static inline void *krealloc_array(void *p, size_t n, size_t size, gfp_t flags) { return krealloc(p, array_size(n, size), flags); }
+#define kmalloc_node(size, flags, node)	kmalloc(size, flags)
+#define kzalloc_node(size, flags, node)	kzalloc(size, flags)
+#define kcalloc_node(n, size, flags, node)	kcalloc(n, size, flags)
+#define kmalloc_array_node(n, size, flags, node)	kmalloc_array(n, size, flags)
+#define kmalloc_track_caller(size, flags)	kmalloc(size, flags)
+#define kmalloc_node_track_caller(size, flags, node)	kmalloc(size, flags)
+/* Newer helpers sized from the object type */
+#define kmalloc_obj(p, flags)		kmalloc(sizeof(*(p)), flags)
+#define kzalloc_obj(p, flags)		kzalloc(sizeof(*(p)), flags)
+#define kzalloc_objs(p, n, flags)	kcalloc(n, sizeof(*(p)), flags)
+#define kmalloc_objs(p, n, flags)	kmalloc_array(n, sizeof(*(p)), flags)
+
+void *kvmalloc(size_t size, gfp_t flags) __malloc;
+void kvfree(const void *addr);
+void kvfree_sensitive(const void *addr, size_t len);
+void *kvrealloc(const void *p, size_t size, gfp_t flags);
+DEFINE_FREE(kvfree, void *, if (!IS_ERR_OR_NULL(_T)) kvfree(_T))
+static inline void *kvzalloc(size_t size, gfp_t flags) { return kvmalloc(size, flags | __GFP_ZERO); }
+static inline void *kvmalloc_array(size_t n, size_t size, gfp_t flags) { return kvmalloc(array_size(n, size), flags); }
+static inline void *kvcalloc(size_t n, size_t size, gfp_t flags) { return kvmalloc_array(n, size, flags | __GFP_ZERO); }
+#define kvmalloc_node(size, flags, node)	kvmalloc(size, flags)
+#define kvzalloc_node(size, flags, node)	kvzalloc(size, flags)
+
+struct kmem_cache;
+struct kmem_cache *kmem_cache_create(const char *name, unsigned int size, unsigned int align,
+	slab_flags_t flags, void (*ctor)(void *));
+struct kmem_cache *kmem_cache_create_usercopy(const char *name, unsigned int size, unsigned int align,
+	slab_flags_t flags, unsigned int useroffset, unsigned int usersize, void (*ctor)(void *));
+#define KMEM_CACHE(__struct, __flags) \
+	kmem_cache_create(#__struct, sizeof(struct __struct), __alignof__(struct __struct), (__flags), NULL)
+void kmem_cache_destroy(struct kmem_cache *s);
+void *kmem_cache_alloc(struct kmem_cache *s, gfp_t flags) __malloc;
+void kmem_cache_free(struct kmem_cache *s, void *objp);
+#define kmem_cache_alloc_lru(s, lru, flags)	kmem_cache_alloc(s, flags)
+struct list_lru;
+static inline void *kmem_cache_zalloc(struct kmem_cache *k, gfp_t flags) { return kmem_cache_alloc(k, flags | __GFP_ZERO); }
+int kmem_cache_shrink(struct kmem_cache *s);
+
+#endif
