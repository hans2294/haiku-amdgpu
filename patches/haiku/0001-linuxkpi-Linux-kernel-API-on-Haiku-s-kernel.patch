+++ b/src/libs/compat/linuxkpi/include/linux/log2.h
@@ -0,0 +1,25 @@
+/*
+ * Copyright 2026, hans2294.
+ * Distributed under the terms of the MIT License.
+ */
+#ifndef _LINUXKPI_LINUX_LOG2_H
+#define _LINUXKPI_LINUX_LOG2_H
+
+#include <linux/bitops.h>
+
+static inline __attribute_const__ int ilog2_u64(u64 n) { return 63 - __builtin_clzll(n); }
+#define ilog2(n) ((n) < 2 ? 0 : ilog2_u64(n))
+#define is_power_of_2(n)	((n) != 0 && (((n) & ((n) - 1)) == 0))
+static inline __attribute_const__ unsigned long __roundup_pow_of_two(unsigned long n)
+{ return n <= 1 ? 1 : 1UL << fls_long(n - 1); }
+static inline __attribute_const__ unsigned long __rounddown_pow_of_two(unsigned long n)
+{ return 1UL << (fls_long(n) - 1); }
+#define roundup_pow_of_two(n)	__roundup_pow_of_two(n)
+#define rounddown_pow_of_two(n)	__rounddown_pow_of_two(n)
+#define order_base_2(n)		((n) > 1 ? ilog2((n) - 1) + 1 : 0)
+static inline int get_count_order(unsigned int count)
+{ return count == 0 ? -1 : (int)order_base_2(count); }
+static inline int get_count_order_long(unsigned long l)
+{ return l == 0 ? -1 : (int)order_base_2(l); }
+
+#endif
