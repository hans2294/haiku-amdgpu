+
+#define DEFINE_KSTRTO_FROM_USER(name, type, base_name) \
+int name(const char __user *s, size_t count, unsigned int base, type *res) \
+{ \
+	char buffer[32]; \
+	count = min(count, sizeof(buffer) - 1); \
+	if (copy_from_user(buffer, s, count) != 0) \
+		return -EFAULT; \
+	buffer[count] = '\0'; \
+	return base_name(buffer, base, res); \
+}
+
+DEFINE_KSTRTO_FROM_USER(kstrtoint_from_user, int, kstrtoint)
+DEFINE_KSTRTO_FROM_USER(kstrtouint_from_user, unsigned int, kstrtouint)
+DEFINE_KSTRTO_FROM_USER(kstrtoul_from_user, unsigned long, kstrtoul)
+DEFINE_KSTRTO_FROM_USER(kstrtou32_from_user, u32, kstrtou32)
