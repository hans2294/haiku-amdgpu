+//	#pragma mark - dumps
+
+
+int
+hex_dump_to_buffer(const void *buf, size_t len, int rowsize, int groupsize,
+	char *linebuf, size_t linebuflen, bool ascii)
+{
+	const u8 *bytes = buf;
+	size_t used = 0;
+	linebuf[0] = '\0';
+	if (rowsize != 16 && rowsize != 32)
+		rowsize = 16;
+	len = min_t(size_t, len, rowsize);
+	for (size_t i = 0; i < len && used + 4 < linebuflen; i++) {
+		used += scnprintf(linebuf + used, linebuflen - used, "%s%02x",
+			i > 0 && groupsize > 0 && i % groupsize == 0 ? " " : "", bytes[i]);
+	}
+	if (ascii && used + len + 3 < linebuflen) {
+		used += scnprintf(linebuf + used, linebuflen - used, "  ");
+		for (size_t i = 0; i < len; i++)
+			linebuf[used++] = isprint(bytes[i]) ? bytes[i] : '.';
+		linebuf[used] = '\0';
+	}
+	return used;
+}
+
+
+void
+print_hex_dump(const char *level, const char *prefix_str, int prefix_type,
+	int rowsize, int groupsize, const void *buf, size_t len, bool ascii)
+{
+	char line[200];
+	if (rowsize != 16 && rowsize != 32)
+		rowsize = 16;
+	for (size_t i = 0; i < len; i += rowsize) {
+		hex_dump_to_buffer((const u8 *)buf + i, len - i, rowsize, groupsize,
+			line, sizeof(line), ascii);
+		if (prefix_type == DUMP_PREFIX_OFFSET)
+			printk("%s%s%.8zx: %s\n", level, prefix_str, i, line);
+		else if (prefix_type == DUMP_PREFIX_ADDRESS)
+			printk("%s%s%p: %s\n", level, prefix_str, (const u8 *)buf + i, line);
+		else
+			printk("%s%s%s\n", level, prefix_str, line);
+	}
+}
