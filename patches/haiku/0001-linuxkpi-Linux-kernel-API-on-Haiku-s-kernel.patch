+
+static int
+parse_unsigned(const char *s, unsigned int base, unsigned long long *result)
+{
+	if (base == 0) {
+		if (s[0] == '0' && tolower(s[1]) == 'x' && isxdigit(s[2])) {
+			base = 16;
+			s += 2;
+		} else if (s[0] == '0') {
+			base = 8;
+		} else
+			base = 10;
+	} else if (base == 16 && s[0] == '0' && tolower(s[1]) == 'x')
+		s += 2;
+
+	unsigned long long value = 0;
+	const char *start = s;
+	for (; *s != '\0'; s++) {
+		unsigned digit;
+		if (isdigit(*s))
+			digit = *s - '0';
+		else if (isxdigit(*s))
+			digit = tolower(*s) - 'a' + 10;
+		else
+			break;
+		if (digit >= base)
+			break;
+		if (check_mul_overflow(value, (unsigned long long)base, &value)
+			|| check_add_overflow(value, (unsigned long long)digit, &value))
+			return -ERANGE;
+	}
+	if (s == start)
+		return -EINVAL;
+	if (*s == '\n')
+		s++;
+	if (*s != '\0')
+		return -EINVAL;
+	*result = value;
+	return 0;
+}
+
+
+int
+kstrtoull(const char *s, unsigned int base, unsigned long long *res)
+{
+	if (s[0] == '+')
+		s++;
+	return parse_unsigned(s, base, res);
+}
+
+
+int
+kstrtoll(const char *s, unsigned int base, long long *res)
+{
+	unsigned long long value;
+	int error;
+	if (s[0] == '-') {
+		error = parse_unsigned(s + 1, base, &value);
+		if (error != 0)
+			return error;
+		if ((long long)-value > 0)
+			return -ERANGE;
+		*res = -value;
+		return 0;
+	}
+	error = kstrtoull(s, base, &value);
+	if (error != 0)
+		return error;
+	if ((long long)value < 0)
+		return -ERANGE;
+	*res = value;
+	return 0;
+}
+
+
+#define DEFINE_KSTRTO(name, type, parse, wide) \
+int name(const char *s, unsigned int base, type *res) \
+{ \
+	wide value; \
+	int error = parse(s, base, &value); \
+	if (error != 0) \
+		return error; \
+	if (value != (type)value) \
+		return -ERANGE; \
+	*res = value; \
+	return 0; \
+}
+
+DEFINE_KSTRTO(kstrtoul, unsigned long, kstrtoull, unsigned long long)
+DEFINE_KSTRTO(kstrtol, long, kstrtoll, long long)
+DEFINE_KSTRTO(kstrtouint, unsigned int, kstrtoull, unsigned long long)
+DEFINE_KSTRTO(kstrtoint, int, kstrtoll, long long)
+DEFINE_KSTRTO(kstrtou64, u64, kstrtoull, unsigned long long)
+DEFINE_KSTRTO(kstrtos64, s64, kstrtoll, long long)
+DEFINE_KSTRTO(kstrtou32, u32, kstrtoull, unsigned long long)
+DEFINE_KSTRTO(kstrtos32, s32, kstrtoll, long long)
+DEFINE_KSTRTO(kstrtou16, u16, kstrtoull, unsigned long long)
+DEFINE_KSTRTO(kstrtos16, s16, kstrtoll, long long)
+DEFINE_KSTRTO(kstrtou8, u8, kstrtoull, unsigned long long)
+DEFINE_KSTRTO(kstrtos8, s8, kstrtoll, long long)
+
+
+int
+kstrtobool(const char *s, bool *res)
+{
+	if (s == NULL)
+		return -EINVAL;
+	switch (s[0]) {
+		case 'y': case 'Y': case 't': case 'T': case '1':
+			*res = true;
+			return 0;
+		case 'n': case 'N': case 'f': case 'F': case '0':
+			*res = false;
+			return 0;
+		case 'o': case 'O':
+			if (tolower(s[1]) == 'n') {
+				*res = true;
+				return 0;
+			}
+			if (tolower(s[1]) == 'f') {
+				*res = false;
+				return 0;
+			}
+	}
+	return -EINVAL;
+}
