+void
+seq_printf(struct seq_file *m, const char *fmt, ...)
+{
+	if (m->buf == NULL || m->count >= m->size)
+		return;
+	va_list args;
+	va_start(args, fmt);
+	int length = vsnprintf(m->buf + m->count, m->size - m->count, fmt, args);
+	va_end(args);
+	if (m->count + length < m->size)
+		m->count += length;
+	else
+		m->count = m->size;
+}
+
+
+void
+seq_puts(struct seq_file *m, const char *s)
+{
+	seq_append(m, s, strlen(s));
+}
+
+
+void
+seq_putc(struct seq_file *m, char c)
+{
+	seq_append(m, &c, 1);
+}
+
+
+void
+seq_write(struct seq_file *seq, const void *data, size_t len)
+{
+	seq_append(seq, data, len);
+}
diff --git a/src/libs/compat/linuxkpi/linux/mm.c b/src/libs/compat/linuxkpi/linux/mm.c
new file mode 100644
index 0000000000..51d587fee7
--- /dev/null
+++ b/src/libs/compat/linuxkpi/linux/mm.c
@@ -0,0 +1,807 @@
+/*
+ * Copyright 2026, hans2294.
+ * Distributed under the terms of the MIT License.
+ */
+
+
+/*!	Memory: kmalloc and friends on Haiku's kernel heap, pages, vmalloc and
+	vmap, kmem_caches, shrinkers.
+
+	Every kmalloc() and vmalloc() block carries a small header in front of
+	it with its size, so ksize(), krealloc() and kvfree() work on both.
+
+	Pages come in blocks of 2^order: order 0 from the (wired) kernel heap,
+	larger ones as physically contiguous areas. Each block has its struct
+	pages in one array, so page + n is the next page as on Linux, and every
+	page is hashed by pfn for pfn_to_page().
+*/
+
+
+#include <linux/slab.h>
+#include <linux/vmalloc.h>
+#include <linux/mm.h>
+#include <linux/gfp.h>
+#include <linux/highmem.h>
+#include <linux/shrinker.h>
+#include <linux/rcupdate.h>
+#include <linux/spinlock.h>
+#include <linux/printk.h>
+#include <asm/set_memory.h>
+
+#include <linuxkpi/haiku.h>
+
+
+//	#pragma mark - kmalloc
+
+
+#define ALLOC_MAGIC		0x6c6b7069	/* 'lkpi' */
+#define ALLOC_VMALLOC	0x1
+
+struct alloc_header {
+	size_t size;
+	unsigned int offset;	/* from the start of the Haiku block */
+	unsigned short reserved0;
+	unsigned short flags;
+	unsigned int magic;
+	unsigned int reserved;
+};
+_Static_assert(sizeof(struct alloc_header) == 24, "header size");
+
+#define HEADER_SPACE	32
+
+
+static inline struct alloc_header *
+header_of(const void *p)
+{
+	return (struct alloc_header *)((char *)p - sizeof(struct alloc_header));
+}
+
+
+static void *
+alloc_common(size_t size, gfp_t flags, unsigned short allocFlags)
+{
+	if (size == 0)
+		return ZERO_SIZE_PTR;
+	if (size > KMALLOC_MAX_SIZE && !(allocFlags & ALLOC_VMALLOC))
+		return NULL;
+
+	// Linux aligns power-of-two sizes naturally; callers rely on it.
+	size_t alignment = 16;
+	if (is_power_of_2(size) && size > alignment)
+		alignment = min_t(size_t, size, PAGE_SIZE);
+	if (allocFlags & ALLOC_VMALLOC)
+		alignment = PAGE_SIZE;
+	size_t offset = max_t(size_t, alignment, HEADER_SPACE);
+
+	char *block = lkpi_haiku_alloc(size + offset, alignment,
+		!gfpflags_allow_blocking(flags));
+	if (block == NULL) {
+		if (!(flags & __GFP_NOWARN))
+			pr_warn_ratelimited("linuxkpi: allocation of %zu bytes failed\n",
+				size);
+		return NULL;
+	}
+
+	char *p = block + offset;
+	struct alloc_header *header = header_of(p);
+	header->size = size;
+	header->offset = offset;
+	header->flags = allocFlags;
+	header->magic = ALLOC_MAGIC;
+	if (flags & __GFP_ZERO)
+		memset(p, 0, size);
+	return p;
+}
+
+
+static void
+free_common(const void *p)
+{
+	if (ZERO_OR_NULL_PTR(p))
+		return;
+	struct alloc_header *header = header_of(p);
+	if (header->magic != ALLOC_MAGIC)
+		panic("linuxkpi: kfree(%p) of memory kmalloc() did not return", p);
+	header->magic = 0;
+	lkpi_haiku_free((char *)p - header->offset);
+}
+
+
+void *
+kmalloc(size_t size, gfp_t flags)
+{
+	return alloc_common(size, flags, 0);
+}
+
+
+void
+kfree(const void *objp)
+{
+	free_common(objp);
+}
+
+
+void
+kfree_sensitive(const void *objp)
+{
+	if (!ZERO_OR_NULL_PTR(objp))
+		memzero_explicit((void *)objp, ksize(objp));
+	kfree(objp);
+}
+
+
+size_t
+ksize(const void *objp)
+{
+	if (ZERO_OR_NULL_PTR(objp))
+		return 0;
+	return header_of(objp)->size;
+}
+
+
+size_t
+kmalloc_size_roundup(size_t size)
+{
+	return size;
+}
+
+
+static void *
+realloc_common(const void *p, size_t size, gfp_t flags,
+	unsigned short allocFlags)
+{
+	if (size == 0) {
+		free_common(p);
+		return ZERO_SIZE_PTR;
+	}
+	size_t old = ksize(p);
+	if (!ZERO_OR_NULL_PTR(p) && size <= old) {
+		if (flags & __GFP_ZERO)
+			memset((char *)p + size, 0, old - size);
+		return (void *)p;
+	}
+	void *copy = alloc_common(size, flags & ~__GFP_ZERO, allocFlags);
+	if (copy == NULL)
+		return NULL;
+	memcpy(copy, p, old);
+	if (flags & __GFP_ZERO)
+		memset((char *)copy + old, 0, size - old);
+	free_common(p);
+	return copy;
+}
+
+
+void *
+krealloc(const void *objp, size_t new_size, gfp_t flags)
+{
+	return realloc_common(objp, new_size, flags, 0);
+}
+
+
+void *
+kvmalloc(size_t size, gfp_t flags)
+{
+	return alloc_common(size, flags,
+		size > 16 * PAGE_SIZE ? ALLOC_VMALLOC : 0);
+}
+
+
+void
+kvfree(const void *addr)
+{
+	free_common(addr);
+}
+
+
+void
+kvfree_sensitive(const void *addr, size_t len)
+{
+	if (!ZERO_OR_NULL_PTR(addr))
+		memzero_explicit((void *)addr, len);
+	kvfree(addr);
+}
+
+
+void *
+kvrealloc(const void *p, size_t size, gfp_t flags)
+{
+	return realloc_common(p, size, flags, 0);
+}
+
+
+//	#pragma mark - vmalloc
+
+
+void *
+__vmalloc(unsigned long size, gfp_t gfp_mask)
+{
+	return alloc_common(size, gfp_mask, ALLOC_VMALLOC);
+}
+
+
+void *
+vmalloc(unsigned long size)
+{
+	return __vmalloc(size, GFP_KERNEL);
+}
+
+
+void *
+vzalloc(unsigned long size)
+{
+	return __vmalloc(size, GFP_KERNEL | __GFP_ZERO);
+}
+
+
+void *
+vmalloc_user(unsigned long size)
+{
+	return vzalloc(size);
+}
+
+
+void *
+vmalloc_32(unsigned long size)
+{
+	return vmalloc(size);
+}
+
+
+void
+vfree(const void *addr)
+{
+	free_common(addr);
+}
+
+
+bool
+is_vmalloc_addr(const void *x)
+{
+	// vmap() mappings count too, but only ever reach vunmap()
+	if (ZERO_OR_NULL_PTR(x) || !PAGE_ALIGNED(x))
+		return false;
+	struct alloc_header *header = header_of(x);
+	return header->magic == ALLOC_MAGIC && (header->flags & ALLOC_VMALLOC);
+}
+
+
+//	#pragma mark - pages
+
+
+#define PAGE_HASH_SIZE	4096
+
+struct page_block {
+	int area;			/* or -1 for heap memory */
+	void *address;
+	unsigned int count;
+	struct page pages[];
+};
+
+static DEFINE_SPINLOCK(sPageHashLock);
+static struct page *sPageHash[PAGE_HASH_SIZE];
+
+
+static void
+page_hash_insert(struct page *page)
+{
+	unsigned int bucket = page->linuxkpi_pfn % PAGE_HASH_SIZE;
+	spin_lock(&sPageHashLock);
+	page->linuxkpi_hash_next = sPageHash[bucket];
+	sPageHash[bucket] = page;
+	spin_unlock(&sPageHashLock);
+}
+
+
+static void
+page_hash_remove(struct page *page)
+{
+	unsigned int bucket = page->linuxkpi_pfn % PAGE_HASH_SIZE;
+	spin_lock(&sPageHashLock);
+	struct page **link = &sPageHash[bucket];
+	while (*link != NULL && *link != page)
+		link = &(*link)->linuxkpi_hash_next;
+	if (*link != NULL)
+		*link = page->linuxkpi_hash_next;
+	spin_unlock(&sPageHashLock);
+}
+
+
+struct page *
+pfn_to_page(unsigned long pfn)
+{
+	spin_lock(&sPageHashLock);
+	struct page *page = sPageHash[pfn % PAGE_HASH_SIZE];
+	while (page != NULL && page->linuxkpi_pfn != pfn)
+		page = page->linuxkpi_hash_next;
+	spin_unlock(&sPageHashLock);
+	if (page == NULL)
+		pr_warn_once("linuxkpi: pfn_to_page(%#lx) of a page linuxkpi did not "
+			"allocate\n", pfn);
+	return page;
+}
+
+
+unsigned long
+page_to_pfn(const struct page *page)
+{
+	return page->linuxkpi_pfn;
+}
+
+
+void *
+page_address(const struct page *page)
+{
+	return page->linuxkpi_vaddr;
+}
+
+
+struct page *
+virt_to_page(const void *addr)
+{
+	unsigned long long physical = lkpi_haiku_virt_to_phys(addr);
+	if (physical == 0)
+		return NULL;
+	return pfn_to_page(physical >> PAGE_SHIFT);
+}
+
+
+struct page *
+vmalloc_to_page(const void *addr)
+{
+	return virt_to_page(addr);
+}
+
+
+unsigned long
+vmalloc_to_pfn(const void *addr)
+{
+	return lkpi_haiku_virt_to_phys(addr) >> PAGE_SHIFT;
+}
+
+
+struct page *
+alloc_pages(gfp_t gfp_mask, unsigned int order)
+{
+	unsigned int count = 1U << order;
+	size_t size = (size_t)count << PAGE_SHIFT;
+	struct page_block *block = kzalloc(struct_size(block, pages, count),
+		gfp_mask & ~__GFP_ZERO);
+	if (block == NULL)
+		return NULL;
+
+	block->count = count;
+	block->area = -1;
+	if (order == 0) {
+		block->address = lkpi_haiku_alloc(PAGE_SIZE, PAGE_SIZE,
+			!gfpflags_allow_blocking(gfp_mask));
+	} else
+		block->address = lkpi_haiku_alloc_contiguous(size, &block->area);
+	if (block->address == NULL) {
+		kfree(block);
+		return NULL;
+	}
+	if (gfp_mask & __GFP_ZERO)
+		memset(block->address, 0, size);
+
+	unsigned long pfn = lkpi_haiku_virt_to_phys(block->address) >> PAGE_SHIFT;
+	for (unsigned int i = 0; i < count; i++) {
+		struct page *page = &block->pages[i];
+		page->linuxkpi_pfn = pfn + i;
+		page->linuxkpi_vaddr = (char *)block->address + i * PAGE_SIZE;
+		page->linuxkpi_block = block;
+		INIT_LIST_HEAD(&page->lru);
+		atomic_set(&page->_mapcount, -1);
+		atomic_set(&page->_refcount, i == 0 ? 1 : 0);
+		page_hash_insert(page);
+	}
+	return &block->pages[0];
+}
+
+
+struct page *
+alloc_pages_node(int nid, gfp_t gfp_mask, unsigned int order)
+{
+	return alloc_pages(gfp_mask, order);
+}
+
+
+struct folio *
+folio_alloc(gfp_t gfp, unsigned int order)
+{
+	return page_folio(alloc_pages(gfp, order));
+}
+
+
+static void
+free_block(struct page_block *block)
+{
+	for (unsigned int i = 0; i < block->count; i++)
+		page_hash_remove(&block->pages[i]);
+	if (block->area >= 0)
+		lkpi_haiku_delete_area(block->area);
+	else
+		lkpi_haiku_free(block->address);
+	kfree(block);
+}
+
+
+void
+__free_pages(struct page *page, unsigned int order)
+{
+	if (page == NULL)
+		return;
+	struct page_block *block = page->linuxkpi_block;
+	if (page != &block->pages[0] || block->count != 1U << order) {
+		pr_warn("linuxkpi: __free_pages() of part of a block\n");
+		return;
+	}
+	if (atomic_dec_and_test(&page->_refcount))
+		free_block(block);
+}
+
+
+void
+get_page(struct page *page)
+{
+	atomic_inc(&page->_refcount);
+}
+
+
+void
+put_page(struct page *page)
+{
+	struct page_block *block = page->linuxkpi_block;
+	if (atomic_dec_and_test(&page->_refcount) && page == &block->pages[0])
+		free_block(block);
+}
+
+
+unsigned long
+__get_free_pages(gfp_t gfp_mask, unsigned int order)
+{
+	struct page *page = alloc_pages(gfp_mask, order);
+	return page != NULL ? (unsigned long)page_address(page) : 0;
+}
+
+
+unsigned long
+get_zeroed_page(gfp_t gfp_mask)
+{
+	return __get_free_pages(gfp_mask | __GFP_ZERO, 0);
+}
+
+
+void
+free_pages(unsigned long addr, unsigned int order)
+{
+	if (addr != 0)
+		__free_pages(virt_to_page((void *)addr), order);
+}
+
+
+void *
+alloc_pages_exact(size_t size, gfp_t gfp_mask)
+{
+	return (void *)__get_free_pages(gfp_mask, get_order(size));
+}
+
+
+void
+free_pages_exact(void *virt, size_t size)
+{
+	free_pages((unsigned long)virt, get_order(size));
+}
+
+
+int
+set_page_dirty(struct page *page)
+{
+	return !test_and_set_bit(PG_dirty, &page->flags);
+}
+
+
+int
+set_page_dirty_lock(struct page *page)
+{
+	return set_page_dirty(page);
+}
+
+
+void
+mark_page_accessed(struct page *page)
+{
+}
+
+
+struct page *
+compound_head(struct page *page)
+{
+	return page;
+}
+
+
+//	#pragma mark - mappings
+
+
+void *
+kmap(struct page *page)
+{
+	return page_address(page);
+}
+
+
+void
+kunmap(struct page *page)
+{
+}
+
+
+void *
+kmap_local_page(struct page *page)
+{
+	return page_address(page);
+}
+
+
+void *
+kmap_local_page_prot(struct page *page, pgprot_t prot)
+{
+	return page_address(page);
+}
+
+
+void
+kunmap_local(const void *vaddr)
+{
+}
+
+
+void *
+kmap_atomic(struct page *page)
+{
+	return page_address(page);
+}
+
+
+void
+kunmap_atomic(void *addr)
+{
+}
+
+
+void *
+vmap(struct page **pages, unsigned int count, unsigned long flags,
+	pgprot_t prot)
+{
+	// Pages that already follow each other need no new mapping.
+	bool contiguous = true;
+	for (unsigned int i = 1; i < count && contiguous; i++) {
+		contiguous = page_address(pages[i])
+			== (char *)page_address(pages[0]) + i * PAGE_SIZE;
+	}
+	if (contiguous)
+		return page_address(pages[0]);
+
+	unsigned long long *physical = kvmalloc_array(count, sizeof(*physical),
+		GFP_KERNEL);
+	if (physical == NULL)
+		return NULL;
+	for (unsigned int i = 0; i < count; i++)
+		physical[i] = (unsigned long long)page_to_pfn(pages[i]) << PAGE_SHIFT;
+	int area;
+	void *address = lkpi_haiku_map_pages(physical, count, &area);
+	kvfree(physical);
+	return address;
+}
+
+
+void *
+vmap_pfn(unsigned long *pfns, unsigned int count, pgprot_t prot)
+{
+	unsigned long long *physical = kvmalloc_array(count, sizeof(*physical),
+		GFP_KERNEL);
+	if (physical == NULL)
+		return NULL;
+	for (unsigned int i = 0; i < count; i++)
+		physical[i] = (unsigned long long)pfns[i] << PAGE_SHIFT;
+	int area;
+	void *address = lkpi_haiku_map_pages(physical, count, &area);
+	kvfree(physical);
+	return address;
+}
+
+
+void
+vunmap(const void *addr)
+{
+	if (addr == NULL)
+		return;
+	// Only mappings vmap() made have an area of their own; for the others
+	// the address is inside a page block, which is not a vmap area.
+	struct page *page = virt_to_page(addr);
+	if (page != NULL && page_address(page) == addr)
+		return;
+	int area = lkpi_haiku_area_for(addr);
+	if (area >= 0)
+		lkpi_haiku_delete_area(area);
+}
+
+
+/*!	Caching changes of RAM pages. linuxkpi keeps them write-back: with
+	CONFIG_X86_PAT unset amdgpu does not ask for write-combined GTT, and
+	the GPU snoops cached pages.
+*/
+int set_pages_wb(struct page *page, int numpages) { return 0; }
+int set_pages_uc(struct page *page, int numpages) { return 0; }
+int set_pages_wc(struct page *page, int numpages) { return 0; }
+int set_pages_array_wb(struct page **pages, int addrinarray) { return 0; }
+int set_pages_array_uc(struct page **pages, int addrinarray) { return 0; }
+int set_pages_array_wc(struct page **pages, int addrinarray) { return 0; }
+int set_memory_wb(unsigned long addr, int numpages) { return 0; }
+int set_memory_uc(unsigned long addr, int numpages) { return 0; }
+int set_memory_wc(unsigned long addr, int numpages) { return 0; }
+
+
+int
+wbinvd_on_all_cpus(void)
+{
+	lkpi_haiku_wbinvd_all_cpus();
+	return 0;
+}
+
+
+//	#pragma mark - system memory
+
+
+unsigned long
+totalram_pages(void)
+{
+	return lkpi_haiku_total_memory() >> PAGE_SHIFT;
+}
+
+
+void
+si_meminfo(struct sysinfo *val)
+{
+	val->totalram = lkpi_haiku_total_memory() >> PAGE_SHIFT;
+	val->freeram = lkpi_haiku_free_memory() >> PAGE_SHIFT;
+	val->totalhigh = 0;
+	val->freehigh = 0;
+	val->mem_unit = PAGE_SIZE;
+}
+
+
+int
+page_is_ram(unsigned long pfn)
+{
+	// amdgpu asks about its BARs, which are not RAM
+	return 0;
+}
+
+
+//	#pragma mark - kmem_cache
+
+
+struct kmem_cache {
+	const char *name;
+	unsigned int size;
+	unsigned int align;
+	slab_flags_t flags;
+	void (*ctor)(void *);
+};
+
+/* SLAB_TYPESAFE_BY_RCU objects may be looked at by RCU readers after they
+ * were freed; they get an rcu_head in front and are freed after a grace
+ * period. */
+struct rcu_object {
+	struct rcu_head rcu;
+	unsigned long pad[2];
+};
+
+
+struct kmem_cache *
+kmem_cache_create(const char *name, unsigned int size, unsigned int align,
+	slab_flags_t flags, void (*ctor)(void *))
+{
+	struct kmem_cache *cache = kzalloc(sizeof(*cache), GFP_KERNEL);
+	if (cache == NULL)
+		return NULL;
+	cache->name = name;
+	cache->size = size;
+	cache->align = align;
+	cache->flags = flags;
+	cache->ctor = ctor;
+	return cache;
+}
+
+
+struct kmem_cache *
+kmem_cache_create_usercopy(const char *name, unsigned int size,
+	unsigned int align, slab_flags_t flags, unsigned int useroffset,
+	unsigned int usersize, void (*ctor)(void *))
+{
+	return kmem_cache_create(name, size, align, flags, ctor);
+}
+
+
+void
+kmem_cache_destroy(struct kmem_cache *s)
+{
+	if (s != NULL && (s->flags & SLAB_TYPESAFE_BY_RCU))
+		rcu_barrier();
+	kfree(s);
+}
+
+
+void *
+kmem_cache_alloc(struct kmem_cache *s, gfp_t flags)
+{
+	char *object;
+	if (s->flags & SLAB_TYPESAFE_BY_RCU) {
+		object = kmalloc(sizeof(struct rcu_object) + s->size, flags);
+		if (object != NULL)
+			object += sizeof(struct rcu_object);
+	} else
+		object = kmalloc(s->size, flags);
+	if (object != NULL && s->ctor != NULL)
+		s->ctor(object);
+	return object;
+}
+
+
+static void
+rcu_object_free(struct rcu_head *head)
+{
+	kfree(head);
+}
+
+
+void
+kmem_cache_free(struct kmem_cache *s, void *objp)
+{
+	if (objp == NULL)
+		return;
+	if (s->flags & SLAB_TYPESAFE_BY_RCU) {
+		struct rcu_object *object = (struct rcu_object *)((char *)objp
+			- sizeof(struct rcu_object));
+		call_rcu(&object->rcu, rcu_object_free);
+	} else
+		kfree(objp);
+}
+
+
+int
+kmem_cache_shrink(struct kmem_cache *s)
+{
+	return 0;
+}
+
+
+//	#pragma mark - shrinkers
+
+
+/*!	Haiku has no shrinker interface to hook into; shrinkers are kept but
+	never asked to give memory back.
+	TODO: low resource manager handlers
+*/
+struct shrinker *
+shrinker_alloc(unsigned int flags, const char *fmt, ...)
+{
+	struct shrinker *shrinker = kzalloc(sizeof(*shrinker), GFP_KERNEL);
+	if (shrinker != NULL)
+		INIT_LIST_HEAD(&shrinker->list);
+	return shrinker;
+}
+
+
+void
+shrinker_register(struct shrinker *shrinker)
+{
+}
+
+
+void
+shrinker_free(struct shrinker *shrinker)
+{
+	kfree(shrinker);
+}
diff --git a/src/libs/compat/linuxkpi/linux/module.c b/src/libs/compat/linuxkpi/linux/module.c
new file mode 100644
index 0000000000..1b67ff1167
--- /dev/null
+++ b/src/libs/compat/linuxkpi/linux/module.c
@@ -0,0 +1,82 @@
+/*
+ * Copyright 2026, hans2294.
+ * Distributed under the terms of the MIT License.
+ */
+
+
+/*!	Runs the Linux modules' init and exit calls in the order Linux's link
+	order would: the libraries first, then DRM's core and helpers, the
+	drivers last.
+*/
+
+
+#include <linux/init.h>
+#include <linux/kernel.h>
+#include <linux/string.h>
+
+
+extern const struct linuxkpi_initcall __start_linuxkpi_initcall[];
+extern const struct linuxkpi_initcall __stop_linuxkpi_initcall[];
+
+static const char * const kModuleOrder[] = {
+	"linuxkpi", "linuxkpi_lib", "dma_buf", "drm", "drm_display_helper",
+	"ttm", "gpu_sched", "amdgpu",
+};
+
+
+static int
+module_rank(const char *module)
+{
+	for (int i = 0; i < (int)ARRAY_SIZE(kModuleOrder); i++) {
+		if (strcmp(module, kModuleOrder[i]) == 0)
+			return i;
+	}
+	return ARRAY_SIZE(kModuleOrder);
+}
+
+
+/*!	A failing init call fails its module, as on Linux: the module's later
+	init calls are skipped, the other modules still run. Returns the first
+	error.
+*/
+int
+linuxkpi_run_initcalls(void)
+{
+	int firstError = 0;
+	for (int rank = 0; rank <= (int)ARRAY_SIZE(kModuleOrder); rank++) {
+		bool failed = false;
+		for (int level = 0; level <= 7 && !failed; level++) {
+			for (const struct linuxkpi_initcall *call = __start_linuxkpi_initcall;
+					call < __stop_linuxkpi_initcall; call++) {
+				if (call->init == NULL || call->level != level
+					|| module_rank(call->module) != rank)
+					continue;
+
+				pr_info("linuxkpi: %s: %s()\n", call->module, call->name);
+				int result = call->init();
+				if (result != 0) {
+					pr_err("linuxkpi: %s: %s() failed: %d\n", call->module,
+						call->name, result);
+					if (firstError == 0)
+						firstError = result;
+					failed = true;
+					break;
+				}
+			}
+		}
+	}
+	return firstError;
+}
+
+
+void
+linuxkpi_run_exitcalls(void)
+{
+	for (int rank = ARRAY_SIZE(kModuleOrder); rank >= 0; rank--) {
+		for (const struct linuxkpi_initcall *call = __stop_linuxkpi_initcall;
+				call-- > __start_linuxkpi_initcall;) {
+			if (call->exit != NULL && module_rank(call->module) == rank)
+				call->exit();
+		}
+	}
+}
diff --git a/src/libs/compat/linuxkpi/linux/pci.c b/src/libs/compat/linuxkpi/linux/pci.c
new file mode 100644
index 0000000000..57b61eace9
--- /dev/null
+++ b/src/libs/compat/linuxkpi/linux/pci.c
@@ -0,0 +1,926 @@
+/*
+ * Copyright 2026, hans2294.
+ * Distributed under the terms of the MIT License.
+ */
+
+
+/*!	PCI: Haiku's PCI devices as Linux pci_devs, driver matching and probe,
+	config space, capabilities, PCIe link information, MSI, ROM and power.
+
+	A pci_dev is made the first time anything asks for its device and lives
+	as long as linuxkpi does.
+*/
+
+
+#include <linux/pci.h>
+#include <linux/slab.h>
+#include <linux/list.h>
+#include <linux/mutex.h>
+#include <linux/io.h>
+
+#include <linuxkpi/chrdev.h>
+#include <linux/printk.h>
+#include <linux/delay.h>
+
+#include <linuxkpi/haiku.h>
+#include <linuxkpi/uapi.h>
+
+
+struct pci_haiku {
+	struct list_head link;
+	struct pci_dev *dev;
+	struct lkpi_haiku_pci_device info;
+	bool msi;
+	char name[16];
+};
+
+struct pci_saved_state {
+	u32 config_space[16];
+};
+
+static DEFINE_MUTEX(sPciLock);
+static LIST_HEAD(sPciDevices);
+static LIST_HEAD(sPciBuses);
+static LIST_HEAD(sPciDrivers);
+
+
+static inline struct pci_haiku *
+haiku_of(const struct pci_dev *dev)
+{
+	return dev->linuxkpi_data;
+}
+
+
+//	#pragma mark - config space
+
+
+static u32
+config_read(const struct pci_dev *dev, int where, int size)
+{
+	struct lkpi_haiku_pci_device *info = &haiku_of(dev)->info;
+	return lkpi_haiku_pci_read_config(info->bus, info->device, info->function,
+		where, size);
+}
+
+
+static void
+config_write(const struct pci_dev *dev, int where, int size, u32 value)
+{
+	struct lkpi_haiku_pci_device *info = &haiku_of(dev)->info;
+	lkpi_haiku_pci_write_config(info->bus, info->device, info->function,
+		where, size, value);
+}
+
+
+int
+pci_read_config_byte(const struct pci_dev *dev, int where, u8 *val)
+{
+	*val = config_read(dev, where, 1);
+	return PCIBIOS_SUCCESSFUL;
+}
+
+
+int
+pci_read_config_word(const struct pci_dev *dev, int where, u16 *val)
+{
+	*val = config_read(dev, where, 2);
+	return PCIBIOS_SUCCESSFUL;
+}
+
+
+int
+pci_read_config_dword(const struct pci_dev *dev, int where, u32 *val)
+{
+	*val = config_read(dev, where, 4);
+	return PCIBIOS_SUCCESSFUL;
+}
+
+
+int
+pci_write_config_byte(const struct pci_dev *dev, int where, u8 val)
+{
+	config_write(dev, where, 1, val);
+	return PCIBIOS_SUCCESSFUL;
+}
+
+
+int
+pci_write_config_word(const struct pci_dev *dev, int where, u16 val)
+{
+	config_write(dev, where, 2, val);
+	return PCIBIOS_SUCCESSFUL;
+}
+
+
+int
+pci_write_config_dword(const struct pci_dev *dev, int where, u32 val)
+{
+	config_write(dev, where, 4, val);
+	return PCIBIOS_SUCCESSFUL;
+}
+
+
+static u8
+find_capability(struct pci_dev *dev, int cap)
+{
+	if ((config_read(dev, PCI_STATUS, 2) & PCI_STATUS_CAP_LIST) == 0)
+		return 0;
+	u8 pos = config_read(dev, PCI_CAPABILITY_LIST, 1) & ~3;
+	for (int ttl = 48; pos >= 0x40 && ttl > 0; ttl--) {
+		u16 entry = config_read(dev, pos, 2);
+		if ((entry & 0xff) == cap)
+			return pos;
+		pos = (entry >> 8) & ~3;
+	}
+	return 0;
+}
+
+
+u8
+pci_find_capability(struct pci_dev *dev, int cap)
+{
+	return find_capability(dev, cap);
+}
+
+
+u16
+pci_find_ext_capability(struct pci_dev *dev, int cap)
+{
+	if (dev->cfg_size <= PCI_CFG_SPACE_SIZE)
+		return 0;
+	int pos = PCI_CFG_SPACE_SIZE;
+	for (int ttl = (PCI_CFG_SPACE_EXP_SIZE - PCI_CFG_SPACE_SIZE) / 8;
+			ttl > 0; ttl--) {
+		u32 header = config_read(dev, pos, 4);
+		if (header == 0 || header == ~0U)
+			return 0;
+		if (PCI_EXT_CAP_ID(header) == cap)
+			return pos;
+		pos = PCI_EXT_CAP_NEXT(header);
+		if (pos < PCI_CFG_SPACE_SIZE)
+			return 0;
+	}
+	return 0;
+}
+
+
+int
+pcie_capability_read_word(struct pci_dev *dev, int pos, u16 *val)
+{
+	if (dev->pcie_cap == 0) {
+		*val = 0;
+		return -EINVAL;
+	}
+	*val = config_read(dev, dev->pcie_cap + pos, 2);
+	return 0;
+}
+
+
+int
+pcie_capability_read_dword(struct pci_dev *dev, int pos, u32 *val)
+{
+	if (dev->pcie_cap == 0) {
+		*val = 0;
+		return -EINVAL;
+	}
+	*val = config_read(dev, dev->pcie_cap + pos, 4);
+	return 0;
+}
+
+
+//	#pragma mark - devices
+
+
+static struct pci_bus *
+bus_for(unsigned int number)
+{
+	struct pci_bus *bus;
+	list_for_each_entry(bus, &sPciBuses, devices) {
+		if (bus->number == number)
+			return bus;
+	}
+	bus = kzalloc(sizeof(*bus), GFP_KERNEL);
+	if (bus == NULL)
+		return NULL;
+	bus->number = number;
+	bus->max_bus_speed = PCI_SPEED_UNKNOWN;
+	bus->cur_bus_speed = PCI_SPEED_UNKNOWN;
+	// The bus list is chained through "devices"; linuxkpi keeps no list of
+	// a bus' devices.
+	list_add_tail(&bus->devices, &sPciBuses);
+	return bus;
+}
+
+
+static struct pci_dev *
+create_pci_dev(const struct lkpi_haiku_pci_device *info)
+{
+	struct pci_dev *dev = kzalloc(sizeof(*dev), GFP_KERNEL);
+	struct pci_haiku *haiku = kzalloc(sizeof(*haiku), GFP_KERNEL);
+	if (dev == NULL || haiku == NULL) {
+		kfree(dev);
+		kfree(haiku);
+		return NULL;
+	}
+	haiku->info = *info;
+	haiku->dev = dev;
+	dev->linuxkpi_data = haiku;
+
+	dev->bus = bus_for(info->bus);
+	dev->devfn = PCI_DEVFN(info->device, info->function);
+	dev->vendor = info->vendor;
+	dev->device = info->device_id;
+	dev->subsystem_vendor = info->subsystem_vendor;
+	dev->subsystem_device = info->subsystem_device;
+	dev->class = info->class_code;
+	dev->revision = info->revision;
+	dev->hdr_type = info->header_type;
+	dev->irq = info->interrupt_line;
+	dev->current_state = PCI_D0;
+	dev->dma_mask = DMA_BIT_MASK(32);
+	dev->cfg_size = PCI_CFG_SPACE_SIZE;
+	INIT_LIST_HEAD(&dev->bus_list);
+
+	device_initialize(&dev->dev);
+	dev->dev.dma_mask = &dev->dma_mask;
+	dev->dev.coherent_dma_mask = DMA_BIT_MASK(32);
+	dev->dev.dma_parms = &dev->dma_parms;
+	snprintf(haiku->name, sizeof(haiku->name), "0000:%02x:%02x.%u",
+		info->bus, info->device, info->function);
+	dev_set_name(&dev->dev, "%s", haiku->name);
+
+	for (int bar = 0; bar < 6; bar++) {
+		struct resource *res = &dev->resource[bar];
+		if (info->bar_size[bar] == 0)
+			continue;
+		res->start = info->bar_base[bar];
+		res->end = info->bar_base[bar] + info->bar_size[bar] - 1;
+		res->name = haiku->name;
+		if (info->bar_flags[bar] & LKPI_HAIKU_BAR_IO) {
+			res->flags = IORESOURCE_IO;
+		} else {
+			res->flags = IORESOURCE_MEM;
+			if (info->bar_flags[bar] & LKPI_HAIKU_BAR_64)
+				res->flags |= IORESOURCE_MEM_64;
+			if (info->bar_flags[bar] & LKPI_HAIKU_BAR_PREFETCH)
+				res->flags |= IORESOURCE_PREFETCH;
+		}
+	}
+	if (info->rom_size != 0) {
+		struct resource *res = &dev->resource[PCI_ROM_RESOURCE];
+		res->start = info->rom_base;
+		res->end = info->rom_base + info->rom_size - 1;
+		res->flags = IORESOURCE_MEM | IORESOURCE_READONLY;
+		res->name = haiku->name;
+	}
+
+	dev->pcie_cap = find_capability(dev, PCI_CAP_ID_EXP);
+	dev->msi_cap = find_capability(dev, PCI_CAP_ID_MSI);
+	dev->msix_cap = find_capability(dev, PCI_CAP_ID_MSIX);
+	dev->pm_cap = find_capability(dev, PCI_CAP_ID_PM);
+	if (dev->pcie_cap != 0) {
+		dev->pcie_flags_reg = config_read(dev, dev->pcie_cap + PCI_EXP_FLAGS,
+			2);
+		// Extended config space answers with something other than all ones
+		if (config_read(dev, PCI_CFG_SPACE_SIZE, 4) != ~0U)
+			dev->cfg_size = PCI_CFG_SPACE_EXP_SIZE;
+	}
+
+	list_add_tail(&haiku->link, &sPciDevices);
+	return dev;
+}
+
+
+/*!	The pci_dev for Haiku's \a index'th PCI device, made if needed.
+	sPciLock must be held. Sets \a _end past the last device.
+*/
+static struct pci_dev *
+get_nth_device(int index, bool *_end)
+{
+	struct lkpi_haiku_pci_device info;
+	*_end = false;
+	if (lkpi_haiku_pci_get(index, &info) != 0) {
+		*_end = true;
+		return NULL;
+	}
+
+	struct pci_haiku *haiku;
+	list_for_each_entry(haiku, &sPciDevices, link) {
+		if (haiku->info.bus == info.bus && haiku->info.device == info.device
+			&& haiku->info.function == info.function)
+			return haiku->dev;
+	}
+	return create_pci_dev(&info);
+}
+
+
+struct pci_dev *
+pci_get_domain_bus_and_slot(int domain, unsigned int bus, unsigned int devfn)
+{
+	if (domain != 0)
+		return NULL;
+	struct pci_dev *found = NULL;
+	mutex_lock(&sPciLock);
+	bool end = false;
+	for (int index = 0; !end && found == NULL; index++) {
+		struct pci_dev *dev = get_nth_device(index, &end);
+		if (dev != NULL && dev->bus->number == bus && dev->devfn == devfn)
+			found = dev;
+	}
+	mutex_unlock(&sPciLock);
+	if (found != NULL)
+		get_device(&found->dev);
+	return found;
+}
+
+
+/*!	The device after \a from (or the first) that \a match accepts, with a
+	reference; drops the reference to \a from.
+*/
+static struct pci_dev *
+get_next_matching(struct pci_dev *from,
+	bool (*match)(struct pci_dev *dev, unsigned int a, unsigned int b),
+	unsigned int a, unsigned int b)
+{
+	struct pci_dev *found = NULL;
+	mutex_lock(&sPciLock);
+	bool end = false;
+	bool afterFrom = from == NULL;
+	for (int index = 0; !end && found == NULL; index++) {
+		struct pci_dev *dev = get_nth_device(index, &end);
+		if (dev == NULL)
+			continue;
+		if (!afterFrom) {
+			afterFrom = dev == from;
+			continue;
+		}
+		if (match(dev, a, b))
+			found = dev;
+	}
+	mutex_unlock(&sPciLock);
+	if (found != NULL)
+		get_device(&found->dev);
+	if (from != NULL)
+		pci_dev_put(from);
+	return found;
+}
+
+
+static bool
+match_class(struct pci_dev *dev, unsigned int class, unsigned int unused)
+{
+	return dev->class == class;
+}
+
+
+static bool
+match_ids(struct pci_dev *dev, unsigned int vendor, unsigned int device)
+{
+	return (vendor == PCI_ANY_ID || dev->vendor == vendor)
+		&& (device == PCI_ANY_ID || dev->device == device);
+}
+
+
+struct pci_dev *
+pci_get_class(unsigned int class, struct pci_dev *from)
+{
+	return get_next_matching(from, match_class, class, 0);
+}
+
+
+struct pci_dev *
+pci_get_device(unsigned int vendor, unsigned int device, struct pci_dev *from)
+{
+	return get_next_matching(from, match_ids, vendor, device);
+}
+
+
+void
+pci_dev_put(struct pci_dev *dev)
+{
+	if (dev != NULL)
+		put_device(&dev->dev);
+}
+
+
+struct pci_dev *
+pci_dev_get(struct pci_dev *dev)
+{
+	if (dev != NULL)
+		get_device(&dev->dev);
+	return dev;
+}
+
+
+/*!	If \a dev is a PCI device's struct device, fills in where and what it
+	is, for linuxkpi's LINUXKPI_IOCTL_DEVICE_INFO.
+*/
+bool
+linuxkpi_pci_device_info(struct device *dev, struct linuxkpi_device_info *info)
+{
+	struct pci_haiku *haiku;
+	bool found = false;
+	mutex_lock(&sPciLock);
+	list_for_each_entry(haiku, &sPciDevices, link) {
+		struct pci_dev *pdev = haiku->dev;
+		if (&pdev->dev != dev)
+			continue;
+		info->bus = LINUXKPI_BUS_PCI;
+		info->pci_domain = 0;
+		info->pci_bus = haiku->info.bus;
+		info->pci_device = haiku->info.device;
+		info->pci_function = haiku->info.function;
+		info->pci_revision = pdev->revision;
+		info->pci_vendor = pdev->vendor;
+		info->pci_device_id = pdev->device;
+		info->pci_subvendor = pdev->subsystem_vendor;
+		info->pci_subdevice = pdev->subsystem_device;
+		found = true;
+		break;
+	}
+	mutex_unlock(&sPciLock);
+	return found;
+}
+
+
+bool
+pci_device_is_present(struct pci_dev *pdev)
+{
+	return config_read(pdev, PCI_VENDOR_ID, 2) != 0xffff;
+}
+
+
+//	#pragma mark - drivers
+
+
+/* Which devices drivers may probe: vendor << 16 | device, or all when
+ * there is no list (see linuxkpi_pci_set_allowed_devices()). */
+static const unsigned int *sAllowedDevices;
+static int sAllowedDeviceCount = -1;
+
+
+void
+linuxkpi_pci_set_allowed_devices(const unsigned int *ids, int count)
+{
+	sAllowedDevices = ids;
+	sAllowedDeviceCount = count;
+}
+
+
+static bool
+device_allowed(struct pci_dev *dev)
+{
+	if (sAllowedDeviceCount < 0)
+		return true;
+	for (int i = 0; i < sAllowedDeviceCount; i++) {
+		if (sAllowedDevices[i] == ((unsigned int)dev->vendor << 16 | dev->device))
+			return true;
+	}
+	return false;
+}
+
+
+static const struct pci_device_id *
+match_id_table(const struct pci_device_id *ids, struct pci_dev *dev)
+{
+	for (; ids->vendor != 0 || ids->subvendor != 0 || ids->class_mask != 0;
+			ids++) {
+		if ((ids->vendor == PCI_ANY_ID || ids->vendor == dev->vendor)
+			&& (ids->device == PCI_ANY_ID || ids->device == dev->device)
+			&& (ids->subvendor == PCI_ANY_ID
+				|| ids->subvendor == dev->subsystem_vendor)
+			&& (ids->subdevice == PCI_ANY_ID
+				|| ids->subdevice == dev->subsystem_device)
+			&& ((ids->class ^ dev->class) & ids->class_mask) == 0)
+			return ids;
+	}
+	return NULL;
+}
+
+
+/*!	Probes the driver on every matching device that has none yet. Probing
+	happens right here, as with Linux's synchronous probe.
+*/
+int
+__pci_register_driver(struct pci_driver *drv, struct module *owner,
+	const char *mod_name)
+{
+	drv->driver.name = drv->name;
+	drv->driver.owner = owner;
+	drv->driver.mod_name = mod_name;
+
+	mutex_lock(&sPciLock);
+	list_add_tail(&drv->linuxkpi_link, &sPciDrivers);
+	mutex_unlock(&sPciLock);
+
+	for (int index = 0;; index++) {
+		mutex_lock(&sPciLock);
+		bool end;
+		struct pci_dev *dev = get_nth_device(index, &end);
+		mutex_unlock(&sPciLock);
+		if (end)
+			break;
+		if (dev == NULL || dev->driver != NULL)
+			continue;
+
+		const struct pci_device_id *id = match_id_table(drv->id_table, dev);
+		if (id == NULL)
+			continue;
+		if (!device_allowed(dev)) {
+			dev_info(&dev->dev, "not probing %s: %04x:%04x is not on the "
+				"device list\n", drv->name, dev->vendor, dev->device);
+			continue;
+		}
+
+		dev->driver = drv;
+		dev->dev.driver = &drv->driver;
+		dev_info(&dev->dev, "probing %s\n", drv->name);
+		int error = drv->probe(dev, id);
+		if (error != 0) {
+			dev_err(&dev->dev, "%s probe failed: %d\n", drv->name, error);
+			dev->driver = NULL;
+			dev->dev.driver = NULL;
+		}
+	}
+	return 0;
+}
+
+
+void
+pci_unregister_driver(struct pci_driver *drv)
+{
+	struct pci_haiku *haiku;
+	mutex_lock(&sPciLock);
+	list_del(&drv->linuxkpi_link);
+	mutex_unlock(&sPciLock);
+
+	list_for_each_entry(haiku, &sPciDevices, link) {
+		struct pci_dev *dev = haiku->dev;
+		if (dev->driver != drv)
+			continue;
+		if (drv->remove != NULL)
+			drv->remove(dev);
+		devres_release_all(&dev->dev);
+		dev->driver = NULL;
+		dev->dev.driver = NULL;
+	}
+}
+
+
+//	#pragma mark - enabling
+
+
+static void
+command_set(struct pci_dev *dev, u16 set, u16 clear)
+{
+	u16 command = config_read(dev, PCI_COMMAND, 2);
+	u16 changed = (command | set) & ~clear;
+	if (changed != command)
+		config_write(dev, PCI_COMMAND, 2, changed);
+}
+
+
+int
+pci_enable_device(struct pci_dev *dev)
+{
+	u16 set = 0;
+	for (int bar = 0; bar < 6; bar++) {
+		if (dev->resource[bar].flags & IORESOURCE_IO)
+			set |= PCI_COMMAND_IO;
+		else if (dev->resource[bar].flags & IORESOURCE_MEM)
+			set |= PCI_COMMAND_MEMORY;
+	}
+	command_set(dev, set, 0);
+	atomic_inc(&dev->enable_cnt);
+	return 0;
+}
+
+
+void
+pci_disable_device(struct pci_dev *dev)
+{
+	if (atomic_dec_return(&dev->enable_cnt) == 0)
+		command_set(dev, 0, PCI_COMMAND_MASTER);
+}
+
+
+void
+pci_set_master(struct pci_dev *dev)
+{
+	command_set(dev, PCI_COMMAND_MASTER, 0);
+}
+
+
+void
+pci_clear_master(struct pci_dev *dev)
+{
+	command_set(dev, 0, PCI_COMMAND_MASTER);
+}
+
+
+int
+pci_enable_atomic_ops_to_root(struct pci_dev *dev, u32 cap_mask)
+{
+	// Would need the root port's capabilities; amdgpu copes without.
+	return -EINVAL;
+}
+
+
+void
+pci_ignore_hotplug(struct pci_dev *dev)
+{
+}
+
+
+bool
+pcie_aspm_enabled(struct pci_dev *pdev)
+{
+	return false;
+}
+
+
+//	#pragma mark - state and power
+
+
+int
+pci_save_state(struct pci_dev *dev)
+{
+	for (int i = 0; i < 16; i++)
+		dev->saved_config_space[i] = config_read(dev, i * 4, 4);
+	return 0;
+}
+
+
+void
+pci_restore_state(struct pci_dev *dev)
+{
+	// From the top down, so the command register comes last
+	for (int i = 15; i >= 0; i--) {
+		if (config_read(dev, i * 4, 4) != dev->saved_config_space[i])
+			config_write(dev, i * 4, 4, dev->saved_config_space[i]);
+	}
+}
+
+
+struct pci_saved_state *
+pci_store_saved_state(struct pci_dev *dev)
+{
+	struct pci_saved_state *state = kmalloc(sizeof(*state), GFP_KERNEL);
+	if (state != NULL)
+		memcpy(state->config_space, dev->saved_config_space,
+			sizeof(state->config_space));
+	return state;
+}
+
+
+int
+pci_load_saved_state(struct pci_dev *dev, struct pci_saved_state *state)
+{
+	if (state == NULL)
+		return 0;
+	memcpy(dev->saved_config_space, state->config_space,
+		sizeof(state->config_space));
+	return 0;
+}
+
+
+int
+pci_load_and_free_saved_state(struct pci_dev *dev,
+	struct pci_saved_state **state)
+{
+	int error = pci_load_saved_state(dev, *state);
+	kfree(*state);
+	*state = NULL;
+	return error;
+}
+
+
+void
+pci_restore_msi_state(struct pci_dev *dev)
+{
+}
+
+
+int
+pci_reset_function(struct pci_dev *dev)
+{
+	return -ENOTTY;
+}
+
+
+int
+pci_wait_for_pending_transaction(struct pci_dev *dev)
+{
+	return 1;
+}
+
+
+int
+pci_wake_from_d3(struct pci_dev *dev, bool enable)
+{
+	return 0;
+}
+
+
+int
+pci_set_power_state(struct pci_dev *dev, pci_power_t state)
+{
+	if (dev->pm_cap == 0 || state > PCI_D3hot)
+		return 0;
+	u16 control = config_read(dev, dev->pm_cap + PCI_PM_CTRL, 2);
+	control = (control & ~PCI_PM_CTRL_STATE_MASK) | state;
+	config_write(dev, dev->pm_cap + PCI_PM_CTRL, 2, control);
+	// D3hot -> D0 needs 10 ms before the device answers again
+	if (dev->current_state == PCI_D3hot && state == PCI_D0)
+		msleep(10);
+	dev->current_state = state;
+	return 0;
+}
+
+
+//	#pragma mark - PCIe link
+
+
+static enum pci_bus_speed
+link_speed(u32 encoded)
+{
+	switch (encoded) {
+		case 1: return PCIE_SPEED_2_5GT;
+		case 2: return PCIE_SPEED_5_0GT;
+		case 3: return PCIE_SPEED_8_0GT;
+		case 4: return PCIE_SPEED_16_0GT;
+		case 5: return PCIE_SPEED_32_0GT;
+		case 6: return PCIE_SPEED_64_0GT;
+		default: return PCI_SPEED_UNKNOWN;
+	}
+}
+
+
+static u32
+speed_mbps(enum pci_bus_speed speed)
+{
+	// per lane, after encoding overhead
+	switch (speed) {
+		case PCIE_SPEED_2_5GT: return 2000;
+		case PCIE_SPEED_5_0GT: return 4000;
+		case PCIE_SPEED_8_0GT: return 7877;
+		case PCIE_SPEED_16_0GT: return 15754;
+		case PCIE_SPEED_32_0GT: return 31508;
+		case PCIE_SPEED_64_0GT: return 60000;
+		default: return 0;
+	}
+}
+
+
+enum pci_bus_speed
+pcie_get_speed_cap(struct pci_dev *dev)
+{
+	u32 cap2 = 0, cap = 0;
+	pcie_capability_read_dword(dev, PCI_EXP_LNKCAP2, &cap2);
+	if (cap2 & PCI_EXP_LNKCAP2_SLS)
+		return link_speed(fls(cap2 & PCI_EXP_LNKCAP2_SLS) - 1);
+	pcie_capability_read_dword(dev, PCI_EXP_LNKCAP, &cap);
+	return link_speed(cap & PCI_EXP_LNKCAP_SLS);
+}
+
+
+enum pcie_link_width
+pcie_get_width_cap(struct pci_dev *dev)
+{
+	u32 cap = 0;
+	pcie_capability_read_dword(dev, PCI_EXP_LNKCAP, &cap);
+	if (cap == 0)
+		return PCIE_LNK_WIDTH_UNKNOWN;
+	return (cap & PCI_EXP_LNKCAP_MLW) >> 4;
+}
+
+
+u32
+pcie_bandwidth_available(struct pci_dev *dev, struct pci_dev **limiting_dev,
+	enum pci_bus_speed *speed, enum pcie_link_width *width)
+{
+	// Only the device's own link; Haiku does not tell us the bridges'.
+	u16 status = 0;
+	pcie_capability_read_word(dev, PCI_EXP_LNKSTA, &status);
+	enum pci_bus_speed linkSpeed = link_speed(status & PCI_EXP_LNKSTA_CLS);
+	enum pcie_link_width linkWidth = (status & PCI_EXP_LNKSTA_NLW) >> 4;
+	if (limiting_dev != NULL)
+		*limiting_dev = dev;
+	if (speed != NULL)
+		*speed = linkSpeed;
+	if (width != NULL)
+		*width = linkWidth;
+	return linkWidth * speed_mbps(linkSpeed);
+}
+
+
+int
+pcie_get_mps(struct pci_dev *dev)
+{
+	u16 control = 0;
+	pcie_capability_read_word(dev, PCI_EXP_DEVCTL, &control);
+	return 128 << ((control & PCI_EXP_DEVCTL_PAYLOAD) >> 5);
+}
+
+
+//	#pragma mark - interrupts
+
+
+int
+pci_alloc_irq_vectors(struct pci_dev *dev, unsigned int min_vecs,
+	unsigned int max_vecs, unsigned int flags)
+{
+	struct pci_haiku *haiku = haiku_of(dev);
+	if (haiku->msi)
+		return 1;
+
+	if (flags & (PCI_IRQ_MSI | PCI_IRQ_MSIX)) {
+		struct lkpi_haiku_pci_device *info = &haiku->info;
+		unsigned int vector;
+		if (lkpi_haiku_pci_enable_msi(info->bus, info->device,
+				info->function, &vector) == 0) {
+			haiku->msi = true;
+			dev->msi_enabled = 1;
+			dev->irq = vector;
+			return 1;
+		}
+	}
+	if (flags & PCI_IRQ_INTX) {
+		// linuxkpi runs handlers in a thread, which a level-triggered,
+		// unmasked line would keep interrupting.
+		dev_warn(&dev->dev, "no MSI; legacy interrupts will not work well\n");
+		dev->irq = haiku->info.interrupt_line;
+		return 1;
+	}
+	return -ENOSPC;
+}
+
+
+void
+pci_free_irq_vectors(struct pci_dev *dev)
+{
+	struct pci_haiku *haiku = haiku_of(dev);
+	if (!haiku->msi)
+		return;
+	lkpi_haiku_pci_disable_msi(haiku->info.bus, haiku->info.device,
+		haiku->info.function);
+	haiku->msi = false;
+	dev->msi_enabled = 0;
+	dev->irq = haiku->info.interrupt_line;
+}
+
+
+int
+pci_irq_vector(struct pci_dev *dev, unsigned int nr)
+{
+	return nr == 0 ? (int)dev->irq : -EINVAL;
+}
+
+
+int
+pci_enable_msi(struct pci_dev *dev)
+{
+	int count = pci_alloc_irq_vectors(dev, 1, 1, PCI_IRQ_MSI);
+	return count < 0 ? count : 0;
+}
+
+
+void
+pci_disable_msi(struct pci_dev *dev)
+{
+	pci_free_irq_vectors(dev);
+}
+
+
+//	#pragma mark - ROM
+
+
+void __iomem *
+pci_map_rom(struct pci_dev *pdev, size_t *size)
+{
+	struct resource *res = &pdev->resource[PCI_ROM_RESOURCE];
+	if (res->flags == 0)
+		return NULL;
+
+	u32 base = config_read(pdev, PCI_ROM_ADDRESS, 4);
+	config_write(pdev, PCI_ROM_ADDRESS, 4, base | PCI_ROM_ADDRESS_ENABLE);
+	size_t length = resource_size(res);
+	void __iomem *rom = ioremap(res->start, length);
+	if (rom == NULL || readw(rom) != 0xaa55) {
+		if (rom != NULL)
+			iounmap(rom);
+		config_write(pdev, PCI_ROM_ADDRESS, 4, base);
+		return NULL;
+	}
+	*size = length;
+	return rom;
+}
+
+
+void
+pci_unmap_rom(struct pci_dev *pdev, void __iomem *rom)
+{
+	iounmap(rom);
+	u32 base = config_read(pdev, PCI_ROM_ADDRESS, 4);
+	config_write(pdev, PCI_ROM_ADDRESS, 4, base & ~PCI_ROM_ADDRESS_ENABLE);
+}
diff --git a/src/libs/compat/linuxkpi/linux/printk.c b/src/libs/compat/linuxkpi/linux/printk.c
new file mode 100644
index 0000000000..172100dbbf
--- /dev/null
+++ b/src/libs/compat/linuxkpi/linux/printk.c
@@ -0,0 +1,64 @@
+/*
+ * Copyright 2026, hans2294.
+ * Distributed under the terms of the MIT License.
+ */
+
+
+/*!	printk() and BUG()/WARN() on top of Haiku's debug output. */
+
+
+#include <linux/kernel.h>
+#include <linux/printk.h>
+#include <linux/bug.h>
+#include <linuxkpi/haiku.h>
+
+
+#define PRINTK_BUFFER_SIZE	512
+
+
+/*!	Strips the KERN_<level> prefix; Haiku's syslog has no levels. */
+static const char *
+skip_level(const char *fmt)
+{
+	while (fmt[0] == KERN_SOH[0] && fmt[1] != '\0')
+		fmt += 2;
+	return fmt;
+}
+
+
+int
+vprintk(const char *fmt, va_list args)
+{
+	char buffer[PRINTK_BUFFER_SIZE];
+	int length = vscnprintf(buffer, sizeof(buffer), skip_level(fmt), args);
+	// dev_printk() and friends pass the level as an argument
+	lkpi_haiku_debug_output(skip_level(buffer));
+	return length;
+}
+
+
+int
+_printk(const char *fmt, ...)
+{
+	va_list args;
+	va_start(args, fmt);
+	int length = vprintk(fmt, args);
+	va_end(args);
+	return length;
+}
+
+
+void
+linuxkpi_bug(const char *file, int line)
+{
+	char buffer[PRINTK_BUFFER_SIZE];
+	snprintf(buffer, sizeof(buffer), "BUG at %s:%d", file, line);
+	lkpi_haiku_panic(buffer);
+}
+
+
+void
+linuxkpi_warn(const char *file, int line, const char *condition)
+{
+	printk(KERN_WARNING "WARNING at %s:%d: %s\n", file, line, condition);
+}
diff --git a/src/libs/compat/linuxkpi/linux/sched.c b/src/libs/compat/linuxkpi/linux/sched.c
new file mode 100644
index 0000000000..5f8f06abaf
--- /dev/null
+++ b/src/libs/compat/linuxkpi/linux/sched.c
@@ -0,0 +1,1136 @@
+/*
+ * Copyright 2026, hans2294.
+ * Distributed under the terms of the MIT License.
+ */
+
+
+/*!	Tasks and sleeping: a task_struct per Haiku thread, schedule() and
+	wake_up_process() on a semaphore per task, wait queues, completions,
+	kthreads, RCU, time and delays.
+
+	A task sleeps while its __state is not TASK_RUNNING. Whoever changes the
+	state of a sleeping task to TASK_RUNNING releases its semaphore once;
+	schedule() acquires it and looks at the state again, so a release left
+	over from an earlier sleep only costs one extra round.
+*/
+
+
+#include <linux/sched.h>
+#include <linux/sched/signal.h>
+#include <linux/wait.h>
+#include <linux/completion.h>
+#include <linux/kthread.h>
+#include <linux/rcupdate.h>
+#include <linux/srcu.h>
+#include <linux/slab.h>
+#include <linux/ratelimit.h>
+#include <linux/pid.h>
+#include <linux/delay.h>
+#include <linux/ktime.h>
+#include <linux/timekeeping.h>
+#include <linux/jiffies.h>
+#include <linux/init.h>
+#include <linux/printk.h>
+
+#include <linuxkpi/haiku.h>
+
+
+enum system_states system_state = SYSTEM_RUNNING;
+
+
+//	#pragma mark - tasks
+
+
+#define TASK_HASH_SIZE	64
+
+static DEFINE_SPINLOCK(sTaskLock);
+static struct task_struct *sTaskHash[TASK_HASH_SIZE];
+
+
+struct kthread {
+	int (*threadfn)(void *data);
+	void *data;
+	atomic_t started;
+	bool should_stop;
+	bool should_park;
+	int result;
+};
+
+
+static struct task_struct *
+task_create(int thread)
+{
+	struct task_struct *task = kzalloc(sizeof(*task), GFP_KERNEL);
+	if (task == NULL)
+		return NULL;
+	task->thread = thread;
+	task->team = lkpi_haiku_team_current();
+	task->pid = thread;
+	task->tgid = task->team;
+	task->__state = TASK_RUNNING;
+	task->prio = 120;
+	task->group_leader = task;
+	refcount_set(&task->usage, 1);
+	INIT_LIST_HEAD(&task->linuxkpi_link);
+	task->linuxkpi_sem = lkpi_haiku_sem_create(0, "linux task");
+	if (task->linuxkpi_sem < 0) {
+		kfree(task);
+		return NULL;
+	}
+	return task;
+}
+
+
+static void
+task_register(struct task_struct *task)
+{
+	unsigned int bucket = (unsigned int)task->thread % TASK_HASH_SIZE;
+	spin_lock(&sTaskLock);
+	task->linuxkpi_hash_next = sTaskHash[bucket];
+	sTaskHash[bucket] = task;
+	spin_unlock(&sTaskLock);
+}
+
+
+static void
+task_unregister(struct task_struct *task)
+{
+	unsigned int bucket = (unsigned int)task->thread % TASK_HASH_SIZE;
+	spin_lock(&sTaskLock);
+	struct task_struct **link = &sTaskHash[bucket];
+	while (*link != NULL && *link != task)
+		link = &(*link)->linuxkpi_hash_next;
+	if (*link != NULL)
+		*link = task->linuxkpi_hash_next;
+	spin_unlock(&sTaskLock);
+}
+
+
+/*!	The task of the calling thread. Threads that did not come from
+	kthread_create() get one the first time they ask.
+	TODO: those are never freed; hook thread exit.
+*/
+struct task_struct *
+linuxkpi_current(void)
+{
+	int thread = lkpi_haiku_thread_current();
+	unsigned int bucket = (unsigned int)thread % TASK_HASH_SIZE;
+
+	spin_lock(&sTaskLock);
+	struct task_struct *task = sTaskHash[bucket];
+	while (task != NULL && task->thread != thread)
+		task = task->linuxkpi_hash_next;
+	spin_unlock(&sTaskLock);
+	if (task != NULL)
+		return task;
+
+	task = task_create(thread);
+	if (task == NULL)
+		panic("linuxkpi: no memory for a task");
+	lkpi_haiku_thread_name(thread, task->comm, sizeof(task->comm));
+	task_register(task);
+	return task;
+}
+
+
+void
+get_task_struct(struct task_struct *t)
+{
+	refcount_inc(&t->usage);
+}
+
+
+void
+put_task_struct(struct task_struct *t)
+{
+	if (!refcount_dec_and_test(&t->usage))
+		return;
+	task_unregister(t);
+	lkpi_haiku_sem_delete(t->linuxkpi_sem);
+	kfree(t->kthread);
+	if (t->linuxkpi_tgid != NULL)
+		put_pid(t->linuxkpi_tgid);
+	kfree(t);
+}
+
+
+//	#pragma mark - pids
+
+
+struct pid *
+get_pid(struct pid *pid)
+{
+	if (pid != NULL)
+		refcount_inc(&pid->count);
+	return pid;
+}
+
+
+void
+put_pid(struct pid *pid)
+{
+	if (pid != NULL && refcount_dec_and_test(&pid->count))
+		kfree(pid);
+}
+
+
+pid_t
+pid_nr(struct pid *pid)
+{
+	return pid != NULL ? pid->nr : 0;
+}
+
+
+pid_t
+pid_vnr(struct pid *pid)
+{
+	return pid_nr(pid);
+}
+
+
+struct pid *
+task_tgid(struct task_struct *task)
+{
+	if (task->linuxkpi_tgid == NULL) {
+		struct pid *pid = kzalloc(sizeof(*pid), GFP_KERNEL);
+		if (pid == NULL)
+			return NULL;
+		refcount_set(&pid->count, 1);
+		pid->nr = task->tgid;
+		if (cmpxchg(&task->linuxkpi_tgid, NULL, pid) != NULL)
+			kfree(pid);
+	}
+	return task->linuxkpi_tgid;
+}
+
+
+struct pid *
+get_task_pid(struct task_struct *task, int type)
+{
+	return get_pid(task_tgid(task));
+}
+
+
+//	#pragma mark - sleeping and waking
+
+
+void
+set_current_state_impl(unsigned int state)
+{
+	smp_store_mb(current->__state, state);
+}
+
+
+void
+schedule(void)
+{
+	struct task_struct *task = current;
+	while (READ_ONCE(task->__state) != TASK_RUNNING)
+		lkpi_haiku_sem_acquire(task->linuxkpi_sem, -1, 0);
+}
+
+
+long
+schedule_timeout(long timeout)
+{
+	struct task_struct *task = current;
+	if (timeout == MAX_SCHEDULE_TIMEOUT) {
+		schedule();
+		return timeout;
+	}
+	if (timeout < 0) {
+		WRITE_ONCE(task->__state, TASK_RUNNING);
+		return 0;
+	}
+
+	long long end = lkpi_haiku_system_time()
+		+ (long long)timeout * (USEC_PER_SEC / HZ);
+	for (;;) {
+		long long remaining = end - lkpi_haiku_system_time();
+		if (READ_ONCE(task->__state) == TASK_RUNNING)
+			return remaining > 0 ? usecs_to_jiffies(remaining) : 0;
+		if (remaining <= 0) {
+			WRITE_ONCE(task->__state, TASK_RUNNING);
+			return 0;
+		}
+		lkpi_haiku_sem_acquire(task->linuxkpi_sem, remaining, 0);
+	}
+}
+
+
+long
+schedule_timeout_interruptible(long timeout)
+{
+	set_current_state(TASK_INTERRUPTIBLE);
+	return schedule_timeout(timeout);
+}
+
+
+long
+schedule_timeout_uninterruptible(long timeout)
+{
+	set_current_state(TASK_UNINTERRUPTIBLE);
+	return schedule_timeout(timeout);
+}
+
+
+long
+schedule_timeout_killable(long timeout)
+{
+	set_current_state(TASK_KILLABLE);
+	return schedule_timeout(timeout);
+}
+
+
+int
+wake_up_state(struct task_struct *tsk, unsigned int state)
+{
+	for (;;) {
+		unsigned int old = READ_ONCE(tsk->__state);
+		if ((old & state) == 0)
+			return 0;
+		if (cmpxchg(&tsk->__state, old, TASK_RUNNING) == old) {
+			lkpi_haiku_sem_release(tsk->linuxkpi_sem);
+			return 1;
+		}
+	}
+}
+
+
+int
+wake_up_process(struct task_struct *tsk)
+{
+	struct kthread *kthread = tsk->kthread;
+	if (kthread != NULL && atomic_xchg(&kthread->started, 1) == 0) {
+		WRITE_ONCE(tsk->__state, TASK_RUNNING);
+		lkpi_haiku_thread_resume(tsk->thread);
+		return 1;
+	}
+	return wake_up_state(tsk, TASK_NORMAL);
+}
+
+
+int
+signal_pending(struct task_struct *p)
+{
+	// TODO: Haiku signals; nothing interrupts a wait yet
+	return 0;
+}
+
+
+int
+fatal_signal_pending(struct task_struct *p)
+{
+	return 0;
+}
+
+
+void
+yield(void)
+{
+	lkpi_haiku_thread_yield();
+}
+
+
+void
+cond_resched(void)
+{
+}
+
+
+void
+might_sleep(void)
+{
+}
+
+
+void
+sched_set_fifo(struct task_struct *p)
+{
+	lkpi_haiku_thread_set_priority(p->thread, LKPI_HAIKU_PRIORITY_URGENT);
+}
+
+
+void
+sched_set_fifo_low(struct task_struct *p)
+{
+	lkpi_haiku_thread_set_priority(p->thread, LKPI_HAIKU_PRIORITY_NORMAL + 2);
+}
+
+
+void
+sched_set_normal(struct task_struct *p, int nice)
+{
+	lkpi_haiku_thread_set_priority(p->thread, LKPI_HAIKU_PRIORITY_NORMAL);
+}
+
+
+int
+sched_setscheduler_nocheck(struct task_struct *p, int policy,
+	const void *param)
+{
+	sched_set_fifo(p);
+	return 0;
+}
+
+
+//	#pragma mark - wait queues
+
+
+void
+linuxkpi_init_waitqueue_head(struct wait_queue_head *wq_head, const char *name)
+{
+	spin_lock_init(&wq_head->lock);
+	INIT_LIST_HEAD(&wq_head->head);
+}
+
+
+int
+default_wake_function(struct wait_queue_entry *wq_entry, unsigned mode,
+	int flags, void *key)
+{
+	return wake_up_state(wq_entry->private, mode);
+}
+
+
+int
+autoremove_wake_function(struct wait_queue_entry *wq_entry, unsigned mode,
+	int sync, void *key)
+{
+	int woken = default_wake_function(wq_entry, mode, sync, key);
+	if (woken)
+		list_del_init(&wq_entry->entry);
+	return woken;
+}
+
+
+void
+init_wait_entry(struct wait_queue_entry *wq_entry, int flags)
+{
+	wq_entry->flags = flags;
+	wq_entry->private = current;
+	wq_entry->func = autoremove_wake_function;
+	INIT_LIST_HEAD(&wq_entry->entry);
+}
+
+
+void
+add_wait_queue(struct wait_queue_head *wq_head,
+	struct wait_queue_entry *wq_entry)
+{
+	unsigned long flags;
+	wq_entry->flags &= ~WQ_FLAG_EXCLUSIVE;
+	spin_lock_irqsave(&wq_head->lock, flags);
+	__add_wait_queue(wq_head, wq_entry);
+	spin_unlock_irqrestore(&wq_head->lock, flags);
+}
+
+
+void
+add_wait_queue_exclusive(struct wait_queue_head *wq_head,
+	struct wait_queue_entry *wq_entry)
+{
+	unsigned long flags;
+	wq_entry->flags |= WQ_FLAG_EXCLUSIVE;
+	spin_lock_irqsave(&wq_head->lock, flags);
+	__add_wait_queue_entry_tail(wq_head, wq_entry);
+	spin_unlock_irqrestore(&wq_head->lock, flags);
+}
+
+
+void
+remove_wait_queue(struct wait_queue_head *wq_head,
+	struct wait_queue_entry *wq_entry)
+{
+	unsigned long flags;
+	spin_lock_irqsave(&wq_head->lock, flags);
+	__remove_wait_queue(wq_head, wq_entry);
+	spin_unlock_irqrestore(&wq_head->lock, flags);
+}
+
+
+void
+prepare_to_wait(struct wait_queue_head *wq_head,
+	struct wait_queue_entry *wq_entry, int state)
+{
+	unsigned long flags;
+	wq_entry->flags &= ~WQ_FLAG_EXCLUSIVE;
+	spin_lock_irqsave(&wq_head->lock, flags);
+	if (list_empty(&wq_entry->entry))
+		__add_wait_queue(wq_head, wq_entry);
+	set_current_state(state);
+	spin_unlock_irqrestore(&wq_head->lock, flags);
+}
+
+
+bool
+prepare_to_wait_exclusive(struct wait_queue_head *wq_head,
+	struct wait_queue_entry *wq_entry, int state)
+{
+	unsigned long flags;
+	bool first = false;
+	wq_entry->flags |= WQ_FLAG_EXCLUSIVE;
+	spin_lock_irqsave(&wq_head->lock, flags);
+	if (list_empty(&wq_entry->entry)) {
+		first = list_empty(&wq_head->head);
+		__add_wait_queue_entry_tail(wq_head, wq_entry);
+	}
+	set_current_state(state);
+	spin_unlock_irqrestore(&wq_head->lock, flags);
+	return first;
+}
+
+
+long
+prepare_to_wait_event(struct wait_queue_head *wq_head,
+	struct wait_queue_entry *wq_entry, int state)
+{
+	unsigned long flags;
+	spin_lock_irqsave(&wq_head->lock, flags);
+	if (list_empty(&wq_entry->entry)) {
+		if (wq_entry->flags & WQ_FLAG_EXCLUSIVE)
+			__add_wait_queue_entry_tail(wq_head, wq_entry);
+		else
+			__add_wait_queue(wq_head, wq_entry);
+	}
+	set_current_state(state);
+	spin_unlock_irqrestore(&wq_head->lock, flags);
+	return 0;
+}
+
+
+void
+finish_wait(struct wait_queue_head *wq_head, struct wait_queue_entry *wq_entry)
+{
+	unsigned long flags;
+	__set_current_state(TASK_RUNNING);
+	if (!list_empty_careful(&wq_entry->entry)) {
+		spin_lock_irqsave(&wq_head->lock, flags);
+		list_del_init(&wq_entry->entry);
+		spin_unlock_irqrestore(&wq_head->lock, flags);
+	}
+}
+
+
+static void
+wake_up_common(struct wait_queue_head *wq_head, unsigned int mode, int nr,
+	void *key)
+{
+	struct wait_queue_entry *curr, *next;
+	list_for_each_entry_safe(curr, next, &wq_head->head, entry) {
+		unsigned int flags = curr->flags;
+		int woken = curr->func(curr, mode, 0, key);
+		if (woken < 0)
+			break;
+		if (woken && (flags & WQ_FLAG_EXCLUSIVE) && --nr == 0)
+			break;
+	}
+}
+
+
+void
+__wake_up(struct wait_queue_head *wq_head, unsigned int mode, int nr,
+	void *key)
+{
+	unsigned long flags;
+	spin_lock_irqsave(&wq_head->lock, flags);
+	wake_up_common(wq_head, mode, nr, key);
+	spin_unlock_irqrestore(&wq_head->lock, flags);
+}
+
+
+void
+__wake_up_locked(struct wait_queue_head *wq_head, unsigned int mode, int nr)
+{
+	wake_up_common(wq_head, mode, nr, NULL);
+}
+
+
+//	#pragma mark - completions
+
+
+void
+init_completion(struct completion *x)
+{
+	x->done = 0;
+	init_waitqueue_head(&x->wait);
+}
+
+
+void
+complete(struct completion *x)
+{
+	unsigned long flags;
+	spin_lock_irqsave(&x->wait.lock, flags);
+	if (x->done != UINT_MAX)
+		x->done++;
+	__wake_up_locked(&x->wait, TASK_NORMAL, 1);
+	spin_unlock_irqrestore(&x->wait.lock, flags);
+}
+
+
+void
+complete_all(struct completion *x)
+{
+	unsigned long flags;
+	spin_lock_irqsave(&x->wait.lock, flags);
+	x->done = UINT_MAX;
+	__wake_up_locked(&x->wait, TASK_NORMAL, 0);
+	spin_unlock_irqrestore(&x->wait.lock, flags);
+}
+
+
+static long
+wait_for_common(struct completion *x, long timeout, int state)
+{
+	struct wait_queue_entry wait;
+	unsigned long flags;
+
+	spin_lock_irqsave(&x->wait.lock, flags);
+	if (x->done == 0) {
+		init_wait_entry(&wait, WQ_FLAG_EXCLUSIVE);
+		wait.func = default_wake_function;
+		__add_wait_queue_entry_tail(&x->wait, &wait);
+		do {
+			__set_current_state(state);
+			spin_unlock_irqrestore(&x->wait.lock, flags);
+			timeout = schedule_timeout(timeout);
+			spin_lock_irqsave(&x->wait.lock, flags);
+		} while (x->done == 0 && timeout > 0);
+		__remove_wait_queue(&x->wait, &wait);
+		__set_current_state(TASK_RUNNING);
+		if (x->done == 0) {
+			spin_unlock_irqrestore(&x->wait.lock, flags);
+			return 0;
+		}
+	}
+	if (x->done != UINT_MAX)
+		x->done--;
+	spin_unlock_irqrestore(&x->wait.lock, flags);
+	return timeout > 0 ? timeout : 1;
+}
+
+
+void
+wait_for_completion(struct completion *x)
+{
+	wait_for_common(x, MAX_SCHEDULE_TIMEOUT, TASK_UNINTERRUPTIBLE);
+}
+
+
+int
+wait_for_completion_interruptible(struct completion *x)
+{
+	wait_for_common(x, MAX_SCHEDULE_TIMEOUT, TASK_INTERRUPTIBLE);
+	return 0;
+}
+
+
+int
+wait_for_completion_killable(struct completion *x)
+{
+	wait_for_common(x, MAX_SCHEDULE_TIMEOUT, TASK_KILLABLE);
+	return 0;
+}
+
+
+unsigned long
+wait_for_completion_timeout(struct completion *x, unsigned long timeout)
+{
+	return wait_for_common(x, timeout, TASK_UNINTERRUPTIBLE);
+}
+
+
+long
+wait_for_completion_interruptible_timeout(struct completion *x,
+	unsigned long timeout)
+{
+	return wait_for_common(x, timeout, TASK_INTERRUPTIBLE);
+}
+
+
+long
+wait_for_completion_killable_timeout(struct completion *x,
+	unsigned long timeout)
+{
+	return wait_for_common(x, timeout, TASK_KILLABLE);
+}
+
+
+bool
+try_wait_for_completion(struct completion *x)
+{
+	unsigned long flags;
+	bool done = false;
+	spin_lock_irqsave(&x->wait.lock, flags);
+	if (x->done != 0) {
+		if (x->done != UINT_MAX)
+			x->done--;
+		done = true;
+	}
+	spin_unlock_irqrestore(&x->wait.lock, flags);
+	return done;
+}
+
+
+bool
+completion_done(struct completion *x)
+{
+	return READ_ONCE(x->done) != 0;
+}
+
+
+//	#pragma mark - kthreads
+
+
+static int
+kthread_entry(void *data)
+{
+	struct task_struct *task = data;
+	struct kthread *kthread = task->kthread;
+	task->team = lkpi_haiku_team_current();
+	task->tgid = task->team;
+
+	int result = -EINTR;
+	if (!READ_ONCE(kthread->should_stop))
+		result = kthread->threadfn(kthread->data);
+	kthread->result = result;
+	return result;
+}
+
+
+struct task_struct *
+kthread_create_on_node(int (*threadfn)(void *data), void *data, int node,
+	const char namefmt[], ...)
+{
+	struct task_struct *task = task_create(0);
+	if (task == NULL)
+		return ERR_PTR(-ENOMEM);
+	struct kthread *kthread = kzalloc(sizeof(*kthread), GFP_KERNEL);
+	if (kthread == NULL) {
+		put_task_struct(task);
+		return ERR_PTR(-ENOMEM);
+	}
+	kthread->threadfn = threadfn;
+	kthread->data = data;
+	task->kthread = kthread;
+	task->__state = TASK_UNINTERRUPTIBLE;
+
+	va_list args;
+	va_start(args, namefmt);
+	vsnprintf(task->comm, sizeof(task->comm), namefmt, args);
+	va_end(args);
+
+	// Haiku threads start suspended; wake_up_process() resumes it.
+	int thread = lkpi_haiku_thread_spawn(kthread_entry, task->comm,
+		LKPI_HAIKU_PRIORITY_NORMAL, task);
+	if (thread < 0) {
+		put_task_struct(task);
+		return ERR_PTR(-ENOMEM);
+	}
+	task->thread = thread;
+	task->pid = thread;
+	task_register(task);
+	return task;
+}
+
+
+int
+kthread_stop(struct task_struct *k)
+{
+	struct kthread *kthread = k->kthread;
+	get_task_struct(k);
+	WRITE_ONCE(kthread->should_stop, true);
+	wake_up_process(k);
+	lkpi_haiku_thread_wait(k->thread);
+	int result = kthread->result;
+	put_task_struct(k);
+	put_task_struct(k);
+	return result;
+}
+
+
+bool
+kthread_should_stop(void)
+{
+	struct kthread *kthread = current->kthread;
+	return kthread != NULL && READ_ONCE(kthread->should_stop);
+}
+
+
+bool
+kthread_should_park(void)
+{
+	struct kthread *kthread = current->kthread;
+	return kthread != NULL && READ_ONCE(kthread->should_park);
+}
+
+
+int
+kthread_park(struct task_struct *k)
+{
+	// The scheduler's threads park around GPU resets; parking is not
+	// implemented, so they keep running.
+	pr_warn_once("linuxkpi: kthread_park() not implemented\n");
+	return 0;
+}
+
+
+void
+kthread_unpark(struct task_struct *k)
+{
+}
+
+
+void
+kthread_parkme(void)
+{
+}
+
+
+void
+kthread_bind(struct task_struct *k, unsigned int cpu)
+{
+}
+
+
+void *
+kthread_data(struct task_struct *k)
+{
+	struct kthread *kthread = k->kthread;
+	return kthread != NULL ? kthread->data : NULL;
+}
+
+
+//	#pragma mark - RCU
+
+
+/*!	Readers count themselves into one of two epochs; synchronize_rcu()
+	switches the epoch and waits for the old one to empty. Readers may not
+	sleep, as on Linux, so the wait is short.
+*/
+
+static DEFINE_SPINLOCK(sRcuLock);
+static DEFINE_MUTEX(sRcuSyncLock);
+static DECLARE_WAIT_QUEUE_HEAD(sRcuWait);
+static int sRcuEpoch;
+static int sRcuReaders[2];
+
+static DEFINE_SPINLOCK(sRcuCallbackLock);
+static struct rcu_head *sRcuCallbacks;
+static struct rcu_head *sRcuFrees;
+static unsigned long sRcuQueued, sRcuDone;
+static DECLARE_WAIT_QUEUE_HEAD(sRcuThreadWait);
+static DECLARE_WAIT_QUEUE_HEAD(sRcuDoneWait);
+
+
+void
+rcu_read_lock(void)
+{
+	struct task_struct *task = current;
+	if (task->linuxkpi_rcu_depth++ > 0)
+		return;
+	spin_lock(&sRcuLock);
+	task->linuxkpi_rcu_epoch = sRcuEpoch;
+	sRcuReaders[sRcuEpoch]++;
+	spin_unlock(&sRcuLock);
+}
+
+
+void
+rcu_read_unlock(void)
+{
+	struct task_struct *task = current;
+	if (--task->linuxkpi_rcu_depth > 0)
+		return;
+	spin_lock(&sRcuLock);
+	bool wake = --sRcuReaders[task->linuxkpi_rcu_epoch] == 0;
+	spin_unlock(&sRcuLock);
+	if (wake)
+		wake_up_all(&sRcuWait);
+}
+
+
+static bool
+rcu_epoch_empty(int epoch)
+{
+	spin_lock(&sRcuLock);
+	bool empty = sRcuReaders[epoch] == 0;
+	spin_unlock(&sRcuLock);
+	return empty;
+}
+
+
+void
+synchronize_rcu(void)
+{
+	mutex_lock(&sRcuSyncLock);
+	spin_lock(&sRcuLock);
+	int old = sRcuEpoch;
+	sRcuEpoch = !old;
+	spin_unlock(&sRcuLock);
+	wait_event(sRcuWait, rcu_epoch_empty(old));
+	mutex_unlock(&sRcuSyncLock);
+}
+
+
+void
+synchronize_srcu(struct srcu_struct *ssp)
+{
+	synchronize_rcu();
+}
+
+
+int
+init_srcu_struct(struct srcu_struct *ssp)
+{
+	return 0;
+}
+
+
+void
+cleanup_srcu_struct(struct srcu_struct *ssp)
+{
+}
+
+
+void
+call_rcu(struct rcu_head *head, rcu_callback_t func)
+{
+	head->func = func;
+	spin_lock(&sRcuCallbackLock);
+	head->next = sRcuCallbacks;
+	sRcuCallbacks = head;
+	sRcuQueued++;
+	spin_unlock(&sRcuCallbackLock);
+	wake_up(&sRcuThreadWait);
+}
+
+
+void
+kvfree_call_rcu(struct rcu_head *head, void *ptr)
+{
+	if (head == NULL) {
+		synchronize_rcu();
+		kvfree(ptr);
+		return;
+	}
+	// The callback field carries the object to free.
+	head->func = (rcu_callback_t)ptr;
+	spin_lock(&sRcuCallbackLock);
+	head->next = sRcuFrees;
+	sRcuFrees = head;
+	sRcuQueued++;
+	spin_unlock(&sRcuCallbackLock);
+	wake_up(&sRcuThreadWait);
+}
+
+
+void
+rcu_barrier(void)
+{
+	spin_lock(&sRcuCallbackLock);
+	unsigned long target = sRcuQueued;
+	spin_unlock(&sRcuCallbackLock);
+	wait_event(sRcuDoneWait, READ_ONCE(sRcuDone) >= target);
+}
+
+
+static bool
+rcu_work_queued(void)
+{
+	return READ_ONCE(sRcuCallbacks) != NULL || READ_ONCE(sRcuFrees) != NULL;
+}
+
+
+static int
+rcu_thread(void *data)
+{
+	for (;;) {
+		wait_event(sRcuThreadWait, rcu_work_queued());
+
+		spin_lock(&sRcuCallbackLock);
+		struct rcu_head *callbacks = sRcuCallbacks;
+		struct rcu_head *frees = sRcuFrees;
+		sRcuCallbacks = sRcuFrees = NULL;
+		spin_unlock(&sRcuCallbackLock);
+
+		synchronize_rcu();
+
+		unsigned long count = 0;
+		while (callbacks != NULL) {
+			struct rcu_head *next = callbacks->next;
+			callbacks->func(callbacks);
+			callbacks = next;
+			count++;
+		}
+		while (frees != NULL) {
+			struct rcu_head *next = frees->next;
+			kvfree((void *)frees->func);
+			frees = next;
+			count++;
+		}
+
+		spin_lock(&sRcuCallbackLock);
+		sRcuDone += count;
+		spin_unlock(&sRcuCallbackLock);
+		wake_up_all(&sRcuDoneWait);
+	}
+	return 0;
+}
+
+
+static int __init
+linuxkpi_rcu_init(void)
+{
+	struct task_struct *task = kthread_run(rcu_thread, NULL, "linux rcu");
+	return IS_ERR(task) ? PTR_ERR(task) : 0;
+}
+core_initcall(linuxkpi_rcu_init);
+
+
+//	#pragma mark - ratelimit
+
+
+int
+___ratelimit(struct ratelimit_state *rs, const char *func)
+{
+	if (rs->interval == 0)
+		return 1;
+
+	unsigned long now = jiffies;
+	int allowed;
+	spin_lock(&rs->lock);
+	if (rs->begin == 0)
+		rs->begin = now;
+	if (time_is_before_jiffies(rs->begin + rs->interval)) {
+		if (rs->missed != 0) {
+			printk(KERN_WARNING "%s: %d callbacks suppressed\n", func,
+				rs->missed);
+			rs->missed = 0;
+		}
+		rs->begin = now;
+		rs->printed = 0;
+	}
+	if (rs->burst != 0 && rs->burst > rs->printed) {
+		rs->printed++;
+		allowed = 1;
+	} else {
+		rs->missed++;
+		allowed = 0;
+	}
+	spin_unlock(&rs->lock);
+	return allowed;
+}
+
+
+//	#pragma mark - time
+
+
+unsigned long
+linuxkpi_jiffies(void)
+{
+	return lkpi_haiku_system_time() / (USEC_PER_SEC / HZ);
+}
