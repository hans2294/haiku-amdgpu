diff --git a/src/libs/compat/linuxkpi/include/linux/jiffies.h b/src/libs/compat/linuxkpi/include/linux/jiffies.h
new file mode 100644
index 0000000000..5f0f881d50
--- /dev/null
+++ b/src/libs/compat/linuxkpi/include/linux/jiffies.h
@@ -0,0 +1,53 @@
+/*
+ * Copyright 2026, hans2294.
+ * Distributed under the terms of the MIT License.
+ */
+#ifndef _LINUXKPI_LINUX_JIFFIES_H
+#define _LINUXKPI_LINUX_JIFFIES_H
+
+#include <linux/types.h>
+#include <linux/time64.h>
+#include <linux/limits.h>
+
+#define HZ				1000
+#define USER_HZ			100
+#define MAX_JIFFY_OFFSET	((LONG_MAX >> 1) - 1)
+
+unsigned long linuxkpi_jiffies(void);
+#define jiffies			linuxkpi_jiffies()
+#define jiffies_64		((u64)linuxkpi_jiffies())
+static inline u64 get_jiffies_64(void) { return jiffies; }
+
+#define time_after(a, b)		((long)((b) - (a)) < 0)
+#define time_before(a, b)		time_after(b, a)
+#define time_after_eq(a, b)		((long)((a) - (b)) >= 0)
+#define time_before_eq(a, b)	time_after_eq(b, a)
+#define time_in_range(a, b, c)	(time_after_eq(a, b) && time_before_eq(a, c))
+#define time_after64(a, b)		((s64)((b) - (a)) < 0)
+#define time_before64(a, b)		time_after64(b, a)
+#define time_after_eq64(a, b)	((s64)((a) - (b)) >= 0)
+#define time_is_before_jiffies(a)	time_after(jiffies, a)
+#define time_is_after_jiffies(a)	time_before(jiffies, a)
+#define time_is_before_eq_jiffies(a)	time_after_eq(jiffies, a)
+#define time_is_after_eq_jiffies(a)	time_before_eq(jiffies, a)
+
+static inline unsigned int jiffies_to_msecs(unsigned long j) { return j * (MSEC_PER_SEC / HZ); }
+static inline unsigned int jiffies_to_usecs(unsigned long j) { return j * (USEC_PER_SEC / HZ); }
+static inline u64 jiffies_to_nsecs(unsigned long j) { return (u64)j * (NSEC_PER_SEC / HZ); }
+static inline u64 jiffies64_to_nsecs(u64 j) { return j * (NSEC_PER_SEC / HZ); }
+static inline u64 jiffies64_to_msecs(u64 j) { return j * (MSEC_PER_SEC / HZ); }
+static inline unsigned long msecs_to_jiffies(unsigned int m)
+{ return m > jiffies_to_msecs(MAX_JIFFY_OFFSET) ? MAX_JIFFY_OFFSET : m / (MSEC_PER_SEC / HZ); }
+static inline unsigned long usecs_to_jiffies(unsigned int u)
+{ return (u + (USEC_PER_SEC / HZ) - 1) / (USEC_PER_SEC / HZ); }
+static inline unsigned long nsecs_to_jiffies(u64 n)
+{ return (n + (NSEC_PER_SEC / HZ) - 1) / (NSEC_PER_SEC / HZ); }
+static inline u64 nsecs_to_jiffies64(u64 n) { return nsecs_to_jiffies(n); }
+static inline clock_t jiffies_to_clock_t(unsigned long x) { return x / (HZ / USER_HZ); }
+static inline unsigned long timespec64_to_jiffies(const struct timespec64 *value)
+{ return nsecs_to_jiffies(timespec64_to_ns(value)); }
+static inline unsigned long round_jiffies_up(unsigned long j) { return j; }
+static inline unsigned long round_jiffies_up_relative(unsigned long j) { return j; }
+static inline unsigned long round_jiffies_relative(unsigned long j) { return j; }
+
+#endif
