+const char hex_asc[] = "0123456789abcdef";
+
+
+//	#pragma mark - strings
+
+
+char *
+kstrdup(const char *s, gfp_t gfp)
+{
+	if (s == NULL)
+		return NULL;
+	size_t length = strlen(s) + 1;
+	char *copy = kmalloc(length, gfp);
+	if (copy != NULL)
+		memcpy(copy, s, length);
+	return copy;
+}
+
+
+const char *
+kstrdup_const(const char *s, gfp_t gfp)
+{
+	return kstrdup(s, gfp);
+}
+
+
+void
+kfree_const(const void *x)
+{
+	kfree(x);
+}
+
+
+char *
+kstrndup(const char *s, size_t max, gfp_t gfp)
+{
+	if (s == NULL)
+		return NULL;
+	size_t length = strnlen(s, max);
+	char *copy = kmalloc(length + 1, gfp);
+	if (copy != NULL) {
+		memcpy(copy, s, length);
+		copy[length] = '\0';
+	}
+	return copy;
+}
+
+
+void *
+kmemdup(const void *src, size_t length, gfp_t gfp)
+{
+	void *copy = kmalloc(length, gfp);
+	if (copy != NULL)
+		memcpy(copy, src, length);
+	return copy;
+}
+
+
+char *
+kmemdup_nul(const char *s, size_t length, gfp_t gfp)
+{
+	char *copy = kmalloc(length + 1, gfp);
+	if (copy != NULL) {
+		memcpy(copy, s, length);
+		copy[length] = '\0';
+	}
+	return copy;
+}
+
+
+void *
+kmemdup_array(const void *src, size_t count, size_t elementSize, gfp_t gfp)
+{
+	return kmemdup(src, size_mul(count, elementSize), gfp);
+}
+
+
+void *
+memdup_user(const void __user *src, size_t length)
+{
+	void *copy = kmalloc(length, GFP_KERNEL);
+	if (copy == NULL)
+		return ERR_PTR(-ENOMEM);
+	if (copy_from_user(copy, src, length) != 0) {
+		kfree(copy);
+		return ERR_PTR(-EFAULT);
+	}
+	return copy;
+}
+
+
+void *
+vmemdup_user(const void __user *src, size_t length)
+{
+	void *copy = kvmalloc(length, GFP_KERNEL);
+	if (copy == NULL)
+		return ERR_PTR(-ENOMEM);
+	if (copy_from_user(copy, src, length) != 0) {
+		kvfree(copy);
+		return ERR_PTR(-EFAULT);
+	}
+	return copy;
+}
+
+
+void *
+memdup_array_user(const void __user *src, size_t n, size_t size)
+{
+	size_t bytes;
+	if (check_mul_overflow(n, size, &bytes))
+		return ERR_PTR(-EOVERFLOW);
+	return memdup_user(src, bytes);
+}
+
+
+void *
+vmemdup_array_user(const void __user *src, size_t n, size_t size)
+{
+	size_t bytes;
+	if (check_mul_overflow(n, size, &bytes))
+		return ERR_PTR(-EOVERFLOW);
+	return vmemdup_user(src, bytes);
+}
+
+
+ssize_t
+strscpy(char *dest, const char *src, size_t count)
+{
+	if (count == 0)
+		return -E2BIG;
+	size_t length = strnlen(src, count);
+	if (length == count) {
+		memcpy(dest, src, count - 1);
+		dest[count - 1] = '\0';
+		return -E2BIG;
+	}
+	memcpy(dest, src, length + 1);
+	return length;
+}
+
+
+ssize_t
+strscpy_pad(char *dest, const char *src, size_t count)
+{
+	ssize_t written = strscpy(dest, src, count);
+	size_t used = written >= 0 ? (size_t)written + 1 : count;
+	if (used < count)
+		memset(dest + used, 0, count - used);
+	return written;
+}
+
+
+char *
+strnchr(const char *s, size_t count, int c)
+{
+	for (; count-- > 0 && *s != '\0'; s++) {
+		if (*s == (char)c)
+			return (char *)s;
+	}
+	return NULL;
+}
+
+
+char *
+strnstr(const char *s1, const char *s2, size_t length)
+{
+	size_t l2 = strlen(s2);
+	if (l2 == 0)
+		return (char *)s1;
+	while (length >= l2) {
+		length--;
+		if (memcmp(s1, s2, l2) == 0)
+			return (char *)s1;
+		s1++;
+	}
+	return NULL;
