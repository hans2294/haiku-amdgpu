+char *
+strndup_user(const char __user *s, long n)
+{
+	char *copy = kmalloc(n, GFP_KERNEL);
+	if (copy == NULL)
+		return ERR_PTR(-ENOMEM);
+	for (long i = 0; i < n; i++) {
+		if (lkpi_haiku_user_copy(&copy[i], (const char *)s + i, 1) != 0) {
+			kfree(copy);
+			return ERR_PTR(-EFAULT);
+		}
+		if (copy[i] == '\0')
+			return copy;
+	}
+	kfree(copy);
+	return ERR_PTR(-EINVAL);
+}
