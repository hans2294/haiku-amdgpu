+//	#pragma mark - sorting and searching
+
+
+static void
+swap_bytes(void *a, void *b, int size)
+{
+	u8 *x = a, *y = b;
+	while (size--) {
+		u8 t = *x;
+		*x++ = *y;
+		*y++ = t;
+	}
+}
+
+
+/*!	Heapsort, like Linux's: no recursion, no extra memory. */
+void
+sort_r(void *base, size_t num, size_t size, cmp_r_func_t cmp,
+	swap_func_t swap_fn, const void *priv)
+{
+	char *array = base;
+	if (num < 2)
+		return;
+
+	#define ELEMENT(i) (array + (i) * size)
+	#define SWAP(a, b) (swap_fn ? swap_fn(ELEMENT(a), ELEMENT(b), size) \
+		: swap_bytes(ELEMENT(a), ELEMENT(b), size))
+
+	for (size_t start = num / 2; start-- > 0;) {
+		for (size_t root = start; root * 2 + 1 < num;) {
+			size_t child = root * 2 + 1;
+			if (child + 1 < num
+				&& cmp(ELEMENT(child), ELEMENT(child + 1), priv) < 0)
+				child++;
+			if (cmp(ELEMENT(root), ELEMENT(child), priv) >= 0)
+				break;
+			SWAP(root, child);
+			root = child;
+		}
+	}
+	for (size_t end = num - 1; end > 0; end--) {
+		SWAP(0, end);
+		for (size_t root = 0; root * 2 + 1 < end;) {
+			size_t child = root * 2 + 1;
+			if (child + 1 < end
+				&& cmp(ELEMENT(child), ELEMENT(child + 1), priv) < 0)
+				child++;
+			if (cmp(ELEMENT(root), ELEMENT(child), priv) >= 0)
+				break;
+			SWAP(root, child);
+			root = child;
+		}
+	}
+	#undef ELEMENT
+	#undef SWAP
+}
+
+
+static int
+call_cmp(const void *a, const void *b, const void *priv)
+{
+	return ((cmp_func_t)priv)(a, b);
+}
+
+
+void
+sort(void *base, size_t num, size_t size, cmp_func_t cmp, swap_func_t swap_fn)
+{
+	sort_r(base, num, size, call_cmp, swap_fn, cmp);
+}
