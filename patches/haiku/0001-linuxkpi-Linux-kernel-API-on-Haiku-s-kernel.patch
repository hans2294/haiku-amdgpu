+strim(char *s)
+{
+	size_t length = strlen(s);
+	if (length == 0)
+		return s;
+	char *end = s + length - 1;
+	while (end >= s && isspace(*end))
+		end--;
+	end[1] = '\0';
+	return skip_spaces(s);
