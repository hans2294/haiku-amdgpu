+
+static void
+seq_append(struct seq_file *m, const void *data, size_t length)
+{
+	if (m->buf == NULL || m->count + length > m->size) {
+		m->count = m->size;
+		return;
+	}
+	memcpy(m->buf + m->count, data, length);
+	m->count += length;
+}
