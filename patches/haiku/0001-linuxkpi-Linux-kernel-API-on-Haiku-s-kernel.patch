+
+static void
+cpuid(u32 leaf, u32 subleaf, u32 *a, u32 *b, u32 *c, u32 *d)
+{
+	asm volatile("cpuid" : "=a" (*a), "=b" (*b), "=c" (*c), "=d" (*d)
+		: "a" (leaf), "c" (subleaf));
+}
+
+
+/*!	Linux's feature numbers are word * 32 + bit, with the words in its
+	cpufeatures.h order; the words amdgpu and DRM ask about are mapped.
+*/
+bool
+boot_cpu_has(int feature)
+{
+	u32 a, b, c, d;
+	u32 bit = feature % 32;
+	switch (feature / 32) {
+		case 0:
+			cpuid(1, 0, &a, &b, &c, &d);
+			return d & (1U << bit);
+		case 1:
+			cpuid(0x80000001, 0, &a, &b, &c, &d);
+			return d & (1U << bit);
+		case 4:
+			cpuid(1, 0, &a, &b, &c, &d);
+			return c & (1U << bit);
+		case 6:
+			cpuid(0x80000001, 0, &a, &b, &c, &d);
+			return c & (1U << bit);
+		case 9:
+			cpuid(7, 0, &a, &b, &c, &d);
+			return b & (1U << bit);
+		case 19:
+			cpuid(0x8000001f, 0, &a, &b, &c, &d);
+			return a & (1U << bit);
+		default:
+			return false;
+	}
+}
+
+
+static int __init
+linuxkpi_cpu_init(void)
+{
+	u32 a, b, c, d;
+	cpuid(0, 0, &a, &b, &c, &d);
+	// "AuthenticAMD" / "HygonGenuine" / "GenuineIntel", by ebx
+	if (b == 0x68747541)
+		boot_cpu_data.x86_vendor = X86_VENDOR_AMD;
+	else if (b == 0x6f677948)
+		boot_cpu_data.x86_vendor = X86_VENDOR_HYGON;
+	else
+		boot_cpu_data.x86_vendor = X86_VENDOR_INTEL;
+
+	cpuid(1, 0, &a, &b, &c, &d);
+	unsigned int family = (a >> 8) & 0xf;
+	unsigned int model = (a >> 4) & 0xf;
+	if (family == 0xf)
+		family += (a >> 20) & 0xff;
+	if (family >= 6)
+		model |= ((a >> 16) & 0xf) << 4;
+	boot_cpu_data.x86 = family;
+	boot_cpu_data.x86_model = model;
+	boot_cpu_data.x86_clflush_size = ((b >> 8) & 0xff) * 8;
+	boot_cpu_data.x86_cache_alignment = boot_cpu_data.x86_clflush_size;
+	return 0;
+}
+core_initcall(linuxkpi_cpu_init);
