+#define spin_lock_init(l)	linuxkpi_spin_lock_init(l, #l)
+#define spin_lock_irqsave(l, flags)	do { (flags) = _spin_lock_irqsave(l); } while (0)
+#define spin_lock_irqsave_nested(l, flags, s)	spin_lock_irqsave(l, flags)
+#define spin_trylock_irqsave(l, flags)	({ local_irq_save(flags); spin_trylock(l) ? 1 : ({ local_irq_restore(flags); 0; }); })
+#define spin_lock_irq(l)		spin_lock(l)
+#define spin_unlock_irq(l)		spin_unlock(l)
+#define spin_lock_bh(l)			spin_lock(l)
+#define spin_unlock_bh(l)		spin_unlock(l)
+#define spin_lock_nested(l, s)	spin_lock(l)
+#define spin_trylock_irq(l)		spin_trylock(l)
+#define assert_spin_locked(l)	do { (void)(l); } while (0)
+#define raw_spin_lock_init		spin_lock_init
+#define raw_spin_lock			spin_lock
+#define raw_spin_unlock			spin_unlock
+#define raw_spin_lock_irqsave	spin_lock_irqsave
+#define raw_spin_unlock_irqrestore	spin_unlock_irqrestore
+#define raw_spin_lock_irq		spin_lock_irq
+#define raw_spin_unlock_irq		spin_unlock_irq
+
+void rwlock_init(rwlock_t *lock);
+void read_lock(rwlock_t *lock);
+void read_unlock(rwlock_t *lock);
+void write_lock(rwlock_t *lock);
+void write_unlock(rwlock_t *lock);
+#define read_lock_irqsave(l, f)	do { local_irq_save(f); read_lock(l); } while (0)
+#define read_unlock_irqrestore(l, f)	do { read_unlock(l); local_irq_restore(f); } while (0)
+#define write_lock_irqsave(l, f)	do { local_irq_save(f); write_lock(l); } while (0)
+#define write_unlock_irqrestore(l, f)	do { write_unlock(l); local_irq_restore(f); } while (0)
+#define write_lock_irq(l)	write_lock(l)
+#define write_unlock_irq(l)	write_unlock(l)
+#define read_lock_irq(l)	read_lock(l)
+#define read_unlock_irq(l)	read_unlock(l)
+
+DEFINE_LOCK_GUARD_1(spinlock, spinlock_t, spin_lock(_T->lock), spin_unlock(_T->lock))
+DEFINE_LOCK_GUARD_1(spinlock_irq, spinlock_t, spin_lock_irq(_T->lock), spin_unlock_irq(_T->lock))
+DEFINE_LOCK_GUARD_1(spinlock_irqsave, spinlock_t, spin_lock_irqsave(_T->lock, _T->flags),
+	spin_unlock_irqrestore(_T->lock, _T->flags), unsigned long flags)
+
+int _atomic_dec_and_lock(atomic_t *atomic, spinlock_t *lock);
+#define atomic_dec_and_lock(a, l)	_atomic_dec_and_lock(a, l)
+int _atomic_dec_and_lock_irqsave(atomic_t *atomic, spinlock_t *lock, unsigned long *flags);
+#define atomic_dec_and_lock_irqsave(a, l, f)	_atomic_dec_and_lock_irqsave(a, l, &(f))
+
+#endif
diff --git a/src/libs/compat/linuxkpi/include/linux/spinlock_types.h b/src/libs/compat/linuxkpi/include/linux/spinlock_types.h
new file mode 100644
index 0000000000..52243f3efe
--- /dev/null
+++ b/src/libs/compat/linuxkpi/include/linux/spinlock_types.h
@@ -0,0 +1,31 @@
+/*
+ * Copyright 2026, hans2294.
+ * Distributed under the terms of the MIT License.
+ */
+#ifndef _LINUXKPI_LINUX_SPINLOCK_TYPES_H
+#define _LINUXKPI_LINUX_SPINLOCK_TYPES_H
+
+#include <linux/types.h>
+/*
+ * Linux spinlocks are Haiku mutexes: Linux interrupt handlers and timers run
+ * in threads under linuxkpi, so nothing takes them in interrupt context, and
+ * Linux code may allocate memory while holding one. A zeroed one is unlocked.
+ */
+typedef struct spinlock {
+	unsigned long opaque[6];
+	const char *name;
+} spinlock_t;
+typedef spinlock_t raw_spinlock_t;
+#define raw_spinlock spinlock
+#define __SPIN_LOCK_UNLOCKED(lockname)	{ .opaque = { 0 }, .name = #lockname }
+#define DEFINE_SPINLOCK(x)	spinlock_t x = __SPIN_LOCK_UNLOCKED(x)
+#define DEFINE_RAW_SPINLOCK(x)	DEFINE_SPINLOCK(x)
+#define __RAW_SPIN_LOCK_UNLOCKED(x)	__SPIN_LOCK_UNLOCKED(x)
+typedef struct {
+	unsigned long opaque[8];	/* Haiku rw_lock */
+	const char *name;
+} rwlock_t;
+#define __RW_LOCK_UNLOCKED(x)	{ .opaque = { 0 }, .name = #x }
+#define DEFINE_RWLOCK(x)	rwlock_t x = __RW_LOCK_UNLOCKED(x)
+
+#endif
