+ */
+#ifndef _LINUXKPI_LINUX_MINMAX_H
+#define _LINUXKPI_LINUX_MINMAX_H
+
+#include <linux/compiler.h>
+
+#define __cmp(op, x, y)	((x) op (y) ? (x) : (y))
+#define __cmp_once(op, x, y, ux, uy) ({ \
+	typeof(x) ux = (x); typeof(y) uy = (y); __cmp(op, ux, uy); })
+
+#define min(x, y)	__cmp_once(<, x, y, __UNIQUE_ID(x_), __UNIQUE_ID(y_))
+#define max(x, y)	__cmp_once(>, x, y, __UNIQUE_ID(x_), __UNIQUE_ID(y_))
+#define umin(x, y)	min((x) + 0u + 0ul + 0ull, (y) + 0u + 0ul + 0ull)
+#define umax(x, y)	max((x) + 0u + 0ul + 0ull, (y) + 0u + 0ul + 0ull)
+#define min3(x, y, z)	min((typeof(x))min(x, y), z)
+#define max3(x, y, z)	max((typeof(x))max(x, y), z)
+#define min_not_zero(x, y) ({ \
+	typeof(x) __x = (x); typeof(y) __y = (y); \
+	__x == 0 ? __y : ((__y == 0) ? __x : min(__x, __y)); })
+#define min_t(type, x, y)	min((type)(x), (type)(y))
+#define max_t(type, x, y)	max((type)(x), (type)(y))
+#define clamp(val, lo, hi)	min((typeof(val))max(val, lo), hi)
+#define clamp_t(type, val, lo, hi)	min_t(type, max_t(type, val, lo), hi)
+#define clamp_val(val, lo, hi)	clamp_t(typeof(val), val, lo, hi)
+#define in_range(val, start, len) \
+	((typeof(start))(val) - (start) < (len))
+#define MIN(a, b)	__cmp(<, a, b)
+#define MAX(a, b)	__cmp(>, a, b)
+#define MIN_T(type, a, b)	__cmp(<, (type)(a), (type)(b))
+#define MAX_T(type, a, b)	__cmp(>, (type)(a), (type)(b))
+#define swap(a, b) \
+	do { typeof(a) __tmp = (a); (a) = (b); (b) = __tmp; } while (0)
+
+#endif
