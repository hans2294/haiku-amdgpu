--- /dev/null
+++ b/src/libs/compat/linuxkpi/haiku/haiku_device.cpp
@@ -0,0 +1,279 @@
+/*
+ * Copyright 2026, hans2294.
+ * Distributed under the terms of the MIT License.
+ */
+
+
+/*!	linuxkpi's Haiku side, devices: PCI, interrupts, firmware files, user
+	memory and the FPU.
+*/
+
+
+#include <KernelExport.h>
+#include <OS.h>
+#include <PCI.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+
+#include <cpu.h>
+#include <smp.h>
+#include <syscalls.h>
+
+#include "../include/linuxkpi/haiku.h"
+
+
+static const int kLinuxENOENT = 2;
+static const int kLinuxEIO = 5;
+static const int kLinuxENOMEM = 12;
+static const int kLinuxENODEV = 19;
+static const int kLinuxEINVAL = 22;
+
+static pci_module_info* sPCI;
+
+
+//	#pragma mark - PCI
+
+
+static bool
+pci_ready()
+{
+	if (sPCI != NULL)
+		return true;
+	return get_module(B_PCI_MODULE_NAME, (module_info**)&sPCI) == B_OK;
+}
+
+
+extern "C" int
+lkpi_haiku_pci_get(int index, struct lkpi_haiku_pci_device* device)
+{
+	if (!pci_ready())
+		return -kLinuxENODEV;
+
+	pci_info info;
+	if (sPCI->get_nth_pci_info(index, &info) != B_OK)
+		return -kLinuxENODEV;
+
+	memset(device, 0, sizeof(*device));
+	device->bus = info.bus;
+	device->device = info.device;
+	device->function = info.function;
+	device->vendor = info.vendor_id;
+	device->device_id = info.device_id;
+	device->revision = info.revision;
+	device->header_type = info.header_type;
+	device->class_code = (info.class_base << 16) | (info.class_sub << 8)
+		| info.class_api;
+	if ((info.header_type & PCI_header_type_mask) != PCI_header_type_generic)
+		return 0;
+
+	device->subsystem_vendor = info.u.h0.subsystem_vendor_id;
+	device->subsystem_device = info.u.h0.subsystem_id;
+	device->interrupt_line = info.u.h0.interrupt_line;
+	device->rom_base = info.u.h0.rom_base;
+	device->rom_size = info.u.h0.rom_size;
+	for (int bar = 0; bar < 6; bar++) {
+		uint32 flags = info.u.h0.base_register_flags[bar];
+		uint64 base = info.u.h0.base_registers[bar];
+		uint64 size = info.u.h0.base_register_sizes[bar];
+		unsigned int linuxFlags = 0;
+		if ((flags & PCI_address_space) != 0)
+			linuxFlags |= LKPI_HAIKU_BAR_IO;
+		else {
+			if ((flags & PCI_address_prefetchable) != 0)
+				linuxFlags |= LKPI_HAIKU_BAR_PREFETCH;
+			if (bar < 5 && (flags & PCI_address_type) == PCI_address_type_64) {
+				linuxFlags |= LKPI_HAIKU_BAR_64;
+				base |= (uint64)info.u.h0.base_registers[bar + 1] << 32;
+				size |= (uint64)info.u.h0.base_register_sizes[bar + 1] << 32;
+			}
+		}
+		device->bar_base[bar] = base;
+		device->bar_size[bar] = size;
+		device->bar_flags[bar] = linuxFlags;
+		if ((linuxFlags & LKPI_HAIKU_BAR_64) != 0)
+			bar++;
+	}
+	return 0;
+}
+
+
+extern "C" unsigned int
+lkpi_haiku_pci_read_config(int bus, int device, int function, int offset,
+	int size)
+{
+	if (!pci_ready())
+		return ~0U;
+	return sPCI->read_pci_config(bus, device, function, offset, size);
+}
+
+
+extern "C" void
+lkpi_haiku_pci_write_config(int bus, int device, int function, int offset,
+	int size, unsigned int value)
+{
+	if (pci_ready())
+		sPCI->write_pci_config(bus, device, function, offset, size, value);
+}
+
+
+extern "C" int
+lkpi_haiku_pci_enable_msi(int bus, int device, int function,
+	unsigned int* _vector)
+{
+	if (!pci_ready())
+		return -kLinuxENODEV;
+	if (sPCI->get_msi_count(bus, device, function) < 1)
+		return -kLinuxEINVAL;
+
+	uint32 vector;
+	if (sPCI->configure_msi(bus, device, function, 1, &vector) != B_OK)
+		return -kLinuxEINVAL;
+	if (sPCI->enable_msi(bus, device, function) != B_OK) {
+		sPCI->unconfigure_msi(bus, device, function);
+		return -kLinuxEINVAL;
+	}
+	*_vector = vector;
+	return 0;
+}
+
+
+extern "C" void
+lkpi_haiku_pci_disable_msi(int bus, int device, int function)
+{
+	if (!pci_ready())
+		return;
+	sPCI->disable_msi(bus, device, function);
+	sPCI->unconfigure_msi(bus, device, function);
+}
+
+
+//	#pragma mark - interrupts
+
+
+struct irq_cookie {
+	sem_id sem;
+};
+
+
+static int32
+irq_handler(void* data)
+{
+	irq_cookie* cookie = (irq_cookie*)data;
+	release_sem_etc(cookie->sem, 1, B_DO_NOT_RESCHEDULE);
+	return B_INVOKE_SCHEDULER;
+}
+
+
+extern "C" int
+lkpi_haiku_irq_install(unsigned int vector, int sem, void** _cookie)
+{
+	irq_cookie* cookie = (irq_cookie*)malloc(sizeof(irq_cookie));
+	if (cookie == NULL)
+		return -kLinuxENOMEM;
+	cookie->sem = sem;
+	if (install_io_interrupt_handler(vector, irq_handler, cookie, 0) != B_OK) {
+		free(cookie);
+		return -kLinuxEINVAL;
+	}
+	*_cookie = cookie;
+	return 0;
+}
+
+
+extern "C" void
+lkpi_haiku_irq_remove(unsigned int vector, void* cookie)
+{
+	remove_io_interrupt_handler(vector, irq_handler, cookie);
+	free(cookie);
+}
+
+
+//	#pragma mark - firmware
+
+
+static const char* const kFirmwareDirectories[] = {
+	"/boot/system/non-packaged/data/firmware",
+	"/boot/system/data/firmware",
+};
+
+
+extern "C" int
+lkpi_haiku_read_firmware(const char* name, void** _data, unsigned long* _size)
+{
+	int fd = -1;
+	char path[B_PATH_NAME_LENGTH];
+	for (size_t i = 0; i < B_COUNT_OF(kFirmwareDirectories) && fd < 0; i++) {
+		snprintf(path, sizeof(path), "%s/%s", kFirmwareDirectories[i], name);
+		fd = _kern_open(-1, path, O_RDONLY, 0);
+	}
+	if (fd < 0)
+		return -kLinuxENOENT;
+
+	struct stat stat;
+	if (_kern_read_stat(fd, NULL, false, &stat, sizeof(stat)) != B_OK) {
+		_kern_close(fd);
+		return -kLinuxEIO;
+	}
+
+	void* data = malloc(stat.st_size > 0 ? stat.st_size : 1);
+	if (data == NULL) {
+		_kern_close(fd);
+		return -kLinuxENOMEM;
+	}
+	ssize_t bytesRead = _kern_read(fd, 0, data, stat.st_size);
+	_kern_close(fd);
+	if (bytesRead != stat.st_size) {
+		free(data);
+		return -kLinuxEIO;
+	}
+
+	*_data = data;
+	*_size = stat.st_size;
+	return 0;
+}
+
+
+//	#pragma mark - user memory
+
+
+extern "C" unsigned long
+lkpi_haiku_user_copy(void* to, const void* from, unsigned long size)
+{
+	return user_memcpy(to, from, size) == B_OK ? 0 : size;
+}
+
+
+//	#pragma mark - FPU
+
+
+/*!	Nothing to do: Haiku saves the FPU state on every kernel entry (from user
+	mode and from interrupts alike) and its kernel uses SSE itself, so Linux's
+	floating point sections (Display Core's DML) need no protection, and
+	must not run with interrupts off for the milliseconds they can take.
+*/
+extern "C" void
+lkpi_haiku_fpu_begin(void)
+{
+}
+
+
+extern "C" void
+lkpi_haiku_fpu_end(void)
+{
+}
+
+
+//	#pragma mark -
+
+
+extern "C" void
+lkpi_haiku_shutdown(void)
+{
+	if (sPCI != NULL) {
+		put_module(B_PCI_MODULE_NAME);
+		sPCI = NULL;
+	}
+}
diff --git a/src/libs/compat/linuxkpi/haiku/haiku_kernel.cpp b/src/libs/compat/linuxkpi/haiku/haiku_kernel.cpp
new file mode 100644
index 0000000000..c47a4fc8a9
--- /dev/null
+++ b/src/libs/compat/linuxkpi/haiku/haiku_kernel.cpp
@@ -0,0 +1,596 @@
+/*
+ * Copyright 2026, hans2294.
+ * Distributed under the terms of the MIT License.
+ */
+
+
+/*!	linuxkpi's Haiku side: the kernel services the Linux side builds on. */
+
+
+#include <KernelExport.h>
+#include <OS.h>
+#include <errno.h>
+
+#include <heap.h>
+#include <lock.h>
+#include <smp.h>
+#include <team.h>
+#include <thread.h>
+#include <arch/x86/arch_cpuasm.h>
+#include <sys/uio.h>
+#include <util/iovec_support.h>
+#include <vm/vm.h>
+#include <vm/VMAddressSpace.h>
+#include <vm/vm_page.h>
+
+#include "../include/linuxkpi/haiku.h"
+
+
+// Linux errno values, which are what the Linux side expects
+static const int kLinuxEINTR = 4;
+static const int kLinuxENOMEM = 12;
+static const int kLinuxEINVAL = 22;
+static const int kLinuxETIMEDOUT = 110;
+
+static_assert(sizeof(mutex) <= LKPI_HAIKU_MUTEX_SIZE,
+	"mutex does not fit linuxkpi's storage");
+static_assert(sizeof(rw_lock) <= LKPI_HAIKU_RWLOCK_SIZE,
+	"rw_lock does not fit linuxkpi's storage");
+
+
+//	#pragma mark - output
+
+
+extern "C" void
+lkpi_haiku_debug_output(const char* text)
+{
+	dprintf("%s", text);
+}
+
+
+extern "C" void
+lkpi_haiku_panic(const char* text)
+{
+	panic("%s", text);
+	for (;;)
+		;
+}
+
+
+/*!	Linux errno numbers are the same on every Linux architecture linuxkpi
+	cares about; Haiku's are its own.
+*/
+extern "C" int
+lkpi_haiku_error(int linuxError)
+{
+	switch (-linuxError) {
+		case 0: return B_OK;
+		case 1: return EPERM;
+		case 2: return ENOENT;
+		case 4: return EINTR;
+		case 5: return EIO;
+		case 6: return ENXIO;
+		case 7: return E2BIG;
+		case 9: return EBADF;
+		case 11: return EAGAIN;
+		case 12: return ENOMEM;
+		case 13: return EACCES;
+		case 14: return EFAULT;
+		case 16: return EBUSY;
+		case 17: return EEXIST;
+		case 19: return ENODEV;
+		case 22: return EINVAL;
+		case 24: return EMFILE;
+		case 25: return ENOTTY;
+		case 27: return EFBIG;
+		case 28: return ENOSPC;
+		case 34: return ERANGE;
+		case 35: return EDEADLK;
+		case 38: return ENOSYS;
+		case 61: return ENODATA;
+		case 62: return ETIME;
+		case 75: return EOVERFLOW;
+		case 95: return EOPNOTSUPP;
+		case 110: return ETIMEDOUT;
+		case 125: return ECANCELED;
+		case 512:	// ERESTARTSYS
+		case 513:	// ERESTARTNOINTR
+		case 514:	// ERESTARTNOHAND
+			return EINTR;
+		default: return B_ERROR;
+	}
+}
+
+
+//	#pragma mark - memory
+
+
+extern "C" void*
+lkpi_haiku_alloc(unsigned long size, unsigned long alignment, int nowait)
+{
+	return memalign_etc(alignment, size,
+		nowait ? HEAP_DONT_WAIT_FOR_MEMORY : 0);
+}
+
+
+extern "C" void
+lkpi_haiku_free(void* address)
+{
+	free_etc(address, 0);
+}
+
+
+extern "C" void*
+lkpi_haiku_alloc_contiguous(unsigned long size, int* _area)
+{
+	void* address;
+	area_id area = create_area("linuxkpi pages", &address,
+		B_ANY_KERNEL_ADDRESS, ROUNDUP(size, B_PAGE_SIZE), B_CONTIGUOUS,
+		B_KERNEL_READ_AREA | B_KERNEL_WRITE_AREA);
+	if (area < 0)
+		return NULL;
+	*_area = area;
+	return address;
+}
+
+
+extern "C" void
+lkpi_haiku_delete_area(int area)
+{
+	delete_area(area);
+}
+
+
+extern "C" unsigned long long
+lkpi_haiku_virt_to_phys(const void* address)
+{
+	physical_entry entry;
+	if (get_memory_map(address, 1, &entry, 1) != B_OK)
+		return 0;
+	return entry.address;
+}
+
+
+extern "C" void*
+lkpi_haiku_map_physical(unsigned long long physical, unsigned long size,
+	int cacheMode, int* _area)
+{
+	// The memory type goes with the address specification; without one
+	// Haiku maps uncached.
+	uint32 memoryType = B_UNCACHED_MEMORY;
+	if (cacheMode == LKPI_HAIKU_CACHE_WRITE_COMBINING)
+		memoryType = B_WRITE_COMBINING_MEMORY;
+	else if (cacheMode == LKPI_HAIKU_CACHE_CACHED)
+		memoryType = B_WRITE_BACK_MEMORY;
+
+	phys_addr_t base = ROUNDDOWN(physical, B_PAGE_SIZE);
+	size_t length = ROUNDUP(physical + size, B_PAGE_SIZE) - base;
+	void* address;
+	area_id area = map_physical_memory("linuxkpi iomem", base, length,
+		B_ANY_KERNEL_ADDRESS | memoryType,
+		B_KERNEL_READ_AREA | B_KERNEL_WRITE_AREA, &address);
+	if (area < 0)
+		return NULL;
+	*_area = area;
+	return (uint8*)address + (physical - base);
+}
+
+
+extern "C" void*
+lkpi_haiku_map_pages(const unsigned long long* physical, unsigned long count,
+	int* _area)
+{
+	generic_io_vec* vecs = (generic_io_vec*)malloc(sizeof(generic_io_vec)
+		* count);
+	if (vecs == NULL)
+		return NULL;
+	for (unsigned long i = 0; i < count; i++) {
+		vecs[i].base = physical[i];
+		vecs[i].length = B_PAGE_SIZE;
+	}
+
+	void* address = NULL;
+	addr_t size = count * B_PAGE_SIZE;
+	area_id area = vm_map_physical_memory_vecs(VMAddressSpace::KernelID(),
+		"linuxkpi vmap", &address, B_ANY_KERNEL_ADDRESS, &size,
+		B_KERNEL_READ_AREA | B_KERNEL_WRITE_AREA, vecs, count);
+	free(vecs);
+	if (area < 0)
+		return NULL;
+	*_area = area;
+	return address;
+}
+
+
+extern "C" int
+lkpi_haiku_map_user(const unsigned long long* physical, unsigned long count,
+	int cacheMode, int writable, void** _address)
+{
+	generic_io_vec* vecs = (generic_io_vec*)malloc(sizeof(generic_io_vec)
+		* count);
+	if (vecs == NULL)
+		return -kLinuxENOMEM;
+	uint32 vecCount = 0;
+	for (unsigned long i = 0; i < count; i++) {
+		if (vecCount > 0 && vecs[vecCount - 1].base
+				+ vecs[vecCount - 1].length == physical[i]) {
+			vecs[vecCount - 1].length += B_PAGE_SIZE;
+			continue;
+		}
+		vecs[vecCount].base = physical[i];
+		vecs[vecCount].length = B_PAGE_SIZE;
+		vecCount++;
+	}
+
+	void* address = NULL;
+	addr_t size = count * B_PAGE_SIZE;
+	// Shared, like a shared mapping on Linux. A private area would go
+	// copy-on-write at the team's next fork(), and the next write would then
+	// replace the buffer's page with a copy or, for one that isn't RAM, panic.
+	uint32 protection = B_READ_AREA | B_KERNEL_READ_AREA | B_SHARED_AREA;
+	if (writable)
+		protection |= B_WRITE_AREA | B_KERNEL_WRITE_AREA;
+	area_id area = vm_map_physical_memory_vecs(team_get_current_team_id(),
+		"linuxkpi mapping", &address, B_RANDOMIZED_ANY_ADDRESS, &size,
+		protection, vecs, vecCount);
+	free(vecs);
+	if (area < 0)
+		return -kLinuxENOMEM;
+
+	// The vector mapping is always write-back; switch the whole area over.
+	uint32 memoryType = 0;
+	if (cacheMode == LKPI_HAIKU_CACHE_UNCACHED)
+		memoryType = B_UNCACHED_MEMORY;
+	else if (cacheMode == LKPI_HAIKU_CACHE_WRITE_COMBINING)
+		memoryType = B_WRITE_COMBINING_MEMORY;
+	if (memoryType != 0
+		&& vm_set_area_memory_type(area, physical[0], memoryType) != B_OK) {
+		vm_delete_area(team_get_current_team_id(), area, true);
+		return -kLinuxEINVAL;
+	}
+
+	*_address = address;
+	return area;
+}
+
+
+extern "C" void
+lkpi_haiku_unmap_user(int area)
+{
+	// The team may already be gone, and its areas with it.
+	area_info info;
+	if (get_area_info(area, &info) == B_OK)
+		vm_delete_area(info.team, area, true);
+}
+
+
+extern "C" int
+lkpi_haiku_user_area_for(const void* address)
+{
+	if (!IS_USER_ADDRESS(address))
+		return -kLinuxEINVAL;
+	area_id area = _user_area_for((void*)address);
+	return area >= 0 ? area : -kLinuxEINVAL;
+}
+
+
+extern "C" int
+lkpi_haiku_area_for(const void* address)
+{
+	return area_for((void*)address);
+}
+
+
+static void
+wbinvd_on_cpu(void* /*cookie*/, int /*cpu*/)
+{
+	wbinvd();
+}
+
+
+extern "C" void
+lkpi_haiku_wbinvd_all_cpus(void)
+{
+	call_all_cpus_sync(wbinvd_on_cpu, NULL);
+}
+
+
+extern "C" unsigned long long
+lkpi_haiku_total_memory(void)
+{
+	return (unsigned long long)vm_page_num_pages() * B_PAGE_SIZE;
+}
+
+
+extern "C" unsigned long long
+lkpi_haiku_free_memory(void)
+{
+	return (unsigned long long)vm_page_num_free_pages() * B_PAGE_SIZE;
+}
+
+
+//	#pragma mark - locks
+
+
+static int
+lock_result(status_t status)
+{
+	return status == B_OK ? 0 : -kLinuxEINTR;
+}
+
+
+extern "C" void
+lkpi_haiku_mutex_init(void* lock, const char* name)
+{
+	mutex_init((mutex*)lock, name);
+}
+
+
+extern "C" void
+lkpi_haiku_mutex_destroy(void* lock)
+{
+	mutex_destroy((mutex*)lock);
+}
+
+
+extern "C" int
+lkpi_haiku_mutex_lock(void* lock, int interruptible)
+{
+	if (!interruptible)
+		return lock_result(mutex_lock((mutex*)lock));
+	return lock_result(mutex_lock_with_timeout((mutex*)lock, B_CAN_INTERRUPT,
+		B_INFINITE_TIMEOUT));
+}
+
+
+extern "C" int
+lkpi_haiku_mutex_trylock(void* lock)
+{
+	return mutex_trylock((mutex*)lock) == B_OK;
+}
+
+
+extern "C" void
+lkpi_haiku_mutex_unlock(void* lock)
+{
+	mutex_unlock((mutex*)lock);
+}
+
+
+extern "C" int
+lkpi_haiku_mutex_is_locked(void* lock)
+{
+#if KDEBUG
+	return ((mutex*)lock)->holder > 0;
+#else
+	return ((mutex*)lock)->count < 0;
+#endif
+}
+
+
+/*!	A zeroed rw_lock has holder 0 rather than -1; give it a real
+	initialization the first time it is used.
+*/
+static rw_lock*
+rw_lock_of(void* storage)
+{
+	rw_lock* lock = (rw_lock*)storage;
+	if (lock->name == NULL)
+		rw_lock_init(lock, "linux rwsem");
+	return lock;
+}
+
+
+extern "C" void
+lkpi_haiku_rwlock_init(void* lock, const char* name)
+{
+	rw_lock_init((rw_lock*)lock, name != NULL ? name : "linux rwsem");
+}
+
+
+extern "C" void
+lkpi_haiku_rwlock_destroy(void* lock)
+{
+	if (((rw_lock*)lock)->name != NULL)
+		rw_lock_destroy((rw_lock*)lock);
+}
+
+
+extern "C" int
+lkpi_haiku_rwlock_read_lock(void* lock, int interruptible)
+{
+	if (!interruptible)
+		return lock_result(rw_lock_read_lock(rw_lock_of(lock)));
+	return lock_result(rw_lock_read_lock_with_timeout(rw_lock_of(lock),
+		B_CAN_INTERRUPT, B_INFINITE_TIMEOUT));
+}
+
+
+extern "C" int
+lkpi_haiku_rwlock_read_trylock(void* lock)
+{
+	return rw_lock_read_lock_with_timeout(rw_lock_of(lock), B_RELATIVE_TIMEOUT,
+		0) == B_OK;
+}
+
+
+extern "C" void
+lkpi_haiku_rwlock_read_unlock(void* lock)
+{
+	rw_lock_read_unlock(rw_lock_of(lock));
+}
+
+
+extern "C" int
+lkpi_haiku_rwlock_write_lock(void* lock, int interruptible)
+{
+	// Haiku's rw_lock has no interruptible write lock
+	return lock_result(rw_lock_write_lock(rw_lock_of(lock)));
+}
+
+
+extern "C" void
+lkpi_haiku_rwlock_write_unlock(void* lock)
+{
+	rw_lock_write_unlock(rw_lock_of(lock));
+}
+
+
+extern "C" int
+lkpi_haiku_rwlock_is_locked(void* lock)
+{
+	rw_lock* rwLock = (rw_lock*)lock;
+	return rwLock->name != NULL && (rwLock->count != 0 || rwLock->holder > 0);
+}
+
+
+//	#pragma mark - semaphores
+
+
+extern "C" int
+lkpi_haiku_sem_create(int count, const char* name)
+{
+	return create_sem(count, name);
+}
+
+
+extern "C" void
+lkpi_haiku_sem_delete(int sem)
+{
+	delete_sem(sem);
+}
+
+
+extern "C" int
+lkpi_haiku_sem_acquire(int sem, long long timeout, int interruptible)
+{
+	uint32 flags = interruptible ? B_CAN_INTERRUPT : 0;
+	if (timeout >= 0)
+		flags |= B_RELATIVE_TIMEOUT;
+	status_t status = acquire_sem_etc(sem, 1, flags,
+		timeout >= 0 ? timeout : B_INFINITE_TIMEOUT);
+	if (status == B_OK)
+		return 0;
+	if (status == B_TIMED_OUT || status == B_WOULD_BLOCK)
+		return -kLinuxETIMEDOUT;
+	return -kLinuxEINTR;
+}
+
+
+extern "C" void
+lkpi_haiku_sem_release(int sem)
+{
+	release_sem_etc(sem, 1, B_DO_NOT_RESCHEDULE);
+}
+
+
+//	#pragma mark - threads
+
+
+extern "C" int
+lkpi_haiku_thread_current(void)
+{
+	return thread_get_current_thread_id();
+}
+
+
+extern "C" int
+lkpi_haiku_team_current(void)
+{
+	return team_get_current_team_id();
+}
+
+
+extern "C" int
+lkpi_haiku_thread_spawn(int (*function)(void*), const char* name,
+	int priority, void* data)
+{
+	return spawn_kernel_thread((thread_func)function, name, priority, data);
+}
+
+
+extern "C" void
+lkpi_haiku_thread_resume(int thread)
+{
+	resume_thread(thread);
+}
+
+
+extern "C" int
+lkpi_haiku_thread_wait(int thread)
+{
+	status_t result;
+	if (wait_for_thread(thread, &result) != B_OK)
+		return 0;
+	return result;
+}
+
+
+extern "C" void
+lkpi_haiku_thread_set_priority(int thread, int priority)
+{
+	set_thread_priority(thread, priority);
+}
+
+
+extern "C" void
+lkpi_haiku_thread_name(int thread, char* buffer, unsigned long size)
+{
+	thread_info info;
+	if (get_thread_info(thread, &info) == B_OK)
+		strlcpy(buffer, info.name, size);
+	else
+		strlcpy(buffer, "?", size);
+}
+
+
+extern "C" void
+lkpi_haiku_thread_yield(void)
+{
+	thread_yield();
+}
+
+
+//	#pragma mark - time
+
+
+extern "C" long long
+lkpi_haiku_system_time(void)
+{
+	return system_time();
+}
+
+
