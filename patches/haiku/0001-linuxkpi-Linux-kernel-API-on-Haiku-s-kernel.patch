+//	#pragma mark - files
+
+
+static struct file *
+alloc_file(struct inode *inode, const struct file_operations *fops,
+	void *priv, int flags)
+{
+	struct file *file = kzalloc(sizeof(*file), GFP_KERNEL);
+	if (file == NULL)
+		return ERR_PTR(-ENOMEM);
+	atomic_long_set(&file->f_count, 1);
+	spin_lock_init(&file->f_lock);
+	mutex_init(&file->f_pos_lock);
+	file->f_op = fops;
+	file->f_flags = flags;
+	file->f_inode = inode;
+	file->f_mapping = inode != NULL ? inode->i_mapping : NULL;
+	file->private_data = priv;
+	return file;
+}
+
+
+/*!	The file gets a dentry of its own, with the mount's dentry operations;
+	fput() releases it (and the inode) with the file.
+*/
+struct file *
+alloc_file_pseudo(struct inode *inode, void *mnt, const char *name, int flags,
+	const struct file_operations *fops)
+{
+	struct dentry *dentry = kzalloc(sizeof(*dentry), GFP_KERNEL);
+	if (dentry == NULL)
+		return ERR_PTR(-ENOMEM);
+	struct file *file = alloc_file(inode, fops, NULL, flags);
+	if (IS_ERR(file)) {
+		kfree(dentry);
+		return file;
+	}
+	struct vfsmount *mount = mnt;
+	dentry->d_inode = inode;
+	dentry->d_name.name = (const unsigned char *)name;
+	dentry->d_name.len = strlen(name);
+	dentry->d_op = mount != NULL ? mount->mnt_sb->d_op : NULL;
+	file->f_path.dentry = dentry;
+	file->f_path.mnt = mnt;
+	switch (flags & O_ACCMODE) {
+		case O_RDONLY: file->f_mode = FMODE_READ; break;
+		case O_WRONLY: file->f_mode = FMODE_WRITE; break;
+		default: file->f_mode = FMODE_READ | FMODE_WRITE; break;
+	}
+	return file;
+}
+
+
+struct file *
+anon_inode_getfile(const char *name, const struct file_operations *fops,
+	void *priv, int flags)
+{
+	return alloc_file(NULL, fops, priv, flags);
+}
