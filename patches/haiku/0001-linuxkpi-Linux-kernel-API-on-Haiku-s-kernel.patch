+
+static u64 sRandomState;
+
+
+/*!	Not for cryptography: amdgpu and DRM want random bytes for IDs and
+	seeds. rdrand when the CPU has it, else xorshift seeded from the TSC.
+*/
+static u64
+random_u64(void)
+{
+	u64 value;
+	unsigned char ok;
+	if (boot_cpu_has(X86_FEATURE_RDRAND)) {
+		for (int retry = 0; retry < 10; retry++) {
+			asm volatile("rdrand %0; setc %1" : "=r" (value), "=qm" (ok));
+			if (ok)
+				return value;
+		}
+	}
+	u64 x = READ_ONCE(sRandomState);
+	if (x == 0) {
+		u32 low, high;
+		asm volatile("rdtsc" : "=a" (low), "=d" (high));
+		x = ((u64)high << 32 | low) | 1;
+	}
+	x ^= x << 13;
+	x ^= x >> 7;
+	x ^= x << 17;
+	WRITE_ONCE(sRandomState, x);
+	return x;
+}
+
+
+void
+get_random_bytes(void *buf, size_t len)
+{
+	u8 *out = buf;
+	while (len > 0) {
+		u64 value = random_u64();
+		size_t chunk = min(len, sizeof(value));
+		memcpy(out, &value, chunk);
+		out += chunk;
+		len -= chunk;
+	}
+}
+
+
+u32
+get_random_u32(void)
+{
+	return random_u64();
+}
+
+
+u64
+get_random_u64(void)
+{
+	return random_u64();
+}
