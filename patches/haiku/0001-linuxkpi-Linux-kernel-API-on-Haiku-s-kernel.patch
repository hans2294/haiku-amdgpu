+int
+string_get_size(u64 size, u64 blk_size, enum string_size_units units,
+	char *buf, int len)
+{
+	static const char *const units10[] = { "B", "kB", "MB", "GB", "TB" };
+	static const char *const units2[] = { "B", "KiB", "MiB", "GiB", "TiB" };
+	unsigned divisor = units == STRING_UNITS_10 ? 1000 : 1024;
+	u64 value = size * blk_size;
+	int i = 0;
+	while (value >= divisor && i < 4) {
+		value /= divisor;
+		i++;
+	}
+	return snprintf(buf, len, "%llu %s", value,
+		units == STRING_UNITS_10 ? units10[i] : units2[i]);
+}
