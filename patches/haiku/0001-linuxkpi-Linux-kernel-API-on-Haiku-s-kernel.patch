+int
+hex2bin(u8 *dst, const char *src, size_t count)
+{
+	while (count--) {
+		int high = hex_to_bin(*src++);
+		int low = hex_to_bin(*src++);
+		if (high < 0 || low < 0)
+			return -EINVAL;
+		*dst++ = (high << 4) | low;
+	}
+	return 0;
+}
