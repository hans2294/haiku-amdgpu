diff --git a/src/libs/compat/linuxkpi/include/linux/init.h b/src/libs/compat/linuxkpi/include/linux/init.h
new file mode 100644
index 0000000000..fdad3b8716
--- /dev/null
+++ b/src/libs/compat/linuxkpi/include/linux/init.h
@@ -0,0 +1,61 @@
+/*
+ * Copyright 2026, hans2294.
+ * Distributed under the terms of the MIT License.
+ */
+#ifndef _LINUXKPI_LINUX_INIT_H
+#define _LINUXKPI_LINUX_INIT_H
+
+#include <linux/compiler.h>
+#include <linux/types.h>
+
+#define __init
+#define __initdata
+#define __initconst
+#define __exit
+#define __exitdata
+#define __refdata
+#define __ref
+#define __meminit
+#define __init_or_module
+#define __exit_p(x)	x
+
+typedef int (*initcall_t)(void);
+typedef void (*exitcall_t)(void);
+
+/*
+ * module_init() and friends leave an entry in the linuxkpi_initcall
+ * section; the Haiku driver runs them by level and module, in the order
+ * Linux's link order gives (see linuxkpi_run_initcalls()).
+ */
+struct linuxkpi_initcall {
+	initcall_t init;
+	exitcall_t exit;
+	const char *name;
+	const char *module;
+	int level;
+};
+#define __define_initcall(fn, id) \
+	static const struct linuxkpi_initcall __initcall_##fn##id __used \
+		__attribute__((__section__("linuxkpi_initcall"), __aligned__(8))) \
+		= { .init = fn, .name = #fn, .module = KBUILD_MODNAME, .level = id };
+#define __define_exitcall(fn) \
+	static const struct linuxkpi_initcall __exitcall_##fn __used \
+		__attribute__((__section__("linuxkpi_initcall"), __aligned__(8))) \
+		= { .exit = fn, .name = #fn, .module = KBUILD_MODNAME, .level = 0 };
+#define __exitcall(fn)	__define_exitcall(fn)
+#define __initcall(fn)	__define_initcall(fn, 6)
+#define module_init(fn)		__define_initcall(fn, 6)
+#define module_exit(fn)		__define_exitcall(fn)
+#define subsys_initcall(fn)	__define_initcall(fn, 4)
+#define device_initcall(fn)	__define_initcall(fn, 6)
+#define late_initcall(fn)	__define_initcall(fn, 7)
+#define early_initcall(fn)	__define_initcall(fn, 0)
+#define pure_initcall(fn)	__define_initcall(fn, 0)
+#define core_initcall(fn)	__define_initcall(fn, 1)
+#define postcore_initcall(fn)	__define_initcall(fn, 2)
+#define arch_initcall(fn)	__define_initcall(fn, 3)
+#define fs_initcall(fn)		__define_initcall(fn, 5)
+#define early_param(str, fn)
+#define __setup(str, fn)
+
+#endif
