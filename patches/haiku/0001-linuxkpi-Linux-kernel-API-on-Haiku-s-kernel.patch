+bin2hex(char *dst, const void *src, size_t count)
+{
+	const unsigned char *s = src;
+	while (count--) {
+		*dst++ = hex_asc_hi(*s);
+		*dst++ = hex_asc_lo(*s);
+		s++;
+	}
+	return dst;
+}
