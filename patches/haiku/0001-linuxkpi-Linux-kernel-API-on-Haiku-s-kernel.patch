diff --git a/src/libs/compat/linuxkpi/linux/irq.c b/src/libs/compat/linuxkpi/linux/irq.c
new file mode 100644
index 0000000000..4c0a7c61f5
--- /dev/null
+++ b/src/libs/compat/linuxkpi/linux/irq.c
@@ -0,0 +1,277 @@
+/*
+ * Copyright 2026, hans2294.
+ * Distributed under the terms of the MIT License.
+ */
+
+
+/*!	Interrupts. Haiku's interrupt handler only releases a semaphore; a
+	thread per interrupt waits on it and runs the Linux handler, so Linux
+	handlers run in thread context and may take linuxkpi's spinlocks.
+
+	That only works for edge-triggered interrupts (MSI): a level-triggered
+	line would fire again until the thread got to run.
+*/
+
+
+#include <linux/interrupt.h>
+#include <linux/irq.h>
+#include <linux/irqdomain.h>
+#include <linux/kthread.h>
+#include <linux/slab.h>
+#include <linux/mutex.h>
+#include <linux/list.h>
+#include <linux/printk.h>
+
+#include <linuxkpi/haiku.h>
+
+
+struct irq_entry {
+	struct list_head link;
+	unsigned int irq;
+	irq_handler_t handler;
+	irq_handler_t thread_fn;
+	void *dev_id;
+	const char *name;
+	int sem;
+	void *cookie;
+	struct task_struct *task;
+	struct mutex running;	/* held while the handler runs */
+	atomic_t disabled;
+	atomic_t pending;		/* arrived while disabled */
+	bool stopping;
+};
+
+static DEFINE_MUTEX(sIrqLock);
+static LIST_HEAD(sIrqs);
+
+
+static struct irq_entry *
+find_irq(unsigned int irq)
+{
+	struct irq_entry *entry;
+	list_for_each_entry(entry, &sIrqs, link) {
+		if (entry->irq == irq)
+			return entry;
+	}
+	return NULL;
+}
+
+
+static int
+irq_thread(void *data)
+{
+	struct irq_entry *entry = data;
+	for (;;) {
+		lkpi_haiku_sem_acquire(entry->sem, -1, 0);
+		if (READ_ONCE(entry->stopping))
+			break;
+		if (atomic_read(&entry->disabled) > 0) {
+			atomic_set(&entry->pending, 1);
+			continue;
+		}
+
+		mutex_lock(&entry->running);
+		irqreturn_t result = entry->handler != NULL
+			? entry->handler(entry->irq, entry->dev_id) : IRQ_WAKE_THREAD;
+		if (result == IRQ_WAKE_THREAD && entry->thread_fn != NULL)
+			entry->thread_fn(entry->irq, entry->dev_id);
+		mutex_unlock(&entry->running);
+	}
+	return 0;
+}
+
+
+int
+request_threaded_irq(unsigned int irq, irq_handler_t handler,
+	irq_handler_t thread_fn, unsigned long flags, const char *name, void *dev)
+{
+	mutex_lock(&sIrqLock);
+	if (find_irq(irq) != NULL) {
+		mutex_unlock(&sIrqLock);
+		pr_err("linuxkpi: interrupt %u is already taken\n", irq);
+		return -EBUSY;
+	}
+
+	struct irq_entry *entry = kzalloc(sizeof(*entry), GFP_KERNEL);
+	if (entry == NULL) {
+		mutex_unlock(&sIrqLock);
+		return -ENOMEM;
+	}
+	entry->irq = irq;
+	entry->handler = handler;
+	entry->thread_fn = thread_fn;
+	entry->dev_id = dev;
+	entry->name = name;
+	mutex_init(&entry->running);
+
+	int error = -ENOMEM;
+	entry->sem = lkpi_haiku_sem_create(0, "linux irq");
+	if (entry->sem < 0)
+		goto err_free;
+
+	entry->task = kthread_create(irq_thread, entry, "irq %u %s", irq, name);
+	if (IS_ERR(entry->task)) {
+		error = PTR_ERR(entry->task);
+		goto err_sem;
+	}
+	lkpi_haiku_thread_set_priority(entry->task->thread,
+		LKPI_HAIKU_PRIORITY_REALTIME);
+
+	error = lkpi_haiku_irq_install(irq, entry->sem, &entry->cookie);
+	if (error != 0)
+		goto err_thread;
+
+	wake_up_process(entry->task);
+	list_add_tail(&entry->link, &sIrqs);
+	mutex_unlock(&sIrqLock);
+	return 0;
+
+err_thread:
+	kthread_stop(entry->task);
+err_sem:
+	lkpi_haiku_sem_delete(entry->sem);
+err_free:
+	kfree(entry);
+	mutex_unlock(&sIrqLock);
+	return error;
+}
+
+
+int
+request_irq(unsigned int irq, irq_handler_t handler, unsigned long flags,
+	const char *name, void *dev)
+{
+	return request_threaded_irq(irq, handler, NULL, flags, name, dev);
+}
+
+
+const void *
+free_irq(unsigned int irq, void *dev_id)
+{
+	mutex_lock(&sIrqLock);
+	struct irq_entry *entry = find_irq(irq);
+	if (entry == NULL || entry->dev_id != dev_id) {
+		mutex_unlock(&sIrqLock);
+		pr_warn("linuxkpi: free_irq(%u) of an interrupt not requested\n", irq);
+		return NULL;
+	}
+	list_del(&entry->link);
+	mutex_unlock(&sIrqLock);
+
+	lkpi_haiku_irq_remove(irq, entry->cookie);
+	WRITE_ONCE(entry->stopping, true);
+	lkpi_haiku_sem_release(entry->sem);
+	kthread_stop(entry->task);
+	lkpi_haiku_sem_delete(entry->sem);
+
+	const char *name = entry->name;
+	kfree(entry);
+	return name;
+}
+
+
+void
+disable_irq_nosync(unsigned int irq)
+{
+	mutex_lock(&sIrqLock);
+	struct irq_entry *entry = find_irq(irq);
+	if (entry != NULL)
+		atomic_inc(&entry->disabled);
+	mutex_unlock(&sIrqLock);
+}
+
+
+void
+disable_irq(unsigned int irq)
+{
+	mutex_lock(&sIrqLock);
+	struct irq_entry *entry = find_irq(irq);
+	if (entry != NULL) {
+		atomic_inc(&entry->disabled);
+		// wait for a running handler to return
+		if (current != entry->task) {
+			mutex_lock(&entry->running);
+			mutex_unlock(&entry->running);
+		}
+	}
+	mutex_unlock(&sIrqLock);
+}
+
+
+void
+enable_irq(unsigned int irq)
+{
+	mutex_lock(&sIrqLock);
+	struct irq_entry *entry = find_irq(irq);
+	if (entry != NULL && atomic_dec_return(&entry->disabled) == 0
+		&& atomic_xchg(&entry->pending, 0) != 0)
+		lkpi_haiku_sem_release(entry->sem);
+	mutex_unlock(&sIrqLock);
+}
+
+
+void
+synchronize_irq(unsigned int irq)
+{
+	mutex_lock(&sIrqLock);
+	struct irq_entry *entry = find_irq(irq);
+	if (entry != NULL && current != entry->task) {
+		mutex_lock(&entry->running);
+		mutex_unlock(&entry->running);
+	}
+	mutex_unlock(&sIrqLock);
+}
+
+
+//	#pragma mark - irq domains
+
+
+/*!	amdgpu has an interrupt domain for its ACP and ISP child devices, which
+	linuxkpi does not create. The domain exists; mappings do not.
+*/
+struct irq_domain *
+irq_domain_add_linear(struct device_node *of_node, unsigned int size,
+	const struct irq_domain_ops *ops, void *host_data)
+{
+	struct irq_domain *domain = kzalloc(sizeof(*domain), GFP_KERNEL);
+	if (domain == NULL)
+		return NULL;
+	domain->ops = ops;
+	domain->host_data = host_data;
+	domain->size = size;
+	return domain;
+}
+
+
+void
+irq_domain_remove(struct irq_domain *domain)
+{
+	kfree(domain);
+}
+
+
+unsigned int
+irq_create_mapping(struct irq_domain *host, irq_hw_number_t hwirq)
+{
+	return 0;
+}
+
+
+int
+generic_handle_domain_irq(struct irq_domain *domain, unsigned int hwirq)
+{
+	return -EINVAL;
+}
+
+
+void
+irq_set_chip_and_handler(unsigned int irq, const struct irq_chip *chip,
+	irq_flow_handler_t handle)
+{
+}
+
+
+void
+handle_simple_irq(struct irq_desc *desc)
+{
+}
