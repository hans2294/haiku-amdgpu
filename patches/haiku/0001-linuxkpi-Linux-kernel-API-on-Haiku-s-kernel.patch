diff --git a/src/libs/compat/linuxkpi/include/linux/atomic.h b/src/libs/compat/linuxkpi/include/linux/atomic.h
new file mode 100644
index 0000000000..b3e60595a9
--- /dev/null
+++ b/src/libs/compat/linuxkpi/include/linux/atomic.h
@@ -0,0 +1,73 @@
+/*
+ * Copyright 2026, hans2294.
+ * Distributed under the terms of the MIT License.
+ */
+#ifndef _LINUXKPI_LINUX_ATOMIC_H
+#define _LINUXKPI_LINUX_ATOMIC_H
+
+#include <linux/kernel.h>
+#include <linux/bug.h>
+#include <linux/types.h>
+#include <asm/barrier.h>
+
+#define ATOMIC_INIT(i)		{ (i) }
+#define ATOMIC64_INIT(i)	{ (i) }
+#define ATOMIC_LONG_INIT(i)	ATOMIC64_INIT(i)
+
+#define cmpxchg(ptr, o, n) ({ typeof(*(ptr)) __o = (o); \
+	__atomic_compare_exchange_n(ptr, &__o, (n), false, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST); __o; })
+#define cmpxchg_relaxed(ptr, o, n)	cmpxchg(ptr, o, n)
+#define cmpxchg64(ptr, o, n)	cmpxchg(ptr, o, n)
+#define try_cmpxchg(ptr, oldp, n) \
+	__atomic_compare_exchange_n(ptr, oldp, (n), false, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST)
+#define xchg(ptr, v)		__atomic_exchange_n(ptr, (v), __ATOMIC_SEQ_CST)
+#define xchg_relaxed(ptr, v)	xchg(ptr, v)
+
+#define __LINUXKPI_ATOMIC(prefix, type, ctype) \
+static inline ctype prefix##_read(const type *v) { return __atomic_load_n(&v->counter, __ATOMIC_RELAXED); } \
+static inline ctype prefix##_read_acquire(const type *v) { return __atomic_load_n(&v->counter, __ATOMIC_ACQUIRE); } \
+static inline void prefix##_set(type *v, ctype i) { __atomic_store_n(&v->counter, i, __ATOMIC_RELAXED); } \
+static inline void prefix##_set_release(type *v, ctype i) { __atomic_store_n(&v->counter, i, __ATOMIC_RELEASE); } \
+static inline void prefix##_add(ctype i, type *v) { __atomic_fetch_add(&v->counter, i, __ATOMIC_SEQ_CST); } \
+static inline void prefix##_sub(ctype i, type *v) { __atomic_fetch_sub(&v->counter, i, __ATOMIC_SEQ_CST); } \
+static inline void prefix##_inc(type *v) { prefix##_add(1, v); } \
+static inline void prefix##_dec(type *v) { prefix##_sub(1, v); } \
+static inline void prefix##_and(ctype i, type *v) { __atomic_fetch_and(&v->counter, i, __ATOMIC_SEQ_CST); } \
+static inline void prefix##_or(ctype i, type *v) { __atomic_fetch_or(&v->counter, i, __ATOMIC_SEQ_CST); } \
+static inline void prefix##_xor(ctype i, type *v) { __atomic_fetch_xor(&v->counter, i, __ATOMIC_SEQ_CST); } \
+static inline void prefix##_andnot(ctype i, type *v) { __atomic_fetch_and(&v->counter, ~i, __ATOMIC_SEQ_CST); } \
+static inline ctype prefix##_add_return(ctype i, type *v) { return __atomic_add_fetch(&v->counter, i, __ATOMIC_SEQ_CST); } \
+static inline ctype prefix##_sub_return(ctype i, type *v) { return __atomic_sub_fetch(&v->counter, i, __ATOMIC_SEQ_CST); } \
+static inline ctype prefix##_fetch_add(ctype i, type *v) { return __atomic_fetch_add(&v->counter, i, __ATOMIC_SEQ_CST); } \
+static inline ctype prefix##_fetch_sub(ctype i, type *v) { return __atomic_fetch_sub(&v->counter, i, __ATOMIC_SEQ_CST); } \
+static inline ctype prefix##_fetch_or(ctype i, type *v) { return __atomic_fetch_or(&v->counter, i, __ATOMIC_SEQ_CST); } \
+static inline ctype prefix##_fetch_and(ctype i, type *v) { return __atomic_fetch_and(&v->counter, i, __ATOMIC_SEQ_CST); } \
+static inline ctype prefix##_fetch_andnot(ctype i, type *v) { return __atomic_fetch_and(&v->counter, ~i, __ATOMIC_SEQ_CST); } \
+static inline ctype prefix##_inc_return(type *v) { return prefix##_add_return(1, v); } \
+static inline ctype prefix##_dec_return(type *v) { return prefix##_sub_return(1, v); } \
+static inline ctype prefix##_fetch_inc(type *v) { return prefix##_fetch_add(1, v); } \
+static inline ctype prefix##_fetch_dec(type *v) { return prefix##_fetch_sub(1, v); } \
+static inline bool prefix##_dec_and_test(type *v) { return prefix##_dec_return(v) == 0; } \
+static inline bool prefix##_inc_and_test(type *v) { return prefix##_inc_return(v) == 0; } \
+static inline bool prefix##_sub_and_test(ctype i, type *v) { return prefix##_sub_return(i, v) == 0; } \
+static inline ctype prefix##_xchg(type *v, ctype n) { return __atomic_exchange_n(&v->counter, n, __ATOMIC_SEQ_CST); } \
+static inline ctype prefix##_cmpxchg(type *v, ctype o, ctype n) \
+{ __atomic_compare_exchange_n(&v->counter, &o, n, false, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST); return o; } \
+static inline bool prefix##_try_cmpxchg(type *v, ctype *o, ctype n) \
+{ return __atomic_compare_exchange_n(&v->counter, o, n, false, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST); } \
+static inline ctype prefix##_fetch_add_unless(type *v, ctype a, ctype u) \
+{ ctype c = prefix##_read(v); do { if (c == u) break; } while (!prefix##_try_cmpxchg(v, &c, c + a)); return c; } \
+static inline bool prefix##_add_unless(type *v, ctype a, ctype u) { return prefix##_fetch_add_unless(v, a, u) != u; } \
+static inline bool prefix##_inc_not_zero(type *v) { return prefix##_add_unless(v, 1, 0); } \
+static inline ctype prefix##_dec_if_positive(type *v) \
+{ ctype c = prefix##_read(v), d; do { d = c - 1; if (d < 0) break; } while (!prefix##_try_cmpxchg(v, &c, d)); return d; }
+
+__LINUXKPI_ATOMIC(atomic, atomic_t, int)
+__LINUXKPI_ATOMIC(atomic64, atomic64_t, s64)
+__LINUXKPI_ATOMIC(atomic_long, atomic_long_t, s64)
+#define atomic_inc_return_relaxed	atomic_inc_return
+#define atomic_dec_return_relaxed	atomic_dec_return
+#define atomic_read_ctrl			atomic_read
+#define atomic_cond_read_relaxed(v, c)	({ int VAL; for (;;) { VAL = atomic_read(v); if (c) break; cpu_relax(); } VAL; })
+
+#endif
