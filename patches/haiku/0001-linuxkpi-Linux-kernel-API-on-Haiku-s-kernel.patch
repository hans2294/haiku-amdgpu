+struct pseudo_fs_context *
+init_pseudo(struct fs_context *fc, unsigned long magic)
+{
+	struct pseudo_fs_context *ctx = kzalloc(sizeof(*ctx), GFP_KERNEL);
+	if (ctx != NULL)
+		ctx->magic = magic;
