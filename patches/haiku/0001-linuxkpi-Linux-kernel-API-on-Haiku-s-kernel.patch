+//	#pragma mark - pseudo file systems
+
+
+/*!	DRM keeps an anonymous inode per device on a pseudo file system, for
+	its address space. The mount and super block are placeholders; inodes
+	are real enough to carry an address space.
+*/
+struct super_block {
+	struct file_system_type *type;
+	const struct dentry_operations *d_op;	/* for its files' dentries */
+};
+
+/* Only what pseudo file systems set up through init_pseudo() */
+struct fs_context {
+	void *fs_private;
+};
+
+
+struct vfsmount *
+kern_mount(struct file_system_type *type)
+{
+	struct vfsmount *mount = kzalloc(sizeof(*mount), GFP_KERNEL);
+	struct super_block *sb = kzalloc(sizeof(*sb), GFP_KERNEL);
+	if (mount == NULL || sb == NULL) {
+		kfree(mount);
+		kfree(sb);
+		return ERR_PTR(-ENOMEM);
+	}
+	sb->type = type;
+	mount->mnt_sb = sb;
+
+	// A pseudo file system's dentry operations (dma-buf frees its buffers
+	// in d_release)
+	if (type->init_fs_context != NULL) {
+		struct fs_context context = { NULL };
+		type->init_fs_context(&context);
+		struct pseudo_fs_context *pseudo = context.fs_private;
+		if (pseudo != NULL) {
+			sb->d_op = pseudo->dops;
+			kfree(pseudo);
+		}
+	}
+	return mount;
+}
+
+
+void
+kern_unmount(struct vfsmount *mnt)
+{
+	if (IS_ERR_OR_NULL(mnt))
+		return;
+	kfree(mnt->mnt_sb);
+	kfree(mnt);
+}
+
+
+int
+simple_pin_fs(struct file_system_type *type, struct vfsmount **mount,
+	int *count)
+{
+	if (*mount == NULL) {
+		struct vfsmount *mnt = kern_mount(type);
+		if (IS_ERR(mnt))
+			return PTR_ERR(mnt);
+		*mount = mnt;
+	}
+	(*count)++;
+	return 0;
+}
+
+
+void
+simple_release_fs(struct vfsmount **mount, int *count)
+{
+	if (--(*count) == 0) {
+		kern_unmount(*mount);
+		*mount = NULL;
+	}
+}
