+//	#pragma mark - mappings to userspace
+
+
+/*!	Mappings to userspace are made whole when they are created (see
+	chrdev.c): linuxkpi calls the fault handler for every page, and the
+	inserts land in the vma's page list instead of a page table.
+*/
+pgprot_t
+vm_get_page_prot(unsigned long vm_flags)
+{
+	return PAGE_SHARED;
+}
+
+
+static vm_fault_t
+insert_physical(struct vm_area_struct *vma, unsigned long addr,
+	unsigned long long physical, pgprot_t pgprot)
+{
+	unsigned long index = (addr - vma->vm_start) >> PAGE_SHIFT;
+	if (vma->linuxkpi_physical == NULL || index >= vma->linuxkpi_pages)
+		return VM_FAULT_SIGBUS;
+	if (vma->linuxkpi_physical[index] == 0)
+		vma->linuxkpi_physical[index] = physical;
+	vma->linuxkpi_cache = pgprot_val(pgprot) & _PAGE_CACHE_MASK;
+	return VM_FAULT_NOPAGE;
+}
+
+
+vm_fault_t
+vmf_insert_pfn_prot(struct vm_area_struct *vma, unsigned long addr,
+	unsigned long pfn, pgprot_t pgprot)
+{
+	return insert_physical(vma, addr, (unsigned long long)pfn << PAGE_SHIFT,
+		pgprot);
+}
+
+
+vm_fault_t
+vmf_insert_pfn(struct vm_area_struct *vma, unsigned long addr,
+	unsigned long pfn)
+{
+	return vmf_insert_pfn_prot(vma, addr, pfn, vma->vm_page_prot);
+}
+
+
+vm_fault_t
+vmf_insert_mixed(struct vm_area_struct *vma, unsigned long addr,
+	unsigned long pfn)
+{
+	return vmf_insert_pfn_prot(vma, addr, pfn, vma->vm_page_prot);
+}
+
+
+vm_fault_t
+vmf_insert_page(struct vm_area_struct *vma, unsigned long addr,
+	struct page *page)
+{
+	return vmf_insert_pfn_prot(vma, addr, page_to_pfn(page),
+		vma->vm_page_prot);
+}
+
+
+int
+vm_insert_page(struct vm_area_struct *vma, unsigned long addr,
+	struct page *page)
+{
+	return vmf_insert_page(vma, addr, page) == VM_FAULT_NOPAGE ? 0 : -EFAULT;
+}
+
+
+int
+remap_pfn_range(struct vm_area_struct *vma, unsigned long addr,
+	unsigned long pfn, unsigned long size, pgprot_t prot)
+{
+	for (unsigned long offset = 0; offset < size; offset += PAGE_SIZE) {
+		if (insert_physical(vma, addr + offset,
+				((unsigned long long)pfn << PAGE_SHIFT) + offset, prot)
+				!= VM_FAULT_NOPAGE)
+			return -EINVAL;
+	}
+	return 0;
+}
