diff --git a/src/libs/compat/linuxkpi/include/linux/percpu.h b/src/libs/compat/linuxkpi/include/linux/percpu.h
new file mode 100644
index 0000000000..9249a58cb2
--- /dev/null
+++ b/src/libs/compat/linuxkpi/include/linux/percpu.h
@@ -0,0 +1,48 @@
+/*
+ * Copyright 2026, hans2294.
+ * Distributed under the terms of the MIT License.
+ */
+#ifndef _LINUXKPI_LINUX_PERCPU_H
+#define _LINUXKPI_LINUX_PERCPU_H
+
+#include <linux/smp.h>
+#include <linux/preempt.h>
+#include <linux/slab.h>
+
+/*
+ * Per-CPU data is a single shared instance: correct as long as access is
+ * serialized (local_lock is a real lock here), just without per-CPU scaling.
+ * Statistics counters bumped with this_cpu_inc() may race; nothing relies on
+ * them being exact.
+ */
+#define DEFINE_PER_CPU(type, name)	__typeof__(type) name
+#define DECLARE_PER_CPU(type, name)	extern __typeof__(type) name
+#define DEFINE_PER_CPU_READ_MOSTLY(type, name)	DEFINE_PER_CPU(type, name)
+#define EXPORT_PER_CPU_SYMBOL(var)
+#define EXPORT_PER_CPU_SYMBOL_GPL(var)
+#define per_cpu(var, cpu)			(var)
+#define per_cpu_ptr(ptr, cpu)		(ptr)
+#define raw_cpu_ptr(ptr)			(ptr)
+#define this_cpu_ptr(ptr)			(ptr)
+#define get_cpu_var(var)			(*({ preempt_disable(); &(var); }))
+#define put_cpu_var(var)			preempt_enable()
+#define get_cpu_ptr(ptr)			({ preempt_disable(); (ptr); })
+#define put_cpu_ptr(ptr)			preempt_enable()
+#define this_cpu_read(var)			(var)
+#define this_cpu_write(var, v)		((var) = (v))
+#define this_cpu_inc(var)			((var)++)
+#define this_cpu_dec(var)			((var)--)
+#define this_cpu_add(var, v)		((var) += (v))
+#define __this_cpu_read(var)		(var)
+#define __this_cpu_write(var, v)	((var) = (v))
+#define __this_cpu_inc(var)			((var)++)
+#define this_cpu_inc_return(var)	(++(var))
+#define this_cpu_dec_return(var)	(--(var))
+#define __this_cpu_inc_return(var)	(++(var))
+#define __this_cpu_dec_return(var)	(--(var))
+#define __this_cpu_add(var, v)		((var) += (v))
+#define alloc_percpu(type)			((typeof(type) *)kzalloc(sizeof(type), GFP_KERNEL))
+#define alloc_percpu_gfp(type, gfp)	((typeof(type) *)kzalloc(sizeof(type), gfp))
+#define free_percpu(ptr)			kfree(ptr)
+
+#endif
