+#define get_user(x, ptr) ({ typeof(*(ptr)) __gu_val; int __gu_ret = linuxkpi_get_user(&__gu_val, (ptr), sizeof(*(ptr))); \
+	(x) = __gu_val; __gu_ret; })
+#define put_user(x, ptr) ({ typeof(*(ptr)) __pu_val = (x); linuxkpi_put_user(&__pu_val, (ptr), sizeof(*(ptr))); })
