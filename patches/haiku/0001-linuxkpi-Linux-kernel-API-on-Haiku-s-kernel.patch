+/*
+ * Copyright 2026, hans2294.
+ * Distributed under the terms of the MIT License.
+ */
+
+
+/*!	Locks: mutexes, spinlocks, rwlocks and rw_semaphores on Haiku mutexes
+	and rw_locks; semaphores and wound/wait mutexes on top of those.
+
+	Interrupt state is not real under linuxkpi: Linux interrupt handlers and
+	timers run in threads, so "disabling interrupts" only has to keep the
+	bookkeeping Linux code looks at.
+*/
+
+
+#include <linux/mutex.h>
+#include <linux/spinlock.h>
+#include <linux/rwsem.h>
+#include <linux/semaphore.h>
+#include <linux/ww_mutex.h>
+#include <linux/sched.h>
+#include <linux/wait.h>
+#include <linux/preempt.h>
+#include <linux/irqflags.h>
+#include <linux/hardirq.h>
+
+#include <linuxkpi/haiku.h>
+
+
+_Static_assert(sizeof(((struct mutex *)0)->opaque) >= LKPI_HAIKU_MUTEX_SIZE,
+	"struct mutex too small");
+_Static_assert(sizeof(((spinlock_t *)0)->opaque) >= LKPI_HAIKU_MUTEX_SIZE,
+	"spinlock_t too small");
+_Static_assert(sizeof(((rwlock_t *)0)->opaque) >= LKPI_HAIKU_RWLOCK_SIZE,
+	"rwlock_t too small");
+_Static_assert(sizeof(((struct rw_semaphore *)0)->opaque)
+	>= LKPI_HAIKU_RWLOCK_SIZE, "struct rw_semaphore too small");
+
+
+//	#pragma mark - mutex
+
+
+void
+linuxkpi_mutex_init(struct mutex *lock, const char *name)
+{
+	lock->name = name;
+	lkpi_haiku_mutex_init(lock->opaque, name);
+}
+
+
+void
+mutex_destroy(struct mutex *lock)
+{
+	lkpi_haiku_mutex_destroy(lock->opaque);
+}
+
+
+void
+mutex_lock(struct mutex *lock)
+{
+	might_sleep();
+	lkpi_haiku_mutex_lock(lock->opaque, 0);
+}
+
+
+int
+mutex_lock_interruptible(struct mutex *lock)
+{
+	return lkpi_haiku_mutex_lock(lock->opaque, 1);
+}
+
+
+int
+mutex_lock_killable(struct mutex *lock)
+{
+	return lkpi_haiku_mutex_lock(lock->opaque, 1);
+}
+
+
+int
+mutex_trylock(struct mutex *lock)
+{
+	return lkpi_haiku_mutex_trylock(lock->opaque);
+}
+
+
+void
+mutex_unlock(struct mutex *lock)
+{
+	lkpi_haiku_mutex_unlock(lock->opaque);
+}
+
+
+bool
+mutex_is_locked(struct mutex *lock)
+{
+	return lkpi_haiku_mutex_is_locked(lock->opaque);
+}
+
+
+int
+atomic_dec_and_mutex_lock(atomic_t *cnt, struct mutex *lock)
+{
+	if (atomic_add_unless(cnt, -1, 1))
+		return 0;
+	mutex_lock(lock);
+	if (!atomic_dec_and_test(cnt)) {
+		mutex_unlock(lock);
+		return 0;
+	}
+	return 1;
+}
+
+
+//	#pragma mark - spinlock
+
+
+void
+linuxkpi_spin_lock_init(spinlock_t *lock, const char *name)
+{
+	lock->name = name;
+	lkpi_haiku_mutex_init(lock->opaque, name);
+}
+
+
+void
+spin_lock(spinlock_t *lock)
+{
+	lkpi_haiku_mutex_lock(lock->opaque, 0);
+}
+
+
+void
+spin_unlock(spinlock_t *lock)
+{
+	lkpi_haiku_mutex_unlock(lock->opaque);
+}
+
+
+int
+spin_trylock(spinlock_t *lock)
+{
+	return lkpi_haiku_mutex_trylock(lock->opaque);
+}
+
+
+unsigned long
+_spin_lock_irqsave(spinlock_t *lock)
+{
+	unsigned long flags = linuxkpi_irq_save();
+	spin_lock(lock);
+	return flags;
+}
+
+
+void
+spin_unlock_irqrestore(spinlock_t *lock, unsigned long flags)
+{
+	spin_unlock(lock);
+	linuxkpi_irq_restore(flags);
+}
+
+
+int
+spin_is_locked(spinlock_t *lock)
+{
+	return lkpi_haiku_mutex_is_locked(lock->opaque);
+}
+
+
+int
+_atomic_dec_and_lock(atomic_t *atomic, spinlock_t *lock)
+{
+	if (atomic_add_unless(atomic, -1, 1))
+		return 0;
+	spin_lock(lock);
+	if (atomic_dec_and_test(atomic))
+		return 1;
+	spin_unlock(lock);
+	return 0;
+}
+
+
+int
+_atomic_dec_and_lock_irqsave(atomic_t *atomic, spinlock_t *lock,
+	unsigned long *flags)
+{
+	if (atomic_add_unless(atomic, -1, 1))
+		return 0;
+	*flags = _spin_lock_irqsave(lock);
+	if (atomic_dec_and_test(atomic))
+		return 1;
+	spin_unlock_irqrestore(lock, *flags);
+	return 0;
+}
+
+
+//	#pragma mark - rwlock
+
+
+void
+rwlock_init(rwlock_t *lock)
+{
+	lkpi_haiku_rwlock_init(lock->opaque, "linux rwlock");
+}
+
+
+void
+read_lock(rwlock_t *lock)
+{
+	lkpi_haiku_rwlock_read_lock(lock->opaque, 0);
+}
+
+
+void
+read_unlock(rwlock_t *lock)
+{
+	lkpi_haiku_rwlock_read_unlock(lock->opaque);
+}
+
+
+void
+write_lock(rwlock_t *lock)
+{
+	lkpi_haiku_rwlock_write_lock(lock->opaque, 0);
+}
+
+
+void
+write_unlock(rwlock_t *lock)
+{
+	lkpi_haiku_rwlock_write_unlock(lock->opaque);
+}
+
+
+//	#pragma mark - rw_semaphore
+
+
+void
+linuxkpi_init_rwsem(struct rw_semaphore *sem, const char *name)
+{
+	sem->name = name;
+	lkpi_haiku_rwlock_init(sem->opaque, name);
+}
+
+
+void
+down_read(struct rw_semaphore *sem)
+{
+	might_sleep();
+	lkpi_haiku_rwlock_read_lock(sem->opaque, 0);
+}
+
+
+int
+down_read_interruptible(struct rw_semaphore *sem)
+{
+	return lkpi_haiku_rwlock_read_lock(sem->opaque, 1);
+}
+
+
+int
+down_read_killable(struct rw_semaphore *sem)
+{
+	return lkpi_haiku_rwlock_read_lock(sem->opaque, 1);
+}
+
+
+int
+down_read_trylock(struct rw_semaphore *sem)
+{
+	return lkpi_haiku_rwlock_read_trylock(sem->opaque);
+}
+
+
+void
+up_read(struct rw_semaphore *sem)
+{
+	lkpi_haiku_rwlock_read_unlock(sem->opaque);
+}
+
+
+void
+down_write(struct rw_semaphore *sem)
+{
+	might_sleep();
+	lkpi_haiku_rwlock_write_lock(sem->opaque, 0);
+}
+
+
+int
+down_write_killable(struct rw_semaphore *sem)
+{
+	return lkpi_haiku_rwlock_write_lock(sem->opaque, 1);
+}
+
+
+int
+down_write_trylock(struct rw_semaphore *sem)
+{
+	// Haiku's rw_lock cannot try a write lock; only uncontended paths call
+	// this, so take it when nobody holds it.
+	if (lkpi_haiku_rwlock_is_locked(sem->opaque))
+		return 0;
+	lkpi_haiku_rwlock_write_lock(sem->opaque, 0);
+	return 1;
+}
+
+
+void
+up_write(struct rw_semaphore *sem)
+{
+	lkpi_haiku_rwlock_write_unlock(sem->opaque);
+}
+
+
+void
+downgrade_write(struct rw_semaphore *sem)
+{
+	// Haiku's rw_lock lets the writer take read locks; drop the write lock
+	// after that.
+	lkpi_haiku_rwlock_read_lock(sem->opaque, 0);
+	lkpi_haiku_rwlock_write_unlock(sem->opaque);
+}
+
+
+int
+rwsem_is_locked(struct rw_semaphore *sem)
+{
+	return lkpi_haiku_rwlock_is_locked(sem->opaque);
+}
+
+
+int
+rwsem_is_contended(struct rw_semaphore *sem)
+{
+	return 0;
+}
+
+
+//	#pragma mark - semaphore
+
+
+struct semaphore_waiter {
+	struct list_head link;
+	struct task_struct *task;
+	bool up;
+};
+
+
+void
+sema_init(struct semaphore *sem, int val)
+{
+	spin_lock_init(&sem->lock);
+	sem->count = val;
+	INIT_LIST_HEAD(&sem->wait_list);
+}
+
+
+static int
+down_common(struct semaphore *sem, unsigned int state, long timeout)
+{
+	struct semaphore_waiter waiter;
+	int result = 0;
+
+	spin_lock(&sem->lock);
+	if (sem->count > 0) {
+		sem->count--;
+		spin_unlock(&sem->lock);
+		return 0;
+	}
+
+	waiter.task = current;
+	waiter.up = false;
+	list_add_tail(&waiter.link, &sem->wait_list);
+	for (;;) {
+		set_current_state(state);
+		spin_unlock(&sem->lock);
+		timeout = schedule_timeout(timeout);
+		spin_lock(&sem->lock);
+		if (waiter.up)
+			break;
+		if (timeout <= 0) {
+			list_del(&waiter.link);
+			result = -ETIME;
+			break;
+		}
+	}
+	spin_unlock(&sem->lock);
+	return result;
+}
+
+
+void
+down(struct semaphore *sem)
+{
+	down_common(sem, TASK_UNINTERRUPTIBLE, MAX_SCHEDULE_TIMEOUT);
+}
+
+
+int
+down_interruptible(struct semaphore *sem)
+{
+	return down_common(sem, TASK_INTERRUPTIBLE, MAX_SCHEDULE_TIMEOUT);
+}
+
+
+int
+down_trylock(struct semaphore *sem)
+{
+	spin_lock(&sem->lock);
+	int busy = sem->count == 0;
+	if (!busy)
+		sem->count--;
+	spin_unlock(&sem->lock);
+	return busy;
+}
+
+
+int
+down_timeout(struct semaphore *sem, long jiffies)
+{
+	return down_common(sem, TASK_UNINTERRUPTIBLE, jiffies);
+}
+
+
+void
+up(struct semaphore *sem)
+{
+	spin_lock(&sem->lock);
+	if (list_empty(&sem->wait_list)) {
+		sem->count++;
+	} else {
+		struct semaphore_waiter *waiter = list_first_entry(&sem->wait_list,
+			struct semaphore_waiter, link);
+		list_del(&waiter->link);
+		waiter->up = true;
+		wake_up_process(waiter->task);
+	}
+	spin_unlock(&sem->lock);
+}
+
+
+//	#pragma mark - ww_mutex
+
+
+/*!	Wait-die for both classes: a context that holds locks and meets a lock
+	held by an older context backs off with -EDEADLK; everyone else waits.
+	Linux's wound-wait would wound the holder instead, but backing off the
+	younger side is correct for both, only less fair.
+*/
+
+
+void
+ww_mutex_init(struct ww_mutex *lock, struct ww_class *ww_class)
+{
+	linuxkpi_mutex_init(&lock->base, ww_class->mutex_name);
+	lock->ctx = NULL;
+	lock->ww_class = ww_class;
+}
+
+
+void
+ww_acquire_init(struct ww_acquire_ctx *ctx, struct ww_class *ww_class)
+{
+	ctx->task = current;
+	ctx->stamp = atomic_long_inc_return(&ww_class->stamp);
+	ctx->acquired = 0;
+	ctx->wounded = 0;
+	ctx->is_wait_die = ww_class->is_wait_die;
+	ctx->ww_class = ww_class;
+}
+
+
+void
+ww_acquire_fini(struct ww_acquire_ctx *ctx)
+{
+	WARN_ON(ctx->acquired != 0);
+}
+
+
+static int
+ww_lock_common(struct ww_mutex *lock, struct ww_acquire_ctx *ctx,
+	bool interruptible)
+{
+	if (ctx == NULL) {
+		if (interruptible)
+			return mutex_lock_interruptible(&lock->base);
+		mutex_lock(&lock->base);
+		return 0;
+	}
+
+	if (READ_ONCE(lock->ctx) == ctx)
+		return -EALREADY;
+
+	while (!mutex_trylock(&lock->base)) {
+		struct ww_acquire_ctx *holder = READ_ONCE(lock->ctx);
+		if (holder != NULL && holder != ctx && ctx->acquired > 0
+			&& holder->stamp < ctx->stamp)
+			return -EDEADLK;
+
+		// The holder may change between our look and our sleep; poll
+		// instead of sleeping on the mutex itself.
+		lkpi_haiku_snooze(50);
+		if (interruptible && signal_pending(current))
+			return -EINTR;
+	}
+
+	WRITE_ONCE(lock->ctx, ctx);
+	ctx->acquired++;
+	return 0;
+}
+
+
+int
+ww_mutex_lock(struct ww_mutex *lock, struct ww_acquire_ctx *ctx)
+{
+	return ww_lock_common(lock, ctx, false);
+}
+
+
+int
+ww_mutex_lock_interruptible(struct ww_mutex *lock, struct ww_acquire_ctx *ctx)
+{
+	return ww_lock_common(lock, ctx, true);
+}
+
+
+void
+ww_mutex_lock_slow(struct ww_mutex *lock, struct ww_acquire_ctx *ctx)
+{
+	// After backing off the context holds nothing, so this always waits.
+	mutex_lock(&lock->base);
+	WRITE_ONCE(lock->ctx, ctx);
+	if (ctx != NULL)
+		ctx->acquired++;
+}
+
+
+int
+ww_mutex_lock_slow_interruptible(struct ww_mutex *lock,
+	struct ww_acquire_ctx *ctx)
+{
+	int error = mutex_lock_interruptible(&lock->base);
+	if (error != 0)
+		return error;
+	WRITE_ONCE(lock->ctx, ctx);
+	if (ctx != NULL)
+		ctx->acquired++;
+	return 0;
+}
+
+
+int
+ww_mutex_trylock(struct ww_mutex *lock, struct ww_acquire_ctx *ctx)
+{
+	if (!mutex_trylock(&lock->base))
+		return 0;
+	WRITE_ONCE(lock->ctx, ctx);
+	if (ctx != NULL)
+		ctx->acquired++;
+	return 1;
+}
+
+
+void
+ww_mutex_unlock(struct ww_mutex *lock)
+{
+	struct ww_acquire_ctx *ctx = lock->ctx;
+	if (ctx != NULL)
+		ctx->acquired--;
+	WRITE_ONCE(lock->ctx, NULL);
+	mutex_unlock(&lock->base);
+}
+
+
+//	#pragma mark - interrupt and preemption state
+
+
+unsigned long
+linuxkpi_irq_save(void)
+{
+	return 0;
+}
+
+
+void
+linuxkpi_irq_restore(unsigned long flags)
+{
+}
+
+
+bool
+linuxkpi_irqs_disabled(void)
+{
+	return false;
+}
+
+
+void
+preempt_disable(void)
+{
+}
+
+
+void
+preempt_enable(void)
+{
+}
+
+
+bool
+in_interrupt(void)
+{
+	return false;
+}
diff --git a/src/libs/compat/linuxkpi/linux/timer.c b/src/libs/compat/linuxkpi/linux/timer.c
new file mode 100644
index 0000000000..94dadaea1a
--- /dev/null
+++ b/src/libs/compat/linuxkpi/linux/timer.c
@@ -0,0 +1,1000 @@
+/*
+ * Copyright 2026, hans2294.
+ * Distributed under the terms of the MIT License.
+ */
+
+
+/*!	Deferred execution: timers, hrtimers and irq_work all run from one timer
+	thread; workqueues and kthread workers have threads of their own.
+
+	Linux runs timer callbacks in softirq context; here they run in a thread
+	like everything else, so they may take linuxkpi's spinlocks (which are
+	Haiku mutexes).
+*/
+
+
+#include <linux/timer.h>
+#include <linux/hrtimer.h>
+#include <linux/irq_work.h>
+#include <linux/workqueue.h>
+#include <linux/kthread.h>
+#include <linux/sched.h>
+#include <linux/wait.h>
+#include <linux/slab.h>
+#include <linux/jiffies.h>
+#include <linux/init.h>
+#include <linux/printk.h>
+#include <linux/string.h>
+
+#include <linuxkpi/haiku.h>
+
+
+//	#pragma mark - timer thread
+
+
+static DEFINE_SPINLOCK(sTimerLock);
+static LIST_HEAD(sTimers);
+static struct task_struct *sTimerTask;
+static struct linuxkpi_timer *sRunningTimer;
+static DECLARE_WAIT_QUEUE_HEAD(sTimerDone);
+
+
+/*!	Queues or requeues \a timer to run at \a when (system time in ns).
+	Returns whether it was queued before.
+*/
+static int
+timer_add(struct linuxkpi_timer *timer, u64 when)
+{
+	spin_lock(&sTimerLock);
+	int wasQueued = timer->queued;
+	if (wasQueued)
+		list_del(&timer->entry);
+	timer->when = when;
+
+	struct linuxkpi_timer *other;
+	struct list_head *before = &sTimers;
+	list_for_each_entry(other, &sTimers, entry) {
+		if (other->when > when) {
+			before = &other->entry;
+			break;
+		}
+	}
+	list_add_tail(&timer->entry, before);
+	timer->queued = 1;
+	bool first = sTimers.next == &timer->entry;
+	spin_unlock(&sTimerLock);
+
+	if (first && sTimerTask != NULL)
+		wake_up_process(sTimerTask);
+	return wasQueued;
+}
+
+
+static int
+timer_remove(struct linuxkpi_timer *timer)
+{
+	spin_lock(&sTimerLock);
+	int wasQueued = timer->queued;
+	if (wasQueued) {
+		list_del(&timer->entry);
+		timer->queued = 0;
+	}
+	spin_unlock(&sTimerLock);
+	return wasQueued;
+}
+
+
+static bool
+timer_running(struct linuxkpi_timer *timer)
+{
+	return READ_ONCE(sRunningTimer) == timer;
+}
+
+
+/*!	Removes \a timer and waits for a running callback of it to return,
+	unless that callback is the caller.
+*/
+static int
+timer_remove_sync(struct linuxkpi_timer *timer)
+{
+	int wasQueued = 0;
+	for (;;) {
+		wasQueued |= timer_remove(timer);
+		if (!timer_running(timer) || current == sTimerTask)
+			break;
+		wait_event(sTimerDone, !timer_running(timer));
+	}
+	return wasQueued;
+}
+
+
+static int
+timer_thread(void *data)
+{
+	for (;;) {
+		spin_lock(&sTimerLock);
+		if (list_empty(&sTimers)) {
+			set_current_state(TASK_UNINTERRUPTIBLE);
+			spin_unlock(&sTimerLock);
+			schedule();
+			continue;
+		}
+
+		struct linuxkpi_timer *timer = list_first_entry(&sTimers,
+			struct linuxkpi_timer, entry);
+		u64 now = ktime_get();
+		if (timer->when > now) {
+			set_current_state(TASK_UNINTERRUPTIBLE);
+			spin_unlock(&sTimerLock);
+			schedule_timeout(max(1UL, nsecs_to_jiffies(timer->when - now)));
+			continue;
+		}
+
+		list_del(&timer->entry);
+		timer->queued = 0;
+		WRITE_ONCE(sRunningTimer, timer);
+		spin_unlock(&sTimerLock);
+
+		// The callback may free the timer; it is not touched afterwards.
+		timer->callback(timer);
+
+		WRITE_ONCE(sRunningTimer, NULL);
+		wake_up_all(&sTimerDone);
+	}
+	return 0;
+}
+
+
+static u64
+jiffies_to_system_ns(unsigned long expires)
+{
+	long delta = (long)(expires - jiffies);
+	u64 now = ktime_get();
+	if (delta <= 0)
+		return now;
+	return now + jiffies_to_nsecs(delta);
+}
+
+
+//	#pragma mark - timer_list
+
+
+static void
+timer_list_fire(struct linuxkpi_timer *base)
+{
+	struct timer_list *timer = container_of(base, struct timer_list, linuxkpi);
+	timer->function(timer);
+}
+
+
+void
+linuxkpi_timer_setup(struct timer_list *timer,
+	void (*func)(struct timer_list *), unsigned int flags)
+{
+	memset(&timer->linuxkpi, 0, sizeof(timer->linuxkpi));
+	INIT_LIST_HEAD(&timer->linuxkpi.entry);
+	timer->linuxkpi.callback = timer_list_fire;
+	timer->function = func;
+	timer->flags = flags;
+	timer->expires = 0;
+}
+
+
+int
+mod_timer(struct timer_list *timer, unsigned long expires)
+{
+	timer->expires = expires;
+	timer->linuxkpi.callback = timer_list_fire;
+	return timer_add(&timer->linuxkpi, jiffies_to_system_ns(expires));
+}
+
+
+void
+add_timer(struct timer_list *timer)
+{
+	mod_timer(timer, timer->expires);
+}
+
+
+int
+del_timer(struct timer_list *timer)
+{
+	return timer_remove(&timer->linuxkpi);
+}
+
+
+int
+del_timer_sync(struct timer_list *timer)
+{
+	return timer_remove_sync(&timer->linuxkpi);
+}
+
+
+int
+timer_pending(const struct timer_list *timer)
+{
+	return READ_ONCE(timer->linuxkpi.queued);
+}
+
+
+//	#pragma mark - hrtimer
+
+
+static void
+hrtimer_fire(struct linuxkpi_timer *base)
+{
+	struct hrtimer *timer = container_of(base, struct hrtimer, linuxkpi);
+	if (timer->function(timer) == HRTIMER_RESTART)
+		timer_add(&timer->linuxkpi, timer->node.expires);
+}
+
+
+void
+hrtimer_init(struct hrtimer *timer, clockid_t which_clock,
+	enum hrtimer_mode mode)
+{
+	memset(timer, 0, sizeof(*timer));
+	INIT_LIST_HEAD(&timer->linuxkpi.entry);
+	timer->linuxkpi.callback = hrtimer_fire;
+}
+
+
+void
+hrtimer_setup(struct hrtimer *timer,
+	enum hrtimer_restart (*function)(struct hrtimer *), clockid_t clock_id,
+	enum hrtimer_mode mode)
+{
+	hrtimer_init(timer, clock_id, mode);
+	timer->function = function;
+}
+
+
+void
+hrtimer_start(struct hrtimer *timer, ktime_t tim, const enum hrtimer_mode mode)
+{
+	if (mode & HRTIMER_MODE_REL)
+		tim += ktime_get();
+	timer->node.expires = tim;
+	timer->linuxkpi.callback = hrtimer_fire;
+	timer_add(&timer->linuxkpi, tim);
+}
+
+
+int
+hrtimer_cancel(struct hrtimer *timer)
+{
+	return timer_remove_sync(&timer->linuxkpi);
+}
+
+
+int
+hrtimer_try_to_cancel(struct hrtimer *timer)
+{
+	if (timer_running(&timer->linuxkpi))
+		return -1;
+	return timer_remove(&timer->linuxkpi);
+}
+
+
+bool
+hrtimer_active(const struct hrtimer *timer)
+{
+	return READ_ONCE(timer->linuxkpi.queued)
+		|| timer_running((struct linuxkpi_timer *)&timer->linuxkpi);
+}
+
+
+u64
+hrtimer_forward_now(struct hrtimer *timer, ktime_t interval)
+{
+	ktime_t now = ktime_get();
+	if (timer->node.expires > now || interval <= 0)
+		return 0;
+	u64 overruns = (now - timer->node.expires) / interval + 1;
+	timer->node.expires += overruns * interval;
+	return overruns;
+}
+
+
+//	#pragma mark - irq_work
+
+
+static void
+irq_work_fire(struct linuxkpi_timer *base)
+{
+	struct irq_work *work = container_of(base, struct irq_work, linuxkpi);
+	atomic_set(&work->flags, 0);
+	work->func(work);
+}
+
+
+bool
+irq_work_queue(struct irq_work *work)
+{
+	if (atomic_cmpxchg(&work->flags, 0, 1) != 0)
+		return false;
+	work->linuxkpi.callback = irq_work_fire;
+	if (work->linuxkpi.entry.next == NULL)
+		INIT_LIST_HEAD(&work->linuxkpi.entry);
+	timer_add(&work->linuxkpi, 0);
+	return true;
+}
+
+
+void
+irq_work_sync(struct irq_work *work)
+{
+	wait_event(sTimerDone, atomic_read(&work->flags) == 0
+		&& !timer_running(&work->linuxkpi));
+}
+
+
+//	#pragma mark - workqueues
+
+
+#define WORK_PENDING_BIT	0
+#define MAX_WORKERS			4
+
+struct worker {
+	struct workqueue_struct *wq;
+	struct task_struct *task;
+	struct work_struct *current_work;
+	work_func_t current_func;
+	unsigned long current_seq;
+};
+
+struct workqueue_struct {
+	char name[32];
+	unsigned int flags;
+	spinlock_t lock;
+	struct list_head works;
+	struct wait_queue_head more_work;
+	struct wait_queue_head work_done;
+	int worker_count;
+	struct worker workers[MAX_WORKERS];
+	bool dying;
+};
+
+struct workqueue_struct *system_wq;
+struct workqueue_struct *system_highpri_wq;
+struct workqueue_struct *system_long_wq;
+struct workqueue_struct *system_unbound_wq;
+struct workqueue_struct *system_freezable_wq;
+struct workqueue_struct *system_power_efficient_wq;
+
+static atomic_long_t sWorkSeq = ATOMIC_LONG_INIT(0);
+
+
+static bool
+work_running_locked(struct workqueue_struct *wq, struct work_struct *work)
+{
+	for (int i = 0; i < wq->worker_count; i++) {
+		if (wq->workers[i].current_work == work
+			&& wq->workers[i].current_func == work->func)
+			return true;
+	}
+	return false;
+}
+
+
+/*!	The first queued work that is not already running on another worker:
+	Linux never runs one work item twice at the same time.
+*/
+static struct work_struct *
+next_work_locked(struct workqueue_struct *wq)
+{
+	struct work_struct *work;
+	list_for_each_entry(work, &wq->works, entry) {
+		if (!work_running_locked(wq, work))
+			return work;
+	}
+	return NULL;
+}
+
+
+static bool
+worker_has_work(struct workqueue_struct *wq)
+{
+	spin_lock(&wq->lock);
+	bool hasWork = wq->dying || next_work_locked(wq) != NULL;
+	spin_unlock(&wq->lock);
+	return hasWork;
+}
+
+
+static int
+worker_thread(void *data)
+{
+	struct worker *worker = data;
+	struct workqueue_struct *wq = worker->wq;
+
+	for (;;) {
+		// A work that was skipped because it was running elsewhere gets no
+		// wakeup of its own; the timeout picks it up.
+		wait_event_timeout(wq->more_work, worker_has_work(wq), HZ / 10);
+
+		spin_lock(&wq->lock);
+		struct work_struct *work = next_work_locked(wq);
+		if (work == NULL) {
+			bool dying = wq->dying;
+			spin_unlock(&wq->lock);
+			if (dying)
+				break;
+			continue;
+		}
+		list_del_init(&work->entry);
+		// Cleared before the run, so the work may requeue itself.
+		clear_bit(WORK_PENDING_BIT, (unsigned long *)&work->data);
+		worker->current_work = work;
+		worker->current_func = work->func;
+		worker->current_seq = work->linuxkpi_queued_seq;
+		spin_unlock(&wq->lock);
+
+		current->linuxkpi_work = work;
+		// The work may free itself; it is not touched afterwards.
+		worker->current_func(work);
+		current->linuxkpi_work = NULL;
+
+		spin_lock(&wq->lock);
+		worker->current_work = NULL;
+		worker->current_func = NULL;
+		spin_unlock(&wq->lock);
+		wake_up_all(&wq->work_done);
+	}
+	return 0;
+}
+
+
+struct workqueue_struct *
+alloc_workqueue(const char *fmt, unsigned int flags, int max_active, ...)
+{
+	struct workqueue_struct *wq = kzalloc(sizeof(*wq), GFP_KERNEL);
+	if (wq == NULL)
+		return NULL;
+
+	va_list args;
+	va_start(args, max_active);
+	vsnprintf(wq->name, sizeof(wq->name), fmt, args);
+	va_end(args);
+
+	wq->flags = flags;
+	spin_lock_init(&wq->lock);
+	INIT_LIST_HEAD(&wq->works);
+	init_waitqueue_head(&wq->more_work);
+	init_waitqueue_head(&wq->work_done);
+
+	int count = MAX_WORKERS;
+	if ((flags & __WQ_ORDERED) != 0 || max_active == 1)
+		count = 1;
+	else if (max_active > 0 && max_active < count)
+		count = max_active;
+
+	for (int i = 0; i < count; i++) {
+		struct worker *worker = &wq->workers[i];
+		worker->wq = wq;
+		worker->task = kthread_create(worker_thread, worker, "%s", wq->name);
+		if (IS_ERR(worker->task)) {
+			worker->task = NULL;
+			break;
+		}
+		if (flags & WQ_HIGHPRI)
+			sched_set_fifo(worker->task);
+		wq->worker_count++;
+	}
+	if (wq->worker_count == 0) {
+		kfree(wq);
+		return NULL;
+	}
+	for (int i = 0; i < wq->worker_count; i++)
+		wake_up_process(wq->workers[i].task);
+	return wq;
+}
+
+
+static void
+insert_work(struct workqueue_struct *wq, struct work_struct *work)
+{
+	spin_lock(&wq->lock);
+	work->wq = wq;
+	work->linuxkpi_queued_seq = atomic_long_inc_return(&sWorkSeq);
+	list_del_init(&work->entry);
+	list_add_tail(&work->entry, &wq->works);
+	spin_unlock(&wq->lock);
+	wake_up(&wq->more_work);
+}
+
+
+bool
+queue_work_on(int cpu, struct workqueue_struct *wq, struct work_struct *work)
+{
+	if (test_and_set_bit(WORK_PENDING_BIT, (unsigned long *)&work->data))
+		return false;
+	insert_work(wq, work);
+	return true;
+}
+
+
+static void
+delayed_work_timer_fn(struct timer_list *timer)
+{
+	struct delayed_work *dwork = container_of(timer, struct delayed_work,
+		timer);
+	insert_work(dwork->wq, &dwork->work);
+}
+
+
+static void
+start_delayed_work(struct workqueue_struct *wq, struct delayed_work *dwork,
+	unsigned long delay)
+{
+	if (delay == 0) {
+		insert_work(wq, &dwork->work);
+		return;
+	}
+	dwork->wq = wq;
+	dwork->work.wq = wq;
+	dwork->timer.function = delayed_work_timer_fn;
+	mod_timer(&dwork->timer, jiffies + delay);
+}
+
+
+bool
+queue_delayed_work_on(int cpu, struct workqueue_struct *wq,
+	struct delayed_work *dwork, unsigned long delay)
+{
+	if (test_and_set_bit(WORK_PENDING_BIT,
+			(unsigned long *)&dwork->work.data))
+		return false;
+	start_delayed_work(wq, dwork, delay);
+	return true;
+}
+
+
+/*!	Takes a pending work off its queue and its timer. Returns whether it
+	was pending.
+*/
+static bool
+grab_pending(struct work_struct *work, struct timer_list *timer)
+{
+	if (timer != NULL)
+		del_timer_sync(timer);
+	struct workqueue_struct *wq = work->wq;
+	if (wq == NULL)
+		return test_and_clear_bit(WORK_PENDING_BIT,
+			(unsigned long *)&work->data);
+	spin_lock(&wq->lock);
+	list_del_init(&work->entry);
+	bool pending = test_and_clear_bit(WORK_PENDING_BIT,
+		(unsigned long *)&work->data);
+	spin_unlock(&wq->lock);
+	return pending;
+}
+
+
+bool
+mod_delayed_work_on(int cpu, struct workqueue_struct *wq,
+	struct delayed_work *dwork, unsigned long delay)
+{
+	bool pending = grab_pending(&dwork->work, &dwork->timer);
+	set_bit(WORK_PENDING_BIT, (unsigned long *)&dwork->work.data);
+	start_delayed_work(wq, dwork, delay);
+	return pending;
+}
+
+
+static bool
+flush_done(struct workqueue_struct *wq, struct work_struct *work,
+	unsigned long target)
+{
+	spin_lock(&wq->lock);
+	bool done = true;
+	if (test_bit(WORK_PENDING_BIT, (unsigned long *)&work->data)
+		&& work->linuxkpi_queued_seq <= target)
+		done = false;
+	for (int i = 0; i < wq->worker_count && done; i++) {
+		if (wq->workers[i].current_work == work
+			&& wq->workers[i].current_seq <= target)
+			done = false;
+	}
+	spin_unlock(&wq->lock);
+	return done;
+}
+
+
+bool
+flush_work(struct work_struct *work)
+{
+	struct workqueue_struct *wq = work->wq;
+	if (wq == NULL)
+		return false;
+
+	spin_lock(&wq->lock);
+	unsigned long target = 0;
+	if (test_bit(WORK_PENDING_BIT, (unsigned long *)&work->data))
+		target = work->linuxkpi_queued_seq;
+	for (int i = 0; i < wq->worker_count; i++) {
+		if (wq->workers[i].current_work == work)
+			target = max(target, wq->workers[i].current_seq);
+	}
+	spin_unlock(&wq->lock);
+	if (target == 0)
+		return false;
+
+	wait_event(wq->work_done, flush_done(wq, work, target));
+	return true;
+}
+
+
+static void
+wait_for_running(struct work_struct *work)
+{
+	struct workqueue_struct *wq = work->wq;
+	if (wq == NULL || current->linuxkpi_work == work)
+		return;
+	unsigned long target = atomic_long_read(&sWorkSeq);
+	wait_event(wq->work_done, flush_done(wq, work, target));
+}
+
+
+bool
+cancel_work(struct work_struct *work)
+{
+	return grab_pending(work, NULL);
+}
+
+
+bool
+cancel_work_sync(struct work_struct *work)
+{
+	bool pending = grab_pending(work, NULL);
+	wait_for_running(work);
+	return pending;
+}
+
+
+bool
+flush_delayed_work(struct delayed_work *dwork)
+{
+	if (del_timer_sync(&dwork->timer))
+		insert_work(dwork->wq, &dwork->work);
+	return flush_work(&dwork->work);
+}
+
+
+bool
+cancel_delayed_work(struct delayed_work *dwork)
+{
+	return grab_pending(&dwork->work, &dwork->timer);
+}
+
+
+bool
+cancel_delayed_work_sync(struct delayed_work *dwork)
+{
+	bool pending = grab_pending(&dwork->work, &dwork->timer);
+	wait_for_running(&dwork->work);
+	return pending;
+}
+
+
+bool
+work_pending(const struct work_struct *work)
+{
+	return test_bit(WORK_PENDING_BIT, (const unsigned long *)&work->data);
+}
+
+
+bool
+work_busy(struct work_struct *work)
+{
+	struct workqueue_struct *wq = work->wq;
+	if (work_pending(work))
+		return true;
+	if (wq == NULL)
+		return false;
+	spin_lock(&wq->lock);
+	bool running = work_running_locked(wq, work);
+	spin_unlock(&wq->lock);
+	return running;
+}
+
+
+struct work_struct *
+current_work(void)
+{
+	return current->linuxkpi_work;
+}
+
+
+static bool
+workqueue_flushed(struct workqueue_struct *wq, unsigned long target)
+{
+	spin_lock(&wq->lock);
+	bool done = true;
+	struct work_struct *work;
+	list_for_each_entry(work, &wq->works, entry) {
+		if (work->linuxkpi_queued_seq <= target) {
+			done = false;
+			break;
+		}
+	}
+	for (int i = 0; i < wq->worker_count && done; i++) {
+		if (wq->workers[i].current_work != NULL
+			&& wq->workers[i].current_seq <= target)
+			done = false;
+	}
+	spin_unlock(&wq->lock);
+	return done;
+}
+
+
+void
+flush_workqueue(struct workqueue_struct *wq)
+{
+	unsigned long target = atomic_long_read(&sWorkSeq);
+	wait_event(wq->work_done, workqueue_flushed(wq, target));
+}
+
+
+static bool
+workqueue_idle(struct workqueue_struct *wq)
+{
+	return workqueue_flushed(wq, ULONG_MAX);
+}
+
+
+void
+drain_workqueue(struct workqueue_struct *wq)
+{
+	wait_event(wq->work_done, workqueue_idle(wq));
+}
+
+
+void
+destroy_workqueue(struct workqueue_struct *wq)
+{
+	drain_workqueue(wq);
+	spin_lock(&wq->lock);
+	wq->dying = true;
+	spin_unlock(&wq->lock);
+	wake_up_all(&wq->more_work);
+	for (int i = 0; i < wq->worker_count; i++)
+		kthread_stop(wq->workers[i].task);
+	kfree(wq);
+}
+
+
+void
+linuxkpi_init_work(struct work_struct *work, work_func_t func)
+{
+	memset(work, 0, sizeof(*work));
+	INIT_LIST_HEAD(&work->entry);
+	work->func = func;
+}
+
+
+void
+linuxkpi_init_delayed_work(struct delayed_work *work, work_func_t func)
+{
+	linuxkpi_init_work(&work->work, func);
+	timer_setup(&work->timer, delayed_work_timer_fn, 0);
+	work->wq = NULL;
+	work->cpu = 0;
+}
+
+
+//	#pragma mark - kthread workers
+
+
+static bool
+kthread_worker_has_work(struct kthread_worker *worker)
+{
+	spin_lock(&worker->lock);
+	bool hasWork = !list_empty(&worker->work_list);
+	spin_unlock(&worker->lock);
+	return hasWork || kthread_should_stop();
+}
+
+
+static DECLARE_WAIT_QUEUE_HEAD(sKthreadWorkerWait);
+
+
+static int
+kthread_worker_fn(void *data)
+{
+	struct kthread_worker *worker = data;
+	for (;;) {
+		wait_event(sKthreadWorkerWait, kthread_worker_has_work(worker));
+		if (kthread_should_stop())
+			break;
+
+		spin_lock(&worker->lock);
+		struct kthread_work *work = list_first_entry_or_null(
+			&worker->work_list, struct kthread_work, node);
+		if (work != NULL)
+			list_del_init(&work->node);
+		worker->current_work = work;
+		spin_unlock(&worker->lock);
+
+		if (work != NULL)
+			work->func(work);
+
+		spin_lock(&worker->lock);
+		worker->current_work = NULL;
+		spin_unlock(&worker->lock);
+		wake_up_all(&sKthreadWorkerWait);
+	}
+	return 0;
+}
+
+
+struct kthread_worker *
+kthread_create_worker(unsigned int flags, const char namefmt[], ...)
+{
+	struct kthread_worker *worker = kzalloc(sizeof(*worker), GFP_KERNEL);
+	if (worker == NULL)
+		return ERR_PTR(-ENOMEM);
+	spin_lock_init(&worker->lock);
+	INIT_LIST_HEAD(&worker->work_list);
+	INIT_LIST_HEAD(&worker->delayed_work_list);
+
+	char name[TASK_COMM_LEN];
+	va_list args;
+	va_start(args, namefmt);
+	vsnprintf(name, sizeof(name), namefmt, args);
+	va_end(args);
+
+	struct task_struct *task = kthread_create(kthread_worker_fn, worker, "%s",
+		name);
+	if (IS_ERR(task)) {
+		kfree(worker);
+		return ERR_CAST(task);
+	}
+	worker->task = task;
+	wake_up_process(task);
+	return worker;
+}
+
+
+void
+kthread_destroy_worker(struct kthread_worker *worker)
+{
+	kthread_flush_worker(worker);
+	kthread_stop(worker->task);
+	kfree(worker);
+}
+
+
+bool
+kthread_queue_work(struct kthread_worker *worker, struct kthread_work *work)
+{
+	spin_lock(&worker->lock);
+	bool queued = list_empty(&work->node);
+	if (queued) {
+		work->worker = worker;
+		list_add_tail(&work->node, &worker->work_list);
+	}
+	spin_unlock(&worker->lock);
+	if (queued)
+		wake_up_all(&sKthreadWorkerWait);
+	return queued;
+}
+
+
+static bool
+kthread_worker_idle(struct kthread_worker *worker, struct kthread_work *work)
+{
+	spin_lock(&worker->lock);
+	bool idle;
+	if (work != NULL)
+		idle = list_empty(&work->node) && worker->current_work != work;
+	else
+		idle = list_empty(&worker->work_list) && worker->current_work == NULL;
+	spin_unlock(&worker->lock);
+	return idle;
+}
+
+
+void
+kthread_flush_work(struct kthread_work *work)
+{
+	struct kthread_worker *worker = work->worker;
+	if (worker == NULL || current == worker->task)
+		return;
+	wait_event(sKthreadWorkerWait, kthread_worker_idle(worker, work));
+}
+
+
+void
+kthread_flush_worker(struct kthread_worker *worker)
+{
+	if (current == worker->task)
+		return;
+	wait_event(sKthreadWorkerWait, kthread_worker_idle(worker, NULL));
+}
+
+
+bool
+kthread_cancel_work_sync(struct kthread_work *work)
+{
+	struct kthread_worker *worker = work->worker;
+	if (worker == NULL)
+		return false;
+	spin_lock(&worker->lock);
+	bool pending = !list_empty(&work->node);
+	list_del_init(&work->node);
+	spin_unlock(&worker->lock);
+	kthread_flush_work(work);
+	return pending;
+}
+
+
+static void
+kthread_delayed_work_timer_fn(struct timer_list *timer)
+{
+	struct kthread_delayed_work *dwork = container_of(timer,
+		struct kthread_delayed_work, timer);
+	kthread_queue_work(dwork->work.worker, &dwork->work);
+}
+
+
+bool
+kthread_queue_delayed_work(struct kthread_worker *worker,
+	struct kthread_delayed_work *dwork, unsigned long delay)
+{
+	if (!list_empty(&dwork->work.node) || timer_pending(&dwork->timer))
+		return false;
+	dwork->work.worker = worker;
+	if (delay == 0)
+		return kthread_queue_work(worker, &dwork->work);
+	timer_setup(&dwork->timer, kthread_delayed_work_timer_fn, 0);
+	mod_timer(&dwork->timer, jiffies + delay);
+	return true;
+}
+
+
+bool
+kthread_mod_delayed_work(struct kthread_worker *worker,
+	struct kthread_delayed_work *dwork, unsigned long delay)
+{
+	bool pending = kthread_cancel_delayed_work_sync(dwork);
+	kthread_queue_delayed_work(worker, dwork, delay);
+	return pending;
+}
+
+
+bool
+kthread_cancel_delayed_work_sync(struct kthread_delayed_work *dwork)
+{
+	bool pending = del_timer_sync(&dwork->timer);
+	return kthread_cancel_work_sync(&dwork->work) || pending;
+}
+
+
+//	#pragma mark - init
+
+
+static int __init
+linuxkpi_timer_init(void)
+{
+	sTimerTask = kthread_create(timer_thread, NULL, "linux timers");
+	if (IS_ERR(sTimerTask)) {
+		int error = PTR_ERR(sTimerTask);
+		sTimerTask = NULL;
+		return error;
+	}
+	sched_set_fifo(sTimerTask);
+	wake_up_process(sTimerTask);
+
+	system_wq = alloc_workqueue("events", 0, 0);
+	system_highpri_wq = alloc_workqueue("events_highpri", WQ_HIGHPRI, 0);
+	system_long_wq = alloc_workqueue("events_long", 0, 0);
+	system_unbound_wq = alloc_workqueue("events_unbound", WQ_UNBOUND, 0);
+	system_freezable_wq = system_wq;
+	system_power_efficient_wq = system_wq;
+	if (system_wq == NULL || system_highpri_wq == NULL
+		|| system_long_wq == NULL || system_unbound_wq == NULL)
+		return -ENOMEM;
+	return 0;
+}
+core_initcall(linuxkpi_timer_init);
diff --git a/src/libs/compat/linuxkpi/linux/vsprintf.c b/src/libs/compat/linuxkpi/linux/vsprintf.c
new file mode 100644
index 0000000000..15376bca65
--- /dev/null
+++ b/src/libs/compat/linuxkpi/linux/vsprintf.c
@@ -0,0 +1,483 @@
+/*
+ * Copyright 2026, hans2294.
+ * Distributed under the terms of the MIT License.
+ */
+
+
+/*!	printf-style formatting with the Linux kernel's extensions: %pV (a nested
+	struct va_format), %pa[p|d], %ph and %*ph, %pe, %p4cc, and the
+	symbol/address forms (%pS, %ps, %pB, %pK, %px), which print the address.
+*/
+
+
+#include <linux/kernel.h>
+#include <linux/string.h>
+#include <linux/err.h>
+#include <linux/slab.h>
+#include <linux/ctype.h>
+#include <linux/sprintf.h>
+
+
+struct output {
+	char *buffer;
+	size_t size;
+	size_t length;		/* what the full output would need */
+};
+
+
+static void
+put_char(struct output *out, char c)
+{
+	if (out->length + 1 < out->size)
+		out->buffer[out->length] = c;
+	out->length++;
+}
+
+
+static void
+put_string(struct output *out, const char *s, int width, int precision,
+	bool left)
+{
+	size_t length = s != NULL ? strnlen(s, precision >= 0 ? (size_t)precision
+		: SIZE_MAX) : 6;
+	if (s == NULL)
+		s = "(null)";
+	int pad = width > (int)length ? width - (int)length : 0;
+	if (!left)
+		while (pad-- > 0) put_char(out, ' ');
+	for (size_t i = 0; i < length; i++)
+		put_char(out, s[i]);
+	if (left)
+		while (pad-- > 0) put_char(out, ' ');
+}
+
+
+#define FLAG_LEFT	0x01
+#define FLAG_PLUS	0x02
+#define FLAG_SPACE	0x04
+#define FLAG_ALT	0x08
+#define FLAG_ZERO	0x10
+#define FLAG_UPPER	0x20
+
+
+static void
+put_number(struct output *out, unsigned long long value, bool negative,
+	unsigned base, int width, int precision, unsigned flags)
+{
+	const char *digits = (flags & FLAG_UPPER) ? "0123456789ABCDEF"
+		: "0123456789abcdef";
+	char buffer[24];
+	int length = 0;
+	do {
+		buffer[length++] = digits[value % base];
+		value /= base;
+	} while (value != 0);
+
+	char sign = 0;
+	if (negative)
+		sign = '-';
+	else if (flags & FLAG_PLUS)
+		sign = '+';
+	else if (flags & FLAG_SPACE)
+		sign = ' ';
+
+	const char *prefix = "";
+	if ((flags & FLAG_ALT) && base == 16)
+		prefix = (flags & FLAG_UPPER) ? "0X" : "0x";
+	else if ((flags & FLAG_ALT) && base == 8 && buffer[length - 1] != '0')
+		prefix = "0";
+
+	int zeros = precision > length ? precision - length : 0;
+	int total = length + zeros + (sign ? 1 : 0) + (int)strlen(prefix);
+	int pad = width > total ? width - total : 0;
+	if ((flags & FLAG_ZERO) && !(flags & FLAG_LEFT) && precision < 0) {
+		zeros += pad;
+		pad = 0;
+	}
+
+	if (!(flags & FLAG_LEFT))
+		while (pad-- > 0) put_char(out, ' ');
+	if (sign)
+		put_char(out, sign);
+	for (const char *p = prefix; *p; p++)
+		put_char(out, *p);
+	while (zeros-- > 0)
+		put_char(out, '0');
+	while (length > 0)
+		put_char(out, buffer[--length]);
+	if (flags & FLAG_LEFT)
+		while (pad-- > 0) put_char(out, ' ');
+}
+
+
+static const char *
+error_name(long error)
+{
+	switch (-error) {
+		case EPERM: return "-EPERM";
+		case ENOENT: return "-ENOENT";
+		case EINTR: return "-EINTR";
+		case EIO: return "-EIO";
+		case ENXIO: return "-ENXIO";
+		case E2BIG: return "-E2BIG";
+		case EBADF: return "-EBADF";
+		case EAGAIN: return "-EAGAIN";
+		case ENOMEM: return "-ENOMEM";
+		case EACCES: return "-EACCES";
+		case EFAULT: return "-EFAULT";
+		case EBUSY: return "-EBUSY";
+		case EEXIST: return "-EEXIST";
+		case ENODEV: return "-ENODEV";
+		case EINVAL: return "-EINVAL";
+		case ENOSPC: return "-ENOSPC";
+		case ERANGE: return "-ERANGE";
+		case EDEADLK: return "-EDEADLK";
+		case ENOSYS: return "-ENOSYS";
+		case ENODATA: return "-ENODATA";
+		case ETIME: return "-ETIME";
+		case EPROTO: return "-EPROTO";
+		case EOVERFLOW: return "-EOVERFLOW";
+		case EOPNOTSUPP: return "-EOPNOTSUPP";
+		case ETIMEDOUT: return "-ETIMEDOUT";
+		case ECANCELED: return "-ECANCELED";
+		case EALREADY: return "-EALREADY";
+		case EHWPOISON: return "-EHWPOISON";
+		case ERESTARTSYS: return "-ERESTARTSYS";
+		case EPROBE_DEFER: return "-EPROBE_DEFER";
+		case ENOTSUPP: return "-ENOTSUPP";
+	}
+	return NULL;
+}
+
+
+/*!	Handles what follows "%p"; returns the format past the extension. */
+static const char *
+put_pointer(struct output *out, const char *fmt, void *pointer, int width,
+	int precision, unsigned flags)
+{
+	char buffer[48];
+
+	switch (*fmt) {
+		case 'V':
+		{
+			struct va_format *vaf = pointer;
+			va_list copy;
+			va_copy(copy, *vaf->va);
+			size_t start = out->length;
+			size_t room = start < out->size ? out->size - start : 0;
+			int length = vsnprintf(room ? out->buffer + start : NULL,
+				room, vaf->fmt, copy);
+			va_end(copy);
+			out->length = start + length;
+			return fmt + 1;
+		}
+
+		case 'a':
+		{
+			// %pa: phys_addr_t, %pad: dma_addr_t, %pap: phys_addr_t
+			unsigned long long value = *(u64 *)pointer;
+			if (fmt[1] == 'd' || fmt[1] == 'p')
+				fmt++;
+			put_number(out, value, false, 16, 18, -1,
+				FLAG_ALT | FLAG_ZERO);
+			return fmt + 1;
+		}
+
+		case 'h':
+		{
+			// hex dump; separator: C ':', D '-', N none, default ' '
+			char separator = ' ';
+			fmt++;
+			if (*fmt == 'C' || *fmt == 'D' || *fmt == 'N') {
+				separator = *fmt == 'C' ? ':' : *fmt == 'D' ? '-' : 0;
+				fmt++;
+			}
+			int count = width > 0 ? width : 1;
+			const u8 *bytes = pointer;
+			for (int i = 0; i < count && i < 64; i++) {
+				if (i > 0 && separator)
+					put_char(out, separator);
+				put_char(out, hex_asc_hi(bytes[i]));
+				put_char(out, hex_asc_lo(bytes[i]));
+			}
+			return fmt;
+		}
+
+		case 'e':
+		{
+			long error = (long)pointer;
+			const char *name = IS_ERR(pointer) ? error_name(error) : NULL;
+			if (name != NULL)
+				put_string(out, name, width, -1, flags & FLAG_LEFT);
+			else
+				put_number(out, -error, true, 10, width, -1, flags);
+			return fmt + 1;
+		}
+
+		case '4':
+			if (fmt[1] == 'c' && fmt[2] == 'c') {
+				u32 code = *(u32 *)pointer;
+				for (int i = 0; i < 4; i++) {
+					char c = (code >> (i * 8)) & 0x7f;
+					buffer[i] = isprint(c) ? c : '.';
+				}
+				snprintf(buffer + 4, sizeof(buffer) - 4, " %s-endian (0x%08x)",
+					(code & (1U << 31)) ? "big" : "little", code);
+				put_string(out, buffer, width, -1, flags & FLAG_LEFT);
+				return fmt + 3;
+			}
+			break;
+
+		case 'S': case 's': case 'B': case 'K': case 'x':
+		case 'F': case 'f': case 'R': case 'r': case 'I': case 'i':
+		case 'M': case 'm': case 'U': case 'D': case 'd': case 'g':
+		case 'G': case 'O': case 'C': case 'E': case 'N': case 'X':
+		case 'b':
+			// Extensions we cannot render: show the address.
+			put_number(out, (unsigned long)pointer, false, 16, width, -1,
+				flags | FLAG_ALT);
+			fmt++;
+			// skip the qualifiers some of these take
+			while (isalnum(*fmt) && (*fmt == 'R' || *fmt == 'b' || *fmt == 'l'
+					|| *fmt == 'h' || *fmt == 'n' || *fmt == 'c' || *fmt == 'f'))
+				fmt++;
+			return fmt;
+	}
+
+	put_number(out, (unsigned long)pointer, false, 16, width, -1,
+		flags | FLAG_ALT);
+	return fmt;
+}
+
+
+int
+vsnprintf(char *buffer, size_t size, const char *fmt, va_list args)
+{
+	struct output out = { buffer, size, 0 };
+
+	while (*fmt) {
+		if (*fmt != '%') {
+			put_char(&out, *fmt++);
+			continue;
+		}
+		fmt++;
+
+		unsigned flags = 0;
+		for (;; fmt++) {
+			if (*fmt == '-') flags |= FLAG_LEFT;
+			else if (*fmt == '+') flags |= FLAG_PLUS;
+			else if (*fmt == ' ') flags |= FLAG_SPACE;
+			else if (*fmt == '#') flags |= FLAG_ALT;
+			else if (*fmt == '0') flags |= FLAG_ZERO;
+			else break;
+		}
+
+		int width = -1;
+		if (*fmt == '*') {
+			width = va_arg(args, int);
+			if (width < 0) {
+				flags |= FLAG_LEFT;
+				width = -width;
+			}
+			fmt++;
+		} else if (isdigit(*fmt)) {
+			width = 0;
+			while (isdigit(*fmt))
+				width = width * 10 + (*fmt++ - '0');
+		}
+
+		int precision = -1;
+		if (*fmt == '.') {
+			fmt++;
+			precision = 0;
+			if (*fmt == '*') {
+				precision = va_arg(args, int);
+				fmt++;
+			} else {
+				while (isdigit(*fmt))
+					precision = precision * 10 + (*fmt++ - '0');
+			}
+		}
+
+		int size_modifier = 0;	// 'H' hh, 'h', 'l', 'L' ll, 'z', 't', 'j'
+		if (*fmt == 'h') {
+			size_modifier = fmt[1] == 'h' ? 'H' : 'h';
+			fmt += fmt[1] == 'h' ? 2 : 1;
+		} else if (*fmt == 'l') {
+			size_modifier = fmt[1] == 'l' ? 'L' : 'l';
+			fmt += fmt[1] == 'l' ? 2 : 1;
+		} else if (*fmt == 'z' || *fmt == 'Z' || *fmt == 't' || *fmt == 'j') {
+			size_modifier = *fmt == 'Z' ? 'z' : *fmt;
+			fmt++;
+		} else if (*fmt == 'q' || *fmt == 'L') {
+			size_modifier = 'L';
+			fmt++;
+		}
+
+		char conversion = *fmt;
+		if (conversion == '\0')
+			break;
+		fmt++;
+
+		unsigned base = 10;
+		bool is_signed = false;
+		switch (conversion) {
+			case '%':
+				put_char(&out, '%');
+				continue;
+			case 'c':
+				if (!(flags & FLAG_LEFT))
+					while (width-- > 1) put_char(&out, ' ');
+				put_char(&out, (char)va_arg(args, int));
+				if (flags & FLAG_LEFT)
+					while (width-- > 1) put_char(&out, ' ');
+				continue;
+			case 's':
+				put_string(&out, va_arg(args, const char *), width, precision,
+					flags & FLAG_LEFT);
+				continue;
+			case 'p':
+				fmt = put_pointer(&out, fmt, va_arg(args, void *), width,
+					precision, flags);
+				continue;
+			case 'n':
+				(void)va_arg(args, void *);
+				continue;
+			case 'd':
+			case 'i':
+				is_signed = true;
+				break;
+			case 'u':
+				break;
+			case 'X':
+				flags |= FLAG_UPPER;
+				base = 16;
+				break;
+			case 'x':
+				base = 16;
+				break;
+			case 'o':
+				base = 8;
+				break;
+			default:
+				put_char(&out, '%');
+				put_char(&out, conversion);
+				continue;
+		}
+
+		unsigned long long value;
+		bool negative = false;
+		if (is_signed) {
+			long long signedValue;
+			switch (size_modifier) {
+				case 'H': signedValue = (signed char)va_arg(args, int); break;
+				case 'h': signedValue = (short)va_arg(args, int); break;
+				case 'l': signedValue = va_arg(args, long); break;
+				case 'L': signedValue = va_arg(args, long long); break;
+				case 'z': case 't': case 'j':
+					signedValue = va_arg(args, long); break;
+				default: signedValue = va_arg(args, int); break;
+			}
+			negative = signedValue < 0;
+			value = negative ? -(unsigned long long)signedValue : signedValue;
+		} else {
+			switch (size_modifier) {
+				case 'H': value = (unsigned char)va_arg(args, unsigned int); break;
+				case 'h': value = (unsigned short)va_arg(args, unsigned int); break;
+				case 'l': value = va_arg(args, unsigned long); break;
+				case 'L': value = va_arg(args, unsigned long long); break;
+				case 'z': case 't': case 'j':
+					value = va_arg(args, unsigned long); break;
+				default: value = va_arg(args, unsigned int); break;
+			}
+		}
+		put_number(&out, value, negative, base, width, precision, flags);
+	}
+
+	if (out.size > 0)
+		out.buffer[out.length < out.size ? out.length : out.size - 1] = '\0';
+	return out.length;
+}
+
+
+int
+vscnprintf(char *buffer, size_t size, const char *fmt, va_list args)
+{
+	if (size == 0)
+		return 0;
+	int length = vsnprintf(buffer, size, fmt, args);
+	return length < (int)size ? length : (int)size - 1;
+}
+
+
+int
+snprintf(char *buffer, size_t size, const char *fmt, ...)
+{
+	va_list args;
+	va_start(args, fmt);
+	int length = vsnprintf(buffer, size, fmt, args);
+	va_end(args);
+	return length;
+}
+
+
+int
+scnprintf(char *buffer, size_t size, const char *fmt, ...)
+{
+	va_list args;
+	va_start(args, fmt);
+	int length = vscnprintf(buffer, size, fmt, args);
+	va_end(args);
+	return length;
+}
+
+
+int
+vsprintf(char *buffer, const char *fmt, va_list args)
+{
+	return vsnprintf(buffer, INT_MAX, fmt, args);
+}
+
+
+int
+sprintf(char *buffer, const char *fmt, ...)
+{
+	va_list args;
+	va_start(args, fmt);
+	int length = vsnprintf(buffer, INT_MAX, fmt, args);
+	va_end(args);
+	return length;
+}
+
+
+char *
+kvasprintf(gfp_t gfp, const char *fmt, va_list args)
+{
+	va_list copy;
+	va_copy(copy, args);
+	int length = vsnprintf(NULL, 0, fmt, copy);
+	va_end(copy);
+
+	char *buffer = kmalloc(length + 1, gfp);
+	if (buffer != NULL)
+		vsnprintf(buffer, length + 1, fmt, args);
+	return buffer;
+}
+
+
+const char *
+kvasprintf_const(gfp_t gfp, const char *fmt, va_list args)
+{
+	return kvasprintf(gfp, fmt, args);
+}
+
+
+char *
+kasprintf(gfp_t gfp, const char *fmt, ...)
+{
+	va_list args;
+	va_start(args, fmt);
+	char *buffer = kvasprintf(gfp, fmt, args);
+	va_end(args);
+	return buffer;
+}
