+/*
+ * Copyright 2026, hans2294.
+ * Distributed under the terms of the MIT License.
+ */
+#ifndef _LINUXKPI_LINUX_BUG_H
+#define _LINUXKPI_LINUX_BUG_H
+
+#include <linux/compiler.h>
+#include <linux/build_bug.h>
+#include <linux/printk.h>
+
+void __noreturn linuxkpi_bug(const char *file, int line);
+void linuxkpi_warn(const char *file, int line, const char *condition);
+
+#define BUG()			linuxkpi_bug(__FILE__, __LINE__)
+#define BUG_ON(c)		do { if (unlikely(c)) BUG(); } while (0)
+#define WARN(c, fmt...)	({ bool __c = !!(c); if (unlikely(__c)) { \
+	printk(fmt); linuxkpi_warn(__FILE__, __LINE__, #c); } unlikely(__c); })
+#define WARN_ON(c)		({ bool __c = !!(c); if (unlikely(__c)) \
+	linuxkpi_warn(__FILE__, __LINE__, #c); unlikely(__c); })
+#define WARN_ONCE(c, fmt...)	({ static bool __warned; bool __c = !!(c); \
+	if (unlikely(__c) && !__warned) { __warned = true; printk(fmt); \
+	linuxkpi_warn(__FILE__, __LINE__, #c); } unlikely(__c); })
+#define WARN_ON_ONCE(c)	({ static bool __warned; bool __c = !!(c); \
+	if (unlikely(__c) && !__warned) { __warned = true; \
+	linuxkpi_warn(__FILE__, __LINE__, #c); } unlikely(__c); })
+#define WARN_TAINT(c, taint, fmt...)	WARN(c, fmt)
+#define WARN_TAINT_ONCE(c, taint, fmt...)	WARN_ONCE(c, fmt)
+#define WARN_ON_SMP(c)	WARN_ON(c)
+
+#endif
