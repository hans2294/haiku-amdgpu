diff --git a/src/libs/compat/linuxkpi/include/linux/sched.h b/src/libs/compat/linuxkpi/include/linux/sched.h
new file mode 100644
index 0000000000..ea52e0cf9b
--- /dev/null
+++ b/src/libs/compat/linuxkpi/include/linux/sched.h
@@ -0,0 +1,108 @@
+/*
+ * Copyright 2026, hans2294.
+ * Distributed under the terms of the MIT License.
+ */
+#ifndef _LINUXKPI_LINUX_SCHED_H
+#define _LINUXKPI_LINUX_SCHED_H
+
+#include <linux/types.h>
+#include <linux/kernel.h>
+#include <linux/bug.h>
+#include <linux/jiffies.h>
+#include <linux/preempt.h>
+#include <linux/irqflags.h>
+#include <linux/list.h>
+#include <linux/refcount.h>
+#include <linux/mm_types_task.h>
+#include <linux/rbtree.h>
+#include <linux/signal.h>
+#include <linux/pid.h>
+
+#define TASK_RUNNING			0x00000000
+#define TASK_INTERRUPTIBLE		0x00000001
+#define TASK_UNINTERRUPTIBLE	0x00000002
+#define TASK_WAKEKILL			0x00000100
+#define TASK_NOLOAD				0x00000400
+#define TASK_KILLABLE			(TASK_WAKEKILL | TASK_UNINTERRUPTIBLE)
+#define TASK_IDLE				(TASK_UNINTERRUPTIBLE | TASK_NOLOAD)
+#define TASK_NORMAL				(TASK_INTERRUPTIBLE | TASK_UNINTERRUPTIBLE)
+#define TASK_COMM_LEN			16
+#define MAX_SCHEDULE_TIMEOUT	LONG_MAX
+#define PF_KTHREAD				0x00200000
+#define PF_MEMALLOC				0x00000800
+#define PF_EXITING				0x00000004
+
+/* One per Haiku thread that ever runs Linux code; linuxkpi owns them. */
+struct task_struct {
+	s32 thread;				/* Haiku thread_id */
+	s32 team;				/* Haiku team_id */
+	unsigned int __state;
+	unsigned int flags;
+	int prio;
+	pid_t pid;
+	pid_t tgid;
+	char comm[TASK_COMM_LEN];
+	struct mm_struct *mm;
+	void *kthread;			/* linuxkpi kthread data */
+	refcount_t usage;
+	struct list_head linuxkpi_link;
+	struct task_struct *linuxkpi_hash_next;
+	int linuxkpi_sem;		/* Haiku semaphore schedule() sleeps on */
+	int linuxkpi_rcu_depth;
+	int linuxkpi_rcu_epoch;
+	struct work_struct *linuxkpi_work;	/* for current_work() */
+	struct pid *linuxkpi_tgid;
+	struct task_struct *group_leader;
+	int exit_code;
+};
+
+struct task_struct *linuxkpi_current(void);
+#define current		linuxkpi_current()
+#define get_current()	linuxkpi_current()
+
+void set_current_state_impl(unsigned int state);
+#define set_current_state(state)	set_current_state_impl(state)
+#define __set_current_state(state)	set_current_state_impl(state)
+#define get_current_state()	(current->__state)
+#define task_is_running(task)	(READ_ONCE((task)->__state) == TASK_RUNNING)
+void schedule(void);
+long schedule_timeout(long timeout);
+long schedule_timeout_interruptible(long timeout);
+long schedule_timeout_uninterruptible(long timeout);
+long schedule_timeout_killable(long timeout);
+void yield(void);
+int wake_up_process(struct task_struct *tsk);
+int wake_up_state(struct task_struct *tsk, unsigned int state);
+int signal_pending(struct task_struct *p);
+int fatal_signal_pending(struct task_struct *p);
+static inline int signal_pending_state(unsigned int state, struct task_struct *p)
+{ return (state & (TASK_INTERRUPTIBLE | TASK_WAKEKILL)) && signal_pending(p); }
+static inline pid_t task_pid_nr(struct task_struct *tsk) { return tsk->pid; }
+static inline pid_t task_tgid_nr(struct task_struct *tsk) { return tsk->tgid; }
+static inline pid_t task_tgid_vnr(struct task_struct *tsk) { return tsk->tgid; }
+static inline pid_t task_pid_vnr(struct task_struct *tsk) { return tsk->pid; }
+#define get_task_comm(buf, tsk)	({ strscpy(buf, (tsk)->comm, sizeof(buf)); buf; })
+void get_task_struct(struct task_struct *t);
+void put_task_struct(struct task_struct *t);
+int sched_setscheduler_nocheck(struct task_struct *p, int policy, const void *param);
+void sched_set_fifo(struct task_struct *p);
+void sched_set_fifo_low(struct task_struct *p);
+void sched_set_normal(struct task_struct *p, int nice);
+#define io_schedule()		schedule()
+#define io_schedule_timeout(t)	schedule_timeout(t)
+#define need_resched()		false
+#define set_freezable()		do { } while (0)
+#define try_to_freeze()		false
+#define freezing(t)			false
+#define TASK_SIZE			(0x00007ffffffff000UL)
+struct pid;
+struct pid *task_tgid(struct task_struct *task);
+struct pid *get_task_pid(struct task_struct *task, int type);
+#define PIDTYPE_PID	0
+#define PIDTYPE_TGID 1
+
+/* As Linux's sched.h brings them along (through seqlock.h and friends) */
+#include <linux/mutex.h>
+#include <linux/wait.h>
+
+#endif
