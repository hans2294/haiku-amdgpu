+
+//	#pragma mark - delays
+
+
+void
+udelay(unsigned long usecs)
+{
+	lkpi_haiku_spin(usecs);
+}
+
+
+void
+ndelay(unsigned long nsecs)
+{
+	lkpi_haiku_spin(DIV_ROUND_UP(nsecs, NSEC_PER_USEC));
