+#define __copy_to_user_inatomic(t, f, n)	copy_to_user(t, f, n)
+#define user_access_begin(p, s)	true
+#define user_access_end()	do { } while (0)
+#define unsafe_put_user(x, p, l)	do { if (put_user(x, p)) goto l; } while (0)
+#define unsafe_get_user(x, p, l)	do { if (get_user(x, p)) goto l; } while (0)
+#define pagefault_disable()	do { } while (0)
+#define pagefault_enable()	do { } while (0)
+int copy_struct_from_user(void *dst, size_t ksize, const void __user *src, size_t usize);
+
+#endif
