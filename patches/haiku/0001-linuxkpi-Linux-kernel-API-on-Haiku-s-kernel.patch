diff --git a/src/libs/compat/linuxkpi/include/linux/workqueue.h b/src/libs/compat/linuxkpi/include/linux/workqueue.h
new file mode 100644
index 0000000000..3bf7f5d251
--- /dev/null
+++ b/src/libs/compat/linuxkpi/include/linux/workqueue.h
@@ -0,0 +1,94 @@
+/*
+ * Copyright 2026, hans2294.
+ * Distributed under the terms of the MIT License.
+ */
+#ifndef _LINUXKPI_LINUX_WORKQUEUE_H
+#define _LINUXKPI_LINUX_WORKQUEUE_H
+
+#include <linux/timer.h>
+#include <linux/bitops.h>
+#include <linux/atomic.h>
+#include <linux/cpumask.h>
+#include <linux/rcupdate.h>
+#include <linux/lockdep.h>
+struct work_struct;
+typedef void (*work_func_t)(struct work_struct *work);
+struct work_struct {
+	atomic_long_t data;
+	struct list_head entry;
+	work_func_t func;
+	struct workqueue_struct *wq;
+	/* flush_work() waits for the run that was queued when it was called */
+	unsigned long linuxkpi_queued_seq;
+};
+struct delayed_work {
+	struct work_struct work;
+	struct timer_list timer;
+	struct workqueue_struct *wq;
+	int cpu;
+};
+struct rcu_work { struct work_struct work; struct rcu_head rcu; struct workqueue_struct *wq; };
+struct workqueue_struct;
+#define WORK_DATA_INIT()	ATOMIC_LONG_INIT(0)
+#define __WORK_INITIALIZER(n, f)	{ .data = WORK_DATA_INIT(), .entry = { &(n).entry, &(n).entry }, .func = (f) }
+#define DECLARE_WORK(n, f)	struct work_struct n = __WORK_INITIALIZER(n, f)
+void linuxkpi_init_work(struct work_struct *work, work_func_t func);
+void linuxkpi_init_delayed_work(struct delayed_work *work, work_func_t func);
+#define INIT_WORK(w, f)			linuxkpi_init_work(w, f)
+#define INIT_WORK_ONSTACK(w, f)	INIT_WORK(w, f)
+#define INIT_DELAYED_WORK(w, f)	linuxkpi_init_delayed_work(w, f)
+#define INIT_DEFERRABLE_WORK(w, f)	INIT_DELAYED_WORK(w, f)
+#define INIT_DELAYED_WORK_ONSTACK(w, f)	INIT_DELAYED_WORK(w, f)
+#define __DELAYED_WORK_INITIALIZER(n, f, tflags) { .work = __WORK_INITIALIZER((n).work, (f)) }
+#define DECLARE_DELAYED_WORK(n, f)	struct delayed_work n = { .work = __WORK_INITIALIZER((n).work, f) }
+#define destroy_work_on_stack(w)	do { } while (0)
+#define destroy_delayed_work_on_stack(w)	do { } while (0)
+static inline struct delayed_work *to_delayed_work(struct work_struct *work)
+{ return container_of(work, struct delayed_work, work); }
+static inline struct rcu_work *to_rcu_work(struct work_struct *work)
+{ return container_of(work, struct rcu_work, work); }
+#define INIT_RCU_WORK(w, f)	INIT_WORK(&(w)->work, (f))
+enum { WQ_UNBOUND = 1 << 1, WQ_FREEZABLE = 1 << 2, WQ_MEM_RECLAIM = 1 << 3, WQ_HIGHPRI = 1 << 4,
+	WQ_CPU_INTENSIVE = 1 << 5, WQ_SYSFS = 1 << 6, WQ_POWER_EFFICIENT = 1 << 7, __WQ_ORDERED = 1 << 17,
+	WQ_MAX_ACTIVE = 512, WQ_DFL_ACTIVE = WQ_MAX_ACTIVE / 2 };
+extern struct workqueue_struct *system_wq;
+extern struct workqueue_struct *system_highpri_wq;
+extern struct workqueue_struct *system_long_wq;
+extern struct workqueue_struct *system_unbound_wq;
+extern struct workqueue_struct *system_freezable_wq;
+extern struct workqueue_struct *system_power_efficient_wq;
+__printf(1, 4) struct workqueue_struct *alloc_workqueue(const char *fmt, unsigned int flags, int max_active, ...);
+#define alloc_ordered_workqueue(fmt, flags, args...) alloc_workqueue(fmt, __WQ_ORDERED | (flags), 1, ##args)
+#define create_workqueue(name)	alloc_workqueue("%s", WQ_MEM_RECLAIM, 1, (name))
+#define create_singlethread_workqueue(name)	alloc_ordered_workqueue("%s", WQ_MEM_RECLAIM, name)
+void destroy_workqueue(struct workqueue_struct *wq);
+bool queue_work_on(int cpu, struct workqueue_struct *wq, struct work_struct *work);
+bool queue_delayed_work_on(int cpu, struct workqueue_struct *wq, struct delayed_work *work, unsigned long delay);
+bool mod_delayed_work_on(int cpu, struct workqueue_struct *wq, struct delayed_work *dwork, unsigned long delay);
+bool queue_rcu_work(struct workqueue_struct *wq, struct rcu_work *rwork);
+void flush_workqueue(struct workqueue_struct *wq);
+void drain_workqueue(struct workqueue_struct *wq);
+bool flush_work(struct work_struct *work);
+bool cancel_work(struct work_struct *work);
+bool cancel_work_sync(struct work_struct *work);
+bool flush_delayed_work(struct delayed_work *dwork);
+bool cancel_delayed_work(struct delayed_work *dwork);
+bool cancel_delayed_work_sync(struct delayed_work *dwork);
+bool flush_rcu_work(struct rcu_work *rwork);
+bool work_pending(const struct work_struct *work);
+bool work_busy(struct work_struct *work);
+#define delayed_work_pending(w)	work_pending(&(w)->work)
+struct work_struct *current_work(void);
+#define WORK_CPU_UNBOUND	64
+#define queue_work_node(node, wq, work)	queue_work(wq, work)
+static inline bool queue_work(struct workqueue_struct *wq, struct work_struct *work) { return queue_work_on(WORK_CPU_UNBOUND, wq, work); }
+static inline bool queue_delayed_work(struct workqueue_struct *wq, struct delayed_work *dwork, unsigned long delay)
+{ return queue_delayed_work_on(WORK_CPU_UNBOUND, wq, dwork, delay); }
+static inline bool mod_delayed_work(struct workqueue_struct *wq, struct delayed_work *dwork, unsigned long delay)
+{ return mod_delayed_work_on(WORK_CPU_UNBOUND, wq, dwork, delay); }
+static inline bool schedule_work(struct work_struct *work) { return queue_work(system_wq, work); }
+static inline bool schedule_delayed_work(struct delayed_work *dwork, unsigned long delay) { return queue_delayed_work(system_wq, dwork, delay); }
+#define flush_scheduled_work()	flush_workqueue(system_wq)
+#define work_on_cpu(cpu, fn, arg)	fn(arg)
+
+#endif
diff --git a/src/libs/compat/linuxkpi/include/linux/ww_mutex.h b/src/libs/compat/linuxkpi/include/linux/ww_mutex.h
new file mode 100644
index 0000000000..5cf15f6180
--- /dev/null
+++ b/src/libs/compat/linuxkpi/include/linux/ww_mutex.h
@@ -0,0 +1,51 @@
+/*
+ * Copyright 2026, hans2294.
+ * Distributed under the terms of the MIT License.
+ */
+#ifndef _LINUXKPI_LINUX_WW_MUTEX_H
+#define _LINUXKPI_LINUX_WW_MUTEX_H
+
+#include <linux/mutex.h>
+#include <linux/lockdep.h>
+
+/* Wound/wait mutexes, as dma-resv and drm_exec use them. */
+struct ww_class {
+	atomic_long_t stamp;
+	const char *acquire_name;
+	const char *mutex_name;
+	unsigned int is_wait_die;
+};
+struct ww_acquire_ctx {
+	struct task_struct *task;
+	unsigned long stamp;
+	unsigned int acquired;
+	unsigned short wounded;
+	unsigned short is_wait_die;
+	struct ww_class *ww_class;
+};
+struct ww_mutex {
+	struct mutex base;
+	struct ww_acquire_ctx *ctx;
+	struct ww_class *ww_class;
+};
+#define __WW_CLASS_INITIALIZER(ww_class, _is_wait_die) \
+	{ .stamp = ATOMIC_LONG_INIT(0), .acquire_name = #ww_class "_acquire", \
+	  .mutex_name = #ww_class "_mutex", .is_wait_die = _is_wait_die }
+#define DEFINE_WD_CLASS(classname) \
+	struct ww_class classname = __WW_CLASS_INITIALIZER(classname, 1)
+#define DEFINE_WW_CLASS(classname) \
+	struct ww_class classname = __WW_CLASS_INITIALIZER(classname, 0)
+void ww_mutex_init(struct ww_mutex *lock, struct ww_class *ww_class);
+void ww_acquire_init(struct ww_acquire_ctx *ctx, struct ww_class *ww_class);
+static inline void ww_acquire_done(struct ww_acquire_ctx *ctx) {}
+void ww_acquire_fini(struct ww_acquire_ctx *ctx);
+int __must_check ww_mutex_lock(struct ww_mutex *lock, struct ww_acquire_ctx *ctx);
+int __must_check ww_mutex_lock_interruptible(struct ww_mutex *lock, struct ww_acquire_ctx *ctx);
+void ww_mutex_lock_slow(struct ww_mutex *lock, struct ww_acquire_ctx *ctx);
+int __must_check ww_mutex_lock_slow_interruptible(struct ww_mutex *lock, struct ww_acquire_ctx *ctx);
+int ww_mutex_trylock(struct ww_mutex *lock, struct ww_acquire_ctx *ctx);
+void ww_mutex_unlock(struct ww_mutex *lock);
+static inline void ww_mutex_destroy(struct ww_mutex *lock) { mutex_destroy(&lock->base); }
+static inline bool ww_mutex_is_locked(struct ww_mutex *lock) { return mutex_is_locked(&lock->base); }
+
+#endif
diff --git a/src/libs/compat/linuxkpi/include/linuxkpi/chrdev.h b/src/libs/compat/linuxkpi/include/linuxkpi/chrdev.h
new file mode 100644
index 0000000000..0c65f6f2e4
--- /dev/null
+++ b/src/libs/compat/linuxkpi/include/linuxkpi/chrdev.h
@@ -0,0 +1,80 @@
+/*
+ * Copyright 2026, hans2294.
+ * Distributed under the terms of the MIT License.
+ */
+#ifndef _LINUXKPI_LINUXKPI_CHRDEV_H
+#define _LINUXKPI_LINUXKPI_CHRDEV_H
+
+/*
+ * Linux character devices for a Haiku driver to publish: every device with
+ * a dev_t that was added, under the path its class gives it (DRM's are
+ * "dri/card0" and "dri/renderD128"). The driver's device hooks call into
+ * the Linux file operations through these. Plain C types only; errors are
+ * negative Linux errno values.
+ */
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Snapshot of the published paths; NULL past the last one. The strings
+ * stay valid until the device goes away. */
+const char *linuxkpi_chrdev_path(int index);
+
+/* Linux open flags (O_ACCMODE, O_NONBLOCK as Linux numbers them) */
+#define LINUXKPI_O_RDONLY	00
+#define LINUXKPI_O_WRONLY	01
+#define LINUXKPI_O_RDWR		02
+#define LINUXKPI_O_NONBLOCK	04000
+
+int linuxkpi_chrdev_open(const char *path, int linuxFlags, void **_cookie);
+/* close(): the file's flush operation */
+void linuxkpi_chrdev_close(void *cookie);
+/* last reference gone: the file's release operation */
+void linuxkpi_chrdev_free(void *cookie);
+long linuxkpi_chrdev_ioctl(void *cookie, unsigned int command, void *argument);
+long linuxkpi_chrdev_read(void *cookie, void *buffer, unsigned long length,
+	long long *position);
+
+/* Maps \a size bytes at the file's \a offset into the calling team, as
+ * mmap() would on Linux; returns the area ID or a negative errno. */
+int linuxkpi_chrdev_mmap(void *cookie, unsigned long long offset,
+	unsigned long long size, int writable, void **_address);
+/* Undoes linuxkpi_chrdev_mmap() for the mapping at \a address */
+int linuxkpi_chrdev_munmap(void *address);
+
+/* Fills a struct linuxkpi_device_info (uapi.h) for the node at \a path */
+struct linuxkpi_device_info;
+int linuxkpi_chrdev_device_info(const char *path,
+	struct linuxkpi_device_info *info);
+
+/* Linux files that are not device nodes (dma-bufs, sync files), which
+ * Linux code hands out as fds. Those are Haiku fds on a node of the
+ * driver's, which the driver provides these for (negative errno values on
+ * failure): reserve opens one in the calling team, install gives it the
+ * file (and the caller's reference), release closes a reserved one again,
+ * get returns the file behind an fd with a new reference, or NULL. */
+int linuxkpi_fd_reserve(int closeOnExec);
+void linuxkpi_fd_install(int fd, void *file);
+void linuxkpi_fd_release(int fd);
+void *linuxkpi_fd_get(int fd);
+
+/* For the driver: references to such files, and the size lseek() to the
+ * end would give (a dma-buf's) */
+void *linuxkpi_file_get(void *cookie);
+void linuxkpi_file_put(void *cookie);
+unsigned long long linuxkpi_file_size(void *cookie);
+
+/* Restricts PCI drivers to these devices (vendor << 16 | device; the
+ * array must stay); without a call they probe every device they match. */
+void linuxkpi_pci_set_allowed_devices(const unsigned int *ids, int count);
+
+/* For linuxkpi's device code */
+struct device;
+void linuxkpi_chrdev_device_added(struct device *dev);
+void linuxkpi_chrdev_device_removed(struct device *dev);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
diff --git a/src/libs/compat/linuxkpi/include/linuxkpi/haiku.h b/src/libs/compat/linuxkpi/include/linuxkpi/haiku.h
new file mode 100644
index 0000000000..e68800e6fa
--- /dev/null
+++ b/src/libs/compat/linuxkpi/include/linuxkpi/haiku.h
@@ -0,0 +1,157 @@
+/*
+ * Copyright 2026, hans2294.
+ * Distributed under the terms of the MIT License.
+ */
+#ifndef _LINUXKPI_LINUXKPI_HAIKU_H
+#define _LINUXKPI_LINUXKPI_HAIKU_H
+
+/*
+ * The Haiku kernel services linuxkpi's Linux side calls, implemented in
+ * linuxkpi/haiku/. Both sides include this, so it uses plain C types only:
+ * IDs are int, times are long long microseconds unless the name says ns,
+ * physical addresses are unsigned long long. Errors are negative Linux
+ * errno values.
+ */
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Output and death */
+void lkpi_haiku_debug_output(const char *text);
+void lkpi_haiku_panic(const char *text) __attribute__((__noreturn__));
+
+/* Memory. lkpi_haiku_alloc() may be called with nowait set where Linux
+ * code asked for GFP_ATOMIC/GFP_NOWAIT. */
+void *lkpi_haiku_alloc(unsigned long size, unsigned long alignment, int nowait);
+void lkpi_haiku_free(void *address);
+/* Wired, physically contiguous kernel memory in its own area */
+void *lkpi_haiku_alloc_contiguous(unsigned long size, int *_area);
+void lkpi_haiku_delete_area(int area);
+/* Physical address of wired kernel memory, 0 if there is none */
+unsigned long long lkpi_haiku_virt_to_phys(const void *address);
+#define LKPI_HAIKU_CACHE_UNCACHED		0
+#define LKPI_HAIKU_CACHE_WRITE_COMBINING	1
+#define LKPI_HAIKU_CACHE_CACHED			2
+void *lkpi_haiku_map_physical(unsigned long long physical, unsigned long size,
+	int cacheMode, int *_area);
+/* One cached, virtually contiguous kernel mapping of single pages */
+void *lkpi_haiku_map_pages(const unsigned long long *physical,
+	unsigned long count, int *_area);
+/* The area a kernel address belongs to, or a negative error */
+int lkpi_haiku_area_for(const void *address);
+void lkpi_haiku_wbinvd_all_cpus(void);
+/* An area in the calling team mapping these pages (adjacent ones are merged
+ * into one range); the area ID, or a negative error. */
+int lkpi_haiku_map_user(const unsigned long long *physical,
+	unsigned long count, int cacheMode, int writable, void **_address);
+void lkpi_haiku_unmap_user(int area);
+/* The calling team's area at a user address, or a negative error */
+int lkpi_haiku_user_area_for(const void *address);
+unsigned long long lkpi_haiku_total_memory(void);
+unsigned long long lkpi_haiku_free_memory(void);
+
+/* Haiku mutexes and rw_locks in Linux structures' opaque storage. A zeroed
+ * one is a valid, unlocked lock. */
+#define LKPI_HAIKU_MUTEX_SIZE	48
+#define LKPI_HAIKU_RWLOCK_SIZE	64
+void lkpi_haiku_mutex_init(void *lock, const char *name);
+void lkpi_haiku_mutex_destroy(void *lock);
+/* 0 or -EINTR */
+int lkpi_haiku_mutex_lock(void *lock, int interruptible);
+int lkpi_haiku_mutex_trylock(void *lock);
+void lkpi_haiku_mutex_unlock(void *lock);
+int lkpi_haiku_mutex_is_locked(void *lock);
+void lkpi_haiku_rwlock_init(void *lock, const char *name);
+void lkpi_haiku_rwlock_destroy(void *lock);
+int lkpi_haiku_rwlock_read_lock(void *lock, int interruptible);
+int lkpi_haiku_rwlock_read_trylock(void *lock);
+void lkpi_haiku_rwlock_read_unlock(void *lock);
+int lkpi_haiku_rwlock_write_lock(void *lock, int interruptible);
+void lkpi_haiku_rwlock_write_unlock(void *lock);
+int lkpi_haiku_rwlock_is_locked(void *lock);
+
+/* Semaphores, the sleep primitive under Linux tasks */
+int lkpi_haiku_sem_create(int count, const char *name);
+void lkpi_haiku_sem_delete(int sem);
+/* timeout < 0 waits forever; 0, -ETIMEDOUT or -EINTR */
+int lkpi_haiku_sem_acquire(int sem, long long timeout, int interruptible);
+/* Does not reschedule, so it may be called with a spinlock held */
+void lkpi_haiku_sem_release(int sem);
+
+/* Threads */
+int lkpi_haiku_thread_current(void);
+int lkpi_haiku_team_current(void);
+int lkpi_haiku_thread_spawn(int (*function)(void *), const char *name,
+	int priority, void *data);
+void lkpi_haiku_thread_resume(int thread);
+int lkpi_haiku_thread_wait(int thread);
+void lkpi_haiku_thread_set_priority(int thread, int priority);
+void lkpi_haiku_thread_name(int thread, char *buffer, unsigned long size);
+void lkpi_haiku_thread_yield(void);
+#define LKPI_HAIKU_PRIORITY_NORMAL		10
+#define LKPI_HAIKU_PRIORITY_URGENT		20
+#define LKPI_HAIKU_PRIORITY_REALTIME	100
+
+/* PCI, through Haiku's PCI bus manager */
+#define LKPI_HAIKU_BAR_IO			0x1
+#define LKPI_HAIKU_BAR_64			0x2
+#define LKPI_HAIKU_BAR_PREFETCH		0x4
+struct lkpi_haiku_pci_device {
+	unsigned char bus, device, function;
+	unsigned char revision, header_type, interrupt_line;
+	unsigned short vendor, device_id;
+	unsigned short subsystem_vendor, subsystem_device;
+	unsigned int class_code;	/* base << 16 | sub << 8 | interface */
+	unsigned long long bar_base[6];
+	unsigned long long bar_size[6];
+	unsigned int bar_flags[6];
+	unsigned long long rom_base, rom_size;
+};
+/* 0, or -ENODEV past the last device */
+int lkpi_haiku_pci_get(int index, struct lkpi_haiku_pci_device *info);
+unsigned int lkpi_haiku_pci_read_config(int bus, int device, int function,
+	int offset, int size);
+void lkpi_haiku_pci_write_config(int bus, int device, int function,
+	int offset, int size, unsigned int value);
+/* One MSI vector; 0 or a negative error */
+int lkpi_haiku_pci_enable_msi(int bus, int device, int function,
+	unsigned int *_vector);
+void lkpi_haiku_pci_disable_msi(int bus, int device, int function);
+
+/* Interrupts: the Haiku handler only releases the semaphore; a Linux
+ * thread waiting on it runs the Linux handler. */
+int lkpi_haiku_irq_install(unsigned int vector, int sem, void **_cookie);
+void lkpi_haiku_irq_remove(unsigned int vector, void *cookie);
+
+/* Firmware, from Haiku's firmware directories. The data is freed with
+ * lkpi_haiku_free(). 0 or -ENOENT/-ENOMEM/-EIO. */
+int lkpi_haiku_read_firmware(const char *name, void **_data,
+	unsigned long *_size);
+
+/* User memory; the number of bytes that could not be copied */
+unsigned long lkpi_haiku_user_copy(void *to, const void *from,
+	unsigned long size);
+
+/* The FPU in kernel code, between interrupts-off brackets */
+void lkpi_haiku_fpu_begin(void);
+void lkpi_haiku_fpu_end(void);
+
+/* A negative Linux errno value as a Haiku status_t */
+int lkpi_haiku_error(int linuxError);
+
+/* Modules linuxkpi got; called at driver unload */
+void lkpi_haiku_shutdown(void);
+
+/* Time */
+long long lkpi_haiku_system_time(void);
+long long lkpi_haiku_system_time_ns(void);
+long long lkpi_haiku_real_time(void);
+void lkpi_haiku_spin(long long microseconds);
+void lkpi_haiku_snooze(long long microseconds);
+int lkpi_haiku_cpu_count(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
diff --git a/src/libs/compat/linuxkpi/include/linuxkpi/uapi.h b/src/libs/compat/linuxkpi/include/linuxkpi/uapi.h
new file mode 100644
index 0000000000..3147808bf6
--- /dev/null
+++ b/src/libs/compat/linuxkpi/include/linuxkpi/uapi.h
@@ -0,0 +1,79 @@
+/*
+ * Copyright 2026, hans2294.
+ * Distributed under the terms of the MIT License.
+ */
+#ifndef _LINUXKPI_LINUXKPI_UAPI_H
+#define _LINUXKPI_LINUXKPI_UAPI_H
+
+/*
+ * What linuxkpi's device nodes offer userspace on top of the Linux
+ * interface: Haiku has no mmap() for devices, so mapping a device's
+ * memory (a DRM buffer at its fake mmap offset, say) is an ioctl that
+ * creates an area in the calling team. Unmap with LINUXKPI_IOCTL_MUNMAP,
+ * not delete_area(): the driver holds a reference for every mapping.
+ *
+ * The commands use Linux's ioctl encoding, type 'L', like the Linux
+ * commands they sit next to.
+ */
+#ifdef __KERNEL__
+#include <linux/types.h>
+#else
+#include <stdint.h>
+#endif
+
+struct linuxkpi_mmap {
+	uint64_t offset;		/* in: as for mmap() on Linux */
+	uint64_t size;			/* in: bytes, page aligned */
+	uint32_t flags;			/* in: LINUXKPI_MMAP_* */
+	int32_t area;			/* out: the new area */
+	uint64_t address;		/* out: where it is mapped */
+};
+
+#define LINUXKPI_MMAP_READ		0x1
+#define LINUXKPI_MMAP_WRITE		0x2
+
+struct linuxkpi_munmap {
+	uint64_t address;		/* in: an address returned by LINUXKPI_IOCTL_MMAP */
+};
+
+/* Which device a node is; answered without opening the Linux file, so it
+ * is cheap (libdrm asks for every node when it enumerates). */
+struct linuxkpi_device_info {
+	uint32_t major;			/* the node's Linux dev_t */
+	uint32_t minor;
+	uint32_t bus;			/* LINUXKPI_BUS_* */
+	uint16_t pci_domain;
+	uint8_t pci_bus;
+	uint8_t pci_device;
+	uint8_t pci_function;
+	uint8_t pci_revision;
+	uint16_t pci_vendor;
+	uint16_t pci_device_id;
+	uint16_t pci_subvendor;
+	uint16_t pci_subdevice;
+	uint16_t _reserved;
+};
+
+/* Linux files that are no device node, like the dma-bufs PRIME hands out,
+ * are fds on linuxkpi's file node (/dev/misc/linuxkpi/file); Linux ioctls
+ * take and return them as on Linux. Haiku's lseek() cannot tell their size,
+ * so LINUXKPI_IOCTL_FILE_SIZE does (lseek(fd, 0, SEEK_END) on Linux). */
+struct linuxkpi_file_size {
+	uint64_t size;			/* out */
+};
+
+#define LINUXKPI_BUS_UNKNOWN	0
+#define LINUXKPI_BUS_PCI		1
+
+#define LINUXKPI_IOC(dir, nr, size) \
+	(((uint32_t)(dir) << 30) | ((uint32_t)(size) << 16) | ('L' << 8) | (nr))
+#define LINUXKPI_IOCTL_MMAP \
+	LINUXKPI_IOC(3, 0x01, sizeof(struct linuxkpi_mmap))
+#define LINUXKPI_IOCTL_MUNMAP \
+	LINUXKPI_IOC(1, 0x02, sizeof(struct linuxkpi_munmap))
+#define LINUXKPI_IOCTL_DEVICE_INFO \
+	LINUXKPI_IOC(2, 0x03, sizeof(struct linuxkpi_device_info))
+#define LINUXKPI_IOCTL_FILE_SIZE \
+	LINUXKPI_IOC(2, 0x04, sizeof(struct linuxkpi_file_size))
+
+#endif
