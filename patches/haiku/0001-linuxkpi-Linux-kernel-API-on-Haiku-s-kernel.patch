+#ifndef _LINUXKPI_LINUX_UUID_H
+#define _LINUXKPI_LINUX_UUID_H
+
+#include <linux/string.h>
+#define UUID_SIZE 16
+typedef struct { __u8 b[UUID_SIZE]; } guid_t;
+typedef struct { __u8 b[UUID_SIZE]; } uuid_t;
+#define GUID_INIT(a, b, c, d0, d1, d2, d3, d4, d5, d6, d7) ((guid_t) {{ (a) & 0xff, ((a) >> 8) & 0xff, \
+	((a) >> 16) & 0xff, ((a) >> 24) & 0xff, (b) & 0xff, ((b) >> 8) & 0xff, (c) & 0xff, ((c) >> 8) & 0xff, \
+	(d0), (d1), (d2), (d3), (d4), (d5), (d6), (d7) }})
+static inline bool guid_equal(const guid_t *u1, const guid_t *u2) { return memcmp(u1, u2, sizeof(guid_t)) == 0; }
