index 0000000000..47c4271cec
--- /dev/null
+++ b/src/libs/compat/linuxkpi/include/linux/timer.h
@@ -0,0 +1,44 @@
+/*
+ * Copyright 2026, hans2294.
+ * Distributed under the terms of the MIT License.
+ */
+#ifndef _LINUXKPI_LINUX_TIMER_H
+#define _LINUXKPI_LINUX_TIMER_H
+
+#include <linux/list.h>
+#include <linux/ktime.h>
+#include <linux/stddef.h>
+/* An entry in linuxkpi's timer thread's queue; callbacks run in that thread. */
+struct linuxkpi_timer {
+	struct list_head entry;
+	u64 when;			/* system time, ns */
+	void (*callback)(struct linuxkpi_timer *);
+	int queued;
+};
+struct timer_list {
+	struct hlist_node entry;
+	unsigned long expires;
+	void (*function)(struct timer_list *);
+	u32 flags;
+	struct linuxkpi_timer linuxkpi;
+};
+#define TIMER_DEFERRABLE	0x00080000
+#define TIMER_PINNED		0x00100000
+#define TIMER_IRQSAFE		0x00200000
+void linuxkpi_timer_setup(struct timer_list *timer, void (*func)(struct timer_list *), unsigned int flags);
+#define timer_setup(timer, callback, flags)	linuxkpi_timer_setup(timer, callback, flags)
+#define timer_setup_on_stack(timer, callback, flags)	timer_setup(timer, callback, flags)
+#define from_timer(var, callback_timer, timer_fieldname) \
+	container_of(callback_timer, typeof(*var), timer_fieldname)
+#define timer_container_of(var, callback_timer, timer_fieldname) from_timer(var, callback_timer, timer_fieldname)
+int mod_timer(struct timer_list *timer, unsigned long expires);
+void add_timer(struct timer_list *timer);
+int del_timer(struct timer_list *timer);
+int del_timer_sync(struct timer_list *timer);
+#define timer_delete(t)		del_timer(t)
+#define timer_delete_sync(t)	del_timer_sync(t)
+#define timer_shutdown_sync(t)	del_timer_sync(t)
+#define destroy_timer_on_stack(t)	do { } while (0)
+int timer_pending(const struct timer_list *timer);
+
+#endif
