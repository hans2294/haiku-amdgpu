new file mode 100644
index 0000000000..775e884499
--- /dev/null
+++ b/src/add-ons/kernel/drivers/graphics/amdgpu/Jamfile
@@ -0,0 +1,162 @@
+SubDir HAIKU_TOP src add-ons kernel drivers graphics amdgpu ;
+
+# Linux's amdgpu (with DRM, TTM, the scheduler and dma-buf) from the unchanged
+# Linux tree next to Haiku's, on top of linuxkpi. The Linux files never see
+# Haiku's headers: they are compiled with their own flags, as Kbuild would.
+
+LINUX_TOP = [ FDirName $(HAIKU_TOP) .. linux-6.12 ] ;
+LINUXKPI_TOP = [ FDirName $(HAIKU_TOP) src libs compat linuxkpi ] ;
+LINUX_CC = $(TARGET_CC_$(TARGET_KERNEL_ARCH)) ;
+
+LINUX_CCFLAGS = -std=gnu11 -O2 -nostdinc -ffreestanding
+	-fno-strict-aliasing -fno-delete-null-pointer-checks -fno-common
+	-fno-tree-vectorize -mno-red-zone -fno-omit-frame-pointer
+	-D__KERNEL__ -D__HAIKU_LINUXKPI__
+	-Werror=implicit-function-declaration -Werror=implicit-int
+	-Wno-override-init -Wno-unused-parameter -Wno-attributes ;
+
+LINUX_HDRS =
+	[ FDirName $(LINUXKPI_TOP) include ]
+	[ FDirName $(LINUXKPI_TOP) linux-include ]
+	[ FDirName $(LINUX_TOP) include uapi ] ;
+
+local amd = [ FDirName $(LINUX_TOP) drivers gpu drm amd ] ;
+LINUX_AMD_HDRS =
+	$(amd)/include/asic_reg $(amd)/include $(amd)/acp/include $(amd)/amdgpu
+	$(amd)/amdkfd $(amd)/display $(amd)/display/amdgpu_dm $(amd)/display/dc
+	$(amd)/display/include $(amd)/display/modules/inc $(amd)/pm/inc
+	$(amd)/pm/legacy-dpm $(amd)/pm/powerplay/hwmgr $(amd)/pm/powerplay/inc
+	$(amd)/pm/powerplay/smumgr $(amd)/pm/swsmu $(amd)/pm/swsmu/inc
+	$(amd)/pm/swsmu/inc/pmfw_if $(amd)/pm/swsmu/smu11 $(amd)/pm/swsmu/smu12
+	$(amd)/pm/swsmu/smu13 $(amd)/pm/swsmu/smu14 ;
+
+# Display Core's, which its Makefiles add per sub-tree
+local dc = $(amd)/display/dc ;
+LINUX_AMD_HDRS +=
+	$(dc)/inc $(dc)/inc/hw $(dc)/clk_mgr $(dc)/dccg $(dc)/dio $(dc)/dpp $(dc)/dsc
+	$(dc)/dwb $(dc)/hpo $(dc)/hubbub $(dc)/hubp $(dc)/hwss $(dc)/mmhubbub
+	$(dc)/mpc $(dc)/opp $(dc)/optc $(dc)/pg $(dc)/resource
+	$(dc)/dml2 $(dc)/dml2/dml21 $(dc)/dml2/dml21/inc $(dc)/dml2/dml21/src/inc
+	$(dc)/dml2/dml21/src/dml2_core $(dc)/dml2/dml21/src/dml2_dpmm
+	$(dc)/dml2/dml21/src/dml2_mcg $(dc)/dml2/dml21/src/dml2_pmo
+	$(dc)/dml2/dml21/src/dml2_standalone_libraries
+	$(amd)/display/dmub/inc $(amd)/display/modules/color
+	$(amd)/display/modules/freesync $(amd)/display/modules/hdcp
+	$(amd)/display/modules/info_packet $(amd)/display/modules/power ;
+
+# linuxkpi's headers change a lot; rebuild the Linux objects when they do.
+local kpiDirs = linux linux/device linux/sched linux/mfd linux/byteorder
+	asm asm/fpu trace video acpi xen kunit generated uapi/linux/sched ;
+LINUXKPI_HEADERS = ;
+local dir ;
+for dir in $(kpiDirs) {
+	LINUXKPI_HEADERS += [ GLOB [ FDirName $(LINUXKPI_TOP) include $(dir) ] : *.h ] ;
+}
+
+rule LinuxObject
+{
+	# LinuxObject <root> : <path below root> : <KBUILD_MODNAME> ;
+	# Compiles one Linux-API C file; returns the object.
+	local root = $(1) ;
+	local path = $(2) ;
+	local source = <linux-src>$(path) ;
+	local object = $(path:B).o ;
+	object = $(object:G=linux-obj-$(path:D)) ;
+
+	SEARCH on $(source) = $(root) ;
+	MakeLocate $(object) : [ FDirName $(LOCATE_TARGET) linux $(path:D) ] ;
+	Depends $(object) : $(source) $(LINUXKPI_HEADERS) ;
+
+	LINUX_MODNAME on $(object) = $(3) ;
+	LINUX_BASENAME on $(object) = $(path:B) ;
+	local hdrs = $(LINUX_HDRS) [ FDirName $(root) $(path:D) ] ;
+	if $(3) = amdgpu {
+		hdrs += $(LINUX_AMD_HDRS) ;
+	}
+	LINUX_OBJECT_HDRS on $(object) = $(hdrs) ;
+	LINUX_KCONFIG on $(object)
+		= [ FDirName $(LINUXKPI_TOP) include linux kconfig.h ] ;
+
+	LinuxCompile $(object) : $(source) ;
+	return $(object) ;
+}
+
+actions LinuxCompile
+{
+	$(LINUX_CC) -c $(LINUX_CCFLAGS) \
+		-isystem `$(LINUX_CC) -print-file-name=include` \
+		-DKBUILD_MODNAME='"$(LINUX_MODNAME)"' \
+		-DKBUILD_BASENAME='"$(LINUX_BASENAME)"' \
+		-include $(LINUX_KCONFIG) -I$(LINUX_OBJECT_HDRS) \
+		-o "$(1)" "$(2)"
+}
+
+include [ FDirName $(SUBDIR) LinuxSources ] ;
+
+local linuxObjects ;
+local sources = $(LINUX_SOURCES) ;
+while $(sources) {
+	linuxObjects += [ LinuxObject $(LINUX_TOP) : $(sources[1]) : $(sources[2]) ] ;
+	sources = $(sources[3-]) ;
+}
+
+# linuxkpi's Linux side: the Linux API in C, compiled like Linux code
+LINUXKPI_LINUX_SOURCES =
+	chrdev.c
+	device.c
+	dma.c
+	irq.c
+	lib.c
+	misc.c
+	mm.c
+	module.c
+	pci.c
+	printk.c
+	sched.c
+	sync.c
+	timer.c
+	vsprintf.c
+	;
+local file ;
+for file in $(LINUXKPI_LINUX_SOURCES) {
+	linuxObjects += [ LinuxObject [ FDirName $(LINUXKPI_TOP) linux ]
+		: $(file) : linuxkpi ] ;
+}
+
+# One merged object rather than an archive: nothing refers to most Linux
+# modules except through their init call entries, and the linker would leave
+# them out of an archive.
+rule LinuxMerge
+{
+	# LinuxMerge <object> : <objects> ;
+	MakeLocate $(1) : $(LOCATE_TARGET) ;
+	Depends $(1) : $(2) ;
+	LinuxMergeObjects $(1) : $(2) ;
+}
+
+actions LinuxMergeObjects
+{
+	$(LINUX_CC) -nostdlib -r -o "$(1)" "$(2)"
+}
+
+LinuxMerge <linux>linux_amdgpu.o : $(linuxObjects) ;
+
+# linuxkpi's Haiku side and the driver glue, with Haiku's headers
+UsePrivateKernelHeaders ;
+UsePrivateHeaders [ FDirName graphics common ] ;
+SubDirHdrs [ FDirName $(LINUXKPI_TOP) haiku ] ;
+SEARCH_SOURCE += [ FDirName $(LINUXKPI_TOP) haiku ] ;
+
+KernelAddon amdgpu :
+	driver.cpp
+	haiku_device.cpp
+	haiku_kernel.cpp
+	;
+
+# Haiku's loader binds an add-on's global symbols to the kernel's first;
+# Linux's vsnprintf(), sort() and friends must bind to linuxkpi's own.
+LINKFLAGS on amdgpu += -Xlinker -Bsymbolic ;
+
+# Straight onto the link line; LinkAgainst would turn it into -l.
+LINK_BEGIN_GLUE on amdgpu += <linux>linux_amdgpu.o ;
+Depends amdgpu : <linux>linux_amdgpu.o ;
