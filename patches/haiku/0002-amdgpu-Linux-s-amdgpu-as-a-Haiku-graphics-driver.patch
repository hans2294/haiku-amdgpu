+++ b/src/add-ons/kernel/drivers/graphics/amdgpu/driver.cpp
@@ -0,0 +1,569 @@
+/*
+ * Copyright 2026, hans2294.
+ * Distributed under the terms of the MIT License.
+ */
+
+
+/*!	Haiku driver glue for Linux's amdgpu: brings up linuxkpi, runs the Linux
+	modules' init calls (DRM, TTM, ..., amdgpu), which probe the GPUs, and
+	publishes the character devices they add (/dev/dri/card0,
+	/dev/dri/renderD128), a graphics node for app_server, and a status node.
+
+	The graphics node, /dev/graphics/amdgpu_kms_0, is the DRM primary node
+	under another name: it names amdgpu_kms.accelerant, which sets modes and
+	gets its frame buffer through Linux's KMS on it.
+
+	The file node, /dev/misc/linuxkpi/file, carries Linux files that are no
+	device node, like the dma-bufs PRIME hands out: Linux's fds for them are
+	Haiku fds of the calling team that the driver opens on that node (see
+	linuxkpi_fd_reserve() and its friends).
+
+	Only GPUs on the device list are probed: Navi 31 (1002:744c), the one
+	this port was brought up on, unless the driver settings file "amdgpu"
+	says otherwise ("devices 744c 164e", PCI device IDs of AMD GPUs, or
+	"devices all"). A machine's other AMD GPUs (an integrated one, say) stay
+	untouched that way.
+
+	The status node is in /dev/misc so app_server leaves it alone; it also
+	keeps the driver loaded when probing failed, as devfs unloads drivers
+	that publish nothing. The DRM nodes go straight to Linux's file
+	operations: open (on first use), flush on close, release on free,
+	ioctl, read; linuxkpi's own ioctls (uapi.h) stand in for mmap() and
+	sysfs.
+*/
+
+
+#include <Drivers.h>
+#include <driver_settings.h>
+#include <KernelExport.h>
+#include <graphic_driver.h>
+#include <PCI.h>
+#include <kernel.h>
+#include <ksystem_info.h>
+#include <fs/fd.h>
+#include <lock.h>
+#include <util/AutoLock.h>
+#include <vfs.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "../../../../../libs/compat/linuxkpi/include/linuxkpi/chrdev.h"
+#include "../../../../../libs/compat/linuxkpi/include/linuxkpi/haiku.h"
+#include "../../../../../libs/compat/linuxkpi/include/linuxkpi/uapi.h"
+
+
+#define TRACE(x...)		dprintf("amdgpu: " x)
+
+
+int32 api_version = B_CUR_DRIVER_API_VERSION;
+
+extern "C" int linuxkpi_run_initcalls(void);
+extern "C" void linuxkpi_run_exitcalls(void);
+
+static const char* kStatusDevice = "misc/amdgpu/0";
+static const char* kFileDevice = "misc/linuxkpi/file";
+static const char* kFileDevicePath = "/dev/misc/linuxkpi/file";
+static const char* kGraphicsDevice = "graphics/amdgpu_kms_0";
+static const char* kGraphicsDRMNode = "dri/card0";
+static const char* kAccelerant = "amdgpu_kms.accelerant";
+static const int kMaxDevices = 16;
+
+static const char* sDeviceNames[kMaxDevices + 1];
+
+static const uint32 kAmdVendor = 0x1002;
+static const uint32 kDefaultDevices[] = { 0x744c };	// Navi 31
+static const int kMaxListedDevices = 16;
+static uint32 sAllowedDevices[kMaxListedDevices];	// vendor << 16 | device
+static int sAllowedDeviceCount = -1;				// all of them
+
+static mutex sFileVnodeLock = MUTEX_INITIALIZER("linuxkpi file vnode");
+static struct vnode* sFileVnode;
+	// referenced while the driver is loaded, to recognize the file node's fds
+static int sInitResult;
+
+
+/*!	The device list from the settings file, or the default one. */
+static void
+read_device_list()
+{
+	sAllowedDeviceCount = 0;
+	void* handle = load_driver_settings("amdgpu");
+	const driver_settings* settings = get_driver_settings(handle);
+	const driver_parameter* devices = NULL;
+	for (int i = 0; settings != NULL && i < settings->parameter_count; i++) {
+		if (strcmp(settings->parameters[i].name, "devices") == 0)
+			devices = &settings->parameters[i];
+	}
+	if (devices != NULL) {
+		for (int i = 0; i < devices->value_count
+				&& sAllowedDeviceCount < kMaxListedDevices; i++) {
+			if (strcmp(devices->values[i], "all") == 0) {
+				sAllowedDeviceCount = -1;
+				break;
+			}
+			sAllowedDevices[sAllowedDeviceCount++] = kAmdVendor << 16
+				| strtoul(devices->values[i], NULL, 16);
+		}
+	} else {
+		for (size_t i = 0; i < B_COUNT_OF(kDefaultDevices); i++)
+			sAllowedDevices[sAllowedDeviceCount++] = kAmdVendor << 16
+				| kDefaultDevices[i];
+	}
+	unload_driver_settings(handle);
+}
+
+
+/*!	This driver reaches into the kernel's private parts, and panics on a kernel
+	from before these changes, where nothing can catch it: the kernel's lock ABI
+	(hrev60013), and fork() with shared device areas (hrev60102). Keep away,
+	and the desktop falls back on the frame buffer.
+*/
+static bool
+kernel_is_recent_enough()
+{
+	static const unsigned long kOldestRevision = 60102;
+	const char* revision = get_haiku_revision();
+	if (strncmp(revision, "hrev", 4) == 0
+		&& strtoul(revision + 4, NULL, 10) >= kOldestRevision) {
+		return true;
+	}
+	dprintf("amdgpu: not loading: needs hrev%lu or newer, this is %s\n",
+		kOldestRevision, revision);
+	return false;
+}
+
+
+static bool
+device_allowed(const pci_info& info)
+{
+	if (sAllowedDeviceCount < 0)
+		return true;
+	for (int i = 0; i < sAllowedDeviceCount; i++) {
+		if (sAllowedDevices[i] == ((uint32)info.vendor_id << 16 | info.device_id))
+			return true;
+	}
+	return false;
+}
+
+
+extern "C" status_t
+init_hardware(void)
+{
+	if (!kernel_is_recent_enough())
+		return ENODEV;
+
+	pci_module_info* pci;
+	if (get_module(B_PCI_MODULE_NAME, (module_info**)&pci) != B_OK)
+		return B_ERROR;
+
+	read_device_list();
+	status_t status = ENODEV;
+	pci_info info;
+	for (int32 i = 0; pci->get_nth_pci_info(i, &info) == B_OK; i++) {
+		if (info.vendor_id == kAmdVendor && info.class_base == PCI_display) {
+			if (device_allowed(info)) {
+				status = B_OK;
+				break;
+			}
+		}
+	}
+	put_module(B_PCI_MODULE_NAME);
+	return status;
+}
+
+
+extern "C" status_t
+init_driver(void)
+{
+	read_device_list();
+	if (sAllowedDeviceCount >= 0) {
+		linuxkpi_pci_set_allowed_devices(sAllowedDevices, sAllowedDeviceCount);
+		TRACE("probing %d listed device(s), the first %04" B_PRIx32 "\n",
+			sAllowedDeviceCount, sAllowedDevices[0] & 0xffff);
+	}
+	TRACE("running the Linux init calls\n");
+	sInitResult = linuxkpi_run_initcalls();
+	TRACE("Linux init calls returned %d\n", sInitResult);
+	return B_OK;
+}
+
+
+extern "C" void
+uninit_driver(void)
+{
+	TRACE("running the Linux exit calls\n");
+	linuxkpi_run_exitcalls();
+	lkpi_haiku_shutdown();
+	if (sFileVnode != NULL)
+		vfs_put_vnode(sFileVnode);
+}
+
+
+extern "C" const char**
+publish_devices(void)
+{
+	int count = 0;
+	sDeviceNames[count++] = kStatusDevice;
+	sDeviceNames[count++] = kFileDevice;
+	for (int i = 0; count < kMaxDevices - 1; i++) {
+		const char* path = linuxkpi_chrdev_path(i);
+		if (path == NULL)
+			break;
+		sDeviceNames[count++] = path;
+		if (strcmp(path, kGraphicsDRMNode) == 0)
+			sDeviceNames[count++] = kGraphicsDevice;
+	}
+	sDeviceNames[count] = NULL;
+	return sDeviceNames;
+}
+
+
+//	#pragma mark - device hooks
+
+
+/*!	The cookie of an open device. The Linux file is opened on first use,
+	so asking a node which device it is (LINUXKPI_IOCTL_DEVICE_INFO) costs
+	no DRM file and GPU VM.
+*/
+struct open_device {
+	char path[B_PATH_NAME_LENGTH];	/* of the Linux node */
+	int linux_flags;
+	bool status;			/* the status node */
+	bool graphics;			/* the graphics node */
+	bool linux_file;		/* the file node */
+	void* file;				/* NULL until opened (or installed) */
+};
+
+
+static status_t
+amdgpu_open(const char* name, uint32 flags, void** _cookie)
+{
+	open_device* device = (open_device*)calloc(1, sizeof(open_device));
+	if (device == NULL)
+		return B_NO_MEMORY;
+	device->status = strcmp(name, kStatusDevice) == 0;
+	device->graphics = strcmp(name, kGraphicsDevice) == 0;
+	device->linux_file = strcmp(name, kFileDevice) == 0;
+	strlcpy(device->path, device->graphics ? kGraphicsDRMNode : name,
+		sizeof(device->path));
+	device->linux_flags = flags & O_ACCMODE;
+	if ((flags & O_NONBLOCK) != 0)
+		device->linux_flags |= LINUXKPI_O_NONBLOCK;
+
+	if (!device->status && !device->linux_file) {
+		linuxkpi_device_info info;
+		int error = linuxkpi_chrdev_device_info(device->path, &info);
+		if (error != 0) {
+			free(device);
+			return lkpi_haiku_error(error);
+		}
+	}
+
+	*_cookie = device;
+	return B_OK;
+}
+
+
+static status_t
+open_linux_file(open_device* device)
+{
+	if (device->file != NULL)
+		return B_OK;
+	if (device->linux_file)
+		return B_FILE_ERROR;
+	return lkpi_haiku_error(linuxkpi_chrdev_open(device->path,
+		device->linux_flags, &device->file));
+}
+
+
+static status_t
+amdgpu_close(void* cookie)
+{
+	open_device* device = (open_device*)cookie;
+	if (device->file != NULL)
+		linuxkpi_chrdev_close(device->file);
+	return B_OK;
+}
+
+
+static status_t
+amdgpu_free(void* cookie)
+{
+	open_device* device = (open_device*)cookie;
+	if (device->linux_file) {
+		if (device->file != NULL)
+			linuxkpi_file_put(device->file);
+	} else if (device->file != NULL)
+		linuxkpi_chrdev_free(device->file);
+	free(device);
+	return B_OK;
+}
+
+
+static status_t
+status_read(off_t position, void* buffer, size_t* _length)
+{
+	char status[64];
+	int length = snprintf(status, sizeof(status),
+		"Linux amdgpu on linuxkpi; init calls returned %d\n", sInitResult);
+	if (position >= length) {
+		*_length = 0;
+		return B_OK;
+	}
+	size_t bytes = min_c(*_length, (size_t)(length - position));
+	if (user_memcpy(buffer, status + position, bytes) != B_OK)
+		return B_BAD_ADDRESS;
+	*_length = bytes;
+	return B_OK;
+}
+
+
+static status_t
+amdgpu_read(void* cookie, off_t position, void* buffer, size_t* _length)
+{
+	open_device* device = (open_device*)cookie;
+	if (device->status)
+		return status_read(position, buffer, _length);
+	status_t status = open_linux_file(device);
+	if (status != B_OK)
+		return status;
+
+	long long linuxPosition = position;
+	long result = linuxkpi_chrdev_read(device->file, buffer, *_length,
+		&linuxPosition);
+	if (result < 0) {
+		*_length = 0;
+		return lkpi_haiku_error(result);
+	}
+	*_length = result;
+	return B_OK;
+}
+
+
+static status_t
+amdgpu_write(void* cookie, off_t position, const void* buffer,
+	size_t* _length)
+{
+	*_length = 0;
+	return B_NOT_ALLOWED;
+}
+
+
+static status_t
+map_into_team(open_device* device, void* buffer)
+{
+	linuxkpi_mmap request;
+	if (!IS_USER_ADDRESS(buffer)
+		|| user_memcpy(&request, buffer, sizeof(request)) != B_OK)
+		return B_BAD_ADDRESS;
+
+	void* address;
+	int area = linuxkpi_chrdev_mmap(device->file, request.offset, request.size,
+		(request.flags & LINUXKPI_MMAP_WRITE) != 0, &address);
+	if (area < 0)
+		return lkpi_haiku_error(area);
+
+	request.area = area;
+	request.address = (addr_t)address;
+	if (user_memcpy(buffer, &request, sizeof(request)) != B_OK) {
+		linuxkpi_chrdev_munmap(address);
+		return B_BAD_ADDRESS;
+	}
+	return B_OK;
+}
+
+
+static status_t
+device_info(open_device* device, void* buffer)
+{
+	linuxkpi_device_info info;
+	int error = linuxkpi_chrdev_device_info(device->path, &info);
+	if (error != 0)
+		return lkpi_haiku_error(error);
+	if (!IS_USER_ADDRESS(buffer)
+		|| user_memcpy(buffer, &info, sizeof(info)) != B_OK)
+		return B_BAD_ADDRESS;
+	return B_OK;
+}
+
+
+static status_t
+unmap_from_team(void* buffer)
+{
+	linuxkpi_munmap request;
+	if (!IS_USER_ADDRESS(buffer)
+		|| user_memcpy(&request, buffer, sizeof(request)) != B_OK)
+		return B_BAD_ADDRESS;
+	return lkpi_haiku_error(linuxkpi_chrdev_munmap((void*)(addr_t)
+		request.address));
+}
+
+
+static status_t
+file_size(open_device* device, void* buffer)
+{
+	if (!device->linux_file || device->file == NULL)
+		return B_FILE_ERROR;
+	struct linuxkpi_file_size request;
+	request.size = linuxkpi_file_size(device->file);
+	if (!IS_USER_ADDRESS(buffer)
+		|| user_memcpy(buffer, &request, sizeof(request)) != B_OK)
+		return B_BAD_ADDRESS;
+	return B_OK;
+}
+
+
+/*!	Linux ioctl commands come through unchanged as \a op, encoded the Linux
+	way (direction, size, type, number); \a buffer is the user's argument.
+	linuxkpi's own commands (uapi.h) stand in for mmap().
+*/
+static status_t
+amdgpu_control(void* cookie, uint32 op, void* buffer, size_t length)
+{
+	open_device* device = (open_device*)cookie;
+	if (device->status)
+		return B_DEV_INVALID_IOCTL;
+
+	if (device->graphics && op == B_GET_ACCELERANT_SIGNATURE) {
+		if (!IS_USER_ADDRESS(buffer)
+			|| user_strlcpy((char*)buffer, kAccelerant, B_OS_NAME_LENGTH) < B_OK)
+			return B_BAD_ADDRESS;
+		return B_OK;
+	}
+
+	// These two need no Linux file: unmapping may go through any node.
+	if (op == LINUXKPI_IOCTL_DEVICE_INFO)
+		return device_info(device, buffer);
+	if (op == LINUXKPI_IOCTL_MUNMAP)
+		return unmap_from_team(buffer);
+	if (op == LINUXKPI_IOCTL_FILE_SIZE)
+		return file_size(device, buffer);
+
+	status_t status = open_linux_file(device);
+	if (status != B_OK)
+		return status;
+	if (op == LINUXKPI_IOCTL_MMAP)
+		return map_into_team(device, buffer);
+
+	long result = linuxkpi_chrdev_ioctl(device->file, op, buffer);
+	if (result < 0)
+		return lkpi_haiku_error(result);
+	return B_OK;
+}
+
+
+//	#pragma mark - Linux fds
+
+
+/*	What devfs keeps as a file descriptor's cookie (devfs.cpp): the
+	device's cookie comes first. */
+struct devfs_cookie_head {
+	void* device_cookie;
+};
+
+// Linux's errno values, which linuxkpi_fd_reserve() returns negated
+static const int kLinuxENODEV = 19;
+static const int kLinuxEMFILE = 24;
+
+
+
+/*!	The file node's cookie behind \a fd of the current team; the
+	descriptor stays referenced (put_fd()) while the cookie is used.
+*/
+static open_device*
+file_device_for_fd(int fd, file_descriptor** _descriptor)
+{
+	if (sFileVnode == NULL)
+		return NULL;
+	file_descriptor* descriptor = get_fd(get_current_io_context(false), fd);
+	if (descriptor == NULL)
+		return NULL;
+	if (descriptor->u.vnode != sFileVnode || descriptor->cookie == NULL) {
+		put_fd(descriptor);
+		return NULL;
+	}
+	*_descriptor = descriptor;
+	return (open_device*)((devfs_cookie_head*)descriptor->cookie)
+		->device_cookie;
+}
+
+
+extern "C" int
+linuxkpi_fd_reserve(int closeOnExec)
+{
+	MutexLocker _(sFileVnodeLock);
+	if (sFileVnode == NULL
+		&& vfs_get_vnode_from_path(kFileDevicePath, true, &sFileVnode) != B_OK) {
+		sFileVnode = NULL;
+		return -kLinuxENODEV;
+	}
+
+	// the new fd takes this reference over
+	struct vnode* vnode;
+	if (vfs_get_vnode_from_path(kFileDevicePath, true, &vnode) != B_OK)
+		return -kLinuxENODEV;
+	int fd = vfs_open_vnode(vnode, O_RDWR | (closeOnExec ? O_CLOEXEC : 0),
+		false);
+	if (fd < 0) {
+		vfs_put_vnode(vnode);
+		return -kLinuxEMFILE;
+	}
+	return fd;
+}
+
+
+extern "C" void
+linuxkpi_fd_install(int fd, void* file)
+{
+	file_descriptor* descriptor;
+	open_device* device = file_device_for_fd(fd, &descriptor);
+	if (device != NULL && device->file == NULL) {
+		device->file = file;
+		file = NULL;
+	}
+	if (device != NULL)
+		put_fd(descriptor);
+	if (file != NULL) {
+		// the fd went away (or was no file node) meanwhile
+		linuxkpi_file_put(file);
+	}
+}
+
+
+extern "C" void
+linuxkpi_fd_release(int fd)
+{
+	_user_close(fd);
+}
+
+
+extern "C" void*
+linuxkpi_fd_get(int fd)
+{
+	file_descriptor* descriptor;
+	open_device* device = file_device_for_fd(fd, &descriptor);
+	if (device == NULL)
+		return NULL;
+	void* file = device->file != NULL ? linuxkpi_file_get(device->file) : NULL;
+	put_fd(descriptor);
+	return file;
+}
+
+
+static device_hooks sHooks = {
+	amdgpu_open,
+	amdgpu_close,
+	amdgpu_free,
+	amdgpu_control,
+	amdgpu_read,
+	amdgpu_write,
+};
+
+
+extern "C" device_hooks*
+find_device(const char* name)
+{
+	return &sHooks;
+}
