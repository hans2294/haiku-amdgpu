+		.vma = vma,
+		.pgoff = vma->vm_pgoff + index,
+		.address = vma->vm_start + index * PAGE_SIZE,
+		.flags = FAULT_FLAG_ALLOW_RETRY | FAULT_FLAG_RETRY_NOWAIT
+			| ((vma->vm_flags & VM_WRITE) != 0 ? FAULT_FLAG_WRITE : 0),
+	};
+	vm_fault_t result = vma->vm_ops->fault(&vmf);
+	if ((result & VM_FAULT_ERROR) != 0)
+		return -EFAULT;
+	if ((result & VM_FAULT_RETRY) != 0 || vma->linuxkpi_physical[index] == 0)
+		return 1;
