diff --git a/src/bin/evicttest/evicttest.c b/src/bin/evicttest/evicttest.c
new file mode 100644
index 0000000000..5a964a2f13
--- /dev/null
+++ b/src/bin/evicttest/evicttest.c
@@ -0,0 +1,176 @@
+/*
+ * Copyright 2026, hans2294.
+ * Distributed under the terms of the MIT License.
+ */
+
+
+/*	Writes and reads mapped buffers without pause while another thread fills VRAM
+	over and over, so the buffers keep moving. Every word has to read back as
+	written, in the same mapping and in a new one. For a card made small with
+	"vramlimit" in the driver's settings file.
+
+	evicttest [seconds]    (default 30)
+*/
+
+
+#include <errno.h>
+#include <fcntl.h>
+#include <inttypes.h>
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <unistd.h>
+
+#include <OS.h>
+
+#include <amdgpu.h>
+#include <amdgpu_drm.h>
+
+
+enum {
+	kBuffers = 16,
+	kMaxFillers = 64
+};
+static const uint64_t kBufferSize = 256 * 1024;
+static const uint64_t kFillerSize = 32 * 1024 * 1024;
+
+static amdgpu_device_handle sDevice;
+static uint64_t sVramSize;
+static volatile bool sStop;
+static volatile uint32_t sFillRounds;
+
+
+static void*
+fill_thread(void* unused)
+{
+	struct amdgpu_bo_alloc_request request = {
+		.alloc_size = kFillerSize,
+		.phys_alignment = 4096,
+		.preferred_heap = AMDGPU_GEM_DOMAIN_VRAM,
+		.flags = AMDGPU_GEM_CREATE_NO_CPU_ACCESS,
+	};
+	amdgpu_bo_handle fillers[kMaxFillers];
+	while (!sStop) {
+		int count = 0;
+		while (!sStop && count < kMaxFillers
+			&& (uint64_t)count * kFillerSize < sVramSize * 3 / 2
+			&& amdgpu_bo_alloc(sDevice, &request, &fillers[count]) == 0) {
+			count++;
+		}
+		while (count > 0)
+			amdgpu_bo_free(fillers[--count]);
+		sFillRounds++;
+	}
+	return NULL;
+}
+
+
+static uint32_t
+check_words(const char* what, volatile uint32_t* cpu, uint32_t pattern,
+	uint32_t round, int buffer)
+{
+	uint32_t errors = 0;
+	for (uint32_t i = 0; i < kBufferSize / 4; i++) {
+		uint32_t value = cpu[i];
+		if (value != (pattern | i)) {
+			if (errors < 1) {
+				printf("FAIL  %s: buffer %d word %#" PRIx32 " (page %" PRIu32
+					") round %" PRIu32 ": %#" PRIx32 ", wrote %#" PRIx32 "\n",
+					what, buffer, i, i / 1024, round, value, pattern | i);
+			}
+			errors++;
+		}
+	}
+	return errors;
+}
+
+
+int
+main(int argc, char** argv)
+{
+	int seconds = argc > 1 ? atoi(argv[1]) : 30;
+	int fd = open("/dev/dri/renderD128", O_RDWR);
+	uint32_t major, minor;
+	if (fd < 0 || amdgpu_device_initialize(fd, &major, &minor, &sDevice) != 0) {
+		printf("FAIL  open the device\n");
+		return 1;
+	}
+	struct amdgpu_heap_info heap;
+	amdgpu_query_heap_info(sDevice, AMDGPU_GEM_DOMAIN_VRAM, 0, &heap);
+	sVramSize = heap.heap_size;
+	printf("      %" PRIu64 " MiB of VRAM, %d buffers, %d s\n", sVramSize >> 20,
+		kBuffers, seconds);
+	if (sVramSize > 4ull << 30) {
+		printf("      skipped: set vramlimit to at most 4096\n");
+		return 0;
+	}
+
+	struct amdgpu_bo_alloc_request request = {
+		.alloc_size = kBufferSize,
+		.phys_alignment = 4096,
+		.preferred_heap = AMDGPU_GEM_DOMAIN_VRAM,
+		.flags = AMDGPU_GEM_CREATE_CPU_ACCESS_REQUIRED,
+	};
+	amdgpu_bo_handle buffers[kBuffers];
+	for (int i = 0; i < kBuffers; i++) {
+		if (amdgpu_bo_alloc(sDevice, &request, &buffers[i]) != 0) {
+			printf("FAIL  amdgpu_bo_alloc\n");
+			return 1;
+		}
+	}
+
+	pthread_t filler;
+	pthread_create(&filler, NULL, fill_thread, NULL);
+
+	bigtime_t end = system_time() + seconds * (bigtime_t)1000000;
+	uint32_t round = 0;
+	uint32_t sameErrors = 0, newErrors = 0;
+	while (system_time() < end && sameErrors + newErrors < 8) {
+		uint32_t pattern = (round & 0x7f) << 24;
+		for (int b = 0; b < kBuffers; b++) {
+			void* mapped;
+			if (amdgpu_bo_cpu_map(buffers[b], &mapped) != 0) {
+				printf("FAIL  amdgpu_bo_cpu_map\n");
+				newErrors++;
+				continue;
+			}
+			volatile uint32_t* cpu = mapped;
+			for (uint32_t i = 0; i < kBufferSize / 4; i++)
+				cpu[i] = pattern | i;
+			sameErrors += check_words("same mapping", cpu, pattern, round, b);
+			amdgpu_bo_cpu_unmap(buffers[b]);
+
+			amdgpu_bo_cpu_map(buffers[b], &mapped);
+			uint32_t errors = check_words("new mapping", mapped, pattern, round,
+				b);
+			newErrors += errors;
+			if (errors > 0) {
+				// Does it heal? Then the kernel let us read too early. If not,
+				// the data is gone, or the CPU's cache is in the way.
+				snooze(300000);
+				uint32_t later = check_words("0.3 s later", mapped, pattern,
+					round, b);
+				amdgpu_bo_cpu_unmap(buffers[b]);
+				amdgpu_bo_cpu_map(buffers[b], &mapped);
+				uint32_t again = check_words("mapped again", mapped, pattern,
+					round, b);
+				printf("      %" PRIu32 " bad words, %" PRIu32 " 0.3 s later, %"
+					PRIu32 " mapped again\n", errors, later, again);
+			}
+			amdgpu_bo_cpu_unmap(buffers[b]);
+		}
+		round++;
+	}
+	sStop = true;
+	pthread_join(filler, NULL);
+
+	printf("      %" PRIu32 " rounds, VRAM filled %" PRIu32 " times, %" PRIu32
+		" bad words in the same mapping, %" PRIu32 " in a new one\n", round,
+		sFillRounds, sameErrors, newErrors);
+	for (int i = 0; i < kBuffers; i++)
+		amdgpu_bo_free(buffers[i]);
+	amdgpu_device_deinitialize(sDevice);
+	close(fd);
+	printf("%s\n", sameErrors + newErrors == 0 ? "PASS" : "DONE: failures");
+	return sameErrors + newErrors == 0 ? 0 : 1;
+}
