@@ -345,6 +351,91 @@ test_fork(amdgpu_device_handle device, const char *what, uint32_t heap,
 }
 
 
+/*	A mapped buffer that the kernel moves out of a full VRAM: what the program
+	writes to its mapping afterwards has to reach the buffer. Only runs on a card
+	made small with "vramlimit" in the driver's settings file.
+*/
+static void
+test_eviction(amdgpu_device_handle device)
+{
+	struct amdgpu_heap_info heap;
+	if (amdgpu_query_heap_info(device, AMDGPU_GEM_DOMAIN_VRAM, 0, &heap) != 0
+		|| heap.heap_size > 4ull << 30) {
+		printf("      eviction: skipped, set vramlimit to at most 4096\n");
+		return;
+	}
+
+	const uint64_t size = 1024 * 1024;
+	struct amdgpu_bo_alloc_request request = {
+		.alloc_size = size,
+		.phys_alignment = 4096,
+		.preferred_heap = AMDGPU_GEM_DOMAIN_VRAM,
+		.flags = AMDGPU_GEM_CREATE_CPU_ACCESS_REQUIRED,
+	};
+	amdgpu_bo_handle bo;
+	uint32_t *cpu;
+	if (!check("eviction: amdgpu_bo_alloc", amdgpu_bo_alloc(device, &request,
+			&bo)))
+		return;
+	if (!check("eviction: amdgpu_bo_cpu_map", amdgpu_bo_cpu_map(bo,
+			(void **)&cpu))) {
+		amdgpu_bo_free(bo);
+		return;
+	}
+	for (uint32_t i = 0; i < size / 4; i++)
+		cpu[i] = 0x33000000 | i;
+
+	// More than fits: the kernel has to move the oldest ones out
+	enum { kMaxFillers = 256 };
+	amdgpu_bo_handle fillers[kMaxFillers];
+	int fillerCount = 0;
+	const uint64_t fillerSize = 64 * 1024 * 1024;
+	struct amdgpu_bo_alloc_request fillerRequest = {
+		.alloc_size = fillerSize,
+		.phys_alignment = 4096,
+		.preferred_heap = AMDGPU_GEM_DOMAIN_VRAM,
+		.flags = AMDGPU_GEM_CREATE_NO_CPU_ACCESS,
+	};
+	while (fillerCount < kMaxFillers
+		&& (uint64_t)fillerCount * fillerSize < heap.heap_size * 3 / 2
+		&& amdgpu_bo_alloc(device, &fillerRequest,
+			&fillers[fillerCount]) == 0) {
+		fillerCount++;
+	}
+	printf("      eviction: %d buffers of 64 MiB on %" PRIu64 " MiB of VRAM\n",
+		fillerCount, heap.heap_size >> 20);
+
+	uint32_t errors = 0;
+	for (uint32_t i = 0; i < size / 4; i++) {
+		if (cpu[i] != (0x33000000 | i))
+			errors++;
+	}
+	check("eviction: the mapping still shows the contents",
+		errors == 0 ? 0 : -EIO);
+
+	for (uint32_t i = 0; i < size / 4; i++)
+		cpu[i] = 0x44000000 | i;
+
+	amdgpu_bo_cpu_unmap(bo);
+	if (check("eviction: map again", amdgpu_bo_cpu_map(bo, (void **)&cpu))) {
+		errors = 0;
+		for (uint32_t i = 0; i < size / 4; i++) {
+			if (cpu[i] != (0x44000000 | i))
+				errors++;
+		}
+		printf("      eviction: %" PRIu32 " of %" PRIu64 " words differ\n",
+			errors, size / 4);
+		check("eviction: writes reach the moved buffer",
+			errors == 0 ? 0 : -EIO);
+		amdgpu_bo_cpu_unmap(bo);
+	}
+
+	while (fillerCount > 0)
+		amdgpu_bo_free(fillers[--fillerCount]);
+	amdgpu_bo_free(bo);
+}
+
+
 /*	What a client needs for drawing straight into the screen: the CRTC's
 	frame buffer from the primary node (not being master), as a dma-buf fd
 	that imports on the render node.
@@ -429,6 +520,7 @@ main(void)
 		test_fork(device, "GTT", AMDGPU_GEM_DOMAIN_GTT, 0);
 		test_fork(device, "VRAM", AMDGPU_GEM_DOMAIN_VRAM,
 			AMDGPU_GEM_CREATE_CPU_ACCESS_REQUIRED);
+		test_eviction(device);
 		check("amdgpu_device_deinitialize", amdgpu_device_deinitialize(device));
 	}
 
