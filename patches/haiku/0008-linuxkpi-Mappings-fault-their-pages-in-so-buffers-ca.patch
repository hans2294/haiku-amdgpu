+//	#pragma mark - mappings to userspace
+
+
+/*!	The cache of a mapping into teams: it gets its pages from the Linux fault
+	handler on demand and has none of its own. Like a device cache, except that
+	a page table entry is only there as long as the buffer's page stays where it
+	is. The table has the current pages, or 0.
+
+	Locks: the Linux fault handler takes the buffer's reservation, and whoever
+	holds that may clear pages here, which takes this cache's lock. So the handler
+	runs without this lock, and a page that is in the table is mapped with it:
+	clearing a page and mapping it can't overlap.
+*/
+class LinuxMappingCache final : public VMCache {
+public:
+	LinuxMappingCache(void* vma, unsigned long long* table, size_t pages)
+		:
+		fVma(vma),
+		fTable(table),
+		fPages(pages)
+	{
+	}
+
+	status_t Init()
+	{
+		return VMCache::Init("linuxkpi mapping", CACHE_TYPE_DEVICE, 0);
+	}
+
+	// Nothing to commit: the buffer has its memory.
+	status_t Commit(off_t size, int priority) override
+	{
+		return B_OK;
+	}
+
+	status_t Fault(VMAddressSpace* addressSpace, off_t offset) override;
+	void Clear(size_t first, size_t count);
+
+protected:
+	void DeleteObject() override
+	{
+		delete this;
+	}
+
+private:
+	VMArea* _AreaIn(VMAddressSpace* addressSpace);
+	void _MapPages(VMTranslationMap* map, VMArea* area, size_t index,
+		vm_page_reservation* reservation);
+
+	static const size_t kMapAhead = 16;
+
+	void*				fVma;
+	volatile unsigned long long* fTable;
+	size_t				fPages;
+};
+
+
+VMArea*
+LinuxMappingCache::_AreaIn(VMAddressSpace* addressSpace)
 {
-	generic_io_vec* vecs = (generic_io_vec*)malloc(sizeof(generic_io_vec)
-		* count);
-	if (vecs == NULL)
-		return -kLinuxENOMEM;
-	uint32 vecCount = 0;
-	for (unsigned long i = 0; i < count; i++) {
-		if (vecCount > 0 && vecs[vecCount - 1].base
-				+ vecs[vecCount - 1].length == physical[i]) {
-			vecs[vecCount - 1].length += B_PAGE_SIZE;
+	for (VMArea* area = areas.First(); area != NULL; area = areas.GetNext(area)) {
+		if (area->address_space == addressSpace)
+			return area;
+	}
+	return NULL;
+}
+
+
+void
+LinuxMappingCache::_MapPages(VMTranslationMap* map, VMArea* area, size_t index,
+	vm_page_reservation* reservation)
+{
+	uint32 protection = area->protection & (B_READ_AREA | B_WRITE_AREA
+		| B_KERNEL_READ_AREA | B_KERNEL_WRITE_AREA);
+	size_t end = min_c(fPages, index + kMapAhead);
+
+	map->Lock();
+	for (size_t i = index; i < end; i++) {
+		unsigned long long entry = fTable[i];
+		if (entry == 0)
+			break;
+
+		addr_t address = area->Base() + i * B_PAGE_SIZE;
+		phys_addr_t physical;
+		uint32 flags;
+		if (map->Query(address, &physical, &flags) == B_OK
+			&& (flags & PAGE_PRESENT) != 0) {
 			continue;
 		}
-		vecs[vecCount].base = physical[i];
-		vecs[vecCount].length = B_PAGE_SIZE;
-		vecCount++;
+
+		uint32 memoryType = 0;
+		switch ((entry & (B_PAGE_SIZE - 1)) - LKPI_HAIKU_ENTRY(0)) {
+			case LKPI_HAIKU_CACHE_UNCACHED:
+				memoryType = B_UNCACHED_MEMORY;
+				break;
+			case LKPI_HAIKU_CACHE_WRITE_COMBINING:
+				memoryType = B_WRITE_COMBINING_MEMORY;
+				break;
+		}
+		map->Map(address, entry & ~(unsigned long long)(B_PAGE_SIZE - 1),
+			protection, memoryType, reservation);
 	}
+	map->Unlock();
+}
+
+
+/*!	Called with the address space read locked and the cache locked. */
+status_t
