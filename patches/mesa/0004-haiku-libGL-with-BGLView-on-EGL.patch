diff --git a/src/haiku-gl/GLView.cpp b/src/haiku-gl/GLView.cpp
new file mode 100644
index 0000000..5af84f0
--- /dev/null
+++ b/src/haiku-gl/GLView.cpp
@@ -0,0 +1,612 @@
+/*
+ * Copyright 2026, hans2294.
+ * SPDX-License-Identifier: MIT
+ */
+
+/*
+ * Haiku's GL kit (BGLView, with the ABI of GLView.h) on Mesa's EGL, so that
+ * existing BGLView programs render with whatever Gallium driver EGL finds:
+ * radeonsi on a linuxkpi DRM node, softpipe otherwise.
+ *
+ * The view's framebuffer is an EGL pbuffer of the view's size on the
+ * surfaceless platform, so the program's default framebuffer (FBO 0) is
+ * what it always was. SwapBuffers() reads it back into a BBitmap and draws
+ * that into the view.
+ *
+ * Locking: fDisplayLock is the GL lock (LockGL()/UnlockGL(), the context is
+ * current while it is held); fDrawLock guards the bitmap. Drawing into the
+ * view takes the window's looper lock first and fDrawLock second, from
+ * SwapBuffers() and from Draw() alike.
+ */
+
+#include "GLView.h"
+
+#include <Autolock.h>
+
+#include <new>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <EGL/egl.h>
+#include <EGL/eglext.h>
+#include <GL/gl.h>
+
+#ifndef GL_BGRA
+#define GL_BGRA 0x80E1
+#endif
+
+
+struct glview_state {
+	EGLDisplay display;
+	EGLConfig config;
+	EGLContext context;
+	EGLSurface surface;
+	int32 width;			/* the view's, wanted for the next LockGL() */
+	int32 height;
+	int32 surfaceWidth;		/* the pbuffer's */
+	int32 surfaceHeight;
+	BBitmap* bitmap;		/* the last frame, B_RGB32 */
+	uint8* staging;			/* glReadPixels() lands here, bottom up */
+	size_t stagingSize;
+};
+
+
+static glview_state*
+state_of(void* gc)
+{
+	return (glview_state*)gc;
+}
+
+
+static glview_state*
+create_state(ulong options)
+{
+	glview_state* state = new(std::nothrow) glview_state;
+	if (state == NULL)
+		return NULL;
+	memset(state, 0, sizeof(*state));
+	state->surface = EGL_NO_SURFACE;
+	state->context = EGL_NO_CONTEXT;
+
+	state->display = eglGetPlatformDisplay(EGL_PLATFORM_SURFACELESS_MESA,
+		EGL_DEFAULT_DISPLAY, NULL);
+	EGLint major, minor;
+	if (state->display == EGL_NO_DISPLAY
+		|| !eglInitialize(state->display, &major, &minor)) {
+		fprintf(stderr, "BGLView: no EGL display (error %#x)\n", eglGetError());
+		delete state;
+		return NULL;
+	}
+
+	const EGLint configAttributes[] = {
+		EGL_SURFACE_TYPE, EGL_PBUFFER_BIT,
+		EGL_RENDERABLE_TYPE, EGL_OPENGL_BIT,
+		EGL_RED_SIZE, 8,
+		EGL_GREEN_SIZE, 8,
+		EGL_BLUE_SIZE, 8,
+		EGL_ALPHA_SIZE, (options & BGL_ALPHA) != 0 ? 8 : 0,
+		EGL_DEPTH_SIZE, (options & BGL_DEPTH) != 0 ? 24 : 0,
+		EGL_STENCIL_SIZE, (options & BGL_STENCIL) != 0 ? 8 : 0,
+		EGL_NONE
+	};
+	EGLint count = 0;
+	if (!eglChooseConfig(state->display, configAttributes, &state->config, 1,
+			&count) || count == 0) {
+		fprintf(stderr, "BGLView: no EGL config for options %#lx\n", options);
+		delete state;
+		return NULL;
+	}
+
+	// The compatibility profile, as BGLView programs expect it
+	eglBindAPI(EGL_OPENGL_API);
+	state->context = eglCreateContext(state->display, state->config,
+		EGL_NO_CONTEXT, NULL);
+	if (state->context == EGL_NO_CONTEXT) {
+		fprintf(stderr, "BGLView: no OpenGL context (error %#x)\n",
+			eglGetError());
+		delete state;
+		return NULL;
+	}
+	return state;
+}
+
+
+/*!	Makes the pbuffer match the view; the context must not be current. */
+static bool
+update_surface(glview_state* state)
+{
+	int32 width = state->width > 0 ? state->width : 1;
+	int32 height = state->height > 0 ? state->height : 1;
+	if (state->surface != EGL_NO_SURFACE && width == state->surfaceWidth
+		&& height == state->surfaceHeight)
+		return true;
+
+	if (state->surface != EGL_NO_SURFACE)
+		eglDestroySurface(state->display, state->surface);
+	const EGLint attributes[] = {
+		EGL_WIDTH, width,
+		EGL_HEIGHT, height,
+		EGL_NONE
+	};
+	state->surface = eglCreatePbufferSurface(state->display, state->config,
+		attributes);
+	if (state->surface == EGL_NO_SURFACE) {
+		fprintf(stderr, "BGLView: no %" B_PRId32 "x%" B_PRId32 " pbuffer "
+			"(error %#x)\n", width, height, eglGetError());
+		return false;
+	}
+	state->surfaceWidth = width;
+	state->surfaceHeight = height;
+	return true;
+}
+
+
+//	#pragma mark - BGLView
+
+
+BGLView::BGLView(BRect rect, const char* name, ulong resizingMode, ulong mode,
+	ulong options)
+	:
+	BView(rect, name, resizingMode, mode | B_WILL_DRAW | B_FRAME_EVENTS),
+	fGc(NULL),
+	fOptions(options),
+	fDitherCount(0),
+	fDrawLock("BGLView draw lock"),
+	fDisplayLock("BGLView display lock"),
+	fClipInfo(NULL),
+	fRenderer(NULL),
+	fRoster(NULL),
+	fDitherMap(NULL),
+	fBounds(rect)
+{
+	fErrorBuffer[0] = fErrorBuffer[1] = NULL;
+	// Every pixel comes from GL; app_server should not paint behind it.
+	SetViewColor(B_TRANSPARENT_COLOR);
+
+	glview_state* state = create_state(options);
+	if (state != NULL) {
+		state->width = rect.IntegerWidth() + 1;
+		state->height = rect.IntegerHeight() + 1;
+	}
+	fGc = state;
+}
+
+
+BGLView::BGLView(BRect rect, char* name, ulong resizingMode, ulong mode,
+	ulong options)
+	:
+	BGLView(rect, (const char*)name, resizingMode, mode, options)
+{
+}
+
+
+BGLView::~BGLView()
+{
+	glview_state* state = state_of(fGc);
+	if (state == NULL)
+		return;
+	// Other views of the team share the display; it stays initialized.
+	eglMakeCurrent(state->display, EGL_NO_SURFACE, EGL_NO_SURFACE,
+		EGL_NO_CONTEXT);
+	if (state->surface != EGL_NO_SURFACE)
+		eglDestroySurface(state->display, state->surface);
+	eglDestroyContext(state->display, state->context);
+	delete state->bitmap;
+	free(state->staging);
+	delete state;
+}
+
+
+void
+BGLView::LockGL()
+{
+	fDisplayLock.Lock();
+	glview_state* state = state_of(fGc);
+	if (state == NULL || fDisplayLock.CountLocks() > 1)
+		return;
+
+	if (!update_surface(state))
+		return;
+	if (!eglMakeCurrent(state->display, state->surface, state->surface,
+			state->context))
+		fprintf(stderr, "BGLView: eglMakeCurrent failed (%#x)\n", eglGetError());
+}
+
+
+void
+BGLView::UnlockGL()
+{
+	glview_state* state = state_of(fGc);
+	if (state != NULL && fDisplayLock.CountLocks() == 1) {
+		// another thread may want the context next
+		eglMakeCurrent(state->display, EGL_NO_SURFACE, EGL_NO_SURFACE,
+			EGL_NO_CONTEXT);
+	}
+	fDisplayLock.Unlock();
+}
+
+
+void
+BGLView::SwapBuffers()
+{
+	SwapBuffers(false);
+}
+
+
+void
+BGLView::SwapBuffers(bool vSync)
+{
+	glview_state* state = state_of(fGc);
+	if (state == NULL || state->surface == EGL_NO_SURFACE
+		|| eglGetCurrentContext() != state->context)
+		return;
+
+	int32 width = state->surfaceWidth;
+	int32 height = state->surfaceHeight;
+	size_t pitch = width * 4;
+	if (state->stagingSize < pitch * height) {
+		free(state->staging);
+		state->staging = (uint8*)malloc(pitch * height);
+		state->stagingSize = state->staging != NULL ? pitch * height : 0;
+		if (state->staging == NULL)
+			return;
+	}
+
+	// The back buffer for double buffered views, the front one otherwise
+	glReadBuffer((fOptions & BGL_DOUBLE) != 0 ? GL_BACK : GL_FRONT);
+	glPixelStorei(GL_PACK_ALIGNMENT, 4);
+	glPixelStorei(GL_PACK_ROW_LENGTH, 0);
+	glReadPixels(0, 0, width, height, GL_BGRA, GL_UNSIGNED_BYTE,
+		state->staging);
+
+	fDrawLock.Lock();
+	BBitmap* bitmap = state->bitmap;
+	if (bitmap == NULL || bitmap->Bounds().IntegerWidth() + 1 != width
+		|| bitmap->Bounds().IntegerHeight() + 1 != height) {
+		delete bitmap;
+		bitmap = new(std::nothrow) BBitmap(BRect(0, 0, width - 1, height - 1),
+			B_RGB32);
+		if (bitmap != NULL && bitmap->InitCheck() != B_OK) {
+			delete bitmap;
+			bitmap = NULL;
+		}
+		state->bitmap = bitmap;
+	}
+	if (bitmap != NULL) {
+		// GL's rows go bottom up
+		uint8* destination = (uint8*)bitmap->Bits();
+		int32 destinationPitch = bitmap->BytesPerRow();
+		for (int32 y = 0; y < height; y++) {
+			memcpy(destination + y * destinationPitch,
+				state->staging + (height - 1 - y) * pitch, pitch);
+		}
+	}
+	fDrawLock.Unlock();
+
+	if (bitmap != NULL && LockLooperWithTimeout(100000) == B_OK) {
+		fDrawLock.Lock();
+		if (state->bitmap != NULL)
+			DrawBitmap(state->bitmap, BPoint(0, 0));
+		fDrawLock.Unlock();
+		Flush();
+		UnlockLooper();
+	}
+}
+
+
+BView*
+BGLView::EmbeddedView()
+{
+	return NULL;
+}
+
+
+void*
+BGLView::GetGLProcAddress(const char* procName)
+{
+	return (void*)eglGetProcAddress(procName);
+}
+
+
+status_t
+BGLView::CopyPixelsOut(BPoint source, BBitmap* dest)
+{
+	glview_state* state = state_of(fGc);
+	if (state == NULL || dest == NULL || dest->ColorSpace() != B_RGB32)
+		return B_BAD_VALUE;
+
+	BAutolock _(fDrawLock);
+	BBitmap* bitmap = state->bitmap;
+	if (bitmap == NULL)
+		return B_ERROR;
+	BRect area = dest->Bounds().OffsetToCopy(source) & bitmap->Bounds();
+	if (!area.IsValid())
+		return B_BAD_VALUE;
+	for (int32 y = 0; y <= area.IntegerHeight(); y++) {
+		memcpy((uint8*)dest->Bits() + y * dest->BytesPerRow(),
+			(uint8*)bitmap->Bits() + ((int32)area.top + y) * bitmap->BytesPerRow()
+				+ (int32)area.left * 4,
+			(area.IntegerWidth() + 1) * 4);
+	}
+	return B_OK;
+}
+
+
+status_t
+BGLView::CopyPixelsIn(BBitmap* source, BPoint dest)
+{
+	return B_UNSUPPORTED;
+}
+
+
+void
+BGLView::ErrorCallback(unsigned long errorCode)
+{
+	fprintf(stderr, "BGLView: GL error %#lx\n", errorCode);
+}
+
+
+void
+BGLView::Draw(BRect updateRect)
+{
+	glview_state* state = state_of(fGc);
+	if (state == NULL)
+		return;
+	BAutolock _(fDrawLock);
+	if (state->bitmap != NULL)
+		DrawBitmap(state->bitmap, BPoint(0, 0));
+}
+
+
+void
+BGLView::AttachedToWindow()
+{
+	BView::AttachedToWindow();
+	glview_state* state = state_of(fGc);
+	if (state != NULL) {
+		state->width = Bounds().IntegerWidth() + 1;
+		state->height = Bounds().IntegerHeight() + 1;
+	}
+}
+
+
+void
+BGLView::AllAttached()
+{
+	BView::AllAttached();
+}
+
+
+void
+BGLView::DetachedFromWindow()
+{
+	BView::DetachedFromWindow();
+}
+
+
+void
+BGLView::AllDetached()
+{
+	BView::AllDetached();
+}
+
+
+void
+BGLView::FrameResized(float newWidth, float newHeight)
+{
+	// The next LockGL() makes the pbuffer this size.
+	glview_state* state = state_of(fGc);
+	if (state != NULL) {
+		state->width = (int32)newWidth + 1;
+		state->height = (int32)newHeight + 1;
+	}
+	fBounds = Bounds();
+	BView::FrameResized(newWidth, newHeight);
+}
+
+
+status_t
+BGLView::Perform(perform_code d, void* arg)
+{
+	return BView::Perform(d, arg);
+}
+
+
+status_t
+BGLView::Archive(BMessage* data, bool deep) const
+{
+	return BView::Archive(data, deep);
+}
+
+
+void
+BGLView::MessageReceived(BMessage* message)
+{
+	BView::MessageReceived(message);
+}
+
+
+void
+BGLView::SetResizingMode(uint32 mode)
+{
+	BView::SetResizingMode(mode);
+}
+
+
+void
+BGLView::Show()
+{
+	BView::Show();
+}
+
+
+void
+BGLView::Hide()
+{
+	BView::Hide();
+}
+
+
+BHandler*
+BGLView::ResolveSpecifier(BMessage* msg, int32 index, BMessage* specifier,
+	int32 form, const char* property)
+{
+	return BView::ResolveSpecifier(msg, index, specifier, form, property);
+}
+
+
+status_t
+BGLView::GetSupportedSuites(BMessage* data)
+{
+	return BView::GetSupportedSuites(data);
+}
+
+
+void
+BGLView::DirectConnected(direct_buffer_info* info)
+{
+	// Frames always go through a bitmap.
+}
+
+
+void
+BGLView::EnableDirectMode(bool enabled)
+{
+}
+
+
+void
+BGLView::GetPreferredSize(float* width, float* height)
+{
+	if (width != NULL)
+		*width = 0;
+	if (height != NULL)
+		*height = 0;
+}
+
+
+void BGLView::_ReservedGLView1() {}
+void BGLView::_ReservedGLView2() {}
+void BGLView::_ReservedGLView3() {}
+void BGLView::_ReservedGLView4() {}
+void BGLView::_ReservedGLView5() {}
+void BGLView::_ReservedGLView6() {}
+void BGLView::_ReservedGLView7() {}
+void BGLView::_ReservedGLView8() {}
+
+
+void
+BGLView::_LockDraw()
+{
+	fDrawLock.Lock();
+}
+
+
+void
+BGLView::_UnlockDraw()
+{
+	fDrawLock.Unlock();
+}
+
+
+void
+BGLView::_CallDirectConnected()
+{
+}
+
+
+//	#pragma mark - BGLScreen
+
+
+/*	Full screen GL needs the screen's frame buffer, which no Mesa driver here
+	draws into; BGLScreen exists so its users load, and fails cleanly.
+*/
+BGLScreen::BGLScreen(char* name, ulong screenMode, ulong options,
+	status_t* error, bool debug)
+	:
+	BWindowScreen(name, screenMode, error, debug),
+	fGc(NULL),
+	fOptions(options),
+	fDrawLock("BGLScreen draw lock"),
+	fColorSpace(B_CMAP8),
+	fScreenMode(screenMode)
+{
+	if (error != NULL)
+		*error = B_UNSUPPORTED;
+}
+
+
+BGLScreen::~BGLScreen()
+{
+}
+
+
+void BGLScreen::LockGL() { fDrawLock.Lock(); }
+void BGLScreen::UnlockGL() { fDrawLock.Unlock(); }
+void BGLScreen::SwapBuffers() {}
+void BGLScreen::ErrorCallback(unsigned long errorCode) {}
+
+void
+BGLScreen::ScreenConnected(bool connected)
+{
+}
+
+
+void
+BGLScreen::FrameResized(float width, float height)
+{
+	BWindowScreen::FrameResized(width, height);
+}
+
+
+status_t
+BGLScreen::Perform(perform_code code, void* arg)
+{
+	// BWindowScreen keeps its Perform() private
+	return BWindow::Perform(code, arg);
+}
+
+
+status_t
+BGLScreen::Archive(BMessage* data, bool deep) const
+{
+	return BWindowScreen::Archive(data, deep);
+}
+
+
+void
+BGLScreen::MessageReceived(BMessage* message)
+{
+	BWindowScreen::MessageReceived(message);
+}
+
+
+void BGLScreen::Show() { BWindowScreen::Show(); }
+void BGLScreen::Hide() { BWindowScreen::Hide(); }
+
+
+BHandler*
+BGLScreen::ResolveSpecifier(BMessage* message, int32 index,
+	BMessage* specifier, int32 form, const char* property)
+{
+	return BWindowScreen::ResolveSpecifier(message, index, specifier, form,
+		property);
+}
+
+
+status_t
+BGLScreen::GetSupportedSuites(BMessage* data)
+{
+	return BWindowScreen::GetSupportedSuites(data);
+}
+
