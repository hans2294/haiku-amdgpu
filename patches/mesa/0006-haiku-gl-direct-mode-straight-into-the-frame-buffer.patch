--- a/src/haiku-gl/GLView.cpp
+++ b/src/haiku-gl/GLView.cpp
@@ -13,25 +13,43 @@
  * what it always was. SwapBuffers() reads it back into a BBitmap and draws
  * that into the view.
  *
+ * In direct mode (a BDirectWindow that called EnableDirectMode()), frames
+ * skip the CPU: the screen's frame buffer, the CRTC's scanout buffer on the
+ * DRM primary node, is imported as an EGLImage through a dma-buf, and
+ * SwapBuffers() blits the pbuffer into it on the GPU, clipped to the
+ * visible parts of the view that DirectConnected() reported. It finishes
+ * the blit before it lets go of fDrawLock, so a B_DIRECT_STOP (which takes
+ * that lock) returns only once nothing more lands in the frame buffer.
+ *
  * Locking: fDisplayLock is the GL lock (LockGL()/UnlockGL(), the context is
- * current while it is held); fDrawLock guards the bitmap. Drawing into the
- * view takes the window's looper lock first and fDrawLock second, from
- * SwapBuffers() and from Draw() alike.
+ * current while it is held); fDrawLock guards the bitmap and the direct
+ * mode state. Drawing into the view takes the window's looper lock first
+ * and fDrawLock second, from SwapBuffers() and from Draw() alike.
  */
 
+// GLView.h brings GL/gl.h, and with it glext.h
+#define GL_GLEXT_PROTOTYPES
 #include "GLView.h"
 
 #include <Autolock.h>
+#include <DirectWindow.h>
 #include <Screen.h>
 
+#include <fcntl.h>
 #include <new>
 #include <stdio.h>
 #include <stdlib.h>
 #include <string.h>
+#include <unistd.h>
 
 #include <EGL/egl.h>
 #include <EGL/eglext.h>
 #include <GL/gl.h>
+#include <GL/glext.h>
+
+#include <drm_fourcc.h>
+#include <xf86drm.h>
+#include <xf86drmMode.h>
 
 #ifndef GL_BGRA
 #define GL_BGRA 0x80E1
@@ -47,9 +65,28 @@ struct glview_state {
 	int32 height;
 	int32 surfaceWidth;		/* the pbuffer's */
 	int32 surfaceHeight;
-	BBitmap* bitmap;		/* the last frame, B_RGB32 */
+	BBitmap* bitmap;		/* the last frame (not in direct mode), B_RGB32 */
 	uint8* staging;			/* glReadPixels() lands here, bottom up */
 	size_t stagingSize;
+
+	/* direct mode, under fDrawLock */
+	bool directEnabled;		/* EnableDirectMode(true) */
+	bool directConnected;	/* between B_DIRECT_START and B_DIRECT_STOP */
+	bool directFailed;		/* the frame buffer could not be imported */
+	bool screenChanged;		/* import the frame buffer again */
+	void* screenBits;		/* as DirectConnected() saw it last */
+	clipping_rect windowBounds;	/* the window's content on screen */
+	clipping_rect viewBounds;	/* the view on screen, inclusive */
+	clipping_rect* clipList;	/* visible parts of the window, on screen */
+	uint32 clipCount;
+	uint32 clipCapacity;
+	BPoint viewOffset;		/* the view's origin in the window */
+
+	/* the frame buffer as a GL framebuffer; GL thread only */
+	int primaryFD;
+	EGLImage screenImage;
+	GLuint screenRenderbuffer;
+	GLuint screenFramebuffer;
 };
 
 
@@ -63,12 +100,13 @@ state_of(void* gc)
