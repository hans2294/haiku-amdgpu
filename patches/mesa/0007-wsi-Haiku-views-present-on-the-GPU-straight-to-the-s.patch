+#ifdef __HAIKU__
+static void
+haiku_release_screen(struct wsi_headless_swapchain *chain)
+{
+   const struct wsi_device *wsi = chain->base.wsi;
+   if (chain->screen != VK_NULL_HANDLE)
+      wsi->DestroyBuffer(chain->base.device, chain->screen, &chain->base.alloc);
+   if (chain->screen_memory != VK_NULL_HANDLE)
+      wsi->FreeMemory(chain->base.device, chain->screen_memory,
+                      &chain->base.alloc);
+   chain->screen = VK_NULL_HANDLE;
+   chain->screen_memory = VK_NULL_HANDLE;
+}
+
+/* A buffer over the screen's frame buffer, imported as a dma-buf. */
+static VkResult
+haiku_import_screen(struct wsi_headless_swapchain *chain)
+{
+   const struct wsi_device *wsi = chain->base.wsi;
+   VkDevice device = chain->base.device;
+   uint32_t width, height, pitch;
+   int fd = wsi_haiku_screen_dma_buf(&width, &height, &pitch);
+   if (fd < 0)
+      return VK_ERROR_FEATURE_NOT_PRESENT;
+
+   const VkExternalMemoryBufferCreateInfo external_info = {
+      .sType = VK_STRUCTURE_TYPE_EXTERNAL_MEMORY_BUFFER_CREATE_INFO,
+      .handleTypes = VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT,
+   };
+   const VkBufferCreateInfo buffer_info = {
+      .sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO,
+      .pNext = &external_info,
+      .size = (VkDeviceSize)pitch * height,
+      .usage = VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+      .sharingMode = VK_SHARING_MODE_EXCLUSIVE,
+   };
+   VkResult result = wsi->CreateBuffer(device, &buffer_info, &chain->base.alloc,
+                                       &chain->screen);
+   if (result != VK_SUCCESS) {
+      close(fd);
+      return result;
+   }
+
+   VkMemoryRequirements requirements;
+   wsi->GetBufferMemoryRequirements(device, chain->screen, &requirements);
+   const VkMemoryDedicatedAllocateInfo dedicated_info = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_DEDICATED_ALLOCATE_INFO,
+      .buffer = chain->screen,
+   };
+   const VkImportMemoryFdInfoKHR import_info = {
+      .sType = VK_STRUCTURE_TYPE_IMPORT_MEMORY_FD_INFO_KHR,
+      .pNext = &dedicated_info,
+      .handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT,
+      .fd = fd,
+   };
+   const VkMemoryAllocateInfo memory_info = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+      .pNext = &import_info,
+      .allocationSize = requirements.size,
+      .memoryTypeIndex =
+         wsi_select_device_memory_type(wsi, requirements.memoryTypeBits),
+   };
+   result = wsi->AllocateMemory(device, &memory_info, &chain->base.alloc,
+                                &chain->screen_memory);
+   if (result != VK_SUCCESS) {
+      /* a successful import owns the fd */
+      close(fd);
+      haiku_release_screen(chain);
+      return result;
+   }
+   result = wsi->BindBufferMemory(device, chain->screen, chain->screen_memory,
+                                  0);
+   if (result != VK_SUCCESS) {
+      haiku_release_screen(chain);
+      return result;
+   }
+   chain->screen_width = width;
+   chain->screen_height = height;
+   chain->screen_pitch = pitch;
+   return VK_SUCCESS;
+}
+
+/* A host-visible buffer for one image's rows, for presents through the
+ * view. */
+static VkResult
+haiku_create_staging(struct wsi_headless_swapchain *chain)
+{
+   const struct wsi_device *wsi = chain->base.wsi;
+   VkDevice device = chain->base.device;
+   const VkBufferCreateInfo buffer_info = {
+      .sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO,
+      .size = (VkDeviceSize)chain->extent.width * chain->extent.height * 4,
+      .usage = VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+      .sharingMode = VK_SHARING_MODE_EXCLUSIVE,
+   };
+   VkResult result = wsi->CreateBuffer(device, &buffer_info, &chain->base.alloc,
+                                       &chain->staging);
+   if (result != VK_SUCCESS)
+      return result;
+   VkMemoryRequirements requirements;
+   wsi->GetBufferMemoryRequirements(device, chain->staging, &requirements);
+   const VkMemoryAllocateInfo memory_info = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO,
+      .allocationSize = requirements.size,
+      .memoryTypeIndex = wsi_select_memory_type(wsi,
+         VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_CACHED_BIT,
+         0, requirements.memoryTypeBits),
+   };
+   result = wsi->AllocateMemory(device, &memory_info, &chain->base.alloc,
+                                &chain->staging_memory);
+   if (result != VK_SUCCESS)
+      return result;
+   result = wsi->BindBufferMemory(device, chain->staging, chain->staging_memory,
+                                  0);
+   if (result != VK_SUCCESS)
+      return result;
+   return wsi->MapMemory(device, chain->staging_memory, 0, VK_WHOLE_SIZE, 0,
+                         &chain->staging_map);
+}
+
+/* Copies \p count regions of an image into \p buffer on the present queue,
+ * after everything submitted to it so far, and waits until they are there.
+ */
+static VkResult
+haiku_copy_image(struct wsi_headless_swapchain *chain, VkImage image,
+                 VkBuffer buffer, const VkBufferImageCopy *regions,
+                 uint32_t count)
+{
+   const struct wsi_device *wsi = chain->base.wsi;
+   VkDevice device = chain->base.device;
+   struct vk_queue *queue = chain->base.present_queue;
+   VkResult result;
+
+   if (chain->copy_pool == VK_NULL_HANDLE
+       || chain->copy_family != queue->queue_family_index) {
+      if (chain->copy_pool != VK_NULL_HANDLE)
+         wsi->DestroyCommandPool(device, chain->copy_pool, &chain->base.alloc);
+      chain->copy_pool = VK_NULL_HANDLE;
+      const VkCommandPoolCreateInfo pool_info = {
+         .sType = VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO,
+         .flags = VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT,
+         .queueFamilyIndex = queue->queue_family_index,
+      };
+      result = wsi->CreateCommandPool(device, &pool_info, &chain->base.alloc,
+                                      &chain->copy_pool);
+      if (result != VK_SUCCESS)
+         return result;
+      chain->copy_family = queue->queue_family_index;
+      const VkCommandBufferAllocateInfo commands_info = {
+         .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO,
+         .commandPool = chain->copy_pool,
+         .level = VK_COMMAND_BUFFER_LEVEL_PRIMARY,
+         .commandBufferCount = 1,
+      };
+      result = wsi->AllocateCommandBuffers(device, &commands_info,
+                                           &chain->copy_commands);
+      if (result != VK_SUCCESS)
+         return result;
+   }
+   if (chain->copy_fence == VK_NULL_HANDLE) {
+      const VkFenceCreateInfo fence_info = {
+         .sType = VK_STRUCTURE_TYPE_FENCE_CREATE_INFO,
+      };
+      result = wsi->CreateFence(device, &fence_info, &chain->base.alloc,
+                                &chain->copy_fence);
+      if (result != VK_SUCCESS)
+         return result;
+   }
+
+   const VkCommandBufferBeginInfo begin_info = {
+      .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO,
+      .flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT,
+   };
+   wsi->BeginCommandBuffer(chain->copy_commands, &begin_info);
+   VkImageMemoryBarrier barrier = {
+      .sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER,
+      .srcAccessMask = VK_ACCESS_MEMORY_WRITE_BIT,
+      .dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT,
+      .oldLayout = VK_IMAGE_LAYOUT_PRESENT_SRC_KHR,
+      .newLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+      .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+      .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+      .image = image,
+      .subresourceRange = {
+         .aspectMask = VK_IMAGE_ASPECT_COLOR_BIT,
+         .levelCount = 1,
+         .layerCount = 1,
+      },
+   };
+   wsi->CmdPipelineBarrier(chain->copy_commands,
+                           VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,
+                           VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, NULL, 0, NULL,
+                           1, &barrier);
+   wsi->CmdCopyImageToBuffer(chain->copy_commands, image,
+                             VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, buffer,
+                             count, regions);
+   barrier.srcAccessMask = 0;
+   barrier.dstAccessMask = 0;
+   barrier.oldLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+   barrier.newLayout = VK_IMAGE_LAYOUT_PRESENT_SRC_KHR;
+   const VkMemoryBarrier host_barrier = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER,
+      .srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT,
+      .dstAccessMask = VK_ACCESS_HOST_READ_BIT,
+   };
+   wsi->CmdPipelineBarrier(chain->copy_commands, VK_PIPELINE_STAGE_TRANSFER_BIT,
+                           VK_PIPELINE_STAGE_HOST_BIT
+                           | VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, 0,
+                           1, &host_barrier, 0, NULL, 1, &barrier);
+   result = wsi->EndCommandBuffer(chain->copy_commands);
+   if (result != VK_SUCCESS)
+      return result;
+
+   const VkCommandBufferSubmitInfo commands = {
+      .sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_SUBMIT_INFO,
+      .commandBuffer = chain->copy_commands,
+   };
+   const VkSubmitInfo2 submit = {
+      .sType = VK_STRUCTURE_TYPE_SUBMIT_INFO_2,
+      .commandBufferInfoCount = 1,
+      .pCommandBufferInfos = &commands,
+   };
+   result = wsi->QueueSubmit2(vk_queue_to_handle(queue), 1, &submit,
+                              chain->copy_fence);
+   if (result != VK_SUCCESS)
+      return result;
+   result = wsi->WaitForFences(device, 1, &chain->copy_fence, true, UINT64_MAX);
+   wsi->ResetFences(device, 1, &chain->copy_fence);
+   return result;
+}
