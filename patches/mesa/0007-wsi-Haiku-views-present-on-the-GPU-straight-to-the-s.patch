+/* Through the view: a copy into the staging buffer, then a bitmap. */
+static VkResult
+haiku_present_view(struct wsi_headless_swapchain *chain, VkImage image)
+{
+   if (chain->staging_map == NULL) {
+      VkResult result = haiku_create_staging(chain);
+      if (result != VK_SUCCESS)
+         return result;
+   }
+   const VkBufferImageCopy copy = {
+      .imageSubresource = {
+         .aspectMask = VK_IMAGE_ASPECT_COLOR_BIT,
+         .layerCount = 1,
+      },
+      .imageExtent = { chain->extent.width, chain->extent.height, 1 },
+   };
+   VkResult result = haiku_copy_image(chain, image, chain->staging, &copy, 1);
+   if (result != VK_SUCCESS)
+      return result;
+   bool shown = wsi_haiku_present(chain->haiku_presenter, chain->staging_map,
+                                  chain->extent.width * 4, chain->extent.width,
+                                  chain->extent.height);
+   return shown ? VK_SUCCESS : VK_ERROR_SURFACE_LOST_KHR;
+}
