diff --git a/src/vulkan/wsi/wsi_common_haiku.cpp b/src/vulkan/wsi/wsi_common_haiku.cpp
index ab220a3..6739a97 100644
--- a/src/vulkan/wsi/wsi_common_haiku.cpp
+++ b/src/vulkan/wsi/wsi_common_haiku.cpp
@@ -6,32 +6,80 @@
 /* Haiku presentation for the headless WSI: each presented image is copied
  * into a BBitmap and drawn in the application's BView, with the view's
  * window locked, as Haiku's BGLView does in SwapBuffers().
+ *
+ * In direct mode (the application forwards its BDirectWindow's
+ * DirectConnected() calls), wsi_common_headless.c copies images straight
+ * into the screen's frame buffer instead; this keeps what it needs for
+ * that: the visible parts of the window, and the frame buffer as a dma-buf.
+ * The direct state's lock is held while a direct present is in flight, so
+ * B_DIRECT_STOP (which takes it) returns only after it landed. Nothing
+ * locks a looper while holding it.
  */
 
 #include "wsi_common_haiku.h"
 
+#include <fcntl.h>
 #include <new>
+#include <stdlib.h>
 #include <string.h>
+#include <unistd.h>
 
+#include <Autolock.h>
 #include <Bitmap.h>
+#include <DirectWindow.h>
+#include <Locker.h>
+#include <Screen.h>
 #include <View.h>
 #include <Window.h>
 
+#include <xf86drm.h>
+#include <xf86drmMode.h>
+
 struct wsi_haiku_presenter {
    BView *view;
    BBitmap *bitmap;
 };
 
+struct wsi_haiku_direct {
+   wsi_haiku_direct *next;       /* in sDirectStates */
+   void *view;
+   BLocker lock;
+   bool connected;
+   uint32_t generation;          /* bumped when the frame buffer may change */
+   void *bits;                   /* as DirectConnected() saw it last */
+   clipping_rect window_bounds;  /* the window's content, on screen */
+   clipping_rect *clips;         /* visible parts of the window, on screen */
+   uint32_t clip_count;
+   uint32_t clip_capacity;
+   BPoint view_offset;           /* the view's origin in the window */
+   wsi_haiku_region *regions;
+   uint32_t region_capacity;
+
+   wsi_haiku_direct(void *view)
+      : next(NULL), view(view), lock("wsi direct"), connected(false), generation(0), bits(NULL),
+        clips(NULL), clip_count(0), clip_capacity(0), view_offset(B_ORIGIN),
+        regions(NULL), region_capacity(0)
+   {
+   }
+};
+
 extern "C" bool
-wsi_haiku_view_extent(void *_view, uint32_t *width, uint32_t *height)
+wsi_haiku_view_extent(void *_view, struct wsi_haiku_direct *direct,
+                      uint32_t *width, uint32_t *height)
 {
    BView *view = (BView *)_view;
    if (!view->LockLooper())
       return false;
    BRect bounds = view->Bounds();
+   BPoint offset = view->ConvertToScreen(B_ORIGIN)
+      - view->Window()->ConvertToScreen(B_ORIGIN);
    view->UnlockLooper();
    *width = bounds.IntegerWidth() + 1;
    *height = bounds.IntegerHeight() + 1;
+   if (direct != NULL) {
+      BAutolock _(direct->lock);
+      direct->view_offset = offset;
+   }
    return true;
 }
 
@@ -87,3 +135,193 @@ wsi_haiku_present(struct wsi_haiku_presenter *presenter, const void *pixels,
    view->UnlockLooper();
    return true;
 }
+
+
+/* Every surface's direct state, found by the view */
+static BLocker sDirectStatesLock("wsi direct states");
+static wsi_haiku_direct *sDirectStates;
+
+extern "C" struct wsi_haiku_direct *
+wsi_haiku_direct_create(void *view)
+{
+   wsi_haiku_direct *direct = new(std::nothrow) wsi_haiku_direct(view);
+   if (direct == NULL)
+      return NULL;
+   BAutolock _(sDirectStatesLock);
+   direct->next = sDirectStates;
+   sDirectStates = direct;
+   return direct;
+}
+
+extern "C" void
+wsi_haiku_direct_destroy(struct wsi_haiku_direct *direct)
+{
+   if (direct == NULL)
+      return;
+   sDirectStatesLock.Lock();
+   for (wsi_haiku_direct **link = &sDirectStates; *link != NULL;
+        link = &(*link)->next) {
+      if (*link == direct) {
+         *link = direct->next;
+         break;
+      }
+   }
+   sDirectStatesLock.Unlock();
+   free(direct->clips);
+   free(direct->regions);
+   delete direct;
+}
+
+static void
+direct_connected(wsi_haiku_direct *direct, const direct_buffer_info *info)
+{
+   BAutolock _(direct->lock);
+   switch (info->buffer_state & B_DIRECT_MODE_MASK) {
+   case B_DIRECT_START:
+   case B_DIRECT_MODIFY: {
+      if (info->clip_list_count > direct->clip_capacity) {
+         clipping_rect *clips = (clipping_rect *)realloc(direct->clips,
+            info->clip_list_count * sizeof(clipping_rect));
+         if (clips == NULL) {
+            direct->connected = false;
+            return;
+         }
+         direct->clips = clips;
+         direct->clip_capacity = info->clip_list_count;
+      }
+      memcpy(direct->clips, info->clip_list,
+             info->clip_list_count * sizeof(clipping_rect));
+      direct->clip_count = info->clip_list_count;
+      direct->window_bounds = info->window_bounds;
+      if (info->bits != direct->bits
+          || (info->buffer_state & B_BUFFER_RESET) != 0) {
+         direct->bits = info->bits;
+         direct->generation++;
+      }
+      direct->connected = true;
+      break;
+   }
+   case B_DIRECT_STOP:
+      direct->connected = false;
+      break;
+   }
+}
+
+extern "C" void
+wsi_haiku_direct_connected(void *view, const void *info)
+{
+   if (view == NULL || info == NULL)
+      return;
+   BAutolock _(sDirectStatesLock);
+   for (wsi_haiku_direct *direct = sDirectStates; direct != NULL;
+        direct = direct->next) {
+      if (direct->view == view)
+         direct_connected(direct, (const direct_buffer_info *)info);
+   }
+}
+
+extern "C" bool
+wsi_haiku_direct_begin(struct wsi_haiku_direct *direct,
+                       uint32_t width, uint32_t height,
+                       const struct wsi_haiku_region **_regions,
+                       uint32_t *_count, uint32_t *generation)
+{
+   if (direct == NULL || !direct->lock.Lock())
+      return false;
+   if (!direct->connected) {
+      direct->lock.Unlock();
+      return false;
+   }
+
+   if (direct->clip_count > direct->region_capacity) {
+      wsi_haiku_region *regions = (wsi_haiku_region *)realloc(
+         direct->regions, direct->clip_count * sizeof(wsi_haiku_region));
+      if (regions == NULL) {
+         direct->lock.Unlock();
+         return false;
+      }
+      direct->regions = regions;
+      direct->region_capacity = direct->clip_count;
+   }
+
+   // the view on screen, inclusive
+   int32_t viewLeft = direct->window_bounds.left
+      + (int32_t)direct->view_offset.x;
+   int32_t viewTop = direct->window_bounds.top
+      + (int32_t)direct->view_offset.y;
+   int32_t viewRight = viewLeft + (int32_t)width - 1;
+   int32_t viewBottom = viewTop + (int32_t)height - 1;
+
+   uint32_t count = 0;
+   for (uint32_t i = 0; i < direct->clip_count; i++) {
+      const clipping_rect &clip = direct->clips[i];
+      int32_t left = max_c(clip.left, viewLeft);
+      int32_t top = max_c(clip.top, viewTop);
+      int32_t right = min_c(clip.right, viewRight);
+      int32_t bottom = min_c(clip.bottom, viewBottom);
+      if (left > right || top > bottom)
+         continue;
+      wsi_haiku_region &region = direct->regions[count++];
+      region.src_x = left - viewLeft;
+      region.src_y = top - viewTop;
+      region.dst_x = left;
+      region.dst_y = top;
+      region.width = right - left + 1;
+      region.height = bottom - top + 1;
+   }
+   *_regions = direct->regions;
+   *_count = count;
+   *generation = direct->generation;
+   return true;
+}
+
+extern "C" void
+wsi_haiku_direct_end(struct wsi_haiku_direct *direct)
+{
+   direct->lock.Unlock();
+}
+
+/* The frame buffer's handle comes from the primary node, which hands it out
+ * without being master on linuxkpi; it leaves as a dma-buf. */
+extern "C" int
+wsi_haiku_screen_dma_buf(uint32_t *width, uint32_t *height, uint32_t *pitch)
+{
+   int fd = open("/dev/dri/card0", O_RDWR | O_CLOEXEC);
+   if (fd < 0)
+      return -1;
+
+   uint32_t framebufferID = 0;
+   drmModeResPtr resources = drmModeGetResources(fd);
+   for (int i = 0; resources != NULL && i < resources->count_crtcs
+        && framebufferID == 0; i++) {
+      drmModeCrtcPtr crtc = drmModeGetCrtc(fd, resources->crtcs[i]);
+      if (crtc != NULL)
+         framebufferID = crtc->buffer_id;
+      drmModeFreeCrtc(crtc);
+   }
+   drmModeFreeResources(resources);
+
+   int dmaBuf = -1;
+   drmModeFBPtr framebuffer = framebufferID != 0
+      ? drmModeGetFB(fd, framebufferID) : NULL;
+   if (framebuffer != NULL && framebuffer->handle != 0
+       && framebuffer->bpp == 32) {
+      if (drmPrimeHandleToFD(fd, framebuffer->handle, DRM_CLOEXEC | DRM_RDWR,
+                             &dmaBuf) != 0)
+         dmaBuf = -1;
+      drmCloseBufferHandle(fd, framebuffer->handle);
+      *width = framebuffer->width;
+      *height = framebuffer->height;
+      *pitch = framebuffer->pitch;
+   }
+   drmModeFreeFB(framebuffer);
+   close(fd);
+   return dmaBuf;
+}
+
+extern "C" void
+wsi_haiku_wait_retrace(void *_view)
+{
+   BView *view = (BView *)_view;
+   BScreen(view->Window()).WaitForRetrace(100000);
+}
