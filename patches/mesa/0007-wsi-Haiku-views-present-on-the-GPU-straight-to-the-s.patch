+/* Straight into the frame buffer while the window is connected (true when
+ * done so), else false and nothing done. */
+static bool
+haiku_present_direct(struct wsi_headless_swapchain *chain, VkImage image,
+                     VkResult *result)
+{
+   const struct wsi_haiku_region *regions;
+   uint32_t count, generation;
+   if (chain->screen_failed
+       || !wsi_haiku_direct_begin(chain->haiku_direct, chain->extent.width,
+                                  chain->extent.height, &regions, &count,
+                                  &generation))
+      return false;
+
+   if (chain->screen == VK_NULL_HANDLE
+       || generation != chain->screen_generation) {
+      haiku_release_screen(chain);
+      if (haiku_import_screen(chain) != VK_SUCCESS) {
+         fprintf(stderr, "wsi: no direct mode, presents go through the "
+                 "view\n");
+         chain->screen_failed = true;
+         wsi_haiku_direct_end(chain->haiku_direct);
+         return false;
+      }
+      static bool told;
+      if (!told) {
+         fprintf(stderr, "wsi: direct mode, presents go straight to the "
+                 "frame buffer\n");
+         told = true;
+      }
+      chain->screen_generation = generation;
+   }
+
+   STACK_ARRAY(VkBufferImageCopy, copies, MAX2(count, 1));
+   uint32_t copy_count = 0;
+   for (uint32_t i = 0; i < count; i++) {
+      const struct wsi_haiku_region *region = &regions[i];
+      if (region->dst_x < 0 || region->dst_y < 0
+          || region->dst_x + region->width > chain->screen_width
+          || region->dst_y + region->height > chain->screen_height)
+         continue;
+      copies[copy_count++] = (VkBufferImageCopy) {
+         .bufferOffset = (VkDeviceSize)region->dst_y * chain->screen_pitch
+            + (VkDeviceSize)region->dst_x * 4,
+         .bufferRowLength = chain->screen_pitch / 4,
+         .imageSubresource = {
+            .aspectMask = VK_IMAGE_ASPECT_COLOR_BIT,
+            .layerCount = 1,
+         },
+         .imageOffset = { region->src_x, region->src_y, 0 },
+         .imageExtent = { region->width, region->height, 1 },
+      };
+   }
+   *result = copy_count > 0
+      ? haiku_copy_image(chain, image, chain->screen, copies, copy_count)
+      : VK_SUCCESS;
+   STACK_ARRAY_FINISH(copies);
+   wsi_haiku_direct_end(chain->haiku_direct);
+   return true;
+}
