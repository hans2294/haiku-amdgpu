-bool wsi_haiku_view_extent(void *view, uint32_t *width, uint32_t *height);
 struct wsi_haiku_presenter *wsi_haiku_presenter_create(void *view);
 void wsi_haiku_presenter_destroy(struct wsi_haiku_presenter *presenter);
 /* Copies BGRA8 rows into the view; false when the view is gone. */
@@ -25,6 +30,40 @@ bool wsi_haiku_present(struct wsi_haiku_presenter *presenter,
                        const void *pixels, uint32_t row_pitch,
                        uint32_t width, uint32_t height);
 
+/* Direct mode: what BDirectWindow::DirectConnected() says about a
+ * surface's window (vkDirectConnectedHAIKU). */
+struct wsi_haiku_direct *wsi_haiku_direct_create(void *view);
+void wsi_haiku_direct_destroy(struct wsi_haiku_direct *direct);
+/* For the direct states of the surfaces of \p view */
+void wsi_haiku_direct_connected(void *view, const void *direct_buffer_info);
+
+/* A visible part of the view: from (src_x, src_y) in the image to
+ * (dst_x, dst_y) on the screen. */
+struct wsi_haiku_region {
+   int32_t src_x, src_y;
+   int32_t dst_x, dst_y;
+   uint32_t width, height;
+};
+
+/* While the window is connected: locks the direct state (until
+ * wsi_haiku_direct_end()) and returns the visible parts of a view image of
+ * \p width x \p height, maybe none; the regions stay valid while locked.
+ * \p generation changes whenever the frame buffer may have. False, and
+ * not locked, when presents must go through the view instead. */
+bool wsi_haiku_direct_begin(struct wsi_haiku_direct *direct,
+                            uint32_t width, uint32_t height,
+                            const struct wsi_haiku_region **regions,
+                            uint32_t *count, uint32_t *generation);
+void wsi_haiku_direct_end(struct wsi_haiku_direct *direct);
+
+/* A dma-buf fd for the frame buffer the CRTC shows (XRGB8888, linear), or
+ * -1. */
+int wsi_haiku_screen_dma_buf(uint32_t *width, uint32_t *height,
+                             uint32_t *pitch);
+
+/* Waits for the next vertical blank of the view's screen. */
+void wsi_haiku_wait_retrace(void *view);
+
 #ifdef __cplusplus
 }
 #endif
