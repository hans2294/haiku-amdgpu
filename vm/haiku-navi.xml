<domain type='kvm' xmlns:qemu='http://libvirt.org/schemas/domain/qemu/1.0'>
  <name>haiku-navi</name>
  <uuid>d4ff9ba0-6ce1-4cfa-8d11-250dcf3757ec</uuid>
  <description>Haiku driver development VM with the RX 7900 GRE (03:00.0) passed through</description>
  <memory unit='GiB'>4</memory>
  <vcpu placement='static'>4</vcpu>
  <os firmware='efi'>
    <type arch='x86_64' machine='q35'>hvm</type>
    <firmware>
      <feature enabled='no' name='secure-boot'/>
    </firmware>
    <boot dev='hd'/>
  </os>
  <features>
    <acpi/>
    <apic/>
    <vmport state='off'/>
  </features>
  <cpu mode='host-passthrough' check='none' migratable='off'>
    <maxphysaddr mode='passthrough'/>
  </cpu>
  <clock offset='utc'/>
  <on_poweroff>destroy</on_poweroff>
  <on_reboot>restart</on_reboot>
  <on_crash>destroy</on_crash>
  <devices>
    <emulator>/usr/bin/qemu-system-x86_64</emulator>
    <disk type='file' device='disk'>
      <driver name='qemu' type='raw' cache='writeback'/>
      <source file='@TOP@/generated.x86_64/haiku-nightly-anyboot.iso'/>
      <target dev='sda' bus='sata'/>
    </disk>
    <controller type='pci' index='0' model='pcie-root'/>
    <controller type='pci' index='1' model='pcie-root-port'/>
    <controller type='pci' index='2' model='pcie-root-port'/>
    <controller type='pci' index='3' model='pcie-root-port'/>
    <controller type='pci' index='4' model='pcie-root-port'/>
    <interface type='bridge'>
      <mac address='52:54:00:4a:1b:7e'/>
      <source bridge='@BRIDGE@'/>
      <model type='e1000e'/>
    </interface>
    <!-- Connects to a listener on the host: vm/serial-listen.sh -->
    <serial type='tcp'>
      <source mode='connect' host='127.0.0.1' service='4555'>
        <reconnect enabled='yes' timeout='2'/>
      </source>
      <protocol type='raw'/>
      <target type='isa-serial' port='0'/>
    </serial>
    <input type='keyboard' bus='usb'/>
    <input type='tablet' bus='usb'/>
    <!-- A plain virtual display next to the card: OVMF's GOP driver lights
         it, so Haiku's framebuffer driver and app_server have a screen even
         when nothing drives the 7900 GRE's outputs (no option ROM, Linux
         amdgpu without DC). Without app_server, net_server dies too. -->
    <video>
      <model type='vga' vram='16384' heads='1' primary='yes'/>
    </video>
    <!-- That display, to watch from the host: gvncviewer 127.0.0.1:5 -->
    <graphics type='vnc' port='5905' autoport='no' listen='127.0.0.1'>
      <listen type='address' address='127.0.0.1'/>
    </graphics>
    <!-- RX 7900 GRE and its HDMI audio, bound to vfio-pci at boot by
         vm/vfio-boot.sh. Both functions go in, as one multifunction device:
         the card is reset by a bus reset, which QEMU only does when the VM
         owns every function on the bus.
         No option ROM: the card's UEFI GOP only lights the display after a
         cold power on, and hangs the firmware for good while the PSP runs
         an sOS from an earlier boot. The driver brings the PSP and SMU up
         itself instead. -->
    <controller type='pci' index='5' model='pcie-root-port'/>
    <hostdev mode='subsystem' type='pci' managed='no'>
      <source>
        <address domain='0x0000' bus='0x03' slot='0x00' function='0x0'/>
      </source>
      <rom bar='off'/>
      <address type='pci' domain='0x0000' bus='0x05' slot='0x00' function='0x0' multifunction='on'/>
    </hostdev>
    <hostdev mode='subsystem' type='pci' managed='no'>
      <source>
        <address domain='0x0000' bus='0x03' slot='0x00' function='0x1'/>
      </source>
      <address type='pci' domain='0x0000' bus='0x05' slot='0x00' function='0x1'/>
    </hostdev>
    <memballoon model='none'/>
  </devices>
  <qemu:commandline>
    <!-- room for the 16 GiB resizable BAR in OVMF's 64-bit MMIO window -->
    <qemu:arg value='-fw_cfg'/>
    <qemu:arg value='name=opt/ovmf/X-PciMmio64Mb,string=65536'/>
  </qemu:commandline>
</domain>
