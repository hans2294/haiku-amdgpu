# Kconfig choices for the Haiku port: amdgpu for RDNA3, with display (DC).
# Used by kbuild-files.sh to evaluate Linux's Kbuild Makefiles, and turned
# into autoconf.h for the compiler.
CONFIG_64BIT=y
CONFIG_X86=y
CONFIG_X86_64=y
CONFIG_MMU=y
CONFIG_PCI=y
CONFIG_DMA_SHARED_BUFFER=y
CONFIG_SYNC_FILE=y
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_TTM=y
CONFIG_DRM_TTM_HELPER=y
CONFIG_DRM_SCHED=y
CONFIG_DRM_BUDDY=y
CONFIG_DRM_EXEC=y
CONFIG_DRM_SUBALLOC_HELPER=y
CONFIG_DRM_DISPLAY_HELPER=y
CONFIG_DRM_DISPLAY_DP_HELPER=y
CONFIG_DRM_DISPLAY_DSC_HELPER=y
CONFIG_DRM_DISPLAY_HDCP_HELPER=y
CONFIG_DRM_DISPLAY_HDMI_HELPER=y
CONFIG_DRM_AMDGPU=y
# Display Core, with its floating point display calculations (DML)
CONFIG_DRM_AMD_DC=y
CONFIG_DRM_AMD_DC_FP=y
# Left out on purpose: HSA_AMD (KFD),
# DRM_AMDGPU_SI/CIK, DRM_AMD_ACP, DRM_AMDGPU_USERPTR/HMM_MIRROR, ACPI,
# DEBUG_FS, PROC_FS, PERF_EVENTS, COMPAT, VGA_SWITCHEROO, DRM_FBDEV_EMULATION.
CONFIG_DRM_PANEL_ORIENTATION_QUIRKS=y
CONFIG_GPU_BUDDY=y
CONFIG_HDMI=y
CONFIG_I2C=y
CONFIG_I2C_ALGOBIT=y
